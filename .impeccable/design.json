  "narrative": {
    "northStar": "The Offbeat Escape",
    "overview": "The Offbeat Escape is expressive and adventurous: travel imagery, warm accents, and characterful serif headings make the public experience feel personal. Its confirmed character is warm, editorial, and approachable, with quieter, practical booking and admin screens.\n\nControls are friendly and confident. Rounded shapes and layered surfaces make the interface welcoming; clear labels, stable hierarchy, and restrained operational layouts keep it usable. Depth is layered, with gentle lift for interactive elements.",
    "keyCharacteristics": [
      "Travel imagery paired with expressive Fraunces headings.",
      "Warm Coral, Deep Navy, and Soft Blush across light surfaces and dark bands.",
      "Manrope for readable body text, navigation, labels, and operational controls.",
      "Rounded cards, pill actions, and gentle interactive lift.",
      "Shared brand tokens with denser, quieter booking and admin layouts."
    ],
    "rules": [
      {
        "name": "The Coral Role Rule",
        "body": "Use cta for the shared coral button fill, coral-ink for normal-size coral text on light surfaces, and coral for large accents or coral text on navy. These roles are not interchangeable.",
        "section": "colors"
      },
      {
        "name": "The Paired Status Rule",
        "body": "Keep each semantic surface with its corresponding ink. Success text on white uses success-ink; mint success badges use success-surface-ink.",
        "section": "colors"
      },
      {
        "name": "The Shared Scale Rule",
        "body": "Use the existing fluid display scale for shared heading patterns. Preserve documented route-specific typography rather than claiming every heading already uses that scale.",
        "section": "typography"
      },
      {
        "name": "The Gentle Lift Rule",
        "body": "Keep shared interactive lift small: buttons and hover-enabled cards rise 2px. Reserve the strongest separation for overlays and elevated panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the existing tokens and shared component variants.",
      "Do preserve readable coral roles and paired semantic status colors.",
      "Do keep image overlays matched to the position of the text.",
      "Do retain visible keyboard focus and the existing reduced-motion treatments.",
      "Do preserve the approved content and identity commitments recorded in PRODUCT.md."
    ],
    "donts": [
      "Don't use the bright coral token as normal-size text on light backgrounds or as the shared white-label CTA fill.",
      "Don't substitute success fill green for readable success text.",
      "Don't turn the documented button hierarchy into a claim that all current trip-card actions already follow it.",
      "Don't use old screenshot layouts or stubbed fixture imagery as authority over current source.",
      "Don't invent visual anti-references or treat synthesized preview ramps as production tokens."
    ]
  }
}
