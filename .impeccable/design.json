      "description": "Shared Button.astro, medium size.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Continue</button>",
      "css": ".ds-button-primary { display:inline-flex; align-items:center; justify-content:center; gap:0.5rem; padding:0.75rem 1.5rem; border:0; border-radius:var(--radius-pill); background:var(--color-navy); color:var(--color-white); font-family:var(--font-sans); font-size:0.875rem; line-height:1.25rem; font-weight:600; cursor:pointer; box-shadow:var(--shadow-card); transition:all 150ms; } .ds-button-primary:hover { transform:translateY(-2px); filter:brightness(1.25); } .ds-button-primary:focus-visible { outline:2px solid var(--color-coral); outline-offset:2px; } .ds-button-primary:disabled, .ds-button-primary[aria-disabled=\"true\"] { opacity:0.4; pointer-events:none; }"
    },
