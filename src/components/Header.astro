---
interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;

const navLinks = [
  { href: '/trips/', label: 'Trips' },
  { href: '/about/', label: 'Our Story' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
  { href: '/cancellation/', label: 'Cancellation Policy' },
  { href: '/terms/', label: 'Terms' },
];

const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class:list={[hidden ? ['fixed', 'is-hideable'] : 'sticky', 'top-0', 'left-0', 'right-0', 'z-50']}
  style="background: rgba(27,43,58,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: transform 0.35s ease;"
>
  <div class="container-app">
    <div class="flex items-center justify-between" style="height: 64px;">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 hover:opacity-90 transition-opacity">
        <img src="/logo.jpg" alt="Seek the Thrill" class="h-9 w-auto rounded-lg" />
        <span class="hidden sm:block font-semibold text-sm text-white">Seek the Thrill</span>
      </a>

      <!-- Menu Button (hamburger-only on all sizes; drawer holds all nav) -->
      <button
        id="menu-btn"
        class="p-2 rounded-lg"
        style="color: white;"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menu Drawer (all sizes) -->
<div id="menu-overlay" class="fixed inset-0 z-[60] pointer-events-none">
  <div id="menu-backdrop" class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-300"></div>
  <div
    id="menu-panel"
    class="absolute right-0 top-0 flex h-full w-[78%] max-w-sm flex-col bg-white p-6 translate-x-full transition-transform duration-300 shadow-2xl"
  >
    <!-- Drawer header -->
    <div class="mb-8 flex items-center justify-between">
      <span class="font-display text-lg" style="color: var(--color-navy);">Seek the Thrill</span>
      <button id="menu-close" aria-label="Close menu" class="p-2" style="color: var(--color-navy);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Links -->
    <nav class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-3 text-base font-medium transition-colors"
          style={pathname.startsWith(link.href)
            ? 'color: var(--color-coral); background: var(--color-blush);'
            : 'color: rgba(27,43,58,0.8);'}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Bottom CTA -->
    <div class="mt-auto">
      <a
        href="/trips/"
        class="block w-full text-center font-semibold text-white py-3.5 rounded-full"
        style="background-color: var(--color-cta);"
      >
        Join a trip
      </a>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('menu-btn');
  const overlay = document.getElementById('menu-overlay');
  const backdrop = document.getElementById('menu-backdrop');
  const panel = document.getElementById('menu-panel');
  const closeBtn = document.getElementById('menu-close');

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    overlay!.classList.remove('pointer-events-none');
    backdrop!.classList.remove('opacity-0');
    panel!.classList.remove('translate-x-full');
    btn!.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    isOpen = false;
    backdrop!.classList.add('opacity-0');
    panel!.classList.add('translate-x-full');
    btn!.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => { if (!isOpen) overlay!.classList.add('pointer-events-none'); }, 300);
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeMenu(); });
</script>

<style is:global>
  /* Homepage hero mode: fixed (reserves no layout space, so no band above
     the hero), hidden until the page is scrolled past the hero. */
  #site-header.is-hideable { transform: translateY(-100%); }
  #site-header.is-hideable.header-visible { transform: translateY(0); }
</style>
