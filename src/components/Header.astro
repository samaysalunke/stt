---
interface Props {
  hidden?: boolean;
  user?: { id: string; email: string; displayName: string | null; avatarUrl: string | null } | null;
}

const { hidden = false, user = null } = Astro.props;

const navLinks = [
  { href: '/trips/', label: 'Trips' },
  { href: '/about/', label: 'Our Story' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
  { href: '/cancellation/', label: 'Cancellation Policy' },
  { href: '/terms/', label: 'Terms' },
];

const pathname = Astro.url.pathname;
const firstName = user?.displayName?.split(' ')[0] ?? null;
---

<header
  id="site-header"
  class:list={[hidden ? ['fixed', 'is-hideable'] : 'sticky', 'top-0', 'left-0', 'right-0', 'z-50']}
  style="background: rgba(27,43,58,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: transform 0.35s ease;"
>
  <div class="container-app">
    <div class="flex items-center justify-between" style="height: 64px;">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 hover:opacity-90 transition-opacity">
        <img src="/logo.jpg" alt="Seek the Thrill" class="h-9 w-auto rounded-lg" />
        <span class="hidden sm:block font-semibold text-sm text-white">Seek the Thrill</span>
      </a>

      <!-- Right side: login/profile button (desktop) + hamburger -->
      <div class="flex items-center gap-3">
        <!-- Desktop auth button (hidden on mobile — handled in drawer) -->
        {user ? (
          <a
            href="/profile"
            class="hidden sm:flex items-center gap-2 text-sm font-medium text-white hover:opacity-80 transition-opacity"
          >
            {user.avatarUrl ? (
              <img src={user.avatarUrl} alt={firstName ?? ''} class="w-7 h-7 rounded-full object-cover" referrerpolicy="no-referrer" />
            ) : (
              <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
                   style="background: var(--color-coral);">
                {(firstName ?? 'U')[0].toUpperCase()}
              </div>
            )}
            {firstName}
          </a>
        ) : (
          <a
            href="/login"
            class="hidden sm:block text-sm font-semibold px-4 py-1.5 rounded-full border border-white/40 text-white hover:bg-white/10 transition-colors"
          >
            Sign in
          </a>
        )}

        <!-- Hamburger button (all sizes) -->
        <button
          id="menu-btn"
          class="p-2 rounded-lg"
          style="color: white;"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Menu Drawer (all sizes) -->
<div id="menu-overlay" class="fixed inset-0 z-[60] pointer-events-none">
  <div id="menu-backdrop" class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-300"></div>
  <div
    id="menu-panel"
    class="absolute right-0 top-0 flex h-full w-[78%] max-w-sm flex-col bg-white p-6 translate-x-full transition-transform duration-300 shadow-2xl"
  >
    <!-- Drawer header -->
    <div class="mb-8 flex items-center justify-between">
      <span class="font-display text-lg" style="color: var(--color-navy);">Seek the Thrill</span>
      <button id="menu-close" aria-label="Close menu" class="p-2" style="color: var(--color-navy);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Nav links -->
    <nav class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-3 text-base font-medium transition-colors"
          style={pathname.startsWith(link.href)
            ? 'color: var(--color-coral); background: var(--color-blush);'
            : 'color: rgba(27,43,58,0.8);'}
        >
          {link.label}
        </a>
      ))}

      <!-- Auth link in drawer -->
      {user ? (
        <a
          href="/profile"
          class="rounded-lg px-3 py-3 text-base font-medium flex items-center gap-2.5 transition-colors"
          style={pathname.startsWith('/profile')
            ? 'color: var(--color-coral); background: var(--color-blush);'
            : 'color: rgba(27,43,58,0.8);'}
        >
          {user.avatarUrl ? (
            <img src={user.avatarUrl} alt="" class="w-6 h-6 rounded-full object-cover" referrerpolicy="no-referrer" />
          ) : (
            <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold text-white"
                 style="background: var(--color-coral);">
              {(firstName ?? 'U')[0].toUpperCase()}
            </div>
          )}
          My Profile
        </a>
      ) : (
        <a
          href="/login"
          class="rounded-lg px-3 py-3 text-base font-medium transition-colors"
          style="color: rgba(27,43,58,0.8);"
        >
          Sign in
        </a>
      )}
    </nav>

    <!-- Bottom CTAs -->
    <div class="mt-auto flex flex-col gap-2">
      <a
        href="/trips/"
        class="block w-full text-center font-semibold text-white py-3.5 rounded-full"
        style="background-color: var(--color-cta);"
      >
        Join a trip
      </a>

      {user && (
        <form method="POST" action="/api/auth/logout">
          <button
            type="submit"
            class="w-full text-center text-sm font-medium py-2.5 rounded-full border transition-colors hover:opacity-70"
            style="color: var(--color-coral); border-color: var(--color-peach);"
          >
            Sign out
          </button>
        </form>
      )}
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('menu-btn');
  const overlay = document.getElementById('menu-overlay');
  const backdrop = document.getElementById('menu-backdrop');
  const panel = document.getElementById('menu-panel');
  const closeBtn = document.getElementById('menu-close');

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    overlay!.classList.remove('pointer-events-none');
    backdrop!.classList.remove('opacity-0');
    panel!.classList.remove('translate-x-full');
    btn!.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    isOpen = false;
    backdrop!.classList.add('opacity-0');
    panel!.classList.add('translate-x-full');
    btn!.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => { if (!isOpen) overlay!.classList.add('pointer-events-none'); }, 300);
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeMenu(); });
</script>

<style is:global>
  #site-header.is-hideable { transform: translateY(-100%); }
  #site-header.is-hideable.header-visible { transform: translateY(0); }
</style>
