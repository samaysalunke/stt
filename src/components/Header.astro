---
interface Props {
  hidden?: boolean;
  logoOnly?: boolean;
  user?: { id: string; email: string; displayName: string | null; avatarUrl: string | null } | null;
}

const { hidden = false, logoOnly = false, user = null } = Astro.props;
const navGroups = [
  {
    label: 'Explore',
    links: [
      { href: '/trips/', label: 'Upcoming trips' },
      { href: '/about/', label: 'Our story' },
    ],
  },
  {
    label: 'Support',
    links: [
      { href: '/faq/', label: 'Frequently asked' },
      { href: '/contact/', label: 'Contact us' },
    ],
  },
  {
    label: 'Legal',
    links: [
      { href: '/terms/', label: 'Terms & conditions' },
      { href: '/cancellation/', label: 'Cancellation policy' },
      { href: '/privacy/', label: 'Privacy policy' },
    ],
  },
];

const pathname = Astro.url.pathname;
const firstName = user?.displayName?.split(' ')[0] ?? null;
const initial = (firstName ?? user?.email ?? 'U')[0].toUpperCase();
---

<header
  id="site-header"
  class:list={[hidden ? ['fixed', 'is-hideable'] : 'sticky', 'top-0', 'left-0', 'right-0', 'z-50']}
>
  <div class="container-app">
    <div class="header-row">
      <a href="/" class="header-brand" aria-label="Seek the Thrill home">
        <img src="/logo.jpg" alt="" class="header-logo" />
        <div class="header-wordmark">
          <span>Seek the Thrill</span>
          <small>by Zahra Shakir</small>
        </div>
      </a>

      {!logoOnly && (
        <div class="header-actions">
          {user ? (
            <a href="/profile" class="desktop-profile">
              {user.avatarUrl ? (
                <img src={user.avatarUrl} alt="" referrerpolicy="no-referrer" />
              ) : (
                <span class="avatar-fallback">{initial}</span>
              )}
              <span>{firstName ?? 'Profile'}</span>
            </a>
          ) : (
            <a href="/login" class="desktop-sign-in">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7.5V6a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3v-1.5M10 12h11m-3-3 3 3-3 3" />
              </svg>
              Sign in
            </a>
          )}

          <button id="menu-btn" class="menu-trigger" aria-label="Open menu" aria-expanded="false" aria-controls="menu-panel">
            <span class="menu-trigger-label">Menu</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14" />
            </svg>
          </button>
        </div>
      )}
    </div>
  </div>
</header>

{!logoOnly && (
  <div id="menu-overlay" class="menu-overlay pointer-events-none" aria-hidden="true">
    <div id="menu-backdrop" class="menu-backdrop opacity-0"></div>
    <aside id="menu-panel" class="menu-panel translate-x-full" role="dialog" aria-modal="true" aria-label="Site navigation" tabindex="-1">
      <div class="drawer-top">
        <a href="/" class="drawer-brand" aria-label="Seek the Thrill home">
          <img src="/logo.jpg" alt="" />
          <div>
            <strong>Seek the Thrill</strong>
            <span>Small groups. Offbeat India.</span>
          </div>
        </a>
        <button id="menu-close" aria-label="Close menu" class="menu-close">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {user ? (
        <a href="/profile" class="drawer-profile">
          {user.avatarUrl ? (
            <img src={user.avatarUrl} alt="" referrerpolicy="no-referrer" />
          ) : (
            <span class="drawer-avatar">{initial}</span>
          )}
          <span class="drawer-profile-copy">
            <small>Signed in as</small>
            <strong>{firstName ?? user.email}</strong>
          </span>
          <span class="drawer-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <a href="/login" class="drawer-sign-in">
          <span class="drawer-sign-in-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21a7 7 0 0 0-14 0m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
            </svg>
          </span>
          <span><strong>Sign in</strong><small>View bookings and your profile</small></span>
          <span class="drawer-arrow" aria-hidden="true">→</span>
        </a>
      )}

      <nav class="drawer-nav" aria-label="Primary navigation">
        {navGroups.map((group) => (
          <section class="drawer-group">
            <h2>{group.label}</h2>
            <div>
              {group.links.map((link) => {
                const active = pathname === link.href || pathname.startsWith(link.href);
                return (
                  <a href={link.href} class:list={['drawer-link', { active }]} aria-current={active ? 'page' : undefined}>
                    <span>{link.label}</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="m9 18 6-6-6-6" />
                    </svg>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </nav>

      <div class="drawer-footer">
        <a href="/trips/" class="drawer-trip-cta">Explore upcoming trips <span aria-hidden="true">→</span></a>
        {user && (
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="drawer-sign-out">Sign out</button>
          </form>
        )}
      </div>
    </aside>
  </div>
)}

{!logoOnly && (
  <script>
    const btn = document.getElementById('menu-btn');
    const overlay = document.getElementById('menu-overlay');
    const backdrop = document.getElementById('menu-backdrop');
    const panel = document.getElementById('menu-panel');
    const closeBtn = document.getElementById('menu-close');
    let isOpen = false;

    const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function openMenu() {
      if (!overlay || !backdrop || !panel || !btn) return;
      isOpen = true;
      overlay.classList.remove('pointer-events-none');
      overlay.setAttribute('aria-hidden', 'false');
      backdrop.classList.remove('opacity-0');
      panel.classList.remove('translate-x-full');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      window.setTimeout(() => closeBtn?.focus(), 50);
    }

    function closeMenu() {
      if (!overlay || !backdrop || !panel || !btn) return;
      isOpen = false;
      backdrop.classList.add('opacity-0');
      panel.classList.add('translate-x-full');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        if (!isOpen) {
          overlay.classList.add('pointer-events-none');
          overlay.setAttribute('aria-hidden', 'true');
          btn.focus();
        }
      }, 300);
    }

    btn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);
    document.addEventListener('keydown', (event) => {
      if (!isOpen) return;
      if (event.key === 'Escape') {
        closeMenu();
        return;
      }
      if (event.key !== 'Tab' || !panel) return;
      const focusable = Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  </script>
)}

<style is:global>
  #site-header { background: rgba(27,43,58,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: transform 0.35s ease; }
  #site-header.is-hideable { transform: translateY(-100%); }
  #site-header.is-hideable.header-visible { transform: translateY(0); }
  .header-row { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .header-brand { display: inline-flex; align-items: center; gap: 0.625rem; transition: opacity 150ms ease; }
  .header-brand:hover { opacity: 0.9; }
  .header-logo { width: auto; height: 2.25rem; border-radius: 0.5rem; object-fit: cover; }
  .header-wordmark { display: flex; flex-direction: column; line-height: normal; }
  .header-wordmark span { color: white; font-family: var(--font-sans); font-size: 0.875rem; font-weight: 600; letter-spacing: normal; }
  .header-wordmark small { margin-top: 0; color: rgba(255,255,255,0.5); font-size: 0.75rem; letter-spacing: normal; }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; }
  .desktop-sign-in { display: inline-flex; align-items: center; padding: 0.375rem 1rem; border: 1px solid rgba(255,255,255,0.4); border-radius: 999px; background: transparent; color: white; font-size: 0.875rem; font-weight: 600; transition: background-color 150ms ease; }
  .desktop-sign-in:hover { background: rgba(255,255,255,0.1); }
  .desktop-sign-in svg { display: none; }
  .desktop-profile { display: inline-flex; align-items: center; gap: 0.5rem; color: white; font-size: 0.875rem; font-weight: 500; transition: opacity 150ms ease; }
  .desktop-profile:hover { opacity: 0.8; }
  .desktop-profile img, .avatar-fallback { width: 1.75rem; height: 1.75rem; border-radius: 999px; object-fit: cover; }
  .avatar-fallback { display: grid; place-items: center; background: var(--color-coral); color: white; font-size: 0.75rem; font-weight: 700; }
  .menu-trigger { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; padding: 0.5rem; border-radius: 0.5rem; color: white; transition: background-color 150ms ease; }
  .menu-trigger:hover { background: rgba(255,255,255,0.1); }
  .menu-trigger-label { display: none; }
  .menu-trigger svg { width: 1.5rem; height: 1.5rem; }
  .menu-overlay { position: fixed; inset: 0; z-index: 60; }
  .menu-backdrop { position: absolute; inset: 0; background: rgba(17,29,39,0.48); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); transition: opacity 300ms ease; }
  .menu-panel { position: absolute; inset: 0 0 0 auto; display: flex; flex-direction: column; width: min(92vw, 25rem); height: 100%; padding: 1.25rem; overflow-y: auto; background: #fffaf8; box-shadow: -20px 0 55px rgba(17,29,39,0.2); transition: transform 300ms cubic-bezier(.22,.8,.28,1); }
  .drawer-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1.15rem; border-bottom: 1px solid var(--color-peach); }
  .drawer-brand { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
  .drawer-brand img { width: 3.25rem; height: 3.25rem; border-radius: 0.9rem; object-fit: cover; box-shadow: var(--shadow-card); }
  .drawer-brand div { display: flex; min-width: 0; flex-direction: column; }
  .drawer-brand strong { color: var(--color-navy); font-family: var(--font-display); font-size: 1.3rem; line-height: 1.1; }
  .drawer-brand span { margin-top: 0.28rem; color: var(--color-gray-text); font-size: 0.65rem; }
  .menu-close { display: grid; place-items: center; flex: 0 0 auto; width: 2.6rem; height: 2.6rem; border: 1px solid var(--color-border); border-radius: 999px; background: white; color: var(--color-navy); transition: transform 160ms ease, background 160ms ease; }
  .menu-close:hover { transform: rotate(5deg); background: var(--color-blush); }
  .menu-close svg { width: 1.1rem; height: 1.1rem; }
  .drawer-sign-in, .drawer-profile { display: flex; align-items: center; gap: 0.75rem; margin: 1rem 0 0.25rem; padding: 0.85rem; border-radius: 1rem; }
  .drawer-sign-in { background: var(--color-coral); color: white; box-shadow: 0 9px 22px rgba(217,95,59,0.2); }
  .drawer-sign-in:hover { background: var(--color-cta); }
  .drawer-sign-in-icon, .drawer-avatar, .drawer-profile img { display: grid; place-items: center; flex: 0 0 auto; width: 2.35rem; height: 2.35rem; border-radius: 0.75rem; }
  .drawer-sign-in-icon { background: rgba(255,255,255,0.16); }
  .drawer-sign-in-icon svg { width: 1.25rem; height: 1.25rem; }
  .drawer-sign-in > span:nth-child(2), .drawer-profile-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
  .drawer-sign-in strong, .drawer-profile strong { font-size: 0.86rem; font-weight: 700; }
  .drawer-sign-in small { margin-top: 0.15rem; color: rgba(255,255,255,0.72); font-size: 0.62rem; }
  .drawer-arrow { flex: 0 0 auto; font-size: 1rem; }
  .drawer-profile { border: 1px solid var(--color-peach); background: white; color: var(--color-navy); }
  .drawer-profile img { object-fit: cover; }
  .drawer-avatar { background: var(--color-navy); color: white; font-size: 0.75rem; font-weight: 700; }
  .drawer-profile small { margin-bottom: 0.18rem; color: var(--color-gray-text); font-size: 0.6rem; }
  .drawer-profile .drawer-arrow { color: var(--color-coral); }
  .drawer-nav { padding: 1.1rem 0; }
  .drawer-group + .drawer-group { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .drawer-group h2 { margin: 0 0 0.3rem 0.75rem; color: rgba(27,43,58,0.46); font-family: var(--font-sans); font-size: 0.6rem; font-weight: 750; letter-spacing: 0.16em; text-transform: uppercase; }
  .drawer-link { display: flex; align-items: center; justify-content: space-between; min-height: 2.65rem; padding: 0.55rem 0.75rem; border-radius: 0.75rem; color: rgba(27,43,58,0.8); font-size: 0.88rem; font-weight: 600; transition: background 140ms ease, color 140ms ease; }
  .drawer-link:hover { background: white; color: var(--color-navy); }
  .drawer-link.active { background: var(--color-blush); color: var(--color-cta); }
  .drawer-link svg { width: 0.95rem; height: 0.95rem; opacity: 0.42; }
  .drawer-link.active svg { opacity: 0.9; }
  .drawer-footer { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--color-peach); }
  .drawer-trip-cta { display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; min-height: 3rem; border-radius: 999px; background: var(--color-navy); color: white; font-size: 0.82rem; font-weight: 700; }
  .drawer-trip-cta:hover { background: var(--color-primary-dark); }
  .drawer-sign-out { width: 100%; margin-top: 0.4rem; padding: 0.7rem; color: var(--color-coral); font-size: 0.72rem; font-weight: 650; }
  @media (max-width: 639px) {
    .desktop-sign-in, .desktop-profile { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-panel, .menu-backdrop { transition-duration: 0.01ms; }
  }
</style>
