---
interface Props {
  fallback?: string;
  label?: string;
}
const { fallback = '/', label = 'Back' } = Astro.props;
---

<a
  href={fallback}
  data-back-button
  aria-label={label}
  class="fixed top-4 left-4 z-30 inline-flex items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium shadow-sm transition-colors"
  style="border: 1px solid rgba(245,221,215,0.7); background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: var(--color-navy);"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
  </svg>
  <span class="hidden sm:inline">{label}</span>
</a>

<script>
  // Pop history when possible; otherwise let the link navigate to the fallback.
  document.querySelectorAll('[data-back-button]').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (window.history.length > 1) {
        e.preventDefault();
        window.history.back();
      }
    });
  });
</script>
