---
interface Props {
  fallback?: string;
  label?: string;
}
const { fallback = '/', label = 'Back' } = Astro.props;
---

<a
  href={fallback}
  data-back-button
  aria-label={label}
  class="fixed top-4 left-4 z-30 inline-flex items-center gap-1.5 rounded-[var(--radius-pill)] border border-peach/70 bg-white/85 px-3 py-2 text-sm font-medium text-navy shadow-sm backdrop-blur-[8px] transition-colors"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
  </svg>
  <span class="hidden sm:inline">{label}</span>
</a>

<script>
  // A new tab can report history.length > 1 because of its initial blank entry.
  // A referrer proves that this document was reached from an actual page.
  document.querySelectorAll('[data-back-button]').forEach((el) => {
    el.addEventListener('click', (e) => {
      if (document.referrer && window.history.length > 1) {
        e.preventDefault();
        window.history.back();
      }
    });
  });
</script>
