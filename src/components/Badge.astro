---
interface Props {
  variant?: 'status' | 'category';
  value: string;
}

const { variant = 'status', value } = Astro.props;

const statusStyles: Record<string, string> = {
  'booking-open': 'background-color: #dcfce7; color: #166534;',
  'coming-soon': 'background-color: #e0e7ff; color: #3730a3;',
  'sold-out': 'background-color: #fee2e2; color: #991b1b;',
  'draft': 'background-color: #fef9c3; color: #713f12;',
};

const statusLabels: Record<string, string> = {
  'booking-open': 'Booking Open',
  'coming-soon': 'Coming Soon',
  'sold-out': 'Sold Out',
  'draft': 'Draft',
};

let style = '';
let label = value;

if (variant === 'status') {
  style = statusStyles[value] ?? statusStyles['draft'];
  label = statusLabels[value] ?? value;
}
---

<span
  class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide"
  style={style}
>
  {label}
</span>
