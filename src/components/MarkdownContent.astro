---
import { renderSafeMarkdown } from '../lib/safeMarkdown';

interface Props {
  content: string;
  class?: string;
  variant?: 'legal' | 'rich-text';
}

const { content, class: className, variant = 'legal' } = Astro.props;

const html = renderSafeMarkdown(content);
---

<div
  class:list={[
    variant === 'legal' && 'legal-prose',
    variant === 'legal' && 'legal-markdown',
    variant === 'rich-text' && 'rich-text',
    className,
  ]}
  set:html={html}
/>
