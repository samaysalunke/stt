---
interface Props { backLabel?: string }
const { backLabel = 'Back to site' } = Astro.props;
---
<header class="profile-topbar">
  <div class="profile-shell topbar-inner">
    <a href="/" class="brand" aria-label="Seek the Thrill home">
      <img src="/logo.jpg" alt="" />
      <span>Seek the Thrill</span>
    </a>
    <a href="/" class="back-site">← {backLabel}</a>
  </div>
</header>

<slot />

<footer class="profile-footer">
  <div class="profile-shell footer-inner">
    <span>© 2026 Seek the Thrill</span>
    <nav aria-label="Footer">
      <a href="/trips/">Explore trips</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
  </div>
</footer>

<style is:global>
  .profile-shell{width:min(100% - 2rem,70rem);margin-inline:auto}
  .profile-topbar{background:#fff;border-bottom:1px solid var(--color-peach)}
  .topbar-inner{min-height:4rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .brand{display:flex;align-items:center;gap:.65rem;font-weight:700;color:var(--color-navy)}
  .brand img{width:2rem;height:2rem;border-radius:.55rem;object-fit:cover}
  .back-site{min-height:44px;display:inline-flex;align-items:center;color:var(--color-coral);font-size:.875rem;font-weight:650}
  .profile-footer{margin-top:4rem;background:var(--color-navy);color:#fff}
  .footer-inner{min-height:5.5rem;padding-block:1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;color:rgba(255,255,255,.62);font-size:.78rem}
  .footer-inner nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.35rem 1.1rem}
  .footer-inner a{min-height:44px;display:inline-flex;align-items:center;color:#fff}
  @media(max-width:560px){.profile-shell{width:min(100% - 1.25rem,70rem)}.footer-inner{align-items:flex-start;flex-direction:column}.footer-inner nav{justify-content:flex-start}}
</style>
