---
import { tripAdvanceAmountBySlug } from '../../lib/registrationWrite';
import { formatDateIN, formatINR } from '../../lib/utils';
import {
  regStatusStyle,
  paymentStatusLabel,
  paymentStatusStyle,
  derivePaymentStatus,
  REFUND_PAYMENT_STATUSES,
  assertTransition,
} from '../../lib/registrationStatus';
import { zohoOpenUrl } from '../../lib/zohoBooks';
interface Props { registration: Record<string, any>; readOnly?: boolean }
const { registration: r, readOnly = false } = Astro.props;
const advanceAmount = tripAdvanceAmountBySlug(String(r.trip_slug || ''));
// Stored payment_status is authoritative; derive only as a legacy fallback.
const payStatus: string = r.payment_status || derivePaymentStatus(r);
const payStyle = paymentStatusStyle(payStatus);
const amountRefunded = Number(r.amount_refunded) || 0;
const isRefunded = (REFUND_PAYMENT_STATUSES as readonly string[]).includes(payStatus);
const remaining = Math.max(0, Number(r.total_amount || 0) - Number(r.amount_paid || 0));
// Status targets this row can move to. For 'confirmed' we only need the button
// enabled — the picker <select> supplies payment_status — so probe with a
// placeholder that clears the payment guard.
const statusButtons = ['lead', 'pending', 'confirmed', 'rejected', 'cancelled'];
const canTransition = (to: string) => {
  try {
    assertTransition(String(r.status), to, {
      amountPaid: Number(r.amount_paid) || 0,
      totalAmount: Number(r.total_amount) > 0 ? Number(r.total_amount) : null,
      requestedPaymentStatus: to === 'confirmed' ? 'advance_paid' : undefined,
    });
    return true;
  } catch {
    return false;
  }
};
const documents = Array.isArray(r.accounting_documents) ? r.accounting_documents : [];
const today = new Date().toISOString().slice(0, 10);
const parseTouch = (raw: unknown) => {
  try { return typeof raw === 'string' ? JSON.parse(raw) : null; } catch { return null; }
};
const firstTouch = parseTouch(r.first_touch_json);
const latestTouch = parseTouch(r.latest_touch_json);
const touchLabel = (touch: any) => touch
  ? [touch.utmSource || (touch.referrer ? (() => { try { return new URL(touch.referrer).hostname; } catch { return ''; } })() : 'direct'), touch.utmCampaign].filter(Boolean).join(' · ')
  : '—';

type Field = { label: string; value: any };
const field = (label: string, value: any): Field | null =>
  value == null || value === '' || value === '—' ? null : { label, value };

const travellerFields = [
  field('Age', r.age), field('Gender', r.gender), field('City', r.city), field('State', r.state),
  field('Instagram', r.instagram), field('Emergency name', r.emergency_name),
  field('Emergency phone', r.emergency_phone), field('Why joining', r.why_join),
  ...(r.wishlisted_at ? [
    field('Wishlisted', formatDateIN(r.wishlisted_at)),
    field('Wishlist notified', r.wishlist_notified_at ? formatDateIN(r.wishlist_notified_at) : null),
  ] : []),
].filter(Boolean) as Field[];

const tripPaymentFields = [
  field('Occupancy', r.sharing_option),
  field('Trip price', r.total_amount ? formatINR(r.total_amount) : null),
  field('Amount paid', formatINR(r.amount_paid)),
  field('Balance due', r.total_amount != null ? formatINR(Math.max(0, r.total_amount - r.amount_paid)) : null),
].filter(Boolean) as Field[];

const zohoStatusWord = (s: unknown) => ({
  queued: 'Queued', processing: 'Processing', draft: 'Draft', sent: 'Sent',
  emailed: 'Emailed', failed: 'Failed', paid: 'Paid', overdue: 'Overdue',
}[String(s || '').toLowerCase()] || (s ? String(s) : 'Pending'));

const attributionFields = [
  field('First touch', touchLabel(firstTouch)),
  field('Latest touch', touchLabel(latestTouch)),
  field('First landing page', firstTouch?.landingPage),
  field('Latest landing page', latestTouch?.landingPage),
  field('Departure ref', r.batch_id),
].filter(Boolean) as Field[];
---
<div class="reg-row" data-name={String(r.full_name ?? '').toLowerCase()} data-email={String(r.email ?? '').toLowerCase()} data-phone={String(r.phone ?? '').toLowerCase()} data-trip={String(r.trip_name ?? '').toLowerCase()} data-trip-slug={String(r.trip_slug ?? '').toLowerCase()} data-status={r.status}>
  <div class="reg-summary">
    {!readOnly && <label class="row-select" title={`Select ${r.full_name}`}><input type="checkbox" class="registration-checkbox" data-registration-id={r.id} /></label>}
    <div class="reg-primary">
      <div class="name-line"><strong>{r.full_name}</strong><span class="status-badge" data-id={r.id} style={regStatusStyle(r.status)}>{r.status}</span>{r.payment_screenshot_url && <span class="screenshot-chip">📎 Screenshot</span>}</div>
      <div class="reg-contact">#{r.id} · {r.email}</div><div class="reg-contact">{r.phone}</div>
    </div>
    <div class="reg-meta"><span class="reg-meta-label">Occupancy</span><strong>{r.sharing_option ?? '—'}</strong><span>Applied {formatDateIN(r.created_at)}</span><span>Updated {formatDateIN(r.updated_at ?? r.created_at)}</span></div>
    {r.status === 'wishlist' ? (
      <div class="reg-meta"><span class="reg-meta-label">Wishlisted</span><strong>{formatDateIN(r.wishlisted_at ?? r.created_at)}</strong><span>{r.wishlist_notified_at ? `Notified ${formatDateIN(r.wishlist_notified_at)}` : 'Not yet notified'}</span></div>
    ) : (
      <div class="reg-meta"><span class="reg-meta-label">Amount paid</span><strong>{formatINR(r.amount_paid)}{amountRefunded > 0 && <span class="refunded"> · Refunded {formatINR(amountRefunded)}</span>}</strong><span class="payment-badge" data-id={r.id} style={payStyle}>{paymentStatusLabel(payStatus)}</span></div>
    )}
    <div class="reg-actions"><button type="button" data-action="toggle-detail" data-id={r.id} aria-expanded="false" class="details-btn">View details</button></div>
  </div>
  <div id={`detail-${r.id}`} class="detail-row">
    <div class="detail-grid">
      <div>
        {travellerFields.length > 0 && <>
          <h3>Traveller</h3>
          <div class="fields">{travellerFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
        </>}
        {tripPaymentFields.length > 0 && <>
          <h3>Trip &amp; payment</h3>
          <div class="fields">{tripPaymentFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
        </>}
        {attributionFields.length > 0 && (
          <details class="attribution">
            <summary>Attribution</summary>
            <div class="fields">{attributionFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
          </details>
        )}
        {r.payment_screenshot_url && (
          <p class="screenshot"><a href={r.payment_screenshot_url} target="_blank" rel="noopener">
            <img src={r.payment_screenshot_url} alt="Payment screenshot" loading="lazy" />
          </a></p>
        )}
      </div>
      <div class="admin-actions">
        <h3>Admin actions</h3>
        {!readOnly ? <>
          <p>Update Status</p>
          <div class="status-actions">{statusButtons.map(s => {
            const action = s === 'confirmed' ? 'open-confirm' : s === 'cancelled' ? 'open-cancel' : 'update-status';
            const disabled = r.status === s || !canTransition(s);
            return <button type="button" data-action={action} data-id={r.id} data-value={s} disabled={disabled} class={r.status === s ? 'current' : ''}>{s}</button>;
          })}</div>

          {r.status !== 'confirmed' && canTransition('confirmed') && (
            <details class="confirm-entry" id={`confirm-entry-${r.id}`}>
              <summary>Confirm booking + record payment</summary>
              <div class="payment-fields">
                <label>Payment received
                  <select id={`confirm-kind-${r.id}`} required>
                    <option value="" disabled selected>Choose…</option>
                    <option value="advance_paid">Advance paid{advanceAmount ? ` — ${formatINR(Math.min(advanceAmount, Number(r.total_amount) || advanceAmount))}` : ''}</option>
                    <option value="fully_paid">Fully paid{r.total_amount ? ` — ${formatINR(remaining)}` : ''}</option>
                  </select>
                </label>
                <label>Amount (₹)<input id={`confirm-amount-${r.id}`} type="number" min="1" step="1" value={advanceAmount || ''} /></label>
                <label>Received date<input id={`confirm-date-${r.id}`} type="date" max={today} value={today} /></label>
                <label>Method<select id={`confirm-method-${r.id}`}><option value="upi">UPI</option><option value="bank_transfer" selected>Bank transfer</option><option value="cash">Cash</option><option value="card">Card</option><option value="cheque">Cheque</option><option value="other">Other</option></select></label>
                <label>Transaction reference (optional)<input id={`confirm-reference-${r.id}`} type="text" maxlength="100" /></label>
                <button type="button" data-action="confirm-booking" data-id={r.id} data-advance={advanceAmount} data-total={r.total_amount ?? 0} data-paid={r.amount_paid ?? 0}>Confirm &amp; record payment</button>
              </div>
            </details>
          )}

          {(r.status === 'pending' || r.status === 'confirmed') && (
            <details class="confirm-entry" id={`cancel-entry-${r.id}`}>
              <summary>Cancel booking</summary>
              <div class="payment-fields">
                {Number(r.amount_paid || 0) > 0 ? <>
                  <label>Refund<select id={`cancel-refundkind-${r.id}`}>
                    <option value="none">No refund</option>
                    <option value="partial">Partial refund</option>
                    <option value="full">Full refund — {formatINR(r.amount_paid)}</option>
                  </select></label>
                  <label class="refund-amount" id={`cancel-amount-wrap-${r.id}`} style="display:none">Refund amount (₹)<input id={`cancel-amount-${r.id}`} type="number" min="1" step="1" max={r.amount_paid} /></label>
                  <label class="refund-amount" id={`cancel-date-wrap-${r.id}`} style="display:none">Refund date<input id={`cancel-date-${r.id}`} type="date" max={today} value={today} /></label>
                  <label class="refund-amount" id={`cancel-method-wrap-${r.id}`} style="display:none">Method<select id={`cancel-method-${r.id}`}><option value="upi">UPI</option><option value="bank_transfer" selected>Bank transfer</option><option value="cash">Cash</option><option value="card">Card</option><option value="cheque">Cheque</option><option value="other">Other</option></select></label>
                  <label class="refund-amount" id={`cancel-ref-wrap-${r.id}`} style="display:none">Transaction reference (optional)<input id={`cancel-reference-${r.id}`} type="text" maxlength="100" /></label>
                </> : <p class="wishlist-note">Nothing has been paid — this cancellation records no refund.</p>}
                <button type="button" data-action="cancel-booking" data-id={r.id} data-paid={r.amount_paid ?? 0}>Cancel booking</button>
              </div>
            </details>
          )}

          {r.status === 'cancelled' && !isRefunded && Number(r.amount_paid || 0) > 0 && (
            <details class="confirm-entry" id={`refund-entry-${r.id}`}>
              <summary>Record refund</summary>
              <div class="payment-fields">
                <label>Refund<select id={`refund-kind-${r.id}`}>
                  <option value="partial">Partial refund</option>
                  <option value="full">Full refund — {formatINR(r.amount_paid)}</option>
                </select></label>
                <label>Refund amount (₹)<input id={`refund-amount-${r.id}`} type="number" min="1" step="1" max={r.amount_paid} value={r.amount_paid} /></label>
                <label>Refund date<input id={`refund-date-${r.id}`} type="date" max={today} value={today} /></label>
                <label>Method<select id={`refund-method-${r.id}`}><option value="upi">UPI</option><option value="bank_transfer" selected>Bank transfer</option><option value="cash">Cash</option><option value="card">Card</option><option value="cheque">Cheque</option><option value="other">Other</option></select></label>
                <label>Transaction reference (optional)<input id={`refund-reference-${r.id}`} type="text" maxlength="100" /></label>
                <button type="button" data-action="record-refund" data-id={r.id} data-paid={r.amount_paid ?? 0}>Record refund</button>
              </div>
            </details>
          )}
          {r.status === 'wishlist' && <p class="wishlist-note">Wishlist entry — payment &amp; documents appear once this converts to a booking.</p>}
          {r.status !== 'wishlist' && <>
          {r.status !== 'cancelled' && <>
          <p>Payment</p>{Number(r.amount_paid || 0) > 0 && <div class="status-actions"><button type="button" data-action="update-payment" data-id={r.id} data-value="unpaid">Reverse all (legacy)</button></div>}
          <details class="payment-entry">
            <summary>Record a payment</summary>
            <div class="payment-fields">
              <label>Payment type<select id={`payment-kind-${r.id}`}><option value="full">Full / remaining balance</option><option value="advance">Advance</option><option value="custom">Custom amount</option></select></label>
              <label>Amount (₹)<input id={`payment-amount-${r.id}`} type="number" min="1" step="1" value={Math.max(0, Number(r.total_amount || 0) - Number(r.amount_paid || 0)) || ''} /></label>
              <label>Received date<input id={`payment-date-${r.id}`} type="date" max={today} value={today} /></label>
              <label>Method<select id={`payment-method-${r.id}`}><option value="upi">UPI</option><option value="bank_transfer">Bank transfer</option><option value="cash">Cash</option><option value="card">Card</option><option value="cheque">Cheque</option><option value="other">Other</option></select></label>
              <label>Transaction reference (optional)<input id={`payment-reference-${r.id}`} type="text" maxlength="100" /></label>
              <button type="button" data-action="record-payment" data-id={r.id} data-advance={advanceAmount} data-total={r.total_amount ?? 0} data-paid={r.amount_paid ?? 0}>Save payment</button>
            </div>
          </details>
          </>}
          <p>Accounting documents</p>
          <div class="documents">
            {documents.map((document: any) => (
              <div class="document-row">
                <div><strong>{document.document_type === 'advance' ? 'Advance' : 'Final invoice'}</strong><span>{document.zoho_document_number || 'Not issued yet'} · {zohoStatusWord(document.zoho_status || document.status)}</span></div>
                <div class="document-actions">
                  {zohoOpenUrl(document) && <a href={zohoOpenUrl(document)!} target="_blank" rel="noopener">Open in Zoho</a>}
                  {document.zoho_document_id && <button type="button" data-action="refresh-document" data-id={r.id} data-value={document.document_type}>Refresh</button>}
                  {['failed', 'queued', 'draft', 'processing'].includes(document.status) && <button type="button" data-action="retry-document" data-id={r.id} data-value={document.document_type}>Retry</button>}
                </div>
                {document.sent_at && <small>Sent {formatDateIN(document.sent_at)}</small>}
                {document.last_error && /state|billing name/i.test(String(document.last_error)) ? (
                  <div class="state-fix">
                    <small class="document-error">Add the traveller's state, then Retry.</small>
                    <div class="state-fix-row">
                      <input id={`state-fix-${r.id}`} type="text" maxlength="60" placeholder="State" value={r.state ?? ''} />
                      <button type="button" data-action="patch-state" data-id={r.id} data-value={document.document_type}>Save state</button>
                    </div>
                  </div>
                ) : document.last_error && <small class="document-error">{document.last_error}</small>}
              </div>
            ))}
            {!documents.length && <div class="document-empty"><span>No documents generated.</span>{r.status === 'confirmed' && <button type="button" data-action="generate-document" data-id={r.id} data-value={payStatus === 'fully_paid' ? 'final' : 'advance'}>Generate document</button>}</div>}
          </div>
          </>}
          <p>Admin Notes</p><textarea id={`notes-${r.id}`} rows={3} placeholder="Add internal notes…">{r.admin_notes ?? ''}</textarea>
          <button type="button" class="save-notes" data-action="save-notes" data-id={r.id}>Save Notes</button><p id={`msg-${r.id}`} class="saved">Saved!</p>
        </> : <p class="read-only-note">Trip leads have read-only access.</p>}
      </div>
    </div>
  </div>
</div>

<style>
  .reg-row{background:#fff;border:1px solid var(--color-border);border-radius:.75rem;padding:.9rem 1rem}.reg-summary{display:grid;grid-template-columns:auto minmax(220px,1.6fr) minmax(150px,1fr) minmax(130px,.8fr) auto;gap:1.25rem;align-items:center}.name-line{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.name-line strong{color:var(--color-navy)}.status-badge,.payment-badge{display:inline-block;padding:.2rem .6rem;border-radius:9999px;font-size:.72rem;font-weight:700}.status-badge{text-transform:capitalize}.screenshot-chip{display:inline-block;padding:.2rem .5rem;border-radius:9999px;font-size:.68rem;font-weight:700;background:var(--color-gray-soft);color:var(--color-text-secondary)}.reg-contact{overflow:hidden;margin-top:.15rem;color:var(--color-text-secondary);font-size:.78rem;text-overflow:ellipsis;white-space:nowrap}.reg-meta{display:flex;min-width:0;flex-direction:column;gap:.15rem;color:var(--color-text-secondary);font-size:.76rem}.reg-meta strong{color:var(--color-navy);font-size:.86rem}.reg-meta-label{font-size:.65rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.row-select{display:inline-flex;align-items:center;justify-content:center}.row-select input{width:1rem;height:1rem;accent-color:var(--color-coral)}.details-btn{border:1px solid var(--color-coral);border-radius:999px;background:#fff;color:var(--color-coral);cursor:pointer;font-weight:700;padding:.4rem .8rem;white-space:nowrap}.detail-row{display:none;margin-top:.9rem;padding-top:.9rem;border-top:1px solid var(--color-border)}.detail-grid{display:grid;grid-template-columns:1fr 340px;gap:1.5rem}.detail-grid h3{margin:0 0 .75rem;font-size:.8rem;text-transform:uppercase}.fields{display:grid;grid-template-columns:1fr 1fr;gap:.4rem 1rem;font-size:.82rem;margin-bottom:.6rem}.fields span,.admin-actions p{color:var(--color-text-secondary);font-weight:600}.detail-grid h3{margin-top:.4rem}.detail-grid h3:first-child{margin-top:0}.attribution{margin:.2rem 0 .6rem}.attribution summary{cursor:pointer;font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--color-text-secondary)}.attribution .fields{margin-top:.5rem}.screenshot{margin:.4rem 0 0}.screenshot img{max-height:120px;border-radius:8px;display:block}.admin-actions{background:var(--color-gray-soft);border:1px solid var(--color-border);border-radius:.75rem;padding:1.25rem}.admin-actions p{font-size:.8rem;margin:.6rem 0 .4rem}.status-actions{display:flex;gap:.35rem;flex-wrap:wrap}.status-actions button{padding:.35rem .55rem;border:1px solid var(--color-border);border-radius:.4rem;background:#fff;text-transform:capitalize}.status-actions button:disabled{opacity:.4;cursor:not-allowed}.status-actions .current{border-color:var(--color-coral);color:var(--color-coral)}.refunded{color:var(--color-text-secondary);font-weight:600}textarea{width:100%;box-sizing:border-box;padding:.5rem;border:1px solid var(--color-border);border-radius:.5rem}.save-notes{margin-top:.5rem;width:100%;padding:.5rem;background:var(--color-primary);color:#fff;border:0;border-radius:.5rem;font-weight:700}.saved{display:none!important;color:var(--color-success)!important;text-align:center}.read-only-note{font-weight:400!important}.wishlist-note{font-weight:400!important;font-size:.75rem;font-style:italic}.reg-actions{justify-self:end}.payment-entry,.confirm-entry{margin-top:.55rem}.payment-entry summary,.confirm-entry summary{cursor:pointer;color:var(--color-coral);font-size:.8rem;font-weight:700}.confirm-entry input[readonly]{background:var(--color-gray-soft);color:var(--color-text-secondary)}.payment-fields{display:grid;gap:.5rem;margin-top:.6rem}.payment-fields label{display:grid;gap:.2rem;color:var(--color-text-secondary);font-size:.72rem;font-weight:700}.payment-fields input,.payment-fields select{box-sizing:border-box;width:100%;padding:.45rem;border:1px solid var(--color-border);border-radius:.4rem;background:#fff}.payment-fields button,.document-actions button,.document-empty button{padding:.4rem .6rem;border:0;border-radius:.4rem;background:var(--color-primary);color:#fff;font-weight:700}.documents{display:grid;gap:.5rem}.document-row{display:grid;gap:.25rem;padding:.55rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff}.document-row>div:first-child{display:flex;justify-content:space-between;gap:.5rem}.document-row span,.document-row small,.document-empty{font-size:.7rem;color:var(--color-text-secondary)}.document-actions{display:flex;gap:.4rem}.document-actions a{font-size:.72rem;font-weight:700;color:var(--color-coral)}.document-error{color:var(--color-danger)!important}.state-fix{display:grid;gap:.35rem}.state-fix-row{display:flex;gap:.4rem}.state-fix-row input{flex:1;min-width:0;padding:.35rem;border:1px solid var(--color-border);border-radius:.4rem}.document-empty{display:flex;align-items:center;justify-content:space-between;gap:.5rem}@media(max-width:900px){.reg-summary{grid-template-columns:auto 1fr 1fr}.reg-primary{grid-column:2/-1}.reg-actions{grid-column:2/-1;justify-self:start}.detail-grid{grid-template-columns:1fr}}@media(max-width:600px){.reg-summary{grid-template-columns:auto 1fr}.reg-meta{grid-column:2}.fields{grid-template-columns:1fr}}
</style>
