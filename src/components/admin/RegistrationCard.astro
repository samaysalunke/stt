---
import { formatDateIN, formatINR } from '../../lib/utils';
import {
  regStatusStyle,
  paymentStatusLabel,
  paymentStatusStyle,
  derivePaymentStatus,
  paymentOptionsFor,
  assertTransition,
  ADMIN_SETTABLE_STATUSES,
} from '../../lib/registrationStatus';
import { zohoOpenUrl } from '../../lib/zohoBooks';
interface Props {
  registration: Record<string, any>;
  readOnly?: boolean;
  tierOptions?: Array<{ tierId: string; label: string; price: number; cap: number | null; booked: number }>;
}
const { registration: r, readOnly = false, tierOptions = [] } = Astro.props;
// Stored payment_status is authoritative; derive only as a legacy fallback.
const payStatus: string = r.payment_status || derivePaymentStatus(r);
const payStyle = paymentStatusStyle(payStatus);
const amountRefunded = Number(r.amount_refunded) || 0;
// Payment states offered for the row as it stands. The client swaps this list
// when the Status select changes, reading the same map.
const paymentChoices = paymentOptionsFor(String(r.status), payStatus);
// Status targets this row can move to. For 'confirmed' we only need the option
// enabled — the payment <select> supplies payment_status — so probe with a
// placeholder that clears the payment guard. A row still sitting on a retired
// status (wishlist, legacy rejected) keeps it listed so the select shows where
// the row actually is.
const statusButtons = [
  ...(ADMIN_SETTABLE_STATUSES as readonly string[]).includes(String(r.status)) ? [] : [String(r.status)],
  ...ADMIN_SETTABLE_STATUSES,
];
const canTransition = (to: string) => {
  try {
    assertTransition(String(r.status), to, {
      amountPaid: Number(r.amount_paid) || 0,
      totalAmount: Number(r.total_amount) > 0 ? Number(r.total_amount) : null,
      requestedPaymentStatus: to === 'confirmed' ? 'advance_paid' : undefined,
    });
    return true;
  } catch {
    return false;
  }
};
const documents = Array.isArray(r.accounting_documents) ? r.accounting_documents : [];
const statusOptions = statusButtons.map((s) => ({
  value: s,
  label: s.charAt(0).toUpperCase() + s.slice(1),
  disabled: s !== r.status && !canTransition(s),
}));
const showDocsTab = r.status !== 'wishlist' && (documents.length > 0 || r.status === 'confirmed');
// Occupancy can only be switched on a multi-tier departure the row is linked to.
// Single-tier trips and the legacy bucket get no tab.
const showOccupancyTab = !readOnly && tierOptions.length > 1 && !!r.batch_id;
const parseTouch = (raw: unknown) => {
  try { return typeof raw === 'string' ? JSON.parse(raw) : null; } catch { return null; }
};
const firstTouch = parseTouch(r.first_touch_json);
const latestTouch = parseTouch(r.latest_touch_json);
const touchLabel = (touch: any) => touch
  ? [touch.utmSource || (touch.referrer ? (() => { try { return new URL(touch.referrer).hostname; } catch { return ''; } })() : 'direct'), touch.utmCampaign].filter(Boolean).join(' · ')
  : '—';

type Field = { label: string; value: any };
const field = (label: string, value: any): Field | null =>
  value == null || value === '' || value === '—' ? null : { label, value };

const travellerFields = [
  field('Age', r.age), field('Gender', r.gender), field('City', r.city), field('State', r.state),
  field('Instagram', r.instagram), field('Emergency name', r.emergency_name),
  field('Emergency phone', r.emergency_phone), field('Why joining', r.why_join),
  ...(r.wishlisted_at ? [
    field('Wishlisted', formatDateIN(r.wishlisted_at)),
    field('Wishlist notified', r.wishlist_notified_at ? formatDateIN(r.wishlist_notified_at) : null),
  ] : []),
].filter(Boolean) as Field[];
const demographicSummary = [field('Age', r.age), field('Gender', r.gender)]
  .filter(Boolean)
  .map((f) => f!.label === 'Age' ? `Age ${f!.value}` : String(f!.value))
  .join(' · ');

const tripPaymentFields = [
  field('Trip price', r.total_amount ? formatINR(r.total_amount) : null),
  field('Amount paid', formatINR(r.amount_paid)),
  field('Balance due', r.total_amount != null ? formatINR(Math.max(0, r.total_amount - r.amount_paid)) : null),
].filter(Boolean) as Field[];

const zohoStatusWord = (s: unknown) => ({
  queued: 'Queued', processing: 'Processing', draft: 'Draft', sent: 'Sent',
  emailed: 'Emailed', failed: 'Failed', paid: 'Paid', overdue: 'Overdue',
}[String(s || '').toLowerCase()] || (s ? String(s) : 'Pending'));

// One state string per document — never the contradictory "Not issued yet · Failed".
const docStateLabel = (d: any) => {
  if (d.zoho_document_number) return `${d.zoho_document_number} · ${zohoStatusWord(d.zoho_status || d.status)}`;
  const st = String(d.status || '').toLowerCase();
  if (['failed', 'queued', 'draft', 'processing'].includes(st)) return zohoStatusWord(st);
  return 'Not issued yet';
};

const attributionFields = [
  field('First touch', touchLabel(firstTouch)),
  field('Latest touch', touchLabel(latestTouch)),
  field('First landing page', firstTouch?.landingPage),
  field('Latest landing page', latestTouch?.landingPage),
  field('Departure ref', r.batch_id),
].filter(Boolean) as Field[];
---
<div class="reg-row" data-name={String(r.full_name ?? '').toLowerCase()} data-email={String(r.email ?? '').toLowerCase()} data-phone={String(r.phone ?? '').toLowerCase()} data-trip={String(r.trip_name ?? '').toLowerCase()} data-trip-slug={String(r.trip_slug ?? '').toLowerCase()} data-status={r.status}>
  <div class="reg-summary">
    {!readOnly && <label class="row-select" title={`Select ${r.full_name}`}><input type="checkbox" class="registration-checkbox" data-registration-id={r.id} data-status={r.status} data-payment-status={payStatus} data-paid={Number(r.amount_paid) || 0} /></label>}
    <div class="reg-primary">
      <div class="name-line"><strong>{r.full_name}</strong><span class="status-badge" data-id={r.id} style={regStatusStyle(r.status)}>{r.status}</span>{r.payment_screenshot_url && <span class="screenshot-chip">📎 Screenshot</span>}</div>
      <div class="reg-contact">#{r.id} · {r.email}</div><div class="reg-contact">{r.phone}</div>
      {demographicSummary && <div class="reg-contact">{demographicSummary}</div>}
      <div class="reg-contact reg-dates">Applied {formatDateIN(r.created_at)} · Updated {formatDateIN(r.updated_at ?? r.created_at)}</div>
    </div>
    <div class="reg-meta"><span class="reg-meta-label">Occupancy</span><strong>{r.sharing_option ?? '—'}</strong></div>
    {r.status === 'wishlist' ? (
      <div class="reg-meta"><span class="reg-meta-label">Wishlisted</span><strong>{formatDateIN(r.wishlisted_at ?? r.created_at)}</strong><span>{r.wishlist_notified_at ? `Notified ${formatDateIN(r.wishlist_notified_at)}` : 'Not yet notified'}</span></div>
    ) : (
      <div class="reg-meta"><span class="reg-meta-label">Amount paid</span><strong class="payment-amount" data-id={r.id}>{formatINR(r.amount_paid)}{amountRefunded > 0 && <span class="refunded"> · Refunded {formatINR(amountRefunded)}</span>}</strong><span class="payment-badge" data-id={r.id} style={payStyle}>{paymentStatusLabel(payStatus)}</span></div>
    )}
    <div class="reg-actions"><button type="button" data-action="toggle-detail" data-id={r.id} aria-expanded="false" class="details-btn">View details</button></div>
  </div>
  <div id={`detail-${r.id}`} class="detail-row">
    {readOnly ? (
      <div class="detail-grid">
        <div>
          {travellerFields.length > 0 && <>
            <h3>Traveller</h3>
            <div class="fields">{travellerFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
          </>}
          {tripPaymentFields.length > 0 && <>
            <h3>Trip &amp; payment</h3>
            <div class="fields">{tripPaymentFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
          </>}
          {attributionFields.length > 0 && (
            <details class="attribution">
              <summary>Attribution</summary>
              <div class="fields">{attributionFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
            </details>
          )}
          {r.payment_screenshot_url && (
            <p class="screenshot"><a href={r.payment_screenshot_url} target="_blank" rel="noopener">
              <img src={r.payment_screenshot_url} alt="Payment screenshot" loading="lazy" />
            </a></p>
          )}
        </div>
        <div class="admin-actions"><h3>Admin actions</h3><p class="read-only-note">Trip leads have read-only access.</p></div>
      </div>
    ) : (
    <>
      <div class="tabs-bar">
        <button type="button" class="tab-btn active" data-id={r.id} data-tab="overview">Overview</button>
        <button type="button" class="tab-btn" data-id={r.id} data-tab="status">Status &amp; payment</button>
        {showDocsTab && <button type="button" class="tab-btn" data-id={r.id} data-tab="documents">Documents</button>}
        {showOccupancyTab && <button type="button" class="tab-btn" data-id={r.id} data-tab="occupancy">Occupancy</button>}
        <button type="button" class="tab-btn" data-id={r.id} data-tab="notes">Notes</button>
      </div>

      <div class="tab-panel" data-id={r.id} data-tab="overview">
        {travellerFields.length > 0 && <>
          <h3>Traveller</h3>
          <div class="fields">{travellerFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
        </>}
        {tripPaymentFields.length > 0 && <>
          <h3>Trip &amp; payment</h3>
          <div class="fields">{tripPaymentFields.map((f) => <div data-payment-field={f.label}><span>{f.label}:</span> {f.value}</div>)}</div>
        </>}
        {attributionFields.length > 0 && (
          <details class="attribution">
            <summary>Attribution</summary>
            <div class="fields">{attributionFields.map((f) => <div><span>{f.label}:</span> {f.value}</div>)}</div>
          </details>
        )}
        {r.payment_screenshot_url && (
          <p class="screenshot"><a href={r.payment_screenshot_url} target="_blank" rel="noopener">
            <img src={r.payment_screenshot_url} alt="Payment screenshot" loading="lazy" />
          </a></p>
        )}
      </div>

      <div class="tab-panel" data-id={r.id} data-tab="status" hidden>
        <div
          class="sp-wrap"
          data-sp
          data-id={r.id}
          data-current-status={r.status}
          data-current-payment={payStatus}
          data-paid={Number(r.amount_paid) || 0}
          data-total={Number(r.total_amount) || 0}
        >
          <div class="sp-hero">
            <span class="sp-hero-label">Current status</span>
            <span class="sp-hero-status" style={regStatusStyle(r.status)}>{r.status}</span>
            {r.status !== 'wishlist' && (
              <span class="sp-hero-pay" data-payment-hero={r.id}>
                {paymentStatusLabel(payStatus)} · {formatINR(r.amount_paid)}{Number(r.total_amount) > 0 ? ` of ${formatINR(r.total_amount)}` : ''}{amountRefunded > 0 ? ` · refunded ${formatINR(amountRefunded)}` : ''}
              </span>
            )}
          </div>

          <div class="sp-controls">
            <label class="sp-field">
              <span>Status</span>
              <select id={`sp-status-${r.id}`}>
                {statusOptions.map((o) => (
                  <option value={o.value} selected={o.value === r.status} disabled={o.disabled}>{o.label}</option>
                ))}
              </select>
            </label>

            {/* Options come from PAYMENT_OPTIONS keyed on the row's status; the
                client rebuilds them from the same map when Status changes, so
                this select and the bulk bar can never offer different words. */}
            <label class="sp-field" id={`sp-payment-wrap-${r.id}`} hidden={paymentChoices.length === 0}>
              <span>Payment</span>
              <select id={`sp-payment-${r.id}`}>
                {paymentChoices.map((p) => (
                  <option value={p} selected={p === payStatus}>{paymentStatusLabel(p)}</option>
                ))}
              </select>
            </label>

            <label class="sp-field" id={`sp-amount-wrap-${r.id}`} hidden>
              <span id={`sp-amount-label-${r.id}`}>Amount (₹)</span>
              <input id={`sp-amount-${r.id}`} type="number" min="1" step="1" placeholder="Trip default" />
            </label>
          </div>

          {r.status === 'wishlist' && <p class="wishlist-note">Wishlist entry — record payment after moving it to Confirmed.</p>}

          <button type="button" class="sp-save" data-action="save-status-payment" data-id={r.id} disabled>Update</button>
        </div>
      </div>

      {showDocsTab && (
        <div class="tab-panel" data-id={r.id} data-tab="documents" hidden>
          <div class="documents">
            {documents.map((document: any) => (
              <div class="document-row">
                <div><strong>{document.document_type === 'advance' ? 'Advance' : 'Final invoice'}</strong><span>{docStateLabel(document)}</span></div>
                <div class="document-actions">
                  {zohoOpenUrl(document) && <a href={zohoOpenUrl(document)!} target="_blank" rel="noopener">Open in Zoho</a>}
                  {document.zoho_document_id && <button type="button" data-action="refresh-document" data-id={r.id} data-value={document.document_type}>Refresh</button>}
                  {['failed', 'queued', 'draft', 'processing'].includes(document.status) && <button type="button" data-action="retry-document" data-id={r.id} data-value={document.document_type}>Retry</button>}
                </div>
                {document.sent_at && <small>Sent {formatDateIN(document.sent_at)}</small>}
                {document.last_error && /state|billing name/i.test(String(document.last_error)) ? (
                  <div class="state-fix">
                    <small class="document-error">Add the traveller's state, then Retry.</small>
                    <div class="state-fix-row">
                      <input id={`state-fix-${r.id}`} type="text" maxlength="60" placeholder="State" value={r.state ?? ''} />
                      <button type="button" data-action="patch-state" data-id={r.id} data-value={document.document_type}>Save state</button>
                    </div>
                  </div>
                ) : document.last_error && <small class="document-error">{document.last_error}</small>}
              </div>
            ))}
            {!documents.length && (
              <div class="document-empty">
                <span>No invoice generated.</span>
                {r.status === 'confirmed' && payStatus === 'fully_paid'
                  ? <button type="button" data-action="generate-document" data-id={r.id} data-value="final">Generate invoice</button>
                  : r.status === 'confirmed' && <span>The invoice is generated once the booking is fully paid.</span>}
              </div>
            )}
          </div>
        </div>
      )}

      {showOccupancyTab && (
        <div class="tab-panel" data-id={r.id} data-tab="occupancy" hidden>
          <div class="sp-wrap">
            <div class="sp-hero">
              <span class="sp-hero-label">Current occupancy</span>
              <span class="sp-hero-pay">{r.sharing_option ?? '—'} · {formatINR(r.total_amount)}</span>
            </div>
            <label class="sp-field">
              <span>Occupancy</span>
              <select id={`occ-tier-${r.id}`}>
                {tierOptions.map((t) => (
                  <option value={t.tierId} selected={t.tierId === r.tier_id}>
                    {t.label} — {formatINR(t.price)}{t.cap != null && t.booked >= t.cap ? ' · full' : ''}
                  </option>
                ))}
              </select>
            </label>
            <p class="wishlist-note">Changes the price to match the new tier. No email is sent to the traveller.</p>
            <button
              type="button"
              class="sp-save"
              data-action="save-occupancy"
              data-id={r.id}
              data-current-tier={r.tier_id ?? ''}
              data-paid={Number(r.amount_paid) || 0}
              data-has-doc={documents.length > 0 ? '1' : ''}
            >Change occupancy</button>
          </div>
        </div>
      )}

      <div class="tab-panel" data-id={r.id} data-tab="notes" hidden>
        <textarea id={`notes-${r.id}`} rows={3} placeholder="Add internal notes…">{r.admin_notes ?? ''}</textarea>
        <button type="button" class="save-notes" data-action="save-notes" data-id={r.id}>Save Notes</button><p id={`msg-${r.id}`} class="saved">Saved!</p>
      </div>
    </>
    )}
  </div>
</div>

<style>
  .reg-row{background:#fff;border:1px solid var(--color-border);border-radius:.75rem;padding:.9rem 1rem}.reg-summary{display:grid;grid-template-columns:auto minmax(220px,1.6fr) minmax(150px,1fr) minmax(130px,.8fr) auto;gap:1.25rem;align-items:center}.name-line{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.name-line strong{color:var(--color-navy)}.status-badge,.payment-badge{display:inline-block;padding:.2rem .6rem;border-radius:9999px;font-size:.72rem;font-weight:700}.status-badge{text-transform:capitalize}.screenshot-chip{display:inline-block;padding:.2rem .5rem;border-radius:9999px;font-size:.68rem;font-weight:700;background:var(--color-gray-soft);color:var(--color-gray-text)}.reg-contact{overflow:hidden;margin-top:.15rem;color:var(--color-gray-text);font-size:.78rem;text-overflow:ellipsis;white-space:nowrap}.reg-meta{display:flex;min-width:0;flex-direction:column;gap:.15rem;color:var(--color-gray-text);font-size:.76rem}.reg-meta strong{color:var(--color-navy);font-size:.86rem}.reg-meta-label{font-size:.65rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.row-select{display:inline-flex;align-items:center;justify-content:center}.row-select input{width:1rem;height:1rem;accent-color:var(--color-coral)}.details-btn{border:0;background:none;color:var(--color-coral);cursor:pointer;font-weight:700;padding:.3rem 0;white-space:nowrap}.details-btn::after{content:" ▾"}.reg-row.open .details-btn::after{content:" ▴"}.detail-row{display:none;margin-top:.9rem;padding-top:.9rem;border-top:1px solid var(--color-border)}.detail-grid{display:grid;grid-template-columns:1fr 340px;gap:1.5rem}.detail-grid h3,.tab-panel h3{margin:0 0 .75rem;font-size:.8rem;text-transform:uppercase}.fields{display:grid;grid-template-columns:1fr 1fr;gap:.4rem 1rem;font-size:.82rem;margin-bottom:.6rem}.fields span,.admin-actions p{color:var(--color-gray-text);font-weight:600}.detail-grid h3,.tab-panel h3{margin-top:.4rem}.detail-grid h3:first-child,.tab-panel h3:first-child{margin-top:0}.tabs-bar{display:flex;gap:.25rem;flex-wrap:wrap;border-bottom:1px solid var(--color-border);margin-bottom:1rem}.tab-btn{padding:.45rem .8rem;border:0;background:none;font-weight:700;font-size:.8rem;color:var(--color-gray-text);border-bottom:2px solid transparent;cursor:pointer;text-transform:capitalize}.tab-btn.active{color:var(--color-navy);border-bottom-color:var(--color-coral)}.tab-panel{display:block}.tab-panel[hidden]{display:none}.sp-wrap{display:flex;flex-direction:column;gap:1rem;max-width:460px}.sp-hero{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}.sp-hero-label{width:100%;font-size:.65rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--color-gray-text)}.sp-hero-status{font:800 1.4rem/1 var(--font-display);padding:.55rem 1rem;border-radius:.6rem;text-transform:capitalize}.sp-hero-pay{font-size:.8rem;font-weight:600;color:var(--color-gray-text)}.sp-controls{display:flex;gap:.75rem;flex-wrap:wrap}.sp-field{display:grid;gap:.25rem;flex:1;min-width:150px}.sp-field>span{font-size:.65rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--color-gray-text)}.sp-field[hidden]{display:none}.sp-field select,.sp-field input{width:100%;box-sizing:border-box;padding:.5rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff;color:var(--color-navy);font-size:.875rem}.sp-save{align-self:flex-start;padding:.55rem 1.4rem;border:0;border-radius:.5rem;background:var(--color-navy);color:#fff;font-weight:700;font-size:.85rem;cursor:pointer}.sp-save:disabled{opacity:.4;cursor:not-allowed}.attribution{margin:.2rem 0 .6rem}.attribution summary{cursor:pointer;font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--color-gray-text)}.attribution .fields{margin-top:.5rem}.screenshot{margin:.4rem 0 0}.screenshot img{max-height:120px;border-radius:8px;display:block}.admin-actions{background:var(--color-gray-soft);border:1px solid var(--color-border);border-radius:.75rem;padding:1.25rem}.admin-actions p{font-size:.8rem;margin:.6rem 0 .4rem}.refunded{color:var(--color-gray-text);font-weight:600}textarea{width:100%;box-sizing:border-box;padding:.5rem;border:1px solid var(--color-border);border-radius:.5rem}.save-notes{margin-top:.5rem;width:100%;padding:.5rem;background:var(--color-navy);color:#fff;border:0;border-radius:.5rem;font-weight:700}.saved{display:none!important;color:var(--color-success)!important;text-align:center}.read-only-note{font-weight:400!important}.wishlist-note{font-weight:400!important;font-size:.75rem;font-style:italic}.reg-actions{justify-self:end}.document-actions button,.document-empty button{padding:.4rem .6rem;border:0;border-radius:.4rem;background:var(--color-navy);color:#fff;font-weight:700}.documents{display:grid;gap:.5rem}.document-row{display:grid;gap:.25rem;padding:.55rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff}.document-row>div:first-child{display:flex;justify-content:space-between;gap:.5rem}.document-row span,.document-row small,.document-empty{font-size:.7rem;color:var(--color-gray-text)}.document-actions{display:flex;gap:.4rem}.document-actions a{font-size:.72rem;font-weight:700;color:var(--color-coral)}.document-error{color:var(--color-danger)!important}.state-fix{display:grid;gap:.35rem;margin-top:.4rem;padding:.5rem;border:1px solid var(--color-border);border-radius:.4rem;background:var(--color-gray-soft)}.state-fix-row{display:flex;gap:.4rem}.state-fix-row input{flex:1;min-width:0;padding:.35rem;border:1px solid var(--color-border);border-radius:.4rem}.document-empty{display:flex;align-items:center;justify-content:space-between;gap:.5rem}@media(max-width:900px){.reg-summary{grid-template-columns:auto 1fr 1fr}.reg-primary{grid-column:2/-1}.reg-actions{grid-column:2/-1;justify-self:start}.detail-grid{grid-template-columns:1fr}}@media(max-width:600px){.reg-summary{grid-template-columns:auto 1fr}.reg-meta{grid-column:2}.fields{grid-template-columns:1fr}}
</style>
