---
import { tripAdvanceAmountBySlug } from '../../lib/registrationWrite';
import { paymentState, paymentStateLabel } from '../../lib/payment';
import { formatDateIN, formatINR, regStatusStyle } from '../../lib/utils';
import { zohoOpenUrl } from '../../lib/zohoBooks';
interface Props { registration: Record<string, any>; readOnly?: boolean }
const { registration: r, readOnly = false } = Astro.props;
const payState = paymentState(r.amount_paid, r.total_amount, tripAdvanceAmountBySlug(String(r.trip_slug || '')));
const payStyle = payState === 'full' ? 'background:#D1FAE5;color:#065F46;' : payState === 'unpaid' ? 'background:#FEE2E2;color:#991B1B;' : 'background:#DBEAFE;color:#1E40AF;';
const documents = Array.isArray(r.accounting_documents) ? r.accounting_documents : [];
const today = new Date().toISOString().slice(0, 10);
---
<div class="reg-row" data-name={String(r.full_name ?? '').toLowerCase()} data-email={String(r.email ?? '').toLowerCase()} data-phone={String(r.phone ?? '').toLowerCase()} data-trip={String(r.trip_name ?? '').toLowerCase()} data-trip-slug={String(r.trip_slug ?? '').toLowerCase()} data-status={r.status}>
  <div class="reg-summary">
    {!readOnly && <label class="row-select" title={`Select ${r.full_name}`}><input type="checkbox" class="registration-checkbox" data-registration-id={r.id} /></label>}
    <div class="reg-primary">
      <div class="name-line"><strong>{r.full_name}</strong><span class="status-badge" data-id={r.id} style={regStatusStyle(r.status)}>{r.status}</span></div>
      <div class="reg-contact">#{r.id} · {r.email}</div><div class="reg-contact">{r.phone}</div>
    </div>
    <div class="reg-meta"><span class="reg-meta-label">Occupancy</span><strong>{r.sharing_option ?? '—'}</strong><span>Applied {formatDateIN(r.created_at)}</span><span>Updated {formatDateIN(r.updated_at ?? r.created_at)}</span></div>
    {r.status === 'wishlist' ? (
      <div class="reg-meta"><span class="reg-meta-label">Wishlisted</span><strong>{formatDateIN(r.wishlisted_at ?? r.created_at)}</strong><span>{r.wishlist_notified_at ? `Notified ${formatDateIN(r.wishlist_notified_at)}` : 'Not yet notified'}</span></div>
    ) : (
      <div class="reg-meta"><span class="reg-meta-label">Amount paid</span><strong>{formatINR(r.amount_paid)}</strong><span class="payment-badge" data-id={r.id} style={payStyle}>{paymentStateLabel(payState)}</span></div>
    )}
    <div class="reg-actions"><button type="button" data-action="toggle-detail" data-id={r.id} aria-expanded="false" class="details-btn">View details</button></div>
  </div>
  <div id={`detail-${r.id}`} class="detail-row">
    <div class="detail-grid">
      <div>
        <h3>Registration details</h3>
        <div class="fields">
          {[
            ['Full Name', r.full_name], ['Email', r.email], ['Phone', r.phone], ['Age', r.age ?? '—'], ['Gender', r.gender ?? '—'], ['City', r.city ?? '—'],
            ['Instagram', r.instagram ?? '—'], ['Emergency Name', r.emergency_name ?? '—'], ['Emergency Phone', r.emergency_phone ?? '—'],
            ['Why Joining', r.why_join ?? '—'], ['Trip Name', r.trip_name], ['Trip Date', r.trip_date ?? '—'], ['Occupancy', r.sharing_option ?? '—'],
            ['Applied', formatDateIN(r.created_at)], ['Updated', formatDateIN(r.updated_at ?? r.created_at)],
            ['Total (selected)', r.total_amount ? formatINR(r.total_amount) : '—'], ['Amount Paid', formatINR(r.amount_paid)], ['Batch ID', r.batch_id ?? '—'],
            ...(r.status === 'wishlist' || r.wishlisted_at ? [['Wishlisted', formatDateIN(r.wishlisted_at ?? r.created_at)], ['Wishlist notified', r.wishlist_notified_at ? formatDateIN(r.wishlist_notified_at) : '—']] : []),
          ].map(([label, value]) => <div><span>{label}:</span> {value}</div>)}
        </div>
        {r.payment_screenshot_url && <p><a href={r.payment_screenshot_url} target="_blank">View Payment Screenshot →</a></p>}
      </div>
      <div class="admin-actions">
        <h3>Admin actions</h3>
        {!readOnly ? <>
          <p>Update Status</p>
          <div class="status-actions">{['lead', 'pending', 'confirmed', 'rejected'].map(s => <button type="button" data-action="update-status" data-id={r.id} data-value={s} class={r.status === s ? 'current' : ''}>{s}</button>)}</div>
          {r.status === 'wishlist' && <p class="wishlist-note">Wishlist entry — payment &amp; documents appear once this converts to a booking.</p>}
          {r.status !== 'wishlist' && <>
          <p>Payment</p>{Number(r.amount_paid || 0) > 0 && <div class="status-actions"><button type="button" data-action="update-payment" data-id={r.id} data-value="unpaid">Reverse all (legacy)</button></div>}
          <details class="payment-entry">
            <summary>Record a payment</summary>
            <div class="payment-fields">
              <label>Amount (₹)<input id={`payment-amount-${r.id}`} type="number" min="1" step="1" value={Math.max(0, Number(r.total_amount || 0) - Number(r.amount_paid || 0)) || ''} /></label>
              <label>Received date<input id={`payment-date-${r.id}`} type="date" max={today} value={today} /></label>
              <label>Method<select id={`payment-method-${r.id}`}><option value="upi">UPI</option><option value="bank_transfer">Bank transfer</option><option value="cash">Cash</option><option value="card">Card</option><option value="cheque">Cheque</option><option value="other">Other</option></select></label>
              <label>Transaction reference (optional)<input id={`payment-reference-${r.id}`} type="text" maxlength="100" /></label>
              <button type="button" data-action="record-payment" data-id={r.id}>Save payment</button>
            </div>
          </details>
          <p>Accounting documents</p>
          <div class="documents">
            {documents.map((document: any) => (
              <div class="document-row">
                <div><strong>{document.document_type === 'advance' ? 'Advance' : 'Final invoice'}</strong><span>{document.zoho_document_number || 'Not issued'} · {document.zoho_status || document.status}</span></div>
                <div class="document-actions">
                  {zohoOpenUrl(document) && <a href={zohoOpenUrl(document)!} target="_blank" rel="noopener">Open in Zoho</a>}
                  {document.zoho_document_id && <button type="button" data-action="refresh-document" data-id={r.id} data-value={document.document_type}>Refresh</button>}
                  {['failed', 'queued', 'draft', 'processing'].includes(document.status) && <button type="button" data-action="retry-document" data-id={r.id} data-value={document.document_type}>Retry</button>}
                </div>
                {document.sent_at && <small>Sent {formatDateIN(document.sent_at)}</small>}
                {document.last_error && <small class="document-error">{document.last_error}</small>}
              </div>
            ))}
            {!documents.length && <div class="document-empty"><span>No documents generated.</span>{r.status === 'confirmed' && <button type="button" data-action="generate-document" data-id={r.id} data-value={payState === 'full' ? 'final' : 'advance'}>Generate document</button>}</div>}
          </div>
          </>}
          <p>Admin Notes</p><textarea id={`notes-${r.id}`} rows={3} placeholder="Add internal notes…">{r.admin_notes ?? ''}</textarea>
          <button type="button" class="save-notes" data-action="save-notes" data-id={r.id}>Save Notes</button><p id={`msg-${r.id}`} class="saved">Saved!</p>
        </> : <p class="read-only-note">Trip leads have read-only access.</p>}
      </div>
    </div>
  </div>
</div>

<style>
  .reg-row{background:#fff;border:1px solid var(--color-border);border-radius:.75rem;padding:.9rem 1rem}.reg-summary{display:grid;grid-template-columns:auto minmax(220px,1.6fr) minmax(150px,1fr) minmax(130px,.8fr) auto;gap:1.25rem;align-items:center}.name-line{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.name-line strong{color:var(--color-navy)}.status-badge{padding:.2rem .6rem;border-radius:9999px;font-size:.72rem;font-weight:700}.reg-contact{overflow:hidden;margin-top:.15rem;color:var(--color-text-secondary);font-size:.78rem;text-overflow:ellipsis;white-space:nowrap}.reg-meta{display:flex;min-width:0;flex-direction:column;gap:.15rem;color:var(--color-text-secondary);font-size:.76rem}.reg-meta strong{color:var(--color-navy);font-size:.86rem}.reg-meta-label{font-size:.65rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.row-select{display:inline-flex;align-items:center;justify-content:center}.row-select input{width:1rem;height:1rem;accent-color:var(--color-coral)}.details-btn{border:1px solid var(--color-coral);border-radius:999px;background:#fff;color:var(--color-coral);cursor:pointer;font-weight:700;padding:.4rem .8rem;white-space:nowrap}.detail-row{display:none;margin-top:.9rem;padding-top:.9rem;border-top:1px solid var(--color-border)}.detail-grid{display:grid;grid-template-columns:1fr 340px;gap:1.5rem}.detail-grid h3{margin:0 0 .75rem;font-size:.8rem;text-transform:uppercase}.fields{display:grid;grid-template-columns:1fr 1fr;gap:.4rem 1rem;font-size:.82rem}.fields span,.admin-actions p{color:var(--color-text-secondary);font-weight:600}.admin-actions{background:var(--color-gray-soft);border:1px solid var(--color-border);border-radius:.75rem;padding:1.25rem}.admin-actions p{font-size:.8rem;margin:.6rem 0 .4rem}.status-actions{display:flex;gap:.35rem;flex-wrap:wrap}.status-actions button{padding:.35rem .55rem;border:1px solid var(--color-border);border-radius:.4rem;background:#fff;text-transform:capitalize}.status-actions .current{border-color:var(--color-coral);color:var(--color-coral)}textarea{width:100%;box-sizing:border-box;padding:.5rem;border:1px solid var(--color-border);border-radius:.5rem}.save-notes{margin-top:.5rem;width:100%;padding:.5rem;background:var(--color-primary);color:#fff;border:0;border-radius:.5rem;font-weight:700}.saved{display:none!important;color:var(--color-success)!important;text-align:center}.read-only-note{font-weight:400!important}.wishlist-note{font-weight:400!important;font-size:.75rem;font-style:italic}.reg-actions{justify-self:end}.payment-entry{margin-top:.55rem}.payment-entry summary{cursor:pointer;color:var(--color-coral);font-size:.8rem;font-weight:700}.payment-fields{display:grid;gap:.5rem;margin-top:.6rem}.payment-fields label{display:grid;gap:.2rem;color:var(--color-text-secondary);font-size:.72rem;font-weight:700}.payment-fields input,.payment-fields select{box-sizing:border-box;width:100%;padding:.45rem;border:1px solid var(--color-border);border-radius:.4rem;background:#fff}.payment-fields button,.document-actions button,.document-empty button{padding:.4rem .6rem;border:0;border-radius:.4rem;background:var(--color-primary);color:#fff;font-weight:700}.documents{display:grid;gap:.5rem}.document-row{display:grid;gap:.25rem;padding:.55rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff}.document-row>div:first-child{display:flex;justify-content:space-between;gap:.5rem}.document-row span,.document-row small,.document-empty{font-size:.7rem;color:var(--color-text-secondary)}.document-actions{display:flex;gap:.4rem}.document-actions a{font-size:.72rem;font-weight:700;color:var(--color-coral)}.document-error{color:var(--color-danger)!important}.document-empty{display:flex;align-items:center;justify-content:space-between;gap:.5rem}@media(max-width:900px){.reg-summary{grid-template-columns:auto 1fr 1fr}.reg-primary{grid-column:2/-1}.reg-actions{grid-column:2/-1;justify-self:start}.detail-grid{grid-template-columns:1fr}}@media(max-width:600px){.reg-summary{grid-template-columns:auto 1fr}.reg-meta{grid-column:2}.fields{grid-template-columns:1fr}}
</style>
