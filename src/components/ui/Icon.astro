---
/**
 * Zero-JS inline icon. Renders a 24×24 stroke SVG from a local name→paths map —
 * the handful of glyphs currently hand-pasted across pages. Uses `currentColor`
 * for stroke, so colour comes from the parent's text colour.
 *
 * If the project later adopts `astro-icon`, this can become a thin re-export
 * without changing call sites.
 */
type IconName =
  | 'map-pin'
  | 'arrow-right'
  | 'chevron-right'
  | 'chevron-down'
  | 'menu'
  | 'close'
  | 'users'
  | 'clock'
  | 'mail'
  | 'check'
  | 'calendar'
  | 'sparkles';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  title?: string;
}

const { name, size = '1.25em', class: className, title, ...rest } = Astro.props;

// Each glyph is one or more `d` strings — `stroke` styling, round caps/joins,
// matching the existing inline SVGs.
const paths: Record<IconName, string[]> = {
  'map-pin': [
    'M17.657 16.657 13.414 20.9a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z',
    'M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
  ],
  'arrow-right': ['M5 12h14', 'M13 5l7 7-7 7'],
  'chevron-right': ['m9 6 6 6-6 6'],
  'chevron-down': ['m6 9 6 6 6-6'],
  'menu': ['M5 7h14', 'M5 12h14', 'M5 17h14'],
  'close': ['M6 6l12 12', 'M18 6 6 18'],
  'users': [
    'M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2',
    'M11 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
    'M21 21v-2a4 4 0 0 0-3-3.87',
    'M16 3.13a4 4 0 0 1 0 7.75',
  ],
  'clock': ['M12 8v4l3 3', 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z'],
  'mail': ['M4 4h16v16H4z', 'M22 6l-10 7L2 6'],
  'check': ['M20 6 9 17l-5-5'],
  'calendar': [
    'M8 2v4',
    'M16 2v4',
    'M3 10h18',
    'M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z',
  ],
  'sparkles': ['M12 3l1.9 4.8L18.7 9l-4.8 1.9L12 15.7 10.1 10.9 5.3 9l4.8-1.2z'],
};

const d = paths[name] ?? [];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['inline-block shrink-0', className]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  {...rest}
>
  {title && <title>{title}</title>}
  {d.map((seg) => <path d={seg} />)}
</svg>
