---
/**
 * Label + control wrapper. Renders a real <label> so clicking the text focuses
 * the control; pass `for` (aliased from `for`) to bind by id, or nest the
 * control in the default slot. `hint` / `error` render below.
 */
interface Props {
  label: string;
  for?: string;
  required?: boolean;
  hint?: string;
  error?: string;
  class?: string;
}

const { label, for: htmlFor, required, hint, error, class: className, ...rest } = Astro.props;
---

<div class:list={['flex flex-col gap-1.5', className]} {...rest}>
  <label class="text-sm font-medium text-navy" for={htmlFor}>
    {label}{required && <span class="text-coral-ink"> *</span>}
  </label>
  <slot />
  {hint && !error && <p class="text-xs text-gray-text">{hint}</p>}
  {error && <p class="text-xs text-coral-ink">{error}</p>}
</div>
