---
/**
 * Status / category badge.
 *
 * Ports the maps from the old `src/components/Badge.astro` verbatim (same
 * `variant` + `value` API) so existing call sites keep working; the only change
 * is that colours come from utilities instead of inline `style`.
 */
interface Props {
  variant?: 'status' | 'category';
  value: string;
  class?: string;
}

const { variant = 'status', value, class: className, ...rest } = Astro.props;

const statusStyles: Record<string, string> = {
  'booking-open': 'bg-success-surface text-success-surface-ink',
  'coming-soon': 'bg-interest-surface text-interest-ink',
  'sold-out': 'bg-danger-surface text-danger-ink',
  'draft': 'bg-caution-surface text-caution-ink',
};

const statusLabels: Record<string, string> = {
  'booking-open': 'Booking Open',
  'coming-soon': 'Coming Soon',
  'sold-out': 'Sold Out',
  'draft': 'Draft',
};

const isStatus = variant === 'status';
const tone = isStatus ? (statusStyles[value] ?? statusStyles['draft']) : 'bg-blush text-navy';
const label = isStatus ? (statusLabels[value] ?? value) : value;
---

<span
  class:list={[
    'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide',
    tone,
    className,
  ]}
  {...rest}
>
  {label}
</span>
