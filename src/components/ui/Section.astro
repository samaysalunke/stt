---
/**
 * Page section — vertical rhythm + `container-app` gutter + optional centered
 * heading block. Replaces the repeated
 * `<section class="py-16 lg:py-20"><div class="container-app">…<div class="max-w-2xl mx-auto text-center mb-12">`
 * pattern. `tone` sets the band background from a brand token.
 */
interface Props {
  as?: 'section' | 'div';
  title?: string;
  intro?: string;
  tone?: 'default' | 'soft' | 'blush' | 'navy';
  space?: 'sm' | 'md' | 'lg';
  align?: 'center' | 'start';
  class?: string;
}

const {
  as: Tag = 'section',
  title,
  intro,
  tone = 'default',
  space = 'md',
  align = 'center',
  class: className,
  ...rest
} = Astro.props;

const tones: Record<string, string> = {
  default: '',
  soft: 'bg-gray-soft',
  blush: 'bg-blush',
  navy: 'bg-navy text-white',
};
const spaces = { sm: 'py-12', md: 'py-16 lg:py-20', lg: 'py-20 lg:py-28' } as const;
const hasHeader = Boolean(title || intro);
---

<Tag class:list={[spaces[space], tones[tone], className]} {...rest}>
  <div class="container-app">
    {hasHeader && (
      <div
        class:list={[
          'mb-10 max-w-2xl',
          align === 'center' ? 'mx-auto text-center' : '',
        ]}
      >
        {title && <h2 class="text-display-md font-display">{title}</h2>}
        {intro && (
          <p class:list={['mt-3 leading-relaxed', tone === 'navy' ? 'text-white/75' : 'text-gray-text']}>
            {intro}
          </p>
        )}
      </div>
    )}
    <slot />
  </div>
</Tag>
