---
import type { ResolvedDeparture } from '../lib/trips';
import { formatDepartureRange, getDepartureSummary } from '../lib/departureSummary';
import { FALLBACK_HERO } from '../lib/images';
import { imageSrcset, TRIP_GRID_SIZES } from '../lib/imageVariants';
import DiscountCountdown from './DiscountCountdown';
import { lowStockSpots, spotsLeftLabel } from '../lib/urgency';

interface Props {
  slug: string;
  title?: string;
  name?: string;
  coverImage?: string | null;
  featuredImage?: string | null;
  description?: string;
  shortDescription?: string;
  location?: string | null;
  duration?: string | null;
  fromPrice?: number | null;
  originalFromPrice?: number | null;
  discountEndsAt?: string | null;
  multiPrice?: boolean;
  spotsLeft?: number | null;
  soldOut?: boolean;
  hasComingSoon?: boolean;
  allComingSoon?: boolean;
  departures?: ResolvedDeparture[];
  /**
   * The `sizes` for the cover image. There is no single correct value: this
   * card is laid out by a 1-then-2 column grid on /trips/ and by a percentage
   * carousel on /, so only the caller knows how wide the slot actually is.
   * The default describes the /trips/ grid.
   */
  sizes?: string;
  /**
   * Set on the one card that is the page's LCP element. Every other card is
   * lazy, which is right for them and wrong for that one.
   */
  priority?: boolean;
  /**
   * Hold this card's cover out of the network until the page's priority image
   * has finished, then load it on approach. `loading="lazy"` alone does not do
   * this: Chrome's lazy threshold *widens* on a slow connection, so on /trips/
   * the below-fold covers get fetched during the initial load and take
   * bandwidth from the very image they are meant to yield to. Promoted by the
   * observer in BaseLayout.astro.
   */
  defer?: boolean;
  /** This signed-in traveller's relationship to the trip, shown as a pill on the cover. */
  userState?: 'going' | 'went' | 'saved' | null;
  /** Whether the heart starts filled. Only meaningful for a signed-in viewer. */
  saved?: boolean;
}

const {
  slug,
  title,
  name,
  coverImage,
  featuredImage,
  description,
  shortDescription,
  location,
  duration,
  fromPrice = null,
  originalFromPrice = null,
  discountEndsAt = null,
  multiPrice = false,
  spotsLeft = null,
  soldOut = false,
  hasComingSoon = false,
  allComingSoon = false,
  departures = [],
  sizes = TRIP_GRID_SIZES,
  priority = false,
  defer = false,
  userState = null,
  saved = false,
} = Astro.props;

// Signed-out visitors get the heart as a link through sign-in, identical for
// all of them, so the edge-cached listing stays one shared page.
const signedIn = Boolean(Astro.locals.user);
const saveHref = `/login?next=${encodeURIComponent(`/trips/?save=${slug}`)}`;
const userStateLabel = { going: "You're going", went: 'You went', saved: 'Saved' } as const;

const tripName = title || name || slug;
const img = coverImage || featuredImage || FALLBACK_HERO;
const imgSrcset = imageSrcset(img);
const coverClass = 'h-full w-full object-cover transition-transform duration-700 group-hover:scale-105';
const cardImageAlt = `${tripName} group trip${location && !tripName.toLowerCase().includes(location.toLowerCase()) ? ` in ${location}` : ''}`;

const formattedPrice = fromPrice != null ? `₹${fromPrice.toLocaleString('en-IN')}` : null;
const isSoldOut = soldOut;
// One capacity signal, only when stock is low. `spotsLeft` is live (confirmed
// registrations against the cap) for the soonest bookable departure.
const lowStock = lowStockSpots({ liveSpotsLeft: spotsLeft, soldOut: isSoldOut });
const departureSummary = getDepartureSummary(departures);

// Card footer order matters: the coming-soon caption renders ABOVE the CTA.
// The footer block is bottom-anchored (mt-auto), so a caption placed under the
// button would push this card's button up and break its baseline against a
// neighbouring card that has no caption.
---

<article
  data-testid="trip-card"
  data-card-skeleton
  class="trip-card-shell group flex h-full w-full flex-col overflow-hidden rounded-[var(--radius-card)] bg-white shadow-media transition-all hover:-translate-y-0.5"
>
  <!-- Cover image -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <a href={`/trips/${slug}/`} class="block h-full">
      <img
        data-skeleton-image
        src={defer ? undefined : img}
        srcset={defer ? undefined : imgSrcset}
        data-defer-src={defer ? img : undefined}
        data-defer-srcset={defer ? imgSrcset : undefined}
        sizes={sizes}
        alt={cardImageAlt}
        width="800"
        height="600"
        class={coverClass}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
      {defer && (
        <noscript>
          <img
            src={img}
            srcset={imgSrcset}
            sizes={sizes}
            alt={cardImageAlt}
            width="800"
            height="600"
            class={coverClass}
            loading="lazy"
            decoding="async"
          />
        </noscript>
      )}
    </a>
    {(duration || userState) && (
      <div class="pointer-events-none absolute left-3 top-3 flex flex-col items-start gap-1.5">
        {duration && (
          <span class="rounded-[var(--radius-pill)] bg-black/55 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-white backdrop-blur-[4px]">
            {duration}
          </span>
        )}
        {userState && (
          <span
            data-testid="trip-card-user-state"
            data-state={userState}
            class:list={[
              'rounded-[var(--radius-pill)] px-3 py-1 text-[11px] font-semibold text-white shadow-md',
              userState === 'going' ? 'bg-cta' : 'bg-navy/85 backdrop-blur-[4px]',
            ]}
          >
            {userStateLabel[userState]}
          </span>
        )}
      </div>
    )}
    {signedIn ? (
      <button
        type="button"
        class="save-heart"
        data-save-trip={slug}
        data-trip-name={tripName}
        aria-pressed={saved ? 'true' : 'false'}
        aria-label={saved ? `Remove ${tripName} from saved trips` : `Save ${tripName}`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.2 3.4 4.5 7 4.5c2.1 0 3.7 1.2 5 3 1.3-1.8 2.9-3 5-3 3.6 0 5.5 3.7 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" /></svg>
      </button>
    ) : (
      <a href={saveHref} class="save-heart" aria-label={`Save ${tripName} (sign in)`} rel="nofollow">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.2 3.4 4.5 7 4.5c2.1 0 3.7 1.2 5 3 1.3-1.8 2.9-3 5-3 3.6 0 5.5 3.7 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" /></svg>
      </a>
    )}
    {departureSummary.displayed.length > 0 && (
      <div data-testid="card-departure-summary" aria-label="Upcoming departures" class="pointer-events-none absolute inset-x-3 bottom-3 flex flex-col items-start gap-1.5">
        <span class="rounded-md bg-black/45 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white backdrop-blur-[4px]">Departures</span>
        <div class="flex min-w-0 flex-wrap items-stretch gap-1.5">
          {departureSummary.displayed.map((departure) => (
            <span
              data-sold-out={String(departure.soldOut)}
              data-coming-soon={String(departure.comingSoon)}
              data-filling-fast={String(departure.fillingFast)}
              class:list={[
                'flex flex-none flex-col justify-center rounded-lg px-2.5 py-1.5 text-xs font-semibold leading-tight text-white shadow-md backdrop-blur-sm',
                departure.soldOut ? 'border border-white/20 bg-navy/60 opacity-70'
                  : departure.comingSoon ? 'border border-white/20 bg-navy/70' : 'bg-cta',
              ]}
            >
              <span class:list={{ 'line-through': departure.soldOut }}>{formatDepartureRange(departure.startDate, departure.endDate)}</span>
              {departure.soldOut ? <span class="mt-0.5 text-[10px] text-white/75">Sold out</span>
                : departure.comingSoon ? <span class="mt-0.5 text-[10px] text-white/75">Coming soon</span>
                : departure.fillingFast ? <span class="mt-0.5 text-[10px] font-semibold text-white">Filling fast</span> : null}
            </span>
          ))}
          {departureSummary.moreAvailable > 0 && (
            <span class="flex flex-none items-center rounded-lg bg-navy/80 px-2 text-xs font-semibold text-white backdrop-blur-sm">+{departureSummary.moreAvailable} more</span>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Card body -->
  <div class="flex flex-1 flex-col gap-5 p-6">
    <div data-testid="trip-card-summary" class="trip-card-summary flex items-start justify-between gap-4">
      <div data-testid="trip-card-info" class="min-w-0">
        <a href={`/trips/${slug}/`}>
          <h3 data-testid="trip-card-title" class="font-display text-display-sm leading-tight text-navy transition-colors group-hover:text-coral-ink">{tripName}</h3>
        </a>
        {location && (
          <p data-testid="trip-card-location" class="mt-2 inline-flex items-center gap-1.5 text-sm text-gray-text">
            <svg class="h-4 w-4 text-coral-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            {location}
          </p>
        )}
      </div>
      <div data-testid="trip-card-price" class="trip-card-price shrink-0 text-right">
        {allComingSoon && formattedPrice == null ? (
          <p class="font-display text-display-sm leading-none text-gray-text">Coming soon</p>
        ) : (
          <>
            {originalFromPrice != null && (
              <p class="text-sm leading-none line-through text-gray-text">₹{originalFromPrice.toLocaleString('en-IN')}</p>
            )}
            <p class="font-display text-display-sm leading-none text-navy">{multiPrice && formattedPrice ? <span class="text-xs font-sans align-middle text-gray-text">from </span> : null}{formattedPrice ?? '—'}</p>
            <p class="mt-1.5 text-xs text-gray-text">per person</p>
            {originalFromPrice != null && discountEndsAt && (
              <DiscountCountdown endsAt={discountEndsAt} reloadOnExpire={true} className="mt-1 block text-[10px] font-semibold" client:load />
            )}
          </>
        )}
      </div>
    </div>

    {isSoldOut ? (
      <span class="mt-auto inline-flex cursor-not-allowed items-center justify-center rounded-[var(--radius-pill)] bg-gray-soft px-6 py-4 text-base font-medium text-gray-text">
        Sold out
      </span>
    ) : (
      <div class="mt-auto flex flex-col gap-2">
        {lowStock != null ? (
          <p data-testid="trip-card-spots-left" class="text-center text-xs font-semibold text-coral-ink">{spotsLeftLabel(lowStock)}</p>
        ) : hasComingSoon ? (
          <p class="text-center text-xs text-coral-ink">New dates — wishlist inside</p>
        ) : null}
        <a
          href={`/trips/${slug}/`}
          class="inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-cta px-6 py-4 font-display text-base font-medium text-white transition-transform hover:-translate-y-0.5"
        >
          View Details
        </a>
      </div>
    )}
  </div>
</article>

<style>
  .save-heart {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    backdrop-filter: blur(4px);
    transition: transform 150ms ease, background-color 150ms ease;
  }
  .save-heart:hover { background: rgb(0 0 0 / 0.6); }
  .save-heart:active { transform: scale(0.92); }
  .save-heart:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .save-heart svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .save-heart[aria-pressed='true'] svg { fill: var(--color-coral); stroke: var(--color-coral); }
  .save-heart[aria-busy='true'] { opacity: 0.7; }
  @media (prefers-reduced-motion: reduce) {
    .save-heart { transition: none; }
    .save-heart:active { transform: none; }
  }

  .trip-card-shell {
    container-name: trip-card;
    container-type: inline-size;
  }

  @container trip-card (max-width: 420px) {
    .trip-card-summary {
      flex-direction: column;
      align-items: stretch;
    }

    .trip-card-price {
      display: flex;
      width: 100%;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.375rem 0.5rem;
      text-align: left;
    }

    .trip-card-price > :global(*) {
      margin-top: 0;
    }
  }
</style>


<style is:global>
  /* Created by the heart script below, outside any card, so it can't be scoped. */
  .save-toast {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    z-index: 60;
    max-width: calc(100vw - 2rem);
    transform: translate(-50%, 0.5rem);
    border-radius: 9999px;
    background: var(--color-navy);
    color: #fff;
    padding: 0.7rem 1.2rem;
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .save-toast[data-show='true'] { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { .save-toast { transition: none; } }
</style>

<script>
  // Hearts on trip cards. Optimistic: the heart fills at once and rolls back if
  // the save fails. One delegated listener covers every card on the page.
  const announce = (() => {
    let region: HTMLElement | null = null;
    let timer = 0;
    return (message: string) => {
      if (!region) {
        region = document.createElement('div');
        region.className = 'save-toast';
        region.setAttribute('role', 'status');
        document.body.append(region);
      }
      region.textContent = message;
      region.dataset.show = 'true';
      clearTimeout(timer);
      timer = window.setTimeout(() => { if (region) region.dataset.show = 'false'; }, 2600);
    };
  })();

  const paint = (slug: string, saved: boolean) => {
    document.querySelectorAll<HTMLButtonElement>(`button[data-save-trip="${CSS.escape(slug)}"]`).forEach((btn) => {
      const name = btn.dataset.tripName ?? 'this trip';
      btn.setAttribute('aria-pressed', String(saved));
      btn.setAttribute('aria-label', saved ? `Remove ${name} from saved trips` : `Save ${name}`);
    });
  };

  const request = (slug: string, saved: boolean) =>
    fetch('/api/saved-trips', {
      method: saved ? 'POST' : 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug }),
    }).then((res) => res.ok);

  document.addEventListener('click', async (event) => {
    const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('button[data-save-trip]');
    if (!btn || btn.getAttribute('aria-busy') === 'true') return;
    const slug = btn.dataset.saveTrip!;
    const name = btn.dataset.tripName ?? 'Trip';
    const next = btn.getAttribute('aria-pressed') !== 'true';
    paint(slug, next);
    btn.setAttribute('aria-busy', 'true');
    let ok = false;
    try { ok = await request(slug, next); } catch {}
    btn.removeAttribute('aria-busy');
    if (!ok) {
      paint(slug, !next);
      announce("Couldn't update your saved trips. Please try again.");
      return;
    }
    announce(next ? `Saved ${name}` : `Removed ${name} from saved trips`);
  });

  // Back from signing in via a heart (/trips/?save=slug): finish the save they
  // asked for, then drop the parameter so a reload doesn't repeat it.
  const params = new URLSearchParams(location.search);
  const pending = params.get('save');
  const pendingBtn = pending ? document.querySelector<HTMLButtonElement>(`button[data-save-trip="${CSS.escape(pending)}"]`) : null;
  if (pending) {
    params.delete('save');
    history.replaceState(history.state, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
  }
  if (pending && pendingBtn) {
    const name = pendingBtn.dataset.tripName ?? 'Trip';
    if (pendingBtn.getAttribute('aria-pressed') === 'true') {
      announce(`${name} is in your saved trips`);
    } else {
      paint(pending, true);
      request(pending, true).then((ok) => {
        if (ok) announce(`Saved ${name}`);
        else { paint(pending, false); announce("Couldn't save that trip. Please try again."); }
      }).catch(() => { paint(pending, false); announce("Couldn't save that trip. Please try again."); });
    }
  }
</script>
