---
import Badge from './Badge.astro';

interface Props {
  slug: string;
  name: string;
  status: string;
  featuredImage?: string | null;
  shortDescription: string;
  location?: string | null;
  startDate?: string | null;
  endDate?: string | null;
  duration?: string | null;
  pricePerPerson?: number | null;
  maxGroupSize?: number | null;
  currentBookings?: number | null;
}

const {
  slug,
  name,
  status,
  featuredImage,
  shortDescription,
  location,
  startDate,
  endDate,
  duration,
  pricePerPerson,
  maxGroupSize,
  currentBookings,
} = Astro.props;

const seatsLeft = maxGroupSize && currentBookings !== null && currentBookings !== undefined
  ? maxGroupSize - currentBookings
  : null;

const formattedPrice = pricePerPerson
  ? new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(pricePerPerson)
  : null;

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

const placeholderImg = 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&auto=format&fit=crop&q=80';
---

<article class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden group flex flex-col">
  <!-- Image -->
  <a href={`/trips/${slug}/`} class="block relative overflow-hidden aspect-[16/10]">
    <img
      src={featuredImage ?? placeholderImg}
      alt={name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <!-- Overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    <!-- Status badge top-left -->
    <div class="absolute top-3 left-3">
      <Badge variant="status" value={status} />
    </div>
    {seatsLeft !== null && seatsLeft <= 5 && seatsLeft > 0 && (
      <div class="absolute top-3 right-3">
        <span class="px-2.5 py-1 rounded-full text-xs font-bold text-white" style="background-color: var(--color-danger);">
          {seatsLeft} left!
        </span>
      </div>
    )}
    {seatsLeft === 0 && (
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="text-white font-bold text-lg bg-black/60 px-4 py-2 rounded-lg">Sold Out</span>
      </div>
    )}
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    {status === 'booking-open' && (
      <p class="italic mb-1" style="font-family: var(--font-accent); font-size: 0.9rem; color: var(--color-accent);">
        spots filling up!
      </p>
    )}
    <h3 class="font-display font-bold text-lg leading-snug mb-2 group-hover:opacity-80 transition-opacity">
      <a href={`/trips/${slug}/`} class="hover:underline">{name}</a>
    </h3>

    <p class="text-sm leading-relaxed mb-4 flex-1" style="color: var(--color-text-secondary);">
      {shortDescription}
    </p>

    <!-- Trip meta -->
    <div class="space-y-1.5 text-xs mb-3" style="color: var(--color-text-secondary);">
      {location && (
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{location}</span>
        </div>
      )}
      {startDate && (
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>{formatDate(startDate)}</span>
        </div>
      )}
      {duration && (
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{duration}</span>
        </div>
      )}
    </div>

    <!-- Spots progress bar -->
    {maxGroupSize && currentBookings != null && (
      <div class="mb-3">
        <div class="flex justify-between text-xs mb-1" style="color: var(--color-text-secondary);">
          <span>{seatsLeft !== null && seatsLeft > 0 ? `${seatsLeft} spot${seatsLeft === 1 ? '' : 's'} left` : 'Fully booked'}</span>
          <span>{currentBookings}/{maxGroupSize} booked</span>
        </div>
        <div class="h-1.5 rounded-full overflow-hidden" style="background-color: var(--color-border);">
          <div
            class="h-full rounded-full transition-all duration-500"
            style={`width: ${Math.min(100, ((currentBookings ?? 0) / maxGroupSize) * 100)}%; background-color: ${
              seatsLeft !== null && seatsLeft <= 3 ? 'var(--color-danger)' :
              seatsLeft !== null && seatsLeft <= 5 ? 'var(--color-gold)' :
              'var(--color-success)'
            };`}
          />
        </div>
      </div>
    )}

    <!-- Price + CTA -->
    <div class="flex items-center justify-between pt-4 border-t" style="border-color: var(--color-border);">
      <div>
        {formattedPrice ? (
          <div>
            <span class="text-xl font-display font-extrabold" style="color: var(--color-accent);">
              {formattedPrice}
            </span>
            <span class="text-xs ml-1" style="color: var(--color-text-secondary);">/ person</span>
          </div>
        ) : (
          <span class="text-sm font-medium" style="color: var(--color-text-secondary);">Price TBD</span>
        )}
      </div>
      <div class="flex items-center gap-2">
        <button
          data-share-url={`/trips/${slug}/`}
          data-share-title={name}
          class="share-btn p-2 rounded-lg border transition-all hover:bg-gray-50 active:scale-95"
          style="border-color: var(--color-border);"
          aria-label="Share trip"
          title="Share"
        >
          <svg class="w-4 h-4" style="color: var(--color-text-secondary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
        </button>
        <a
          href={`/trips/${slug}/`}
          class="font-bold text-sm text-white px-4 py-2 rounded-lg transition-all hover:opacity-90 active:scale-95"
          style={`background-color: ${status === 'booking-open' ? 'var(--color-accent)' : status === 'sold-out' ? '#991b1b' : 'var(--color-text-secondary)'};`}
        >
          {status === 'booking-open' ? 'Book Now →' : status === 'sold-out' ? 'Sold Out' : 'View Details'}
        </a>
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const path = btn.dataset.shareUrl ?? '';
      const title = btn.dataset.shareTitle ?? 'Seek the Thrill';
      const url = `${location.origin}${path}`;
      if (navigator.share) {
        await navigator.share({ title, url }).catch(() => {});
      } else {
        await navigator.clipboard.writeText(url).catch(() => {});
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4" style="color:var(--color-success)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
      }
    });
  });
</script>
