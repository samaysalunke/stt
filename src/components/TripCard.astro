---
interface Batch {
  id: string;
  startDate: string;
  endDate: string;
  price: number;
  totalSpots: number;
  bookedSpots: number;
}

interface Props {
  slug: string;
  title?: string;
  name?: string;
  status: string;
  coverImage?: string | null;
  featuredImage?: string | null;
  description?: string;
  shortDescription?: string;
  location?: string | null;
  duration?: string | null;
  batches?: Batch[];
  startDate?: string | null;
  endDate?: string | null;
  pricePerPerson?: number | null;
  maxGroupSize?: number | null;
  currentBookings?: number | null;
  sharingOptions?: Array<{ id?: string; label?: string; price?: number }> | null;
}

const {
  slug,
  title,
  name,
  status,
  coverImage,
  featuredImage,
  description,
  shortDescription,
  location,
  duration,
  batches = [],
  startDate,
  endDate,
  pricePerPerson,
  maxGroupSize,
  currentBookings,
  sharingOptions = [],
} = Astro.props;

const tripName = title || name || slug;
const img = coverImage || featuredImage || 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&auto=format&fit=crop&q=80';
const desc = description || shortDescription || '';

// Determine price/spots from batches or legacy fields
const hasBatches = batches && batches.length > 0;
const firstBatch = hasBatches ? batches[0] : null;
const price = firstBatch?.price ?? pricePerPerson;
const totalSpots = firstBatch?.totalSpots ?? maxGroupSize;
const bookedSpots = firstBatch?.bookedSpots ?? currentBookings ?? 0;
const spotsLeft = totalSpots ? totalSpots - bookedSpots : null;
const moreDates = hasBatches && batches.length > 1 ? batches.length - 1 : 0;

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

const displayDate = firstBatch
  ? `${formatDate(firstBatch.startDate)} – ${formatDate(firstBatch.endDate)}`
  : (startDate ? `${formatDate(startDate)} – ${formatDate(endDate ?? '')}` : '');

// Occupancy options (if any) drive the displayed price as "from <lowest>".
const sharingPrices = (sharingOptions ?? [])
  .map((o) => Number(o?.price))
  .filter((p) => Number.isFinite(p) && p > 0);
const hasSharing = sharingPrices.length > 0;
const displayPrice = hasSharing ? Math.min(...sharingPrices) : price;

const formattedPrice = displayPrice
  ? `₹${displayPrice.toLocaleString('en-IN')}`
  : null;

const isSoldOut = status === 'sold_out' || status === 'sold-out';
---

<article
  class="group flex flex-col overflow-hidden rounded-3xl bg-white transition-all hover:-translate-y-0.5"
  style="box-shadow: 0 4px 30px -12px rgba(27,43,58,0.18);"
>
  <!-- Cover image -->
  <a href={`/trips/${slug}/`} class="relative block overflow-hidden" style="aspect-ratio: 4/3;">
    <img
      src={img}
      alt={tripName}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    {duration && (
      <span
        class="absolute left-3 top-3 rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-white"
        style="background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);"
      >
        {duration}
      </span>
    )}
  </a>

  <!-- Card body -->
  <div class="flex flex-1 flex-col gap-5 p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <a href={`/trips/${slug}/`}>
          <h3 class="font-display text-2xl leading-tight transition-colors group-hover:text-[color:var(--color-coral)]" style="color: var(--color-navy);">{tripName}</h3>
        </a>
        {location && (
          <p class="mt-2 inline-flex items-center gap-1.5 text-sm" style="color: var(--color-gray-text);">
            <svg class="h-4 w-4" style="color: var(--color-coral);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            {location}
          </p>
        )}
      </div>
      <div class="shrink-0 text-right">
        <p class="font-display text-2xl leading-none" style="color: var(--color-coral);">{hasSharing && formattedPrice ? <span class="text-xs font-sans align-middle" style="color: var(--color-gray-text);">from </span> : null}{formattedPrice ?? '—'}</p>
        <p class="mt-1.5 text-xs" style="color: var(--color-gray-text);">per person</p>
      </div>
    </div>

    {isSoldOut ? (
      <span class="mt-auto inline-flex cursor-not-allowed items-center justify-center rounded-full px-6 py-4 text-base font-medium" style="background-color: #e5e7eb; color: #9ca3af;">
        Sold out
      </span>
    ) : (
      <div class="mt-auto flex flex-col gap-2">
        <a
          href={`/trips/${slug}/`}
          class="inline-flex items-center justify-center rounded-full px-6 py-4 font-display text-base font-medium text-white transition-transform hover:-translate-y-0.5"
          style="background-color: var(--color-coral);"
        >
          View Details
        </a>
        {spotsLeft !== null && (
          <p class="text-center text-xs" style="color: var(--color-gray-text);">{spotsLeft} slots left</p>
        )}
      </div>
    )}
  </div>
</article>
