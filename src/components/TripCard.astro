---
interface Batch {
  id: string;
  startDate: string;
  endDate: string;
  price: number;
  totalSpots: number;
  bookedSpots: number;
}

interface Props {
  slug: string;
  title?: string;
  name?: string;
  status: string;
  coverImage?: string | null;
  featuredImage?: string | null;
  description?: string;
  shortDescription?: string;
  location?: string | null;
  duration?: string | null;
  batches?: Batch[];
  startDate?: string | null;
  endDate?: string | null;
  pricePerPerson?: number | null;
  maxGroupSize?: number | null;
  currentBookings?: number | null;
}

const {
  slug,
  title,
  name,
  status,
  coverImage,
  featuredImage,
  description,
  shortDescription,
  location,
  duration,
  batches = [],
  startDate,
  endDate,
  pricePerPerson,
  maxGroupSize,
  currentBookings,
} = Astro.props;

const tripName = title || name || slug;
const img = coverImage || featuredImage || 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&auto=format&fit=crop&q=80';
const desc = description || shortDescription || '';

// Determine price/spots from batches or legacy fields
const hasBatches = batches && batches.length > 0;
const firstBatch = hasBatches ? batches[0] : null;
const price = firstBatch?.price ?? pricePerPerson;
const totalSpots = firstBatch?.totalSpots ?? maxGroupSize;
const bookedSpots = firstBatch?.bookedSpots ?? currentBookings ?? 0;
const spotsLeft = totalSpots ? totalSpots - bookedSpots : null;
const moreDates = hasBatches && batches.length > 1 ? batches.length - 1 : 0;

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

const displayDate = firstBatch
  ? `${formatDate(firstBatch.startDate)} – ${formatDate(firstBatch.endDate)}`
  : (startDate ? `${formatDate(startDate)} – ${formatDate(endDate ?? '')}` : '');

const formattedPrice = price
  ? `₹${price.toLocaleString('en-IN')}`
  : null;

// Status badge config
const statusMap: Record<string, { label: string; bg: string; color: string }> = {
  upcoming:     { label: 'UPCOMING',     bg: '#E8725A',  color: '#fff' },
  filling_fast: { label: 'FILLING FAST', bg: '#F59E0B',  color: '#fff' },
  sold_out:     { label: 'SOLD OUT',     bg: '#9CA3AF',  color: '#fff' },
  'booking-open': { label: 'UPCOMING',   bg: '#E8725A',  color: '#fff' },
  'sold-out':   { label: 'SOLD OUT',     bg: '#9CA3AF',  color: '#fff' },
};

const badge = statusMap[status] ?? statusMap['upcoming'];
const isSoldOut = status === 'sold_out' || status === 'sold-out';
const hasMultipleBatches = batches.length > 1;
---

<article
  class={`bg-white rounded-2xl overflow-hidden flex flex-col transition-all duration-300 hover:shadow-xl group ${isSoldOut ? 'opacity-60 grayscale' : ''}`}
  style="box-shadow: 0 1px 4px rgba(0,0,0,0.08);"
>
  <!-- Cover image -->
  <a href={`/trips/${slug}/`} class="block relative overflow-hidden" style="aspect-ratio: 16/9;">
    <img
      src={img}
      alt={tripName}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <!-- Status badge -->
    <span
      class="absolute top-3 left-3 text-xs font-bold uppercase tracking-widest px-2.5 py-1 rounded-full"
      style={`background-color: ${badge.bg}; color: ${badge.color};`}
    >
      {badge.label}
    </span>
    {moreDates > 0 && (
      <span
        class="absolute top-3 right-3 text-xs font-semibold px-2.5 py-1 rounded-full"
        style="background: rgba(0,0,0,0.55); color: white; backdrop-filter: blur(4px);"
      >
        +{moreDates} more {moreDates === 1 ? 'date' : 'dates'}
      </span>
    )}
  </a>

  <!-- Card body -->
  <div class="flex flex-col flex-1 p-5">
    <h3 class="text-lg font-bold leading-snug mb-1" style="font-family: var(--font-display); color: var(--color-navy);">
      <a href={`/trips/${slug}/`} class="hover:opacity-80 transition-opacity">{tripName}</a>
    </h3>

    {desc && (
      <p class="text-sm leading-relaxed mb-3 line-clamp-2" style="color: var(--color-gray-text);">{desc}</p>
    )}

    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-4 text-xs" style="color: var(--color-gray-text);">
      {location && (
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          {location}
        </span>
      )}
      {duration && (
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {duration}
        </span>
      )}
    </div>

    {displayDate && (
      <p class="text-xs font-medium mb-3" style="color: var(--color-navy);">{displayDate}</p>
    )}

    <!-- Spots progress bar -->
    {totalSpots && spotsLeft !== null && !isSoldOut && (
      <div class="mb-4">
        <div class="flex justify-between text-xs mb-1.5" style="color: var(--color-gray-text);">
          <span>{bookedSpots}/{totalSpots} booked</span>
          <span style={spotsLeft <= 4 ? 'color: var(--color-coral); font-weight: 600;' : ''}>{spotsLeft} spots left</span>
        </div>
        <div class="w-full h-1.5 rounded-full overflow-hidden" style="background-color: var(--color-peach);">
          <div
            class="h-full rounded-full transition-all duration-300"
            style={`width: ${Math.min(100, (bookedSpots / totalSpots) * 100)}%; background-color: ${spotsLeft <= 4 ? 'var(--color-coral)' : 'var(--color-navy)'};`}
          ></div>
        </div>
      </div>
    )}

    <!-- Bottom row -->
    <div class="mt-auto flex items-center justify-between pt-4 border-t" style="border-color: var(--color-peach);">
      {formattedPrice && (
        <div>
          <span class="text-xl font-bold" style="font-family: var(--font-display); color: var(--color-coral);">{formattedPrice}</span>
          <span class="text-xs ml-1" style="color: var(--color-gray-text);">/ person</span>
        </div>
      )}
      <a
        href={`/trips/${slug}/`}
        class="font-semibold text-sm px-4 py-2 rounded-full transition-all hover:opacity-90"
        style={isSoldOut
          ? 'background-color: #f3f4f6; color: var(--color-gray-text);'
          : 'background-color: var(--color-cta); color: white;'}
      >
        {isSoldOut ? 'Sold out' : hasMultipleBatches ? 'View dates →' : 'View trip →'}
      </a>
    </div>
  </div>
</article>
