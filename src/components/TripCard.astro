---
import type { ResolvedDeparture } from '../lib/trips';
import { formatDepartureRange, getDepartureSummary } from '../lib/departureSummary';
import DiscountCountdown from './DiscountCountdown';

interface Props {
  slug: string;
  title?: string;
  name?: string;
  coverImage?: string | null;
  featuredImage?: string | null;
  description?: string;
  shortDescription?: string;
  location?: string | null;
  duration?: string | null;
  fromPrice?: number | null;
  originalFromPrice?: number | null;
  discountEndsAt?: string | null;
  multiPrice?: boolean;
  spotsLeft?: number | null;
  soldOut?: boolean;
  hasComingSoon?: boolean;
  allComingSoon?: boolean;
  departures?: ResolvedDeparture[];
}

const {
  slug,
  title,
  name,
  coverImage,
  featuredImage,
  description,
  shortDescription,
  location,
  duration,
  fromPrice = null,
  originalFromPrice = null,
  discountEndsAt = null,
  multiPrice = false,
  spotsLeft = null,
  soldOut = false,
  hasComingSoon = false,
  allComingSoon = false,
  departures = [],
} = Astro.props;

const tripName = title || name || slug;
const img = coverImage || featuredImage || 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&auto=format&fit=crop&q=80';
const cardImageAlt = `${tripName} group trip${location && !tripName.toLowerCase().includes(location.toLowerCase()) ? ` in ${location}` : ''}`;

const formattedPrice = fromPrice != null ? `₹${fromPrice.toLocaleString('en-IN')}` : null;
const isSoldOut = soldOut;
// One capacity signal, only when stock is low.
const showLowStock = !isSoldOut && spotsLeft != null && spotsLeft <= 3;
const departureSummary = getDepartureSummary(departures);
---

<article
  data-testid="trip-card"
  data-card-skeleton
  class="trip-card-shell group flex h-full w-full flex-col overflow-hidden rounded-3xl bg-white transition-all hover:-translate-y-0.5"
  style="box-shadow: 0 4px 30px -12px rgba(27,43,58,0.18);"
>
  <!-- Cover image -->
  <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
    <a href={`/trips/${slug}/`} class="block h-full">
      <img
        data-skeleton-image
        src={img}
        alt={cardImageAlt}
        width="800"
        height="600"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
    </a>
    {duration && (
      <span
        class="pointer-events-none absolute left-3 top-3 rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-white"
        style="background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);"
      >
        {duration}
      </span>
    )}
    {departureSummary.displayed.length > 0 && (
      <div data-testid="card-departure-summary" aria-label="Upcoming departures" class="pointer-events-none absolute inset-x-3 bottom-3 flex flex-col items-start gap-1.5">
        <span class="rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white" style="background: rgba(0,0,0,0.45); backdrop-filter: blur(4px);">Departures</span>
        <div class="flex min-w-0 flex-wrap items-stretch gap-1.5">
          {departureSummary.displayed.map((departure) => (
            <span
              data-sold-out={String(departure.soldOut)}
              data-coming-soon={String(departure.comingSoon)}
              class:list={[
                'flex flex-none flex-col justify-center rounded-lg px-2.5 py-1.5 text-xs font-semibold leading-tight text-white shadow-md backdrop-blur-sm',
                departure.soldOut ? 'border border-white/20 bg-[#1B2B3A]/60 opacity-70'
                  : departure.comingSoon ? 'border border-white/20 bg-[#1B2B3A]/70' : '',
              ]}
              style={departure.soldOut || departure.comingSoon ? undefined : 'background-color: var(--color-cta);'}
            >
              <span class:list={{ 'line-through': departure.soldOut }}>{formatDepartureRange(departure.startDate, departure.endDate)}</span>
              {departure.soldOut ? <span class="mt-0.5 text-[10px] text-white/75">Sold out</span>
                : departure.comingSoon ? <span class="mt-0.5 text-[10px] text-white/75">Coming soon</span> : null}
            </span>
          ))}
          {departureSummary.moreAvailable > 0 && (
            <span class="flex flex-none items-center rounded-lg bg-[#1B2B3A]/80 px-2 text-xs font-semibold text-white backdrop-blur-sm">+{departureSummary.moreAvailable} more</span>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Card body -->
  <div class="flex flex-1 flex-col gap-5 p-6">
    <div data-testid="trip-card-summary" class="trip-card-summary flex items-start justify-between gap-4">
      <div data-testid="trip-card-info" class="min-w-0">
        <a href={`/trips/${slug}/`}>
          <h3 data-testid="trip-card-title" class="font-display text-2xl leading-tight transition-colors group-hover:text-[color:var(--color-coral)]" style="color: var(--color-navy);">{tripName}</h3>
        </a>
        {location && (
          <p data-testid="trip-card-location" class="mt-2 inline-flex items-center gap-1.5 text-sm" style="color: var(--color-gray-text);">
            <svg class="h-4 w-4" style="color: var(--color-coral);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            {location}
          </p>
        )}
      </div>
      <div data-testid="trip-card-price" class="trip-card-price shrink-0 text-right">
        {allComingSoon && formattedPrice == null ? (
          <p class="font-display text-2xl leading-none" style="color: var(--color-coral);">Coming soon</p>
        ) : (
          <>
            {originalFromPrice != null && (
              <p class="text-sm leading-none line-through" style="color: var(--color-gray-text);">₹{originalFromPrice.toLocaleString('en-IN')}</p>
            )}
            <p class="font-display text-2xl leading-none" style="color: var(--color-coral);">{multiPrice && formattedPrice ? <span class="text-xs font-sans align-middle" style="color: var(--color-gray-text);">from </span> : null}{formattedPrice ?? '—'}</p>
            <p class="mt-1.5 text-xs" style="color: var(--color-gray-text);">per person</p>
            {originalFromPrice != null && discountEndsAt && (
              <DiscountCountdown endsAt={discountEndsAt} reloadOnExpire={true} className="mt-1 block text-[10px] font-semibold" client:load />
            )}
          </>
        )}
      </div>
    </div>

    {isSoldOut ? (
      <span class="mt-auto inline-flex cursor-not-allowed items-center justify-center rounded-full px-6 py-4 text-base font-medium" style="background-color: #e5e7eb; color: #9ca3af;">
        Sold out
      </span>
    ) : (
      <div class="mt-auto flex flex-col gap-2">
        <a
          href={`/trips/${slug}/`}
          class="inline-flex items-center justify-center rounded-full px-6 py-4 font-display text-base font-medium text-white transition-transform hover:-translate-y-0.5"
          style="background-color: var(--color-coral);"
        >
          View Details
        </a>
        {showLowStock ? (
          <p class="text-center text-xs" style="color: var(--color-coral);">Only {spotsLeft} spots left</p>
        ) : hasComingSoon ? (
          <p class="text-center text-xs" style="color: var(--color-coral);">New dates — wishlist inside</p>
        ) : null}
      </div>
    )}
  </div>
</article>

<style>
  .trip-card-shell {
    container-name: trip-card;
    container-type: inline-size;
  }

  @container trip-card (max-width: 420px) {
    .trip-card-summary {
      flex-direction: column;
      align-items: stretch;
    }

    .trip-card-price {
      display: flex;
      width: 100%;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.375rem 0.5rem;
      text-align: left;
    }

    .trip-card-price > :global(*) {
      margin-top: 0;
    }
  }
</style>
