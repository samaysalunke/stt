---
// Static India SVG map with destination pins.
// No external tile provider, no API key, no Leaflet, no GeoJSON parsed at runtime.
//
// The geometry and the projection both come from `src/lib/indiaMapGeometry.ts`,
// which `scripts/generate-india-map.mjs` emits. Importing `project()` from there
// rather than re-deriving it here is what keeps the pins registered to the
// coastline — read that generator's header before changing any of this.
import {
  INDIA_VIEWBOX,
  INDIA_MAINLAND,
  INDIA_ISLANDS,
  INDIA_STATE_BORDERS,
  project,
  withinIndia,
} from '../lib/indiaMapGeometry';

interface Pin {
  lat: number;
  lng: number;
  status: 'upcoming' | 'ongoing' | 'completed';
  label?: string;
}

interface Props {
  pins?: Pin[];
  class?: string;
}

const { pins = [], class: className = '' } = Astro.props;

// The interior hairlines are clipped to the landmass, so each instance on a page
// needs its own clip-path id.
const clipId = `india-land-${Math.random().toString(36).slice(2, 9)}`;

// Deduplicate pins to the same destination, then drop anything the projection
// puts off-canvas rather than letting it stack up against an edge.
const seen = new Map<string, Pin & { x: number; y: number }>();
for (const p of pins) {
  const key = `${Math.round(p.lat * 10)},${Math.round(p.lng * 10)}`;
  if (seen.has(key)) continue;
  const { x, y } = project(p.lat, p.lng);
  if (!withinIndia(x, y)) continue;
  seen.set(key, { ...p, x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 });
}
const uniquePins = Array.from(seen.values());
---

<svg
  viewBox={`0 0 ${INDIA_VIEWBOX.width} ${INDIA_VIEWBOX.height}`}
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-label="Map of India showing trip destinations"
  role="img"
>
  <defs>
    <clipPath id={clipId}>
      <path d={INDIA_MAINLAND} />
    </clipPath>
  </defs>

  <!-- Landmass: the claimed extent, filled. -->
  <path d={INDIA_MAINLAND} fill="rgba(245,221,215,0.35)" stroke="none" />
  {INDIA_ISLANDS.map((d) => (
    <path
      d={d}
      fill="rgba(245,221,215,0.35)"
      stroke="rgba(245,221,215,0.8)"
      stroke-width="0.6"
      stroke-linejoin="round"
    />
  ))}

  <!--
    Interior state hairlines. The state source stops short of the claimed
    northern extent, so it is clipped to the landmass above and never filled —
    the strip it omits simply carries no internal line.
  -->
  <g clip-path={`url(#${clipId})`}>
    <path
      d={INDIA_STATE_BORDERS}
      fill="none"
      stroke="rgba(245,221,215,0.55)"
      stroke-width="0.7"
      stroke-linejoin="round"
      stroke-linecap="round"
    />
  </g>

  <!-- Coastline drawn last of the land layers, so the hairlines never cross it. -->
  <path
    d={INDIA_MAINLAND}
    fill="none"
    stroke="rgba(245,221,215,0.9)"
    stroke-width="1.4"
    stroke-linejoin="round"
  />

  <!-- Destination pins -->
  {uniquePins.map((pin) => (
    pin.status === 'completed' ? (
      <circle cx={pin.x} cy={pin.y} r="6" fill="var(--color-coral)" stroke="white" stroke-width="1.5">
        {pin.label && <title>{pin.label}</title>}
      </circle>
    ) : (
      <circle cx={pin.x} cy={pin.y} r="5" fill="white" stroke="var(--color-coral)" stroke-width="2">
        {pin.label && <title>{pin.label}</title>}
      </circle>
    )
  ))}

  {uniquePins.length === 0 && (
    <text
      x={INDIA_VIEWBOX.width / 2}
      y={INDIA_VIEWBOX.height / 2}
      text-anchor="middle"
      font-size="14"
      fill="rgba(27,43,58,0.3)"
    >No destinations yet</text>
  )}
</svg>
