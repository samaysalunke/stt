---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import BackButton from '../components/BackButton.astro';
import Footer from '../components/Footer.astro';
import PageLoader from '../components/PageLoader.astro';
import '../styles/global.css';
import { readSiteSettings } from '../lib/content';
import { SITE_ORIGIN, siteUrl } from '../lib/siteUrl';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  imageAlt?: string;
  robots?: string;
  type?: 'website' | 'article';
  // Navigation model (matches the prototype):
  //  'scroll' — homepage scroll-reveal hamburger header
  //  'header' — sticky header with full hamburger (trips listing)
  //  'back'   — floating back arrow on inner pages (default)
  //  'logo'   — sticky header with logo only, no hamburger (trip detail)
  //  'none'   — page provides its own top bar (about, album detail)
  nav?: 'scroll' | 'header' | 'back' | 'logo' | 'none';
  backFallback?: string;
  // Hide the floating WhatsApp button (e.g. during the checkout flow).
  hideWhatsApp?: boolean;
}

const { title, description, image, imageAlt, canonical, robots, type = 'website', nav = 'back', backFallback = '/', hideWhatsApp = false } = Astro.props;
const isHome = nav === 'scroll';
const user = Astro.locals.user ?? null;

let settings: any = {};
try {
  settings = readSiteSettings();
} catch (e) {}

// Analytics: only load in production and never on admin pages (keeps local/preview
// traffic and admin sessions out of GA4 / Clarity). GA4 id is admin-managed via
// Settings, falling back to the built-in property; blank disables GA4.
const isAdminRoute = Astro.url.pathname.startsWith('/admin');
const analyticsEnabled = import.meta.env.PROD && !isAdminRoute;
const gaId = settings.googleAnalyticsId || '';
const clarityId = 'x2ms8bxixr';

const siteId = `${SITE_ORIGIN}/#website`;
const orgId = `${SITE_ORIGIN}/#organization`;
const founderId = `${SITE_ORIGIN}/about/#zahra-shakir`;
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite', '@id': siteId, name: 'Seek the Thrill',
      url: siteUrl('/'), publisher: { '@id': orgId }, inLanguage: 'en-IN',
    },
    {
      '@type': ['Organization', 'TravelAgency'], '@id': orgId, name: 'Seek the Thrill',
      alternateName: 'STT',
      url: siteUrl('/'), logo: siteUrl('/logo.jpg'),
      email: settings.email ?? 'zahra@seekthethrill.in',
      founder: { '@id': founderId },
      contactPoint: {
        '@type': 'ContactPoint', telephone: settings.phone ?? '+91-7975027491',
        contactType: 'customer service', areaServed: 'IN', availableLanguage: ['en'],
      },
      sameAs: [settings.instagram, settings.facebook, settings.youtube, settings.linkedin].filter(Boolean),
    },
    { '@type': 'Person', '@id': founderId, name: 'Zahra Shakir', url: siteUrl('/about/'), worksFor: { '@id': orgId } },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('card-skeletons-active');</script>
    {settings.googleSiteVerification && <meta name="google-site-verification" content={settings.googleSiteVerification} />}
    {settings.bingSiteVerification && <meta name="msvalidate.01" content={settings.bingSiteVerification} />}

    <!-- Fonts: Fraunces (display) + DM Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/atom+xml" title="Seek the Thrill — Upcoming Trips" href="/feed.xml" />

    <SEO {title} {description} {image} {imageAlt} {canonical} {robots} {type} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <slot name="head" />

    {analyticsEnabled && gaId && (
      <>
        <!-- Google tag (gtag.js) -->
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    {analyticsEnabled && (
      <!-- Microsoft Clarity -->
      <script type="text/javascript" is:inline define:vars={{ clarityId }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col" style="background-color: var(--color-gray-soft); color: var(--color-navy);">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
      style="background-color: var(--color-cta);"
    >
      Skip to content
    </a>
    <PageLoader />
    {nav === 'scroll' && <Header hidden={true} user={user} />}
    {nav === 'header' && <Header user={user} />}
    {nav === 'logo' && <Header logoOnly={true} user={user} />}
    {nav === 'back' && <BackButton fallback={backFallback} />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {/* Footer on every page except 'none' (checkout / about own their full chrome).
        This keeps Terms / Privacy / Cancellation, the sitemap, and newsletter
        reachable site-wide instead of only on the homepage. */}
    {nav !== 'none' && <Footer />}

    <!-- WhatsApp Floating Button (not on the homepage, matching the prototype) -->
    {!isHome && !hideWhatsApp && (
    <a
      href={`https://wa.me/${(settings.phone ?? '+917975027491').replace(/[^0-9]/g, '')}?text=Hi%2C%20I%27m%20interested%20in%20a%20trip%20with%20Seek%20the%20Thrill!`}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-24 right-5 lg:bottom-5 z-40 w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-200"
      style="background:#25D366;"
      title="Chat with us on WhatsApp"
      aria-label="Chat with us on WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="28" height="28" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
    )}

    <script>
      const initializeCardSkeletons = () => {
        document.querySelectorAll<HTMLElement>('[data-card-skeleton]').forEach((card) => {
          if (card.hasAttribute('data-skeleton-ready')) return;
          const marker = card.querySelector<HTMLElement>('[data-skeleton-image]');
          const image = marker instanceof HTMLImageElement ? marker : marker?.querySelector<HTMLImageElement>('img');
          const reveal = () => {
            card.setAttribute('data-skeleton-ready', '');
            window.clearTimeout(failSafe);
          };
          const failSafe = window.setTimeout(reveal, 2500);

          if (!image) {
            reveal();
            return;
          }
          if (image.complete) reveal();
          else {
            image.addEventListener('load', reveal, { once: true });
            image.addEventListener('error', reveal, { once: true });
          }
          card.addEventListener('pointerdown', reveal, { once: true, passive: true });
          card.addEventListener('focusin', reveal, { once: true });
        });
      };
      initializeCardSkeletons();

      const reveals = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );
      reveals.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
