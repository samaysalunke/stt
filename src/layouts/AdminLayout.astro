---
import '../styles/global.css';
import { isEmailConfigured } from '../lib/email';

interface Props {
  title: string;
  page?: 'dashboard' | 'trips' | 'registrations' | 'photo-vault' |
         'testimonials' | 'faqs' | 'newsletter' | 'contacts' | 'broadcast' | 'settings' |
         'roles' | 'audit';
}

const { title, page } = Astro.props;
const adminUser = Astro.locals.adminUser;

// Email silently no-ops when SMTP isn't set — warn the admin so confirmations
// and broadcasts aren't assumed to be sending when they aren't.
const emailConfigured = isEmailConfigured();

const navItems = [
  { href: '/admin/',              label: 'Dashboard',       key: 'dashboard',
    icon: 'M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z' },
  { href: '/admin/trips/',        label: 'Trip Management', key: 'trips',
    icon: 'M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z' },
  { href: '/admin/registrations/', label: 'Registrations',  key: 'registrations',
    icon: 'M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z' },
  { href: '/admin/photo-vault/',  label: 'Photo Vault',     key: 'photo-vault',
    icon: 'M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25z' },
  { href: '/admin/testimonials/', label: 'Testimonials',     key: 'testimonials',
    icon: 'M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z' },
  { href: '/admin/faqs/',         label: 'FAQ',              key: 'faqs',
    icon: 'M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z' },
  { href: '/admin/newsletter/',   label: 'Newsletter',      key: 'newsletter',
    icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75' },
  { href: '/admin/contacts/',     label: 'Contacts',        key: 'contacts',
    icon: 'M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z' },
  { href: '/admin/broadcast/',    label: 'Broadcast',       key: 'broadcast',
    icon: 'M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73' },
  { href: '/admin/settings/',     label: 'Settings',        key: 'settings',
    icon: 'M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z',
    ownerOnly: false },
];

// Owner-only items appended dynamically below
const ownerNavItems = adminUser?.role === 'owner' ? [
  { href: '/admin/settings/roles', label: 'Roles',       key: 'roles',
    icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z' },
  { href: '/admin/audit',          label: 'Audit Log',   key: 'audit',
    icon: 'M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z' },
] : [];

const allNavItems = [...navItems, ...ownerNavItems];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Seek the Thrill Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen" style="background-color: var(--color-gray-soft); color: var(--color-navy); font-family: var(--font-sans);">

    <!-- Top bar (fixed) -->
    <header class="fixed top-0 left-0 right-0 z-40 px-5 sm:px-6 py-3 flex items-center justify-between"
            style="background: rgba(255,255,255,0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(245,221,215,0.6);">
      <div class="flex items-center gap-3">
        <button id="menu-toggle" aria-label="Open menu" aria-expanded="false"
                class="w-10 h-10 rounded-xl flex items-center justify-center"
                style="background: rgba(27,43,58,0.05); color: var(--color-navy);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5" />
          </svg>
        </button>
        <div class="leading-none">
          <h1 class="font-display text-base sm:text-lg font-semibold leading-none">{title}</h1>
          <span class="text-[10px] font-semibold uppercase tracking-widest"
                style="color: var(--color-coral);">Admin Portal</span>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="relative">
          <svg class="w-5 h-5" style="color: var(--color-navy); opacity: 0.6;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
          </svg>
          <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full border-2 border-white"
                style="background: var(--color-coral);"></span>
        </div>
        <img src="/logo.jpg" alt="STT" class="w-8 h-8 rounded-full object-cover" style="border: 1px solid var(--color-peach);" />
      </div>
    </header>

    <!-- Sidebar overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
         style="background: rgba(27,43,58,0.4); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);"></div>

    <!-- Sidebar drawer -->
    <aside id="sidebar"
           class="fixed top-0 left-0 z-50 h-full w-72 flex flex-col -translate-x-full transition-transform duration-300 shadow-2xl"
           style="background: var(--color-white);">
      <div class="flex items-center justify-between px-5 h-16 border-b" style="border-color: rgba(245,221,215,0.6);">
        <a href="/admin/" class="flex items-center gap-2.5">
          <img src="/logo.jpg" alt="Seek the Thrill" class="h-9 w-auto rounded-lg" />
          <span class="font-display font-semibold text-sm" style="color: var(--color-navy);">Seek the Thrill</span>
        </a>
        <button id="sidebar-close" aria-label="Close menu"
                class="w-8 h-8 rounded-lg flex items-center justify-center"
                style="color: var(--color-navy); opacity: 0.6;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4 flex flex-col gap-1">
        {allNavItems.map(item => {
          const active = page === item.key;
          return (
            <a href={item.href}
               class="flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium transition-colors"
               style={active
                 ? 'background: rgba(232,114,90,0.10); color: var(--color-coral); font-weight: 600;'
                 : 'color: rgba(27,43,58,0.6);'}>
              <svg class="w-5 h-5 flex-none" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="px-4 py-4 border-t" style="border-color: rgba(245,221,215,0.6);">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-full grid place-items-center font-display font-bold text-white text-sm"
               style="background: var(--color-coral);">
            {(adminUser?.displayName ?? adminUser?.email ?? 'A')[0].toUpperCase()}
          </div>
          <div class="leading-tight">
            <p class="text-sm font-semibold" style="color: var(--color-navy);">
              {adminUser?.displayName ?? adminUser?.email ?? 'Admin'}
            </p>
            <p class="text-[11px]" style="color: rgba(27,43,58,0.5);">{adminUser?.role ?? ''}</p>
          </div>
        </div>
        <form method="POST" action="/api/admin/logout">
          <button type="submit"
                  class="w-full text-center text-sm font-medium py-2.5 rounded-full transition-colors"
                  style="color: var(--color-navy); border: 1px solid var(--color-peach);">
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <!-- Page content -->
    <main class="pt-24 pb-12 px-5 sm:px-6" style="max-width: 1200px; margin: 0 auto;">
      {!emailConfigured && (
        <div class="mb-6 flex items-start gap-3 rounded-xl px-4 py-3"
             style="background: #FEF3C7; border: 1px solid #FCD34D; color: #92400E;">
          <svg class="w-5 h-5 flex-none mt-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          <div class="text-sm leading-relaxed">
            <strong>Email is not configured.</strong> Registration confirmations, status emails, and broadcasts are
            <strong>not being sent</strong> — they're only logged to the server console. Set <code>SMTP_HOST</code>,
            <code>SMTP_USER</code>, and <code>SMTP_PASS</code> in the production environment to enable email.
          </div>
        </div>
      )}
      <slot />
    </main>

    <style>
      /* ===== Carried-over utility classes (retinted coral) used by not-yet-restyled pages ===== */
      button { transition: all 0.15s ease; }

      input:focus, select:focus, textarea:focus {
        outline: 2px solid var(--color-coral) !important;
        outline-offset: -1px;
      }

      .reg-row:hover, .contact-row:hover {
        background: rgba(232,114,90,0.05) !important;
        transition: background 0.12s;
      }

      .trip-group-header { transition: filter 0.15s; }
      .trip-group-header:hover { filter: brightness(0.97); }

      .trip-chevron { transition: transform 0.2s ease; display: inline-block; }
      .trip-group.collapsed .trip-chevron { transform: rotate(-90deg); }

      @media (max-width: 768px) {
        .detail-panel-grid { grid-template-columns: 1fr !important; }
      }
    </style>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const closeBtn = document.getElementById('sidebar-close');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');

      function openSidebar() {
        sidebar!.classList.remove('-translate-x-full');
        overlay!.classList.remove('opacity-0', 'pointer-events-none');
        toggle!.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeSidebar() {
        sidebar!.classList.add('-translate-x-full');
        overlay!.classList.add('opacity-0', 'pointer-events-none');
        toggle!.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      toggle?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      overlay?.addEventListener('click', closeSidebar);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSidebar();
      });
    </script>
  </body>
</html>
