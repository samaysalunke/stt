---
import BaseLayout from '../layouts/BaseLayout.astro';

const founderImg = 'https://images.unsplash.com/photo-1543269865-cbf427effbad?w=900&auto=format&fit=crop&q=80';

const principles = [
  { n: '01', t: 'Real People', d: 'No professional guides. Just local legends who know the land better than any map.' },
  { n: '02', t: 'Hidden Spots', d: "We go where the big buses can't fit. Private trails and secret stays are our specialty." },
  { n: '03', t: 'Zero Fluff', d: 'No forced stopping spots. No generic itineraries. Just raw, unfiltered adventure.' },
];
---

<BaseLayout
  title="Our Story — Seek the Thrill"
  description="I'm Zahra. I built Seek the Thrill from one scary yes."
  hideHeader={true}
>
  <main style="background-color: var(--color-blush);">
    <!-- Top bar -->
    <header class="mx-auto flex max-w-2xl items-center justify-between px-5 pt-5">
      <a href="/" id="about-back" aria-label="Back" class="grid h-9 w-9 place-items-center rounded-full transition-colors hover:bg-white/70" style="color: var(--color-navy);">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </a>
      <span class="text-[11px] uppercase tracking-[0.25em]" style="color: rgba(27,43,58,0.55);">
        by <span class="font-display italic normal-case tracking-normal" style="color: var(--color-coral);">Zahra</span>
      </span>
      <button id="about-share" aria-label="Share" class="grid h-9 w-9 place-items-center rounded-full transition-colors hover:bg-white/70" style="color: var(--color-navy);">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
        </svg>
      </button>
    </header>

    <!-- Portrait + caption card -->
    <section class="mx-auto mt-6 max-w-2xl px-5">
      <div class="relative">
        <img src={founderImg} alt="Zahra" class="aspect-[4/5] w-full rounded-sm object-cover" loading="lazy" />
        <div class="absolute -bottom-6 left-1/2 w-[88%] -translate-x-1/2 rounded-md bg-white px-5 py-4 text-center" style="box-shadow: 0 10px 30px -12px rgba(15,23,42,0.25);">
          <p class="font-display text-xl leading-snug" style="color: var(--color-navy);">The Tour Industry is Broken.</p>
        </div>
      </div>
    </section>

    <!-- Pull quote -->
    <section class="mx-auto max-w-2xl px-8 pt-16 pb-6">
      <blockquote class="font-display italic leading-snug" style="font-size: 1.35rem; color: var(--color-navy);">
        "I spent years watching people travel thousands of miles just to see the same gift shops and eat at the same 'tourist-friendly' buffets."
      </blockquote>
    </section>

    <!-- Body paragraphs -->
    <section class="mx-auto max-w-2xl space-y-5 px-8 pb-12 text-[15px] leading-relaxed" style="color: rgba(27,43,58,0.85);">
      <p>
        I started <span class="font-medium" style="color: var(--color-coral);">Seek the Thrill</span> because I was tired of the fluff. I wanted the dust of the mountain roads, the taste of a home-cooked meal in a village that isn't on Google Maps, and the silence of a valley at dawn.
      </p>
      <p>
        Travel should change you. It shouldn't just be a checklist of monuments. It should be about the people you meet and the stories that don't make it to the brochure.
      </p>
    </section>

    <!-- Dark principles block -->
    <section style="background-color: var(--color-navy);">
      <div class="mx-auto max-w-2xl px-8 py-14 text-white">
        <h2 class="text-center font-display text-3xl leading-tight">How we do it<br />differently</h2>
        <div class="mt-10 space-y-9 text-center">
          {principles.map((p) => (
            <div>
              <p class="font-display text-3xl italic" style="color: var(--color-coral);">{p.n}.</p>
              <p class="mt-2 font-display text-lg text-white">{p.t}</p>
              <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/65">{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Signature -->
    <section class="mx-auto max-w-2xl px-8 py-14 text-center">
      <p class="text-[15px] leading-relaxed" style="color: rgba(27,43,58,0.8);">
        If you're looking for a holiday, there are plenty of apps for that. If you're looking for a journey that sticks to your soul, come with us.
      </p>
      <p class="mt-10 text-[10px] uppercase tracking-[0.3em]" style="color: rgba(27,43,58,0.55);">With love &amp; grit,</p>
      <p class="mt-3 font-display text-5xl italic" style="color: var(--color-coral);">Zahra</p>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-2xl px-5 pb-12">
      <a href="/trips/" class="flex w-full items-center justify-center gap-2 rounded-full px-6 py-4 text-base font-medium text-white" style="background-color: var(--color-coral);">
        Explore Zahra's Trips
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  // Back: use history when possible, else fall back to the home link's href.
  const back = document.getElementById('about-back');
  back?.addEventListener('click', (e) => {
    if (window.history.length > 1) {
      e.preventDefault();
      window.history.back();
    }
  });
  // Share: Web Share API where available, else copy the URL.
  const share = document.getElementById('about-share');
  share?.addEventListener('click', async () => {
    const url = window.location.href;
    if (navigator.share) {
      try { await navigator.share({ title: 'Seek the Thrill — Our Story', url }); } catch {}
    } else {
      try { await navigator.clipboard.writeText(url); } catch {}
    }
  });
</script>
