---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT_DEFAULTS } from '../lib/aboutDefaults';
import { buildBreadcrumb } from '../lib/breadcrumbs';
import { readSiteSettings } from '../lib/content';
import { siteUrl } from '../lib/siteUrl';

export const prerender = false;

let s: any = {};
try { s = readSiteSettings(); } catch {}

const pick = (v: unknown, d: string) => (typeof v === 'string' && v.trim()) ? v.trim() : d;

const founderImg = pick(s.aboutFounderImage, ABOUT_DEFAULTS.founderImage);
const bylineName = pick(s.aboutBylineName, ABOUT_DEFAULTS.bylineName);
const caption = pick(s.aboutCaption, ABOUT_DEFAULTS.caption);
const quote = pick(s.aboutQuote, ABOUT_DEFAULTS.quote);
const bodyParas = pick(s.aboutBody, ABOUT_DEFAULTS.body).split(/\n\s*\n/).map((p: string) => p.trim()).filter(Boolean);
const principlesHeading = pick(s.aboutPrinciplesHeading, ABOUT_DEFAULTS.principlesHeading);
const principlesSrc = (Array.isArray(s.aboutPrinciples) && s.aboutPrinciples.length > 0) ? s.aboutPrinciples : ABOUT_DEFAULTS.principles;
const principles = principlesSrc.map((p: any, i: number) => ({ n: String(i + 1).padStart(2, '0'), t: p.title, d: p.desc }));
const signature = pick(s.aboutSignature, ABOUT_DEFAULTS.signature);
const signoff = pick(s.aboutSignoff, ABOUT_DEFAULTS.signoff);
const signName = pick(s.aboutSignName, ABOUT_DEFAULTS.signName);
const ctaLabel = pick(s.aboutCtaLabel, ABOUT_DEFAULTS.ctaLabel);
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumb([{ name: 'Our Story', path: '/about/' }]),
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl('/about/')}#profile-page`,
      url: siteUrl('/about/'),
      mainEntity: { '@id': `${siteUrl('/about/')}#zahra-shakir` },
      about: { '@id': `${siteUrl('/')}#organization` },
    },
  ],
};
---

<BaseLayout
  title="Our Story — Seek the Thrill"
  description="I'm Zahra. I built Seek the Thrill from one scary yes."
  nav="none"
>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} /></Fragment>
  <div class="bg-blush">
    <!-- Top bar -->
    <header class="mx-auto flex max-w-2xl items-center justify-between px-5 pt-5">
      <a href="/" id="about-back" aria-label="Back" class="grid h-9 w-9 place-items-center rounded-[var(--radius-pill)] text-navy transition-colors hover:bg-white/70">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </a>
      <span class="text-[11px] uppercase tracking-[0.25em] text-gray-text">
        by <span class="font-display italic normal-case tracking-normal text-coral-ink">{bylineName}</span>
      </span>
      <button id="about-share" aria-label="Share" class="grid h-9 w-9 place-items-center rounded-[var(--radius-pill)] text-navy transition-colors hover:bg-white/70">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
        </svg>
      </button>
    </header>

    <!-- Portrait + caption card -->
    <section class="mx-auto mt-6 max-w-2xl px-5">
      <div class="relative">
        <img src={founderImg} alt={bylineName} class="aspect-[4/5] w-full rounded-sm object-cover" loading="lazy" />
        <div class="absolute -bottom-6 left-1/2 w-[88%] -translate-x-1/2 rounded-md bg-white px-5 py-4 text-center shadow-media">
          <h1 class="font-display text-display-xs leading-snug text-navy">{caption}</h1>
        </div>
      </div>
    </section>

    <!-- Pull quote -->
    <section class="mx-auto max-w-2xl px-8 pt-16 pb-6">
      <blockquote class="font-display italic leading-snug text-display-xs text-navy">
        &ldquo;{quote}&rdquo;
      </blockquote>
    </section>

    <!-- Body paragraphs -->
    <section class="mx-auto max-w-2xl space-y-5 px-8 pb-12 text-[15px] leading-relaxed text-navy/85">
      {bodyParas.map((p: string) => <p>{p}</p>)}
    </section>

    <!-- Dark principles block -->
    <section class="bg-navy">
      <div class="mx-auto max-w-2xl px-8 py-14 text-white">
        <h2 class="text-center font-display text-display-md leading-tight">{principlesHeading}</h2>
        <div class="mt-10 space-y-9 text-center">
          {principles.map((p) => (
            <div>
              <p class="font-display text-display-md italic text-coral">{p.n}.</p>
              <p class="mt-2 font-display text-lg text-white">{p.t}</p>
              <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-white/65">{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Signature -->
    <section class="mx-auto max-w-2xl px-8 py-14 text-center">
      <p class="text-[15px] leading-relaxed text-navy/80">
        {signature}
      </p>
      <p class="mt-10 text-[10px] uppercase tracking-[0.3em] text-gray-text">{signoff}</p>
      <p class="mt-3 font-display text-5xl italic text-coral-ink">{signName}</p>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-2xl px-5 pb-12">
      <a href="/trips/" class="flex w-full items-center justify-center gap-2 rounded-[var(--radius-pill)] bg-cta px-6 py-4 text-base font-medium text-white">
        {ctaLabel}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>

<script>
  // Back: use history when possible, else fall back to the home link's href.
  const back = document.getElementById('about-back');
  back?.addEventListener('click', (e) => {
    if (window.history.length > 1) {
      e.preventDefault();
      window.history.back();
    }
  });
  // Share: Web Share API where available, else copy the URL.
  const share = document.getElementById('about-share');
  share?.addEventListener('click', async () => {
    const url = window.location.href;
    if (navigator.share) {
      try { await navigator.share({ title: 'Seek the Thrill — Our Story', url }); } catch {}
    } else {
      try { await navigator.clipboard.writeText(url); } catch {}
    }
  });
</script>
