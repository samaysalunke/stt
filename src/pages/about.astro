---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readSiteSettings } from '../lib/content';

let settings: any = {};
try {
  settings = readSiteSettings();
} catch (e) {}

const stats = [
  { value: settings.tripsCompleted ?? 25, label: 'Trips run' },
  { value: settings.happyTravelers ?? 500, label: 'Travellers' },
  { value: settings.destinationsCovered ?? 15, label: 'Destinations' },
  { value: settings.yearsOfAdventure ?? 4, label: 'Years in' },
];

const founderImg = 'https://images.unsplash.com/photo-1543269865-cbf427effbad?w=900&auto=format&fit=crop&q=80';

const principles = [
  { title: 'Small groups, always', desc: 'Twelve to sixteen people. Big enough for a crowd, small enough that nobody disappears.' },
  { title: 'Offbeat over obvious', desc: 'We go where the buses don\'t. The places you can\'t google your way through.' },
  { title: 'Safety, quietly handled', desc: 'Experienced leads, real plans, backups for the backups. You shouldn\'t have to think about it.' },
  { title: 'Real moments, no fluff', desc: 'No forced fun, no rigid schedules. Just good routes and the room to actually be there.' },
];
---

<BaseLayout
  title="Our Story — Seek the Thrill"
  description="Why Seek the Thrill exists — a note from founder Zahra on small groups, offbeat routes, and the kind of trips worth talking about for years."
  hideHeader={true}
>
  <!-- Minimal top: back arrow only (no site nav — this is a focused editorial page) -->
  <div class="container-app pt-6">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-medium" style="color: var(--color-navy);">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      Back to home
    </a>
  </div>

  <!-- Intro -->
  <section class="container-app pt-10 lg:pt-16">
    <div class="max-w-3xl">
      <span class="reveal text-xs font-bold uppercase tracking-widest" style="color: var(--color-coral);">Our story</span>
      <h1 class="reveal text-4xl md:text-5xl lg:text-6xl font-bold mt-3 leading-tight" style="font-family: var(--font-display); color: var(--color-navy);">
        I started this because the trips I wanted <span style="color: var(--color-coral); font-style: italic;">didn't exist.</span>
      </h1>
    </div>
  </section>

  <!-- Portrait + body -->
  <section class="container-app py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-10 lg:gap-16 items-start">
      <!-- Portrait with floating card -->
      <div class="reveal relative lg:sticky lg:top-24">
        <img
          src={founderImg}
          alt="Zahra, founder of Seek the Thrill"
          class="w-full rounded-3xl object-cover shadow-xl"
          style="aspect-ratio: 4/5;"
          loading="lazy"
        />
        <div class="absolute -bottom-5 -right-3 sm:right-6 lg:-right-5 bg-white rounded-2xl px-5 py-4 shadow-lg" style="border: 1px solid var(--color-peach);">
          <div class="font-display text-2xl font-bold" style="color: var(--color-coral);">Since 2020</div>
          <div class="text-xs" style="color: var(--color-gray-text);">One trip at a time</div>
        </div>
      </div>

      <!-- Body text -->
      <div class="reveal pt-6 lg:pt-0">
        <div class="space-y-5 text-base lg:text-lg leading-relaxed" style="color: var(--color-navy);">
          <p>
            In 2020, stuck inside like everyone else, I kept making the same list — the places I'd go the second we could leave. Not the postcard spots. The quiet valleys, the long drives, the towns nobody had turned into a checklist yet.
          </p>
          <p>
            The problem was, the trips on offer were either luxury packages I couldn't justify, or going completely alone. There was nothing in between for someone who wanted the real thing without the price tag or the solitude.
          </p>
          <p>
            So I organised one myself. Eight of us, a rough plan, Rishikesh. It worked better than it had any right to — and the people I met on it I still talk to every week. That trip became the whole idea: small groups, offbeat routes, and enough room to actually be somewhere instead of rushing through it.
          </p>
          <p>
            We've run a lot of them since. The format hasn't changed much, because it didn't need to.
          </p>
        </div>

        <!-- Pull quote -->
        <blockquote class="reveal mt-9 pl-5 border-l-4" style="border-color: var(--color-coral);">
          <p class="text-2xl lg:text-3xl leading-snug" style="font-family: var(--font-display); font-style: italic; color: var(--color-navy);">
            We don't sell destinations. We make the kind of trips you talk about for years.
          </p>
        </blockquote>

        <!-- Signature -->
        <div class="reveal mt-8">
          <p class="font-display text-xl" style="color: var(--color-navy);">— Zahra</p>
          <p class="text-sm" style="color: var(--color-gray-text);">Founder &amp; trip lead, Seek the Thrill</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles (navy block) -->
  <section class="py-16 lg:py-24" style="background-color: var(--color-navy);">
    <div class="container-app">
      <h2 class="reveal text-3xl lg:text-4xl font-bold text-white mb-10 lg:mb-14" style="font-family: var(--font-display);">
        What we hold to
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10">
        {principles.map((p, i) => (
          <div class="reveal">
            <div class="font-display text-2xl font-bold mb-2" style="color: var(--color-coral);">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="text-lg font-bold text-white mb-2" style="font-family: var(--font-display);">{p.title}</h3>
            <p class="text-sm lg:text-base leading-relaxed text-white/70">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-14 lg:py-20" style="background-color: var(--color-blush);">
    <div class="container-app">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 text-center">
        {stats.map((s) => (
          <div class="reveal">
            <div class="text-4xl lg:text-5xl font-bold mb-2" style="color: var(--color-coral); font-family: var(--font-display);">
              {s.value}+
            </div>
            <div class="text-sm lg:text-base font-medium" style="color: var(--color-navy);">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24" style="background-color: var(--color-gray-soft);">
    <div class="container-app text-center max-w-xl mx-auto">
      <h2 class="reveal text-3xl lg:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-navy);">
        Come find your people.
      </h2>
      <p class="reveal text-base mb-8 leading-relaxed" style="color: var(--color-gray-text);">
        The next batch is probably already filling. Take a look at where we're headed.
      </p>
      <a href="/trips/" class="reveal inline-flex items-center gap-2 font-semibold text-white px-9 py-4 rounded-full text-base transition-all hover:opacity-90" style="background-color: var(--color-cta);">
        Explore trips →
      </a>
    </div>
  </section>
</BaseLayout>
