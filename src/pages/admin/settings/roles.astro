---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAdminUsers, getUserRoles } from '../../../lib/admin-session';
import { listTrips } from '../../../lib/content';
export const prerender = false;

const adminUser = Astro.locals.adminUser;
if (!adminUser || adminUser.role !== 'owner') {
  return Astro.redirect('/admin/');
}

const adminUsers = listAdminUsers();
const trips = listTrips().map((t: any) => ({ slug: t.slug, name: t.title || t.name || t.slug }));

const saved   = Astro.url.searchParams.get('saved')   === '1';
const removed = Astro.url.searchParams.get('removed') === '1';
const error   = Astro.url.searchParams.get('error');
---

<AdminLayout title="Role Management" page="settings">
  <div class="mb-6">
    <h1 class="text-2xl font-bold font-display text-navy">Role Management</h1>
    <p class="text-sm mt-1 text-gray-text">Control who can access the admin panel and what they can do.</p>
  </div>

  {saved && (
    <div class="rounded-2xl px-4 py-3 mb-6 text-sm flex items-center gap-2 bg-success/10 text-success">
      Role assigned successfully.
    </div>
  )}
  {removed && (
    <div class="rounded-2xl px-4 py-3 mb-6 text-sm bg-success/10 text-success">
      Role removed.
    </div>
  )}
  {error && (
    <div class="rounded-2xl px-4 py-3 mb-6 text-sm bg-[#FEF2F2] border border-[#FECACA] text-[#DC2626]">
      {error === 'last_owner' ? "Can't remove the last owner." :
       error === 'self'       ? "Can't remove your own owner role." :
       error === 'not_found'  ? 'User not found.' : 'Something went wrong.'}
    </div>
  )}

  <!-- Current roles table -->
  <div class="bg-white rounded-[2rem] overflow-hidden mb-8 border border-peach/60">
    <div class="px-6 py-4 border-b border-peach">
      <h2 class="text-base font-semibold text-navy">Current admin users</h2>
    </div>
    {adminUsers.length === 0 ? (
      <div class="px-6 py-8 text-center text-sm text-gray-text">
        No roles assigned yet.
      </div>
    ) : (
      <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-peach/20">
            <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-widest text-navy">User</th>
            <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-widest text-navy">Role</th>
            <th class="text-left px-6 py-3 text-xs font-semibold uppercase tracking-widest hidden sm:table-cell text-navy">Trips</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {adminUsers.map((u) => {
            const tripList = (() => { try { return JSON.parse(u.tripIds); } catch { return []; } })();
            const isSelf = u.userId === adminUser.userId;
            const isLastOwner = u.role === 'owner' && adminUsers.filter(x => x.role === 'owner').length === 1;
            const canRemove = !isSelf && !isLastOwner;
            return (
              <tr class="border-t border-peach">
                <td class="px-6 py-4">
                  <div class="font-medium text-navy">{u.displayName ?? u.email}</div>
                  <div class="text-xs text-gray-text">{u.email}</div>
                </td>
                <td class="px-6 py-4">
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full"
                    style={u.role === 'owner' ? 'background: rgba(232,114,90,0.12); color: var(--color-coral);' :
                           u.role === 'ops'   ? 'background: rgba(59,130,246,0.1); color: #3B82F6;' :
                                                'background: rgba(16,185,129,0.1); color: #10B981;'}>
                    {u.role}
                  </span>
                </td>
                <td class="px-6 py-4 hidden sm:table-cell text-xs text-gray-text">
                  {tripList.length > 0 ? tripList.join(', ') : '—'}
                </td>
                <td class="px-6 py-4 text-right">
                  {canRemove ? (
                    <form method="POST" action="/api/admin/roles" class="inline">
                      <input type="hidden" name="action" value="remove-form" />
                      <input type="hidden" name="userId" value={u.userId} />
                      <input type="hidden" name="role" value={u.role} />
                      <button type="submit" class="text-xs font-medium hover:opacity-70 transition-opacity text-[#DC2626]"
                             >Remove</button>
                    </form>
                  ) : (
                    <span class="text-xs text-gray-text">{isSelf ? 'You' : '—'}</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      </div>
    )}
  </div>

  <!-- Add role form -->
  <div class="bg-white rounded-[2rem] px-6 py-6 border border-peach/60">
    <h2 class="text-base font-semibold mb-5 text-navy">Assign a role</h2>
    <form method="POST" action="/api/admin/roles" class="space-y-4" id="assign-form">
      <input type="hidden" name="action" value="assign-form" />

      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest mb-1.5 text-navy">
          User email
        </label>
        <input type="email" name="email" required placeholder="user@example.com"
               class="w-full rounded-2xl px-4 py-3 text-sm outline-none border border-peach/80 bg-blush"
               />
        <p class="text-xs mt-1 text-gray-text">The user must have logged in with Google at least once.</p>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest mb-1.5 text-navy">
          Role
        </label>
        <select name="role" required id="role-select"
                class="w-full rounded-2xl px-4 py-3 text-sm outline-none border border-peach/80 bg-blush"
               >
          <option value="owner">owner — full access, can manage roles</option>
          <option value="ops" selected>ops — can manage bookings and content</option>
          <option value="trip_lead">trip_lead — read-only participant list for assigned trips</option>
        </select>
      </div>

      <div id="trip-ids-row" class="hidden">
        <label class="block text-xs font-semibold uppercase tracking-widest mb-1.5 text-navy">
          Assigned trips
        </label>
        <select name="tripIds" multiple id="trip-ids-select"
                class="w-full rounded-2xl px-4 py-3 text-sm outline-none border border-peach/80 bg-blush min-h-[100px]"
               >
          {trips.map((t) => (
            <option value={t.slug}>{t.name} ({t.slug})</option>
          ))}
        </select>
        <p class="text-xs mt-1 text-gray-text">Hold Cmd/Ctrl to select multiple trips.</p>
      </div>

      <button type="submit"
              class="rounded-full px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90 bg-cta"
             >
        Assign role
      </button>
    </form>
  </div>
</AdminLayout>

<script>
  const roleSelect = document.getElementById('role-select') as HTMLSelectElement;
  const tripRow = document.getElementById('trip-ids-row') as HTMLElement;
  roleSelect?.addEventListener('change', () => {
    tripRow.classList.toggle('hidden', roleSelect.value !== 'trip_lead');
  });
</script>
