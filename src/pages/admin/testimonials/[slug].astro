---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readTestimonial } from '../../../lib/content';
import { ADMIN_CONTENT_INPUT_CLASS as inputCls, ADMIN_CONTENT_LABEL_CLASS as labelCls } from '../../../components/admin/formClasses';
export const prerender = false;

const { slug } = Astro.params;
const t = slug ? readTestimonial(slug) : null;
if (!t) return Astro.redirect('/admin/testimonials');

---

<AdminLayout title={`Edit: ${t.name ?? slug}`} page="testimonials">
  <form method="POST" action="/api/admin/testimonials/update" class="bg-white rounded-[2rem] p-6 max-w-2xl border border-peach/60">
    <input type="hidden" name="slug" value={slug} />
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelCls}>Name</label>
        <input type="text" name="name" required value={t.name ?? ''} class={inputCls} />
      </div>
      <div>
        <label class={labelCls}>Location</label>
        <input type="text" name="location" value={t.location ?? ''} class={inputCls} />
      </div>
      <div>
        <label class={labelCls}>Trip taken</label>
        <input type="text" name="tripName" value={t.tripName ?? ''} aria-describedby="trip-name-help" class={inputCls} />
        <p id="trip-name-help" class="mt-1.5 text-xs text-gray-text">Optional display context only. This does not control where the testimonial appears.</p>
      </div>
      <div>
        <label class={labelCls}>Rating</label>
        <select name="rating" class={inputCls}>
          {[5, 4, 3, 2, 1].map(n => <option value={n} selected={n === (t.rating ?? 5)}>{n} star{n === 1 ? '' : 's'}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class={labelCls}>Quote</label>
        <textarea name="quote" rows="4" required class={inputCls}>{t.quote ?? ''}</textarea>
      </div>
      <div class="sm:col-span-2">
        <label class="flex items-center gap-2 text-sm text-navy">
          <input type="checkbox" name="featured" value="true" checked={!!t.featured} />
          Featured (highlighted on homepage)
        </label>
      </div>
    </div>
    <div class="flex items-center gap-3 mt-6">
      <button type="submit" class="rounded-full px-7 py-3 text-sm font-semibold text-white bg-cta">Save changes</button>
      <a href="/admin/testimonials/" class="text-sm font-medium text-gray-text">Cancel</a>
    </div>
  </form>
</AdminLayout>
