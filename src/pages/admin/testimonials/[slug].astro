---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readTestimonial } from '../../../lib/content';
import { ADMIN_CONTENT_INPUT_STYLE as inputStyle, ADMIN_CONTENT_LABEL_STYLE as labelStyle } from '../../../lib/adminStyles';
export const prerender = false;

const { slug } = Astro.params;
const t = slug ? readTestimonial(slug) : null;
if (!t) return Astro.redirect('/admin/testimonials');

const inputCls = 'w-full rounded-2xl px-4 py-3 text-sm outline-none';
const labelCls = 'block text-xs font-semibold uppercase tracking-widest mb-1.5';
---

<AdminLayout title={`Edit: ${t.name ?? slug}`} page="testimonials">
  <form method="POST" action="/api/admin/testimonials/update" class="bg-white rounded-[2rem] p-6 max-w-2xl" style="border: 1px solid rgba(245,221,215,0.6);">
    <input type="hidden" name="slug" value={slug} />
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelCls} style={labelStyle}>Name</label>
        <input type="text" name="name" required value={t.name ?? ''} class={inputCls} style={inputStyle} />
      </div>
      <div>
        <label class={labelCls} style={labelStyle}>Location</label>
        <input type="text" name="location" value={t.location ?? ''} class={inputCls} style={inputStyle} />
      </div>
      <div>
        <label class={labelCls} style={labelStyle}>Trip taken</label>
        <input type="text" name="tripName" value={t.tripName ?? ''} aria-describedby="trip-name-help" class={inputCls} style={inputStyle} />
        <p id="trip-name-help" class="mt-1.5 text-xs" style="color: rgba(27,43,58,0.55);">Optional display context only. This does not control where the testimonial appears.</p>
      </div>
      <div>
        <label class={labelCls} style={labelStyle}>Rating</label>
        <select name="rating" class={inputCls} style={inputStyle}>
          {[5, 4, 3, 2, 1].map(n => <option value={n} selected={n === (t.rating ?? 5)}>{n} star{n === 1 ? '' : 's'}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label class={labelCls} style={labelStyle}>Quote</label>
        <textarea name="quote" rows="4" required class={inputCls} style={inputStyle}>{t.quote ?? ''}</textarea>
      </div>
      <div class="sm:col-span-2">
        <label class="flex items-center gap-2 text-sm" style="color: var(--color-navy);">
          <input type="checkbox" name="featured" value="true" checked={!!t.featured} />
          Featured (highlighted on homepage)
        </label>
      </div>
    </div>
    <div class="flex items-center gap-3 mt-6">
      <button type="submit" class="rounded-full px-7 py-3 text-sm font-semibold text-white" style="background-color: var(--color-cta);">Save changes</button>
      <a href="/admin/testimonials/" class="text-sm font-medium" style="color: rgba(27,43,58,0.55);">Cancel</a>
    </div>
  </form>
</AdminLayout>
