---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RegistrationCard from '../../../components/admin/RegistrationCard.astro';
import { buildRegistrationsView, regStats, type RegTrip, type RegDeparture } from '../../../lib/registrationsView';
import { buildDepartureOccupancy } from '../../../lib/occupancyMatrix';
import { formatINR } from '../../../lib/utils';
import { PAYMENT_STATUS_COLORS, REG_STATUS_COLORS } from '../../../lib/registrationStatus';
export const prerender = false;

const adminUser = Astro.locals.adminUser;
const isTripLead = adminUser?.role === 'trip_lead';
const slug = String(Astro.params.slug || '');

const view = buildRegistrationsView(adminUser);

let trip: RegTrip | null = null;
if (slug === '__legacy') {
  if (view.legacyRegs.length) {
    const dep: RegDeparture = {
      id: '', startDate: '', endDate: '', status: 'history',
      regs: view.legacyRegs, cap: null, booked: 0, soldOut: false, historical: true,
      tierOptions: [], perTierOffers: false,
    };
    trip = { slug: '__legacy', name: 'Unassigned / legacy registrations', active: false, nextDate: '', departures: [dep], historical: true, regCount: view.legacyRegs.length };
  }
} else {
  trip = view.trips.find((t) => t.slug === slug) ?? null;
}

if (!trip) return Astro.redirect('/admin/registrations');

const s = regStats(trip.departures.flatMap((d) => d.regs));
const tripRevenue = trip.departures
  .flatMap((d) => d.regs)
  .filter((r) => r.status !== 'rejected' && r.status !== 'wishlist' && r.status !== 'cancelled')
  .reduce((n, r) => n + Number(r.amount_paid || 0), 0);
const historyCount = trip.departures.filter((d) => d.historical).length;

const BOOKABLE_STATUSES = ['booking-open', 'booking_open', 'filling-fast', 'filling_fast'];
const unnotifiedWishlist = (dep: RegDeparture) =>
  dep.regs.filter((r: any) => r.status === 'wishlist' && !r.wishlist_notified_at).length;

const fmt = (d: string) => (d ? new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—');
const exportHref = trip.slug === '__legacy'
  ? '/api/admin/export?type=registrations'
  : `/api/admin/export?type=registrations&trip_name=${encodeURIComponent(trip.name)}`;

// Per-departure stats for client-side switching
const depStatsMap = Object.fromEntries(
  trip.departures.map((dep) => {
    const ds = regStats(dep.regs);
    const rev = dep.regs.filter((r: any) => r.status !== 'rejected' && r.status !== 'wishlist' && r.status !== 'cancelled').reduce((n: number, r: any) => n + Number(r.amount_paid || 0), 0);
    return [dep.id || '__none__', { count: dep.regs.length, wishlist: ds.wishlist, lead: ds.lead, pending: ds.pending, confirmed: ds.confirmed, rejected: ds.rejected, cancelled: ds.cancelled, revenue: rev }];
  })
);
const allDepStats = { count: trip.regCount, wishlist: s.wishlist, lead: s.lead, pending: s.pending, confirmed: s.confirmed, rejected: s.rejected, cancelled: s.cancelled, revenue: tripRevenue };
---
<AdminLayout title={trip.name} page="registrations">
  <a class="back-link" href="/admin/registrations">← All trips</a>

  <header class="trip-header">
    <div>
      <h1>{trip.name}</h1>
      <p class="trip-sub">
        <span class={trip.active ? 'active' : 'closed'}>{trip.active ? 'active' : 'closed / history'}</span>
        {trip.departures.length} departure{trip.departures.length === 1 ? '' : 's'} · {trip.regCount} registration{trip.regCount === 1 ? '' : 's'}
      </p>
    </div>
    {!isTripLead && trip.slug !== '__legacy' && (
      <div class="header-actions">
        <a class="primary" href={`/admin/registrations/new?trip=${encodeURIComponent(trip.slug)}`}>+ Add</a>
        <a href={`/admin/registrations/import?trip=${encodeURIComponent(trip.slug)}`}>↑ Import</a>
        <a id="registrations-export" class="export" href={exportHref} data-base-href={exportHref}>↓ Export CSV</a>
      </div>
    )}
  </header>

  <div class="stats-grid">{[
    ['Registrations', trip.regCount],
    ['Leads', s.lead],
    ['Confirmed', s.confirmed],
    ['Revenue', formatINR(tripRevenue)],
  ].map(([label, value]) => (
    <div class={`stat-card${label === 'Revenue' ? ' revenue-card' : ''}`} data-stat-label={label}>
      <p>{label}</p>
      <strong>{value}</strong>
    </div>
  ))}</div>
  <p class="stats-caption">
    <span class="stat-mini" data-stat-label="Wishlist">{s.wishlist}</span> wishlist ·
    <span class="stat-mini" data-stat-label="Pending">{s.pending}</span> pending ·
    <span class="stat-mini" data-stat-label="Rejected">{s.rejected}</span> rejected ·
    <span class="stat-mini" data-stat-label="Cancelled">{s.cancelled}</span> cancelled
  </p>

  <div class="toolbar">
    <div class="toolbar-row">
      <input id="search-input" type="search" placeholder="Search by name, phone, or email…" autocomplete="off" />
      {trip.departures.length > 1 && (
        <select id="departure-select">
          <option value="">All departures</option>
          {trip.departures.map((dep) => (
            <option value={dep.id} data-historical={dep.historical ? 'true' : 'false'}>
              {dep.id ? `${fmt(dep.startDate)} – ${fmt(dep.endDate)}` : 'No departure assigned'}
              {dep.historical ? ' (past)' : ''}
            </option>
          ))}
        </select>
      )}
      <select id="filter-status">
        <option value="">All statuses</option>
        <option value="wishlist">Wishlist</option>
        <option value="lead">Lead</option>
        <option value="pending">Pending</option>
        <option value="confirmed">Confirmed</option>
        <option value="rejected">Rejected</option>
        <option value="cancelled">Cancelled</option>
      </select>
      {historyCount > 0 && (
        <label class="history-toggle">
          <input id="show-history" type="checkbox" />
          Show past <span class="history-count">({historyCount})</span>
        </label>
      )}
    </div>
    {!isTripLead && (
      <div class="toolbar-row" id="bulk-actions" hidden>
        <label><input id="select-all-visible" type="checkbox" /> Select all matching</label>
        <strong id="selected-count"></strong>
        <select id="bulk-status"><option value="">Choose new status…</option><option>lead</option><option>pending</option><option>confirmed</option><option>rejected</option><option>cancelled</option></select>
        <select id="bulk-confirm-kind" style="display:none"><option value="advance_paid">Advance paid</option><option value="fully_paid">Fully paid</option></select>
        <select id="bulk-cancel-kind" style="display:none"><option value="none">No refund</option><option value="refunded">Full refund — all paid</option></select>
        <button id="apply-bulk-status" disabled>Update status</button>
        <button id="clear-selection">Clear</button>
      </div>
    )}
  </div>

  <div id="departures-container">
    {trip.departures.map((dep) => {
      const ds = regStats(dep.regs);
      const occ = buildDepartureOccupancy(dep.regs, dep.tierOptions);
      const heldTotal = occ.heldMale + occ.heldFemale + occ.heldOther;
      return (
        <article class={`departure ${dep.historical ? 'history-item' : ''}`} data-departure-id={dep.id}>
          <div class="departure-head">
            <div class="departure-title">
              {!isTripLead && dep.regs.length > 0 && <label title="Select this departure"><input class="departure-select-checkbox" type="checkbox" /></label>}
              <div>
                <strong>{dep.id ? `${fmt(dep.startDate)} – ${fmt(dep.endDate)}` : 'No departure assigned'}</strong>
                <span class="dep-status-chip">{dep.status.replace(/[-_]/g, ' ')}</span>
              </div>
            </div>
            <div class="departure-summary">
              <span>{dep.regs.length} registration{dep.regs.length === 1 ? '' : 's'}</span>
              {ds.wishlist > 0 && <b style={REG_STATUS_COLORS.wishlist}>{ds.wishlist} wishlist</b>}
              {ds.lead > 0 && <b style={REG_STATUS_COLORS.lead}>{ds.lead} lead</b>}
              {ds.pending > 0 && <b style={REG_STATUS_COLORS.pending}>{ds.pending} pending</b>}
              {ds.confirmed > 0 && <b style={REG_STATUS_COLORS.confirmed}>{ds.confirmed} confirmed</b>}
              {ds.rejected > 0 && <b style={REG_STATUS_COLORS.rejected}>{ds.rejected} rejected</b>}
              {ds.cancelled > 0 && <b style={REG_STATUS_COLORS.cancelled}>{ds.cancelled} cancelled</b>}
              {dep.cap !== null && <span>{dep.booked}/{dep.cap} occupied</span>}
              {heldTotal > 0 && <span>{occ.heldMale} M · {occ.heldFemale} F{occ.heldOther > 0 ? ` · ${occ.heldOther} other` : ''} held</span>}
              {!isTripLead && dep.id && (
                <span class="dep-actions">
                  <a href={`/admin/registrations/new?trip=${encodeURIComponent(trip.slug)}&departure=${encodeURIComponent(dep.id)}`}>+ Add</a>
                  <a href={`/admin/registrations/import?trip=${encodeURIComponent(trip.slug)}&departure=${encodeURIComponent(dep.id)}`}>↑ Import</a>
                </span>
              )}
            </div>
          </div>
          {dep.perTierOffers && dep.id && occ.rows.length > 0 && (
            <div class="occ-matrix-wrap">
              <table class="occ-matrix">
                <thead>
                  <tr>
                    <th scope="col">Tier</th>
                    <th scope="col">Rooms</th>
                    <th scope="col">Male</th>
                    <th scope="col">Female</th>
                    <th scope="col">Other</th>
                    <th scope="col">Beds left</th>
                  </tr>
                </thead>
                <tbody>
                  {occ.rows.map((row) => {
                    const rooms = row.roomSize == null
                      ? (row.cap == null ? '—' : 'open')
                      : `${row.roomsUsed?.total ?? 0} / ${row.totalRooms}`;
                    const cell = (held: number, hr: number | null) => hr == null ? `${held} · —` : `${held} · +${hr}`;
                    return (
                      <tr class={row.overbooked ? 'occ-over' : undefined}>
                        <td>{row.label}{row.overbooked ? ' ⚠' : ''}</td>
                        <td>{rooms}</td>
                        <td>{cell(row.held.male, row.headroom.male)}</td>
                        <td>{cell(row.held.female, row.headroom.female)}</td>
                        <td>{row.held.other > 0 ? <span title="Set this traveller's gender to pair them into a room">{row.held.other}</span> : 0}</td>
                        <td>{row.headroom.bedsLeft ?? '—'}</td>
                      </tr>
                    );
                  })}
                </tbody>
                {occ.unmatchedHeld > 0 && (
                  <tfoot>
                    <tr><td colspan="6" class="occ-note">{occ.unmatchedHeld} held registration{occ.unmatchedHeld === 1 ? '' : 's'} not matched to a tier</td></tr>
                  </tfoot>
                )}
              </table>
              <p class="occ-note">Best-case estimate: single-gender rooms, current travellers assumed tightly packed. Move someone between tiers from a registration's Occupancy tab.</p>
            </div>
          )}
          {!isTripLead && dep.id && BOOKABLE_STATUSES.includes(dep.status) && unnotifiedWishlist(dep) > 0 && (
            <div class="wishlist-notify" data-batch-id={dep.id}>
              <span>
                <strong>{unnotifiedWishlist(dep)}</strong> traveller{unnotifiedWishlist(dep) === 1 ? '' : 's'} wishlisted this date and haven't been told it's open.
              </span>
              <button type="button" class="notify-wishlist-btn" data-batch-id={dep.id}>Notify them</button>
            </div>
          )}
          {dep.regs.length > 0 && <div class="registration-list">{dep.regs.map((r) => <RegistrationCard registration={r} readOnly={isTripLead} tierOptions={dep.tierOptions} />)}</div>}
        </article>
      );
    })}
  </div>
  <p id="noResults">No matching registrations.</p>
</AdminLayout>

<style>
  .back-link{display:inline-block;margin-bottom:.75rem;color:var(--color-text-secondary);font-weight:700;font-size:.82rem;text-decoration:none}.back-link:hover{color:var(--color-coral)}
  .trip-header{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;margin-bottom:1rem}.trip-header h1{margin:0;font:800 1.5rem var(--font-display);color:var(--color-navy)}.trip-sub{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;margin:.35rem 0 0;font-size:.8rem;color:var(--color-text-secondary)}.trip-sub .active,.trip-sub .closed{padding:.15rem .5rem;border-radius:999px;font-weight:700;text-transform:uppercase;font-size:.7rem}.trip-sub .active{background:#D1FAE5;color:#065F46}.trip-sub .closed{background:#E5E7EB;color:#374151}
  .header-actions{display:flex;gap:.5rem;flex-wrap:wrap}.header-actions a{padding:.45rem .8rem;border:1px solid var(--color-coral);border-radius:.5rem;color:var(--color-coral);font-size:.8rem;font-weight:700;text-decoration:none}.header-actions .primary{background:var(--color-coral);color:#fff}.header-actions .export{background:var(--color-primary);border-color:var(--color-primary);color:#fff}
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.7rem;margin-bottom:.5rem}.stat-card{background:#fff;border:1px solid var(--color-border);border-radius:.85rem;padding:.8rem 1rem}.stat-card.revenue-card{border-left:3px solid var(--color-coral)}.stat-card p{margin:0 0 .25rem;font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--color-text-secondary)}.stat-card strong{font:800 1.45rem var(--font-display);color:var(--color-navy)}
  .stats-caption{margin:0 0 1.25rem;font-size:.78rem;color:var(--color-text-secondary)}.stats-caption .stat-mini{font-weight:700;color:var(--color-navy)}
  .toolbar{position:sticky;top:4rem;z-index:30;display:flex;flex-direction:column;gap:.6rem;background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:.7rem .9rem;margin-bottom:1rem}
  .toolbar-row{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}.toolbar-row:nth-child(2){border-top:1px solid var(--color-border);padding-top:.6rem}
  .toolbar #search-input{flex:1;min-width:200px}
  .toolbar input,.toolbar select{padding:.45rem .75rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff;color:var(--color-navy);font-size:.875rem}
  .toolbar button{padding:.45rem .7rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff;font-weight:700;cursor:pointer}
  .toolbar #apply-bulk-status{background:var(--color-navy);color:#fff;border-color:var(--color-navy)}
  .toolbar button:disabled{opacity:.4;cursor:default}
  .toolbar label{display:flex;align-items:center;gap:.35rem;font-weight:700;font-size:.8rem}
  #bulk-actions[hidden]{display:none}#selected-count{color:var(--color-text-secondary);font-size:.8rem}
  .history-toggle{white-space:nowrap;cursor:pointer}.history-count{color:var(--color-text-secondary);font-weight:400}
  .departure{border:1px solid var(--color-border);border-radius:.75rem;background:#fff;margin-bottom:.65rem;overflow:hidden}.departure-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.75rem .9rem;background:#FCFAF9}.departure-title,.departure-summary{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}.dep-status-chip{margin-left:.5rem;padding:.1rem .45rem;border-radius:999px;background:var(--color-gray-soft);color:var(--color-text-secondary);font-size:.68rem;font-weight:700;text-transform:capitalize;white-space:nowrap}.departure-select-checkbox{width:1rem;height:1rem;accent-color:var(--color-coral)}.departure-summary>span{font-size:.74rem;color:var(--color-text-secondary)}.departure-summary b{padding:.15rem .5rem;border-radius:999px;font-size:.7rem}.dep-actions a{padding:.2rem .45rem;font-size:.7rem;border:1px solid var(--color-peach);border-radius:.4rem;color:var(--color-navy);text-decoration:none;font-weight:700}
  .wishlist-notify{display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap;background:#EEF2FF;border-top:1px solid #C7D2FE;padding:.6rem .9rem;font-size:.8rem;color:#3730A3}.wishlist-notify button{padding:.4rem .8rem;border:0;border-radius:.5rem;background:#4338CA;color:#fff;font-weight:700;font-size:.78rem;cursor:pointer}.wishlist-notify button:disabled{opacity:.6;cursor:default}.wishlist-notify.done{background:#ECFDF5;border-color:#A7F3D0;color:#065F46}
  .registration-list{display:flex;flex-direction:column;gap:.6rem;padding:.7rem;border-top:1px solid var(--color-border);background:#FCFAF9}.history-item{display:none}#noResults{display:none;text-align:center;padding:2rem;color:var(--color-text-secondary)}
  .occ-matrix-wrap{overflow-x:auto;margin:.5rem .9rem}
  .occ-matrix{width:100%;border-collapse:collapse;font-size:.76rem}
  .occ-matrix th,.occ-matrix td{padding:.3rem .5rem;border-bottom:1px solid var(--color-border);text-align:left;white-space:nowrap}
  .occ-matrix thead th{font-size:.65rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--color-text-secondary)}
  .occ-matrix td:first-child{font-weight:700;color:var(--color-navy)}
  .occ-matrix .occ-over,.occ-matrix .occ-over td:first-child{color:var(--color-danger)}
  .occ-note{margin:.35rem 0 0;font-size:.68rem;color:var(--color-text-secondary)}
  td.occ-note{padding:.3rem .5rem}
  @media(max-width:900px){.stats-grid{grid-template-columns:repeat(3,1fr)}.departure-head{align-items:flex-start;flex-direction:column}}
  @media(max-width:600px){.stats-grid{grid-template-columns:repeat(2,1fr)}.toolbar{position:static}.toolbar-row{align-items:stretch;flex-direction:column}}
</style>

<script define:vars={{ depStatsMap, allDepStats, tripSlug: trip.slug, PAYMENT_STATUS_COLORS, REG_STATUS_COLORS }}>
  // Reload after a bulk action while preserving the active filters in the URL,
  // so search/status/departure/history selections survive the round-trip.
  function reloadWithFilters() {
    const p = new URLSearchParams();
    const q = document.getElementById('search-input')?.value;
    const sf = document.getElementById('filter-status')?.value;
    const dep = document.getElementById('departure-select')?.value;
    if (q) p.set('q', q);
    if (sf) p.set('status', sf);
    if (dep) p.set('dep', dep);
    if (document.getElementById('show-history')?.checked) p.set('hist', '1');
    location.href = location.pathname + (p.size ? '?' + p : '');
  }

  const badgeStyle = (s) => REG_STATUS_COLORS[s] || REG_STATUS_COLORS.pending;
  const paymentLabel = (s) => ({
    unpaid: 'Unpaid', advance_paid: 'Advance paid', fully_paid: 'Fully paid',
    partial_refund: 'Partial refund', full_refund: 'Refunded',
  })[s] || s;
  const formatMoney = (amount) => `₹${Math.round(Number(amount) || 0).toLocaleString('en-IN')}`;

  function applyPaymentResult(id, result) {
    const row = document.querySelector(`.payment-badge[data-id="${id}"]`)?.closest('.reg-row');
    const wrap = row?.querySelector('[data-sp]');
    if (!row || !wrap) return;
    const paymentStatus = result.payment_status;
    const amountPaid = Number(result.amountPaid) || 0;
    const total = Number(wrap.dataset.total) || 0;
    wrap.dataset.currentPayment = paymentStatus;
    wrap.dataset.paid = String(amountPaid);
    const checkbox = row.querySelector('.registration-checkbox');
    if (checkbox) {
      checkbox.dataset.paymentStatus = paymentStatus;
      checkbox.dataset.paid = String(amountPaid);
    }
    const badge = row.querySelector('.payment-badge');
    if (badge) {
      badge.textContent = paymentLabel(paymentStatus);
      badge.style.cssText = PAYMENT_STATUS_COLORS[paymentStatus] || PAYMENT_STATUS_COLORS.unpaid;
    }
    const summaryAmount = row.querySelector('.payment-amount');
    if (summaryAmount) summaryAmount.textContent = formatMoney(amountPaid);
    const hero = row.querySelector('[data-payment-hero]');
    if (hero) hero.textContent = `${paymentLabel(paymentStatus)} · ${formatMoney(amountPaid)}${total > 0 ? ` of ${formatMoney(total)}` : ''}`;
    const paidField = row.querySelector('[data-payment-field="Amount paid"]');
    if (paidField) paidField.innerHTML = `<span>Amount paid:</span> ${formatMoney(amountPaid)}`;
    const balanceField = row.querySelector('[data-payment-field="Balance due"]');
    if (balanceField) balanceField.innerHTML = `<span>Balance due:</span> ${formatMoney(Math.max(0, total - amountPaid))}`;
    spSync(wrap);
  }

  function toggleDetail(id) {
    const el = document.getElementById('detail-' + id);
    if (!el) return;
    const open = getComputedStyle(el).display === 'none';
    el.style.display = open ? 'block' : 'none';
    el.parentElement?.classList.toggle('open', open);
    const btn = el.parentElement?.querySelector('.details-btn');
    if (btn) { btn.textContent = open ? 'Hide details' : 'View details'; btn.setAttribute('aria-expanded', String(open)); }
  }

  async function requestStatusUpdate(id, status, admin_notes = '') {
    const res = await fetch('/api/admin/update-registration', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status, admin_notes, requestId: crypto.randomUUID() }),
    });
    if (res.ok) {
      const badge = document.querySelector(`.status-badge[data-id="${id}"]`);
      if (badge) { badge.textContent = status; badge.style.cssText = badgeStyle(status); }
      const row = badge?.closest('.reg-row');
      if (row) row.dataset.status = status;
      return { ok: true, error: '' };
    }
    const data = await res.json().catch(() => null);
    return { ok: false, error: data?.error || 'Status update failed.' };
  }

  async function requestDocument(id, type, action) {
    const res = await fetch('/api/admin/registrations/document', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ registrationId: Number(id), type, action }),
    });
    const data = await res.json().catch(() => null);
    return res.ok ? data : { success: false, error: data?.error || 'Document request failed.' };
  }

  // ── Per-row actions ──
  document.getElementById('departures-container')?.addEventListener('click', async (e) => {
    const tabBtn = e.target.closest('.tab-btn');
    if (tabBtn) {
      const scope = tabBtn.closest('.detail-row');
      const tab = tabBtn.dataset.tab;
      scope?.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('active', b === tabBtn));
      scope?.querySelectorAll('.tab-panel').forEach((p) => p.toggleAttribute('hidden', p.dataset.tab !== tab));
      return;
    }
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    const id = btn.dataset.id || '';
    const value = btn.dataset.value || '';
    if (btn.dataset.action === 'toggle-detail') { toggleDetail(id); return; }
    if (btn.dataset.action === 'save-status-payment') {
      const wrap = btn.closest('[data-sp]');
      if (!wrap) return;
      const cur = wrap.dataset.currentStatus;
      const curPay = wrap.dataset.currentPayment;
      const paid = Number(wrap.dataset.paid) || 0;
      const status = document.getElementById('sp-status-' + id)?.value || cur;
      const confirmKind = document.getElementById('sp-confirm-kind-' + id)?.value || 'advance_paid';
      const cancelKind = document.getElementById('sp-cancel-kind-' + id)?.value || 'none';
      const rid = crypto.randomUUID();
      let url, body, ask;
      if (status === 'confirmed' && cur !== 'confirmed') {
        url = '/api/admin/update-registration';
        body = { id: Number(id), status: 'confirmed', payment_status: confirmKind, requestId: rid };
        ask = `Confirm #${id} as ${confirmKind === 'fully_paid' ? 'fully paid' : 'advance paid'}?`;
      } else if (status === 'confirmed' && confirmKind === 'fully_paid' && curPay !== 'fully_paid') {
        url = '/api/admin/registrations/payment';
        body = { ids: [Number(id)], action: 'full', method: 'bank_transfer', requestId: rid };
        ask = `Record the full balance as received for #${id}?`;
      } else if (status === 'cancelled' && cancelKind === 'refunded') {
        const amt = Math.round(Number(document.getElementById('sp-refund-amount-' + id)?.value));
        if (!Number.isInteger(amt) || amt < 1 || amt > paid) {
          alert(`Refund must be between ₹1 and ₹${paid.toLocaleString('en-IN')}.`);
          return;
        }
        const kind = amt >= paid ? 'full' : 'partial';
        if (cur === 'cancelled') {
          url = '/api/admin/registrations/payment';
          body = { ids: [Number(id)], action: 'refund', refundKind: kind, amount: amt, method: 'bank_transfer', requestId: rid };
          ask = `Record a ${kind} refund of ₹${amt.toLocaleString('en-IN')} for #${id}?`;
        } else {
          url = '/api/admin/update-registration';
          body = { id: Number(id), status: 'cancelled', requestId: rid, refund: { kind, amount: amt, method: 'bank_transfer' } };
          ask = `Cancel #${id} and refund ₹${amt.toLocaleString('en-IN')}?`;
        }
      } else if (status === 'cancelled' && cur !== 'cancelled') {
        url = '/api/admin/update-registration';
        body = { id: Number(id), status: 'cancelled', requestId: rid };
        ask = paid > 0 ? `Cancel #${id}? No refund will be recorded.` : `Cancel #${id}?`;
      } else if ((status === 'lead' || status === 'pending' || status === 'rejected') && status !== cur) {
        url = '/api/admin/update-registration';
        body = { id: Number(id), status, requestId: rid };
        ask = `Change #${id} to "${status}"?`;
      } else {
        alert('Nothing to update.');
        return;
      }
      if (!confirm(ask)) return;
      btn.disabled = true;
      const res = await fetch(url, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json().catch(() => null);
      btn.disabled = false;
      if (!res.ok || !data?.success || data.failed) alert(data?.error || data?.results?.find((x) => !x.success)?.error || 'Update failed.');
      else if (url === '/api/admin/registrations/payment') applyPaymentResult(id, data.results[0]);
      else reloadWithFilters();
      return;
    }
    if (btn.dataset.action === 'save-occupancy') {
      const sel = document.getElementById('occ-tier-' + id);
      const newTier = sel?.value || '';
      const curTier = btn.dataset.currentTier || '';
      if (!newTier || newTier === curTier) { alert('Pick a different occupancy.'); return; }
      const labelOf = (v) => [...(sel?.options || [])].find((o) => o.value === v)?.text?.trim() || v;
      const paid = Number(btn.dataset.paid) || 0;
      const hasDoc = btn.dataset.hasDoc === '1';
      let ask = `Change #${id} occupancy?\n\n${labelOf(curTier)}\n→ ${labelOf(newTier)}\n\nThe trip price is recomputed to match the new tier. No email is sent to the traveller.`;
      if (paid > 0 || hasDoc) ask += `\n\nThis booking has a payment or an invoice attached — you may need to record a refund or fix the invoice in Zoho afterwards.`;
      if (!confirm(ask)) return;
      btn.disabled = true;
      const res = await fetch('/api/admin/registrations/occupancy', {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id), tierId: newTier, requestId: crypto.randomUUID() }),
      });
      const data = await res.json().catch(() => null);
      btn.disabled = false;
      if (!res.ok || !data?.success) { alert(data?.error || 'Could not change occupancy.'); return; }
      if (Array.isArray(data.warnings) && data.warnings.length) alert(data.warnings.join('\n'));
      reloadWithFilters();
      return;
    }
    if (btn.dataset.action === 'patch-state') {
      const state = document.getElementById('state-fix-' + id)?.value?.trim() || '';
      if (!state) { alert('Enter the traveller’s state.'); return; }
      btn.disabled = true;
      const res = await fetch('/api/admin/registrations/fields', {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(id), patch: { state } }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.success) { btn.disabled = false; alert(data?.error || 'Could not save the state.'); return; }
      const doc = await requestDocument(id, value, 'retry');
      btn.disabled = false;
      if (!doc.success) alert(doc.error || 'State saved, but the document retry failed.');
      reloadWithFilters();
      return;
    }
    if (btn.dataset.action === 'retry-document' || btn.dataset.action === 'generate-document' || btn.dataset.action === 'refresh-document') {
      const action = btn.dataset.action === 'retry-document' ? 'retry' : btn.dataset.action === 'generate-document' ? 'generate' : 'refresh';
      const verb = action === 'retry' ? 'Retry' : action === 'generate' ? 'Generate' : 'Refresh';
      if (!confirm(`${verb} the ${value} document for registration #${id}?`)) return;
      btn.disabled = true;
      const data = await requestDocument(id, value, action);
      btn.disabled = false;
      if (!data.success) alert(data.error || 'Document request failed.'); else reloadWithFilters();
      return;
    }
    if (btn.dataset.action === 'save-notes') {
      const badge = document.querySelector(`.status-badge[data-id="${id}"]`);
      const notes = document.getElementById('notes-' + id)?.value ?? '';
      const result = await requestStatusUpdate(Number(id), badge?.textContent?.trim() || 'pending', notes);
      if (result.ok) {
        const msg = document.getElementById('msg-' + id);
        if (msg) { msg.style.setProperty('display', 'block', 'important'); setTimeout(() => msg.style.removeProperty('display'), 1500); }
      }
    }
  });

  // ── Status & payment tab: contextual payment field + dirty state ──
  function spSync(wrap) {
    const id = wrap.dataset.id;
    const cur = wrap.dataset.currentStatus;
    const curPay = wrap.dataset.currentPayment;
    const status = document.getElementById('sp-status-' + id)?.value || cur;
    const confirmKind = document.getElementById('sp-confirm-kind-' + id)?.value || 'advance_paid';
    const cancelKind = document.getElementById('sp-cancel-kind-' + id)?.value || 'none';
    const confirmWrap = document.getElementById('sp-confirm-wrap-' + id);
    const cancelWrap = document.getElementById('sp-cancel-wrap-' + id);
    const refundWrap = document.getElementById('sp-refund-wrap-' + id);
    if (confirmWrap) confirmWrap.hidden = status !== 'confirmed';
    if (cancelWrap) cancelWrap.hidden = status !== 'cancelled';
    if (refundWrap) refundWrap.hidden = !(status === 'cancelled' && cancelKind === 'refunded');
    let dirty = status !== cur;
    if (!dirty && status === 'confirmed' && confirmKind === 'fully_paid' && curPay !== 'fully_paid') dirty = true;
    if (!dirty && status === 'cancelled' && cancelKind === 'refunded' && curPay !== 'full_refund') dirty = true;
    const btn = document.querySelector(`button.sp-save[data-id="${id}"]`);
    if (btn) btn.disabled = !dirty;
  }

  document.getElementById('departures-container')?.addEventListener('change', (e) => {
    const sel = e.target;
    if (!sel || !sel.id) return;
    if (/^sp-(status|confirm-kind|cancel-kind)-/.test(sel.id)) {
      const wrap = sel.closest('[data-sp]');
      if (wrap) spSync(wrap);
    }
  });
  document.querySelectorAll('[data-sp]').forEach(spSync);

  // ── Selection ──
  const boxes = () => [...document.querySelectorAll('.registration-checkbox')];
  const rowOf = (b) => b.closest('.reg-row');
  const depOf = (b) => b.closest('.departure');
  const isVisible = (b) => depOf(b)?.style.display !== 'none' && rowOf(b)?.style.display !== 'none';
  const visibleBoxes = () => boxes().filter(isVisible);

  function selectionUI() {
    const selected = visibleBoxes().filter((b) => b.checked);
    const matching = visibleBoxes();
    const all = document.getElementById('select-all-visible');
    const apply = document.getElementById('apply-bulk-status');
    const bulk = document.getElementById('bulk-status');
    const count = document.getElementById('selected-count');
    const confirmKind = document.getElementById('bulk-confirm-kind');
    const cancelKind = document.getElementById('bulk-cancel-kind');
    const actions = document.getElementById('bulk-actions');
    if (count) count.textContent = selected.length ? `${selected.length} selected` : '';
    if (actions) actions.hidden = selected.length === 0;
    if (confirmKind) confirmKind.style.display = bulk?.value === 'confirmed' ? '' : 'none';
    if (cancelKind) cancelKind.style.display = bulk?.value === 'cancelled' ? '' : 'none';
    if (apply) apply.disabled = !selected.length || !bulk?.value;
    if (all) { const n = matching.filter((b) => b.checked).length; all.checked = matching.length > 0 && n === matching.length; all.indeterminate = n > 0 && n < matching.length; }
    document.querySelectorAll('.departure-select-checkbox').forEach((g) => {
      const dep = g.closest('.departure');
      const bs = [...(dep?.querySelectorAll('.registration-checkbox') ?? [])].filter(isVisible);
      const n = bs.filter((b) => b.checked).length;
      g.checked = bs.length > 0 && n === bs.length;
      g.indeterminate = n > 0 && n < bs.length;
    });
  }

  // ── Stats update ──
  const fmtINR = (n) => '₹' + Math.round(n ?? 0).toLocaleString('en-IN');

  function updateStats(data) {
    const vals = { Registrations: data.count, Leads: data.lead, Confirmed: data.confirmed, Revenue: fmtINR(data.revenue), Wishlist: data.wishlist, Pending: data.pending, Rejected: data.rejected, Cancelled: data.cancelled };
    document.querySelectorAll('[data-stat-label]').forEach((el) => {
      const label = el.dataset.statLabel ?? '';
      if (!(label in vals)) return;
      const target = el.matches('.stat-card') ? el.querySelector('strong') : el;
      if (target) target.textContent = String(vals[label]);
    });
  }

  // ── Departure filter ──
  const depSelect = document.getElementById('departure-select');
  const histCheckbox = document.getElementById('show-history');

  function applyDepFilters() {
    const selectedId = depSelect?.value ?? '';
    const showHist = !!histCheckbox?.checked;
    document.querySelectorAll('.departure').forEach((dep) => {
      const depId = dep.dataset.departureId ?? '';
      const isHist = dep.classList.contains('history-item');
      const show = selectedId === '' ? (!isHist || showHist) : depId === selectedId;
      dep.style.display = show ? 'block' : 'none';
    });
    const statsForId = selectedId && depStatsMap[selectedId] ? depStatsMap[selectedId] : allDepStats;
    updateStats(statsForId);
  }

  function applyRowFilters() {
    const q = (document.getElementById('search-input')?.value ?? '').toLowerCase().trim();
    const sf = document.getElementById('filter-status')?.value ?? '';
    let totalVisible = 0;

    document.querySelectorAll('.departure').forEach((dep) => {
      if (dep.style.display === 'none') {
        dep.querySelectorAll('.reg-row').forEach((r) => { r.style.display = ''; });
        return;
      }
      const rows = [...dep.querySelectorAll('.reg-row')];
      if (rows.length === 0) { totalVisible++; return; }
      let rowsVisible = 0;
      rows.forEach((row) => {
        const matchText = !q || (row.dataset.name||'').includes(q) || (row.dataset.email||'').includes(q) || (row.dataset.phone||'').includes(q);
        const matchStatus = !sf || row.dataset.status === sf;
        const show = matchText && matchStatus;
        row.style.display = show ? '' : 'none';
        if (!show) { const cb = row.querySelector('.registration-checkbox'); if (cb) cb.checked = false; }
        if (show) rowsVisible++;
      });
      if (rowsVisible === 0) { dep.style.display = 'none'; } else { totalVisible++; }
    });

    const nr = document.getElementById('noResults');
    if (nr) nr.style.display = totalVisible > 0 ? 'none' : 'block';
    selectionUI();
  }

  function applyFilters() {
    applyDepFilters();
    applyRowFilters();
    updateExportLink();
  }

  function updateExportLink() {
    const link = document.getElementById('registrations-export');
    if (!link) return;
    const base = link.dataset.baseHref || '/api/admin/export?type=registrations';
    const exportUrl = new URL(base, location.origin);
    const q = document.getElementById('search-input')?.value?.trim() ?? '';
    const status = document.getElementById('filter-status')?.value ?? '';
    const selectedId = depSelect?.value ?? '';
    const showHistory = !!histCheckbox?.checked;
    if (q) exportUrl.searchParams.set('q', q); else exportUrl.searchParams.delete('q');
    if (status) exportUrl.searchParams.set('status', status); else exportUrl.searchParams.delete('status');
    exportUrl.searchParams.delete('batch_id');
    exportUrl.searchParams.delete('batch_filter');
    if (selectedId || !showHistory) {
      exportUrl.searchParams.set('batch_filter', '1');
      const batchIds = selectedId
        ? [selectedId]
        : [...document.querySelectorAll('.departure:not(.history-item)')]
            .map((dep) => dep.dataset.departureId || '')
            .filter(Boolean);
      batchIds.forEach((id) => exportUrl.searchParams.append('batch_id', id));
    }
    link.href = exportUrl.pathname + exportUrl.search;
  }

  boxes().forEach((b) => b.addEventListener('change', selectionUI));
  document.querySelectorAll('.departure-select-checkbox').forEach((g) =>
    g.addEventListener('change', () => {
      g.closest('.departure')?.querySelectorAll('.registration-checkbox').forEach((b) => { if (isVisible(b)) b.checked = g.checked; });
      selectionUI();
    }),
  );
  document.getElementById('select-all-visible')?.addEventListener('change', (e) => { visibleBoxes().forEach((b) => (b.checked = e.target.checked)); selectionUI(); });
  document.getElementById('clear-selection')?.addEventListener('click', () => { boxes().forEach((b) => (b.checked = false)); selectionUI(); });
  document.getElementById('bulk-status')?.addEventListener('change', selectionUI);

  document.getElementById('apply-bulk-status')?.addEventListener('click', async () => {
    const selected = visibleBoxes().filter((b) => b.checked);
    const status = document.getElementById('bulk-status').value;
    if (!selected.length || !status) return;
    const confirmKind = document.getElementById('bulk-confirm-kind')?.value || 'advance_paid';
    const refundAll = status === 'cancelled' && document.getElementById('bulk-cancel-kind')?.value === 'refunded';
    const paidCount = refundAll ? selected.filter((b) => (Number(b.dataset.paid) || 0) > 0).length : 0;
    const msg = refundAll
      ? `Cancel ${selected.length} registration(s)? ${paidCount} with payments will be fully refunded.`
      : `Change ${selected.length} registration(s) to ${status}?`;
    if (!confirm(msg)) return;
    const failures = [];
    for (const b of selected) {
      const id = Number(b.dataset.registrationId);
      if (status === 'confirmed') {
        const alreadyConfirmed = b.dataset.status === 'confirmed';
        const needsFullBalance = alreadyConfirmed
          && confirmKind === 'fully_paid'
          && b.dataset.paymentStatus !== 'fully_paid';
        if (alreadyConfirmed && !needsFullBalance) continue;
        const url = needsFullBalance
          ? '/api/admin/registrations/payment'
          : '/api/admin/update-registration';
        const body = needsFullBalance
          ? { ids: [id], action: 'full', method: 'bank_transfer', requestId: crypto.randomUUID() }
          : { id, status: 'confirmed', payment_status: confirmKind, requestId: crypto.randomUUID() };
        const res = await fetch(url, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => null);
        const paymentFailure = needsFullBalance && data?.results?.find((result) => !result.success);
        if (!res.ok || !data?.success || paymentFailure) {
          failures.push(`#${id}: ${data?.error || paymentFailure?.error || 'failed'}`);
        }
      } else if (refundAll) {
        const paid = Number(b.dataset.paid) || 0;
        const refund = paid > 0 ? { kind: 'full', amount: paid, method: 'bank_transfer' } : undefined;
        const res = await fetch('/api/admin/update-registration', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, status: 'cancelled', requestId: crypto.randomUUID(), refund }),
        });
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.success) failures.push(`#${id}: ${data?.error || 'failed'}`);
      } else {
        const r = await requestStatusUpdate(id, status);
        if (!r.ok) failures.push(`#${id}: ${r.error}`);
      }
    }
    if (failures.length) alert(failures.join('\n')); else reloadWithFilters();
  });

  document.getElementById('search-input')?.addEventListener('input', applyFilters);
  document.getElementById('filter-status')?.addEventListener('change', applyFilters);
  depSelect?.addEventListener('change', applyFilters);
  histCheckbox?.addEventListener('change', applyFilters);

  // ── Notify wishlisters that a departure opened ──────────────────────────
  document.querySelectorAll('.notify-wishlist-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const banner = btn.closest('.wishlist-notify');
      const batchId = btn.dataset.batchId;
      if (!batchId || !confirm('Email everyone who wishlisted this departure that it is now open for booking?')) return;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/admin/wishlist/notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tripSlug, batchId }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          banner?.classList.add('done');
          banner.innerHTML = `<span>Notified ${data.sent} traveller${data.sent === 1 ? '' : 's'}${data.failed ? ` · ${data.failed} failed` : ''}.</span>`;
        } else {
          alert(data.error || 'Failed to notify.');
          btn.disabled = false;
          btn.textContent = 'Notify them';
        }
      } catch {
        alert('Network error.');
        btn.disabled = false;
        btn.textContent = 'Notify them';
      }
    });
  });

  // Restore filters carried over by reloadWithFilters() after a bulk action.
  const sp = new URLSearchParams(location.search);
  const searchEl = document.getElementById('search-input');
  const statusEl = document.getElementById('filter-status');
  if (searchEl && sp.get('q')) searchEl.value = sp.get('q');
  if (statusEl && sp.get('status')) statusEl.value = sp.get('status');
  if (depSelect && sp.get('dep')) depSelect.value = sp.get('dep');
  if (histCheckbox && sp.get('hist')) histCheckbox.checked = true;
  applyFilters();
</script>
