---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminTable from '../../../components/admin/AdminTable.astro';
import AdminCard from '../../../components/admin/AdminCard.astro';
import { getDb } from '../../../lib/db';
import { buildUnpaidLeadNudgeMessage, unpaidLeadCutoffDate, UNPAID_LEAD_NUDGE_THRESHOLD_HOURS } from '../../../lib/unpaidLeads';

export const prerender = false;

const adminUser = Astro.locals.adminUser;
if (adminUser?.role === 'trip_lead') return Astro.redirect('/admin/registrations');

const cutoff = unpaidLeadCutoffDate();
const rows = getDb().prepare(`
  SELECT id, full_name, phone, trip_name, trip_date, sharing_option, why_join, created_at, nudge_sent_at
  FROM registrations
  WHERE status = 'lead' AND datetime(created_at) <= datetime(?)
  ORDER BY datetime(created_at) ASC
`).all(cutoff.toISOString()) as Array<Record<string, any>>;

function digits(phone: string) {
  const d = String(phone || '').replace(/\D/g, '');
  if (d.length === 10) return `91${d}`;
  return d;
}

function firstName(name: string) {
  return String(name || 'there').trim().split(/\s+/)[0] || 'there';
}

function since(createdAt: string) {
  const ms = Date.now() - new Date(createdAt).getTime();
  const mins = Math.max(0, Math.floor(ms / 60000));
  if (mins < 60) return `${mins}m`;
  const hours = Math.floor(mins / 60);
  if (hours < 48) return `${hours}h`;
  return `${Math.floor(hours / 24)}d`;
}

function waLink(r: Record<string, any>) {
  const phone = digits(r.phone);
  const msg = buildUnpaidLeadNudgeMessage({
    firstName: firstName(r.full_name),
    tripName: String(r.trip_name || 'your trip'),
    departure: String(r.trip_date || 'selected dates'),
  });
  return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
}
---

<AdminLayout title="Unpaid leads" page="registrations">
  <a class="back-link" href="/admin/registrations">← Registrations</a>

  <div class="page-head">
    <div>
      <h1>Unpaid leads</h1>
      <p>Leads older than {UNPAID_LEAD_NUDGE_THRESHOLD_HOURS} hours that have not moved to payment review.</p>
    </div>
    <span>{rows.length} lead{rows.length === 1 ? '' : 's'}</span>
  </div>

  {rows.length === 0 ? (
    <div class="empty">No unpaid leads need a nudge right now.</div>
  ) : (
    <AdminCard pad="none">
      <AdminTable class="unpaid-table">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Trip</th>
            <th>Departure</th>
            <th>WhatsApp</th>
            <th>Why join</th>
            <th>Age</th>
            <th>Nudge</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>
                <strong>{r.full_name}</strong>
                <small>#{r.id}{r.nudge_sent_at ? ` · nudged ${since(r.nudge_sent_at)} ago` : ''}</small>
              </td>
              <td>{r.trip_name}</td>
              <td>{r.trip_date}{r.sharing_option ? ` · ${r.sharing_option}` : ''}</td>
              <td><a href={`tel:${r.phone}`}>{r.phone}</a></td>
              <td class="why">{r.why_join || '—'}</td>
              <td>{since(r.created_at)}</td>
              <td><a class="chat" href={waLink(r)} target="_blank" rel="noopener noreferrer" data-nudge-id={r.id}>Chat</a></td>
            </tr>
          ))}
        </tbody>
      </table>
      </AdminTable>
      </AdminCard>
  )}
</AdminLayout>

<style>
  /* coral-ink, not coral, on every one of these: --color-coral is 3.0:1 on white
     and 2.75:1 on blush, so as text at these sizes all three failed AA. See the
     coral-as-text rule in tokens.css. */
  .back-link{display:inline-block;margin-bottom:.75rem;color:var(--color-gray-text);font-weight:700;font-size:.82rem;text-decoration:none}
  .back-link:hover{color:var(--color-coral-ink)}

  .page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;margin-bottom:1rem;background:var(--color-white);border:1px solid var(--color-border);border-radius:var(--radius-card);padding:1rem}
  .page-head h1{margin:0;font:800 1.45rem var(--font-display);color:var(--color-navy)}
  .page-head p{margin:.25rem 0 0;color:var(--color-gray-text);font-size:.86rem}
  .page-head span{padding:.25rem .65rem;border-radius:var(--radius-pill);background:var(--color-blush);color:var(--color-coral-ink);font-weight:800;font-size:.8rem;white-space:nowrap}

  .empty{background:var(--color-white);border:1px solid var(--color-border);border-radius:var(--radius-card);padding:2rem;text-align:center;color:var(--color-gray-text)}

  /* Shared table treatment now comes from `.admin-table` (src/styles/admin.css).
     What stays here is genuinely page-specific: this table has seven columns and
     free-text in one of them, so it needs a scroll floor and top-aligned cells. */
  /* `:global()` is load-bearing here. `.unpaid-table` lands on the <div> that
     AdminTable renders, and Astro's scope hash does not cross a component
     boundary — so a plain `.unpaid-table table` selector compiles to
     `.unpaid-table[data-astro-cid-X] table[data-astro-cid-X]`, and that <div>
     never carries the page's cid. The rules were silently dead. */
  :global(.unpaid-table table){min-width:920px}
  :global(.unpaid-table td){vertical-align:top}
  td strong{display:block}
  td small{display:block;margin-top:.2rem;color:var(--color-gray-text);font-size:.72rem}
  .why{max-width:280px;color:var(--color-gray-text);line-height:1.35}
  .chat{display:inline-block;padding:.45rem .75rem;border-radius:.5rem;background:var(--color-whatsapp);color:var(--color-navy);font-weight:800;text-decoration:none}
  td a:not(.chat){color:var(--color-coral-ink);font-weight:700}

  @media(max-width:700px){.page-head{flex-direction:column}}
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-nudge-id]').forEach((link) => {
    link.addEventListener('click', () => {
      const id = Number(link.dataset.nudgeId || 0);
      if (!id) return;
      fetch('/api/admin/registrations/nudge-sent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      }).catch(() => {});
    });
  });
</script>
