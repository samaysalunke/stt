---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { buildTripOptions } from '../../../lib/adminTripOptions';
export const prerender = false;

const tripsData = buildTripOptions();
const preselectTrip = Astro.url.searchParams.get('trip') ?? '';
const preselectDeparture = Astro.url.searchParams.get('departure') ?? '';

const inputStyle = 'width:100%;padding:0.55rem 0.75rem;border:1.5px solid var(--color-border);border-radius:0.5rem;font-size:0.875rem;font-family:var(--font-sans);box-sizing:border-box;';
const labelStyle = 'display:block;font-size:0.78rem;font-weight:700;color:var(--color-text-secondary);margin:0 0 0.3rem;text-transform:uppercase;letter-spacing:0.03em;';
---

<AdminLayout title="Import Registrations" page="registrations">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;">
    <p style="font-size:0.875rem;color:var(--color-text-secondary);margin:0;">Bulk-add registrations to one trip + departure from a CSV. Preview before importing.</p>
    <a href="/admin/registrations" style="font-size:0.875rem;font-weight:600;color:var(--color-coral);text-decoration:none;">← Back to registrations</a>
  </div>

  {tripsData.length === 0 ? (
    <p style="text-align:center;padding:3rem;color:var(--color-text-secondary);background:white;border-radius:0.75rem;border:1px solid var(--color-border);">No trips with departures to import into.</p>
  ) : (
    <div style="max-width:820px;background:white;border:1px solid var(--color-border);border-radius:0.9rem;padding:1.5rem;display:flex;flex-direction:column;gap:1.1rem;">

      <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;color:var(--color-text-primary);cursor:pointer;">
        <input type="checkbox" id="backfill" /> Show past departures (historical back-fill)
      </label>

      <!-- Destination -->
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
        <div style="grid-column:1 / -1;">
          <label style={labelStyle}>Trip *</label>
          <select id="trip" style={inputStyle}><option value="">Select a trip…</option></select>
        </div>
        <div><label style={labelStyle}>Departure *</label><select id="departure" style={inputStyle}><option value="">Select trip first…</option></select></div>
        <div><label style={labelStyle}>Occupancy *</label><select id="tier" style={inputStyle}><option value="">—</option></select></div>
        <div><label style={labelStyle}>Status</label>
          <select id="status" style={inputStyle}>
            <option value="pending" selected>Pending</option><option value="lead">Lead</option><option value="confirmed">Confirmed</option>
          </select>
        </div>
      </div>

      <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;color:var(--color-text-primary);cursor:pointer;">
        <input type="checkbox" id="sendEmail" /> Send notification emails (off by default for imports)
      </label>
      <label id="capacity-override-row" style="display:none;align-items:center;gap:0.5rem;font-size:0.85rem;color:#991B1B;cursor:pointer;">
        <input type="checkbox" id="capacityOverride" /> Import despite capacity mismatch
      </label>

      <hr style="border:none;border-top:1px solid var(--color-border);margin:0;" />

      <!-- CSV -->
      <div style="display:flex;align-items:center;justify-content:space-between;">
        <label style={labelStyle}>Registrants CSV</label>
        <div style="display:flex;gap:1rem;">
          <button id="template-btn" type="button" style="font-size:0.82rem;font-weight:600;color:var(--color-coral);background:none;border:none;cursor:pointer;">↓ Download template</button>
          <label style="font-size:0.82rem;font-weight:600;color:var(--color-coral);cursor:pointer;">Upload .csv
            <input id="csv-file" type="file" accept=".csv,text/csv" style="display:none;" />
          </label>
        </div>
      </div>
      <textarea id="csv-content" rows="8" placeholder="full_name,email,phone,age,gender,city,instagram,emergency_name,emergency_phone,why_join"
        style="width:100%;padding:0.75rem;border:1.5px solid var(--color-border);border-radius:0.5rem;font-size:0.82rem;font-family:monospace;box-sizing:border-box;line-height:1.5;"></textarea>
      <p style="font-size:0.75rem;color:var(--color-text-secondary);margin:0;">Required columns: <strong>full_name, email, phone</strong>. Optional: age, gender, city, instagram, emergency_name, emergency_phone, why_join.</p>

      <div style="display:flex;gap:0.75rem;align-items:center;">
        <button id="preview-btn" type="button" style="padding:0.55rem 1.25rem;background:var(--color-navy);color:white;border:none;border-radius:0.5rem;font-size:0.875rem;font-weight:700;cursor:pointer;">Preview</button>
        <span id="import-msg" style="font-size:0.85rem;color:var(--color-text-secondary);"></span>
      </div>

      <!-- Preview -->
      <div id="preview-box" style="display:none;">
        <div id="preview-summary" style="display:flex;gap:0.5rem;margin-bottom:0.75rem;flex-wrap:wrap;"></div>
        <div id="preview-list" style="max-height:340px;overflow:auto;border:1px solid var(--color-border);border-radius:0.5rem;"></div>
        <div id="confirm-row" style="display:none;align-items:center;gap:0.75rem;margin-top:1rem;">
          <button id="confirm-btn" type="button" style="padding:0.6rem 1.5rem;background:var(--color-cta, #D95F3B);color:white;border:none;border-radius:0.5rem;font-size:0.875rem;font-weight:700;cursor:pointer;"></button>
          <span style="font-size:0.78rem;color:var(--color-text-secondary);">Only rows marked “create” will be imported.</span>
        </div>
      </div>

      <div id="result-box" style="display:none;font-size:0.875rem;padding:0.85rem 1rem;border-radius:0.5rem;background:rgba(34,166,84,0.10);color:var(--color-success);"></div>
    </div>
  )}

  <script is:inline define:vars={{ tripsData, preselectTrip, preselectDeparture }}>
    const tripSel = document.getElementById('trip');
    const depSel = document.getElementById('departure');
    const tierSel = document.getElementById('tier');
    const backfill = document.getElementById('backfill');
    const bySlug = Object.fromEntries(tripsData.map((t) => [t.slug, t]));

    const visibleTrips = () => tripsData.filter((t) => backfill.checked || t.hasUpcoming);
    const visibleDeps = (t) => (t ? t.departures.filter((d) => backfill.checked || !d.past) : []);

    function refreshTrips(keepSlug) {
      const cur = keepSlug ?? tripSel.value;
      tripSel.innerHTML = '<option value="">Select a trip…</option>';
      for (const t of visibleTrips()) { const o = document.createElement('option'); o.value = t.slug; o.textContent = t.name; tripSel.appendChild(o); }
      if (cur && visibleTrips().some((t) => t.slug === cur)) { tripSel.value = cur; fillDepartures(cur); }
      else { depSel.innerHTML = '<option value="">Select trip first…</option>'; tierSel.innerHTML = '<option value="">—</option>'; }
    }
    function fillDepartures(slug, preferredDeparture) {
      const t = bySlug[slug];
      const deps = visibleDeps(t);
      depSel.innerHTML = '<option value="">Select departure…</option>';
      tierSel.innerHTML = '<option value="">—</option>';
      for (const d of deps) { const o = document.createElement('option'); o.value = d.id; o.textContent = d.label; depSel.appendChild(o); }
      const selected = preferredDeparture && deps.some((d) => d.id === preferredDeparture)
        ? preferredDeparture : deps.length === 1 ? deps[0].id : '';
      if (selected) { depSel.value = selected; fillTiers(slug, selected); }
    }
    function fillTiers(slug, depId) {
      const t = bySlug[slug];
      const d = t && t.departures.find((x) => x.id === depId);
      tierSel.innerHTML = '';
      if (!d) { tierSel.innerHTML = '<option value="">—</option>'; return; }
      for (const off of d.offers) { const o = document.createElement('option'); o.value = off.tierId; o.textContent = off.label + ' — ₹' + off.price.toLocaleString('en-IN'); tierSel.appendChild(o); }
    }
    tripSel?.addEventListener('change', () => fillDepartures(tripSel.value));
    depSel?.addEventListener('change', () => fillTiers(tripSel.value, depSel.value));
    backfill?.addEventListener('change', () => refreshTrips());
    if (preselectTrip && bySlug[preselectTrip] && (
      !bySlug[preselectTrip].hasUpcoming || bySlug[preselectTrip].departures.some((d) => d.id === preselectDeparture && d.past)
    )) backfill.checked = true;
    refreshTrips(preselectTrip);
    if (preselectTrip && tripSel.value === preselectTrip) fillDepartures(preselectTrip, preselectDeparture);

    // CSV file → textarea
    const fileInput = document.getElementById('csv-file');
    const textarea = document.getElementById('csv-content');
    const msg = document.getElementById('import-msg');
    fileInput?.addEventListener('change', async () => {
      const f = fileInput.files && fileInput.files[0];
      if (f) { textarea.value = await f.text(); msg.textContent = 'Loaded ' + f.name; }
    });

    // Template download
    const HEADERS = 'full_name,email,phone,age,gender,city,instagram,emergency_name,emergency_phone,why_join';
    document.getElementById('template-btn')?.addEventListener('click', () => {
      const sample = HEADERS + '\n' + 'Asha Rao,asha@example.com,+91 9000000001,28,female,Pune,@asharao,Mom,+91 9000000002,Excited for the trek';
      const blob = new Blob([sample], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob); a.download = 'registrations-template.csv'; a.click();
      URL.revokeObjectURL(a.href);
    });

    const previewBox = document.getElementById('preview-box');
    const previewSummary = document.getElementById('preview-summary');
    const previewList = document.getElementById('preview-list');
    const confirmRow = document.getElementById('confirm-row');
    const confirmBtn = document.getElementById('confirm-btn');
    const resultBox = document.getElementById('result-box');

    function selectionPayload(dryRun) {
      return {
        tripSlug: tripSel.value, batchId: depSel.value, tierId: tierSel.value,
        status: document.getElementById('status').value,
        sendEmail: document.getElementById('sendEmail').checked,
        capacityOverride: document.getElementById('capacityOverride').checked,
        csv: textarea.value, dryRun,
      };
    }
    function validSelection() {
      if (!tripSel.value || !depSel.value || !tierSel.value) { msg.textContent = 'Pick a trip, departure, and occupancy.'; return false; }
      if (!textarea.value.trim()) { msg.textContent = 'Upload or paste a CSV first.'; return false; }
      return true;
    }
    const badge = (n, label, color) => `<span style="padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.75rem;font-weight:700;${color}">${n} ${label}</span>`;
    const actionStyle = (a) => a === 'create' ? 'background:#D1FAE5;color:#065F46;' : a === 'skip' ? 'background:#FEF3C7;color:#92400E;' : 'background:#FEE2E2;color:#991B1B;';

    function renderPreview(data) {
      previewBox.style.display = 'block';
      previewSummary.innerHTML =
        badge(data.counts.create, 'create', 'background:#D1FAE5;color:#065F46;') +
        badge(data.counts.skip, 'skip', 'background:#FEF3C7;color:#92400E;') +
        badge(data.counts.error, 'error', 'background:#FEE2E2;color:#991B1B;') +
        badge(data.counts.superseded || 0, 'superseded', 'background:#E5E7EB;color:#374151;') +
        (data.totals || []).map(t => badge(t.lead + t.pending + t.confirmed, `${t.tierId}: ${t.confirmed} confirmed`, 'background:#DBEAFE;color:#1E40AF;')).join('') +
        (data.capacity || []).filter(c => c.conflict).map(c => badge(c.totalConfirmed, `${c.tierId} over cap ${c.cap} (${c.existingConfirmed} existing + ${c.proposedConfirmed} proposed)`, 'background:#FEE2E2;color:#991B1B;')).join('');
      const overrideRow = document.getElementById('capacity-override-row');
      overrideRow.style.display = data.hasCapacityConflict ? 'flex' : 'none';
      if (!data.hasCapacityConflict) document.getElementById('capacityOverride').checked = false;
      previewList.innerHTML = data.preview.map((p) => `
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;padding:0.5rem 0.75rem;border-bottom:1px solid var(--color-border);font-size:0.82rem;">
          <div style="min-width:0;"><span style="font-weight:600;color:var(--color-navy);">#${p.row} ${p.name}</span> <span style="color:var(--color-text-secondary);">${p.email}</span></div>
          <span style="padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:700;white-space:nowrap;${actionStyle(p.action)}">${p.tierId} · ${p.status} · ${p.action}${p.reason ? ' · ' + p.reason : ''}</span>
        </div>`).join('');
    }

    document.getElementById('preview-btn')?.addEventListener('click', async () => {
      resultBox.style.display = 'none';
      if (!validSelection()) return;
      msg.textContent = 'Checking…';
      try {
        const res = await fetch('/api/admin/registrations/import', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(selectionPayload(true)) });
        const data = await res.json();
        msg.textContent = '';
        if (!data.success) { msg.textContent = data.error || 'Could not parse.'; previewBox.style.display = 'none'; return; }
        renderPreview(data);
        if (data.counts.create > 0) {
          confirmRow.style.display = 'flex';
          confirmBtn.textContent = `Import ${data.counts.create} registration${data.counts.create === 1 ? '' : 's'}`;
        } else { confirmRow.style.display = 'none'; }
      } catch { msg.textContent = 'Network error.'; }
    });

    confirmBtn?.addEventListener('click', async () => {
      confirmBtn.disabled = true; confirmBtn.textContent = 'Importing…';
      try {
        const res = await fetch('/api/admin/registrations/import', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(selectionPayload(false)) });
        const data = await res.json();
        if (data.success) {
          previewBox.style.display = 'none';
          resultBox.style.display = 'block';
          resultBox.textContent = `✓ Imported ${data.created} registration${data.created === 1 ? '' : 's'} (${data.counts.skip} skipped, ${data.counts.error} errors). Redirecting…`;
          setTimeout(() => { window.location.href = '/admin/registrations'; }, 1400);
        } else {
          confirmBtn.disabled = false; confirmBtn.textContent = 'Try again';
          msg.textContent = data.error || 'Import failed.';
        }
      } catch { confirmBtn.disabled = false; confirmBtn.textContent = 'Try again'; msg.textContent = 'Network error.'; }
    });
  </script>
</AdminLayout>
