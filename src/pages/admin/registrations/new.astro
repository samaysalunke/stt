---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { buildTripOptions } from '../../../lib/adminTripOptions';
import { ADMIN_REG_INPUT_CLASS as inputCls, ADMIN_REG_LABEL_CLASS as labelCls } from '../../../components/admin/formClasses';
export const prerender = false;

const tripsData = buildTripOptions();
const preselectTrip = Astro.url.searchParams.get('trip') ?? '';
const preselectDeparture = Astro.url.searchParams.get('departure') ?? '';
---

<AdminLayout title="Add Registration" page="registrations">
  <div class="flex items-center justify-between mb-[1.25rem]">
    <p class="text-[0.875rem] text-gray-text m-0">Add a single registration manually (e.g. an offline or phone booking).</p>
    <a href="/admin/registrations" class="text-[0.875rem] font-semibold text-coral no-underline">← Back to registrations</a>
  </div>

  {tripsData.length === 0 ? (
    <p class="text-center p-[3rem] text-gray-text bg-white rounded-[0.75rem] border border-border">No trips with departures to add registrations to.</p>
  ) : (
    <form id="reg-form" class="max-w-[720px] bg-white border border-border rounded-[0.9rem] p-[1.5rem] flex flex-col gap-[1.1rem]">

      <label class="flex items-center gap-[0.5rem] text-[0.85rem] text-navy cursor-pointer">
        <input type="checkbox" id="backfill" /> Show past departures (historical back-fill)
      </label>

      <!-- Trip / departure / occupancy -->
      <div class="reg-form-grid grid grid-cols-2 gap-[1rem]">
        <div class="col-span-full">
          <label class={labelCls}>Trip *</label>
          <select id="trip" class={inputCls}><option value="">Select a trip…</option></select>
        </div>
        <div>
          <label class={labelCls}>Departure *</label>
          <select id="departure" class={inputCls}><option value="">Select trip first…</option></select>
        </div>
        <div>
          <label class={labelCls}>Occupancy *</label>
          <select id="tier" class={inputCls}><option value="">—</option></select>
        </div>
      </div>

      <div class="reg-form-grid grid grid-cols-2 gap-[1rem]">
        <div>
          <label class={labelCls}>Status</label>
          <select id="status" class={inputCls}>
            <option value="pending" selected>Pending (awaiting verification)</option>
            <option value="lead">Lead (registered, unpaid)</option>
            <option value="confirmed">Confirmed</option>
          </select>
        </div>
        <div class="flex items-end pb-[0.5rem]">
          <label class="flex items-center gap-[0.5rem] text-[0.85rem] text-navy cursor-pointer">
            <input type="checkbox" id="sendEmail" checked /> Send notification email (on confirm)
          </label>
        </div>
      </div>

      <hr class="border-t border-border my-[0.25rem] mx-[0]" />

      <!-- Registrant -->
      <div class="reg-form-grid grid grid-cols-2 gap-[1rem]">
        <div><label class={labelCls}>Full name *</label><input id="full_name" type="text" class={inputCls} /></div>
        <div><label class={labelCls}>Email *</label><input id="email" type="email" class={inputCls} /></div>
        <div><label class={labelCls}>Phone *</label><input id="phone" type="tel" class={inputCls} /></div>
        <div><label class={labelCls}>Age</label><input id="age" type="text" inputmode="numeric" class={inputCls} /></div>
        <div>
          <label class={labelCls}>Gender</label>
          <select id="gender" class={inputCls}>
            <option value="">—</option><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option>
          </select>
        </div>
        <div><label class={labelCls}>City</label><input id="city" type="text" class={inputCls} /></div>
        <div><label class={labelCls}>Instagram</label><input id="instagram" type="text" class={inputCls} /></div>
        <div><label class={labelCls}>Emergency name</label><input id="emergency_name" type="text" class={inputCls} /></div>
        <div><label class={labelCls}>Emergency phone</label><input id="emergency_phone" type="tel" class={inputCls} /></div>
        <div class="col-span-full"><label class={labelCls}>Why joining / notes</label><textarea id="why_join" rows="2" class={inputCls}></textarea></div>
      </div>

      <div id="form-msg" class="hidden text-[0.85rem] py-[0.6rem] px-[0.85rem] rounded-[0.5rem]"></div>

      <div class="flex gap-[0.75rem] items-center">
        <button type="submit" id="submit-btn" class="py-[0.6rem] px-[1.5rem] bg-navy text-white border-none rounded-[0.5rem] text-[0.875rem] font-bold cursor-pointer font-sans">Add registration</button>
        <a href="/admin/registrations" class="text-[0.85rem] text-gray-text no-underline">Cancel</a>
      </div>
    </form>
  )}

  <style>
    @media (max-width: 640px) {
      .reg-form-grid { grid-template-columns: 1fr !important; }
    }
  </style>

  <script is:inline define:vars={{ tripsData, preselectTrip, preselectDeparture }}>
    const tripSel = document.getElementById('trip');
    const depSel = document.getElementById('departure');
    const tierSel = document.getElementById('tier');
    const backfill = document.getElementById('backfill');
    const bySlug = Object.fromEntries(tripsData.map((t) => [t.slug, t]));

    const visibleTrips = () => tripsData.filter((t) => backfill.checked || t.hasUpcoming);
    const visibleDeps = (t) => (t ? t.departures.filter((d) => backfill.checked || !d.past) : []);

    function refreshTrips(keepSlug) {
      const cur = keepSlug ?? tripSel.value;
      tripSel.innerHTML = '<option value="">Select a trip…</option>';
      for (const t of visibleTrips()) {
        const o = document.createElement('option');
        o.value = t.slug; o.textContent = t.name;
        tripSel.appendChild(o);
      }
      if (cur && visibleTrips().some((t) => t.slug === cur)) { tripSel.value = cur; fillDepartures(cur); }
      else { depSel.innerHTML = '<option value="">Select trip first…</option>'; tierSel.innerHTML = '<option value="">—</option>'; }
    }
    function fillDepartures(slug, preferredDeparture) {
      const t = bySlug[slug];
      const deps = visibleDeps(t);
      depSel.innerHTML = '<option value="">Select departure…</option>';
      tierSel.innerHTML = '<option value="">—</option>';
      for (const d of deps) { const o = document.createElement('option'); o.value = d.id; o.textContent = d.label; depSel.appendChild(o); }
      const selected = preferredDeparture && deps.some((d) => d.id === preferredDeparture)
        ? preferredDeparture : deps.length === 1 ? deps[0].id : '';
      if (selected) { depSel.value = selected; fillTiers(slug, selected); }
    }
    function fillTiers(slug, depId) {
      const t = bySlug[slug];
      const d = t && t.departures.find((x) => x.id === depId);
      tierSel.innerHTML = '';
      if (!d) { tierSel.innerHTML = '<option value="">—</option>'; return; }
      for (const off of d.offers) { const o = document.createElement('option'); o.value = off.tierId; o.textContent = off.label + ' — ₹' + off.price.toLocaleString('en-IN'); tierSel.appendChild(o); }
    }

    tripSel?.addEventListener('change', () => fillDepartures(tripSel.value));
    depSel?.addEventListener('change', () => fillTiers(tripSel.value, depSel.value));
    backfill?.addEventListener('change', () => refreshTrips());

    // If the preselected trip only has past departures, start in back-fill mode.
    if (preselectTrip && bySlug[preselectTrip] && (
      !bySlug[preselectTrip].hasUpcoming || bySlug[preselectTrip].departures.some((d) => d.id === preselectDeparture && d.past)
    )) backfill.checked = true;
    refreshTrips(preselectTrip);
    if (preselectTrip && tripSel.value === preselectTrip) fillDepartures(preselectTrip, preselectDeparture);

    const form = document.getElementById('reg-form');
    const msg = document.getElementById('form-msg');
    const btn = document.getElementById('submit-btn');
    function showMsg(text, ok) {
      msg.style.display = 'block';
      msg.textContent = text;
      msg.style.background = ok ? 'rgba(34,166,84,0.10)' : '#FEE2E2';
      msg.style.color = ok ? 'var(--color-success)' : '#991B1B';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (id) => (document.getElementById(id)).value.trim();
      if (!tripSel.value || !depSel.value || !tierSel.value) return showMsg('Pick a trip, departure, and occupancy.', false);
      btn.disabled = true; btn.textContent = 'Saving…';
      const payload = {
        tripSlug: tripSel.value, batchId: depSel.value, tierId: tierSel.value,
        status: val('status'), sendEmail: document.getElementById('sendEmail').checked,
        full_name: val('full_name'), email: val('email'), phone: val('phone'),
        age: val('age'), gender: val('gender'), city: val('city'), instagram: val('instagram'),
        emergency_name: val('emergency_name'), emergency_phone: val('emergency_phone'), why_join: val('why_join'),
      };
      try {
        const res = await fetch('/api/admin/registrations/create', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.success) {
          showMsg('Registration added. Redirecting…', true);
          setTimeout(() => { window.location.href = '/admin/registrations'; }, 900);
        } else {
          showMsg(data.error || 'Could not add registration.', false);
          btn.disabled = false; btn.textContent = 'Add registration';
        }
      } catch {
        showMsg('Network error. Try again.', false);
        btn.disabled = false; btn.textContent = 'Add registration';
      }
    });
  </script>
</AdminLayout>
