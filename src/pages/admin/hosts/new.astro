---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ADMIN_CONTENT_INPUT_CLASS as inputCls, ADMIN_CONTENT_LABEL_CLASS as labelCls } from '../../../components/admin/formClasses';
export const prerender = false;

const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="New Host" page="hosts">
  {error === 'duplicate' && (
    <p class="mb-4 text-sm text-danger">A host with that name already exists.</p>
  )}
  <form method="POST" action="/api/admin/hosts/create" enctype="multipart/form-data" class="bg-white rounded-[2rem] p-6 max-w-2xl border border-peach/60">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={labelCls}>Name</label>
        <input type="text" name="name" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls}>Subtitle</label>
        <input type="text" name="subtitle" placeholder="e.g. Founder, Seek the Thrill" class={inputCls} />
      </div>
      <div class="sm:col-span-2">
        <label class={labelCls}>Photo</label>
        <input type="file" name="photo" accept="image/*" class={inputCls} />
        <p class="mt-1.5 text-xs text-gray-text">Square crop reads best at 44px.</p>
      </div>
      <div class="sm:col-span-2">
        <label class={labelCls}>Bio</label>
        <textarea name="bio" rows="4" class={inputCls}></textarea>
      </div>
    </div>
    <div class="flex items-center gap-3 mt-6">
      <button type="submit" class="rounded-full px-7 py-3 text-sm font-semibold text-white bg-cta">Create</button>
      <a href="/admin/hosts/" class="text-sm font-medium text-gray-text">Cancel</a>
    </div>
  </form>
</AdminLayout>
