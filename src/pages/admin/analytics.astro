---
import '../../styles/global.css';
export const prerender = false;
const adminUser = Astro.locals.adminUser;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Analytics Chat - Seek the Thrill Admin</title>
  </head>
  <body>
    <main class="analytics-shell">
      <header class="topbar">
        <a href="/admin/" class="back-link" aria-label="Back to admin">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </a>
        <div>
          <h1>Analytics Chat</h1>
          <p>{adminUser?.email}</p>
        </div>
      </header>

      <section id="history" class="history" aria-live="polite">
        <div class="empty" id="empty-state">
          <h2>Ask a data question</h2>
          <p class="hint">Tap a suggestion or type your own</p>
          <div class="chips" data-default-suggestions></div>
        </div>
      </section>

      <form id="chat-form" class="composer">
        <input id="chat-input" name="message" autocomplete="off" placeholder="Ask about revenue, trips, payments, demographics, trends..." />
        <button type="submit" aria-label="Send">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>
    </main>

    <script>
      const defaults = [
        'How much revenue came from the past 3 trips?',
        'List the top 3 trips by revenue.',
        'Show pending payments by trip.',
        'What is the male vs female ratio across all trips?',
        "What's the age distribution of our customers?",
        'Show daily revenue trend for the last 30 days.',
        'How many repeat customers do we have?',
      ];

      let conversationId = null;
      let pendingQuestion = '';
      const history = document.getElementById('history');
      const form = document.getElementById('chat-form');
      const input = document.getElementById('chat-input');
      const empty = document.getElementById('empty-state');

      function renderSuggestions(container, suggestions = defaults) {
        container.innerHTML = '';
        suggestions.forEach((text) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'chip';
          chip.textContent = text;
          chip.addEventListener('click', () => sendMessage(text));
          container.appendChild(chip);
        });
      }

      renderSuggestions(document.querySelector('[data-default-suggestions]'));

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        input.value = '';
        sendMessage(text);
      });

      async function sendMessage(message, selection = null) {
        pendingQuestion = message;
        empty?.remove();
        if (!selection) addBubble('user', message);
        const assistant = addBubble('assistant', '');
        const body = { message, conversationId, selection };
        setBusy(true);

        try {
          const res = await fetch('/api/admin/analytics/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok || !res.body) throw new Error('network');
          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const events = buffer.split('\n\n');
            buffer = events.pop() || '';
            for (const event of events) handleSse(event, assistant);
          }
        } catch {
          assistant.textContent = 'Something went wrong. Try again.';
          assistant.classList.add('error');
        } finally {
          setBusy(false);
        }
      }

      function handleSse(raw, assistant) {
        const lines = raw.split('\n');
        const event = lines.find((line) => line.startsWith('event:'))?.slice(6).trim();
        const dataLine = lines.find((line) => line.startsWith('data:'));
        if (!event || !dataLine) return;
        const data = JSON.parse(dataLine.slice(5));
        if (event === 'token') {
          assistant.textContent += data.text || '';
          history.scrollTop = history.scrollHeight;
        }
        if (event === 'final') {
          conversationId = data.conversationId || conversationId;
          if (data.error) {
            assistant.textContent = data.error;
            assistant.classList.add('error');
          } else if (data.answer && !assistant.textContent.trim()) {
            assistant.textContent = data.answer;
          }
          if (data.needsSelection) renderSelection(assistant.parentElement, data.needsSelection);
          if (data.data?.columns?.length) renderTable(assistant.parentElement, data.data);
          if (data.suggestedQuestions?.length) renderFollowups(assistant.parentElement, data.suggestedQuestions);
          history.scrollTop = history.scrollHeight;
        }
      }

      function addBubble(role, text) {
        const wrap = document.createElement('article');
        wrap.className = `turn ${role}`;
        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.textContent = text;
        wrap.appendChild(bubble);
        history.appendChild(wrap);
        history.scrollTop = history.scrollHeight;
        return bubble;
      }

      function renderSelection(parent, selection) {
        const box = document.createElement('div');
        box.className = 'selection';
        selection.options.forEach((option) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = [option.label, option.dateRange, option.status].filter(Boolean).join(' · ');
          btn.addEventListener('click', () => {
            [...box.querySelectorAll('button')].forEach((b) => b.disabled = true);
            sendMessage(pendingQuestion, { type: selection.type, id: option.id });
          });
          box.appendChild(btn);
        });
        parent.appendChild(box);
      }

      function renderTable(parent, data) {
        const wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        const table = document.createElement('table');
        const thead = document.createElement('thead');
        const tr = document.createElement('tr');
        data.columns.forEach((col) => {
          const th = document.createElement('th');
          th.textContent = col;
          tr.appendChild(th);
        });
        thead.appendChild(tr);
        table.appendChild(thead);
        const tbody = document.createElement('tbody');
        data.rows.forEach((row) => {
          const r = document.createElement('tr');
          row.forEach((cell) => {
            const td = document.createElement('td');
            td.textContent = cell == null ? '' : String(cell);
            r.appendChild(td);
          });
          tbody.appendChild(r);
        });
        table.appendChild(tbody);
        wrap.appendChild(table);
        parent.appendChild(wrap);
      }

      function renderFollowups(parent, suggestions) {
        const chips = document.createElement('div');
        chips.className = 'chips followups';
        renderSuggestions(chips, suggestions);
        parent.appendChild(chips);
      }

      function setBusy(busy) {
        input.disabled = busy;
        form.querySelector('button').disabled = busy;
      }
    </script>

    <style>
      :root { color-scheme: light; }
      body { margin: 0; min-height: 100vh; background: #ece5dd; color: #1b2b3a; font-family: var(--font-sans); }
      .analytics-shell { height: 100vh; display: grid; grid-template-rows: auto 1fr auto; }

      /* WhatsApp-style header bar */
      .topbar { height: 60px; display: flex; align-items: center; gap: 12px; padding: 0 14px; background: #1b2b3a; color: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.18); position: relative; z-index: 2; }
      .topbar h1 { margin: 0; font-family: var(--font-display); font-size: 18px; }
      .topbar p { margin: 1px 0 0; font-size: 12px; color: rgba(255,255,255,.6); }
      .back-link { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; border: none; color: #fff; background: transparent; }
      .back-link:hover { background: rgba(255,255,255,.12); }
      svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

      /* Chat surface — subtle paper texture like WhatsApp */
      .history { overflow-y: auto; padding: 16px clamp(10px, 3vw, 28px); background-color: #ece5dd; background-image: radial-gradient(rgba(27,43,58,.035) 1px, transparent 1px); background-size: 22px 22px; }

      .empty { max-width: 560px; margin: 6vh auto 0; text-align: center; }
      .empty h2 { font-family: var(--font-display); font-size: clamp(24px, 5vw, 40px); margin: 0 0 6px; }
      .empty .hint { margin: 0 0 22px; font-size: 14px; color: rgba(27,43,58,.55); }

      /* Chat rows + bubbles with tails */
      .turn { display: flex; flex-direction: column; gap: 6px; max-width: 980px; margin: 0 auto 10px; }
      .turn.user { align-items: flex-end; }
      .turn.assistant { align-items: flex-start; }
      .bubble { position: relative; max-width: min(75%, 620px); white-space: pre-wrap; line-height: 1.5; font-size: 14.5px; padding: 8px 12px 9px; border-radius: 12px; box-shadow: 0 1px 1px rgba(0,0,0,.12); }
      .assistant .bubble { background: #fff; border-top-left-radius: 3px; }
      .user .bubble { background: #d6f0c8; border-top-right-radius: 3px; }
      .bubble.error { background: #fff1f1; color: #991b1b; }
      /* little tail triangles */
      .assistant .bubble::before { content: ''; position: absolute; top: 0; left: -7px; width: 0; height: 0; border: 7px solid transparent; border-top-color: #fff; border-right: 0; }
      .user .bubble::before { content: ''; position: absolute; top: 0; right: -7px; width: 0; height: 0; border: 7px solid transparent; border-top-color: #d6f0c8; border-left: 0; }

      /* Composer */
      .composer { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 8px clamp(8px, 3vw, 20px); background: #f3eee8; border-top: 1px solid rgba(27,43,58,.08); }
      .composer input { min-width: 0; height: 44px; border: 1px solid transparent; border-radius: 22px; padding: 0 16px; font: inherit; outline: none; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
      .composer input:focus { border-color: rgba(232,114,90,.4); }
      .composer button { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; border: none; background: #e8725a; color: #fff; box-shadow: 0 2px 6px rgba(232,114,90,.4); }
      .composer button:hover { background: #d9624b; }
      .composer :disabled { opacity: .55; cursor: not-allowed; }

      /* Suggestion + selection pills — clearly tappable */
      .chips, .selection { display: flex; flex-wrap: wrap; gap: 8px; }
      .empty .chips { justify-content: center; }
      .chip, .selection button { border: 1px solid rgba(232,114,90,.5); background: #fff; color: #c2563f; font-weight: 600; border-radius: 999px; padding: 9px 15px; font: inherit; font-size: 13px; cursor: pointer; box-shadow: 0 1px 3px rgba(27,43,58,.08); transition: background .15s, color .15s, transform .05s; }
      .chip:hover, .selection button:hover { background: #e8725a; color: #fff; border-color: #e8725a; }
      .chip:active, .selection button:active { transform: scale(.97); }
      .selection { margin-top: 2px; }
      .selection button { color: #1b2b3a; border-color: rgba(27,43,58,.2); font-weight: 500; }
      .selection button:disabled { opacity: .5; cursor: default; }
      .followups { max-width: 75%; margin-top: 2px; }

      .table-wrap { max-width: min(75%, 620px); overflow-x: auto; border-radius: 10px; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.12); }
      table { border-collapse: collapse; min-width: 100%; font-size: 13px; }
      th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid rgba(27,43,58,.08); white-space: nowrap; }
      th { background: #f3eee8; font-weight: 700; color: rgba(27,43,58,.7); }

      @media (max-width: 640px) {
        .bubble, .table-wrap, .followups { max-width: 85%; }
        .topbar { padding: 0 10px; }
      }
    </style>
  </body>
</html>
