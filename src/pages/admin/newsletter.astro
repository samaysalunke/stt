---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import { getDb } from '../../lib/db';
export const prerender = false;

const subscribers = getDb()
  .prepare('SELECT * FROM newsletter_subscribers ORDER BY id DESC')
  .all() as Record<string, any>[];

const active = subscribers.filter(s => s.active === 1).length;

function fmt(date: string) {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<AdminLayout title="Newsletter" page="newsletter">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-display text-2xl font-extrabold text-navy-deep mt-0 mx-0 mb-1">Newsletter Subscribers</h1>
      <p class="text-gray-text text-sm m-0">{active} active · {subscribers.length} total</p>
    </div>
    <Button href="/api/admin/export?type=newsletter" variant="primary" size="sm">
      ↓ Export CSV
    </Button>
  </div>

  {subscribers.length === 0 ? (
    <p class="text-center p-12 text-gray-text bg-white border border-peach/60 rounded-[var(--radius-card)]">No subscribers yet.</p>
  ) : (
    <div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
      {subscribers.map((s) => (
        <div class="bg-white border border-peach/60 rounded-[var(--radius-card)] py-4 px-4.5 flex flex-col gap-2.5">
          <div class="flex items-start justify-between gap-2">
            <span class="font-semibold text-navy break-all text-sm">{s.email}</span>
            <span style={`flex:none;padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.7rem;font-weight:700;${s.active ? 'background:var(--color-success-surface);color:var(--color-success-surface-ink);' : 'background:var(--color-muted-surface);color:var(--color-muted-ink);'}`}>
              {s.active ? 'active' : 'unsubscribed'}
            </span>
          </div>
          <div class="flex items-center justify-between text-xs text-gray-text">
            <span>#{s.id}</span>
            <span>{fmt(s.subscribed_at as string)}</span>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>
