---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
export const prerender = false;

const subscribers = getDb()
  .prepare('SELECT * FROM newsletter_subscribers ORDER BY id DESC')
  .all() as Record<string, any>[];

const active = subscribers.filter(s => s.active === 1).length;

function fmt(date: string) {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<AdminLayout title="Newsletter" page="newsletter">
  <div class="flex items-center justify-between mb-[1.5rem]">
    <div>
      <h1 class="font-display text-[1.5rem] font-extrabold text-[#111D27] mt-[0] mx-[0] mb-[0.25rem]">Newsletter Subscribers</h1>
      <p class="text-gray-text text-[0.875rem] m-0">{active} active · {subscribers.length} total</p>
    </div>
    <a
      href="/api/admin/export?type=newsletter"
      class="py-[0.45rem] px-[1rem] bg-navy text-white rounded-[0.5rem] text-[0.875rem] font-semibold no-underline"
    >
      ↓ Export CSV
    </a>
  </div>

  {subscribers.length === 0 ? (
    <p class="text-center p-[3rem] text-gray-text bg-white border border-peach/60 rounded-[1.25rem]">No subscribers yet.</p>
  ) : (
    <div class="grid gap-[0.75rem] grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
      {subscribers.map((s) => (
        <div class="bg-white border border-peach/60 rounded-[1.25rem] py-[1rem] px-[1.15rem] flex flex-col gap-[0.6rem]">
          <div class="flex items-start justify-between gap-[0.5rem]">
            <span class="font-semibold text-navy break-all text-[0.9rem]">{s.email}</span>
            <span style={`flex:none;padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.7rem;font-weight:700;${s.active ? 'background:#D1FAE5;color:#065F46;' : 'background:#F3F4F6;color:#6B7280;'}`}>
              {s.active ? 'active' : 'unsubscribed'}
            </span>
          </div>
          <div class="flex items-center justify-between text-[0.75rem] text-gray-text">
            <span>#{s.id}</span>
            <span>{fmt(s.subscribed_at as string)}</span>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>
