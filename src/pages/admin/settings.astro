---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import { ABOUT_DEFAULTS } from '../../lib/aboutDefaults';
import { readSiteSettings } from '../../lib/content';
import { telegramActionsConfigured, telegramBotUsername } from '../../lib/telegram';
import { linkForUser } from '../../lib/telegramLink';
import { ADMIN_CONTENT_INPUT_CLASS as inputCls, ADMIN_CONTENT_LABEL_CLASS as labelCls } from '../../components/admin/formClasses';
export const prerender = false;

const s = readSiteSettings();
const saved = Astro.url.searchParams.get('saved') === '1';

const cardCls = 'bg-white rounded-[var(--radius-card)] p-6 mb-6';
const cardStyle = 'border: 1px solid rgba(245,221,215,0.6);';
const aboutValue = (value: unknown, fallback: string) =>
  typeof value === 'string' && value.trim() ? value : fallback;
const aboutPrinciples = Array.isArray(s.aboutPrinciples) && s.aboutPrinciples.length > 0
  ? s.aboutPrinciples
  : ABOUT_DEFAULTS.principles;

// Two-way Telegram actions. The role gate matches the endpoints: only the people
// who can move a booking in the admin UI may hold a link.
const adminUser = Astro.locals.adminUser;
const telegramCanLink = adminUser?.role === 'owner' || adminUser?.role === 'ops';
const telegramReady = telegramActionsConfigured() && Boolean(telegramBotUsername());
const telegramLink = telegramCanLink && adminUser ? linkForUser(adminUser.userId) : null;
---

<AdminLayout title="Settings" page="settings">
  {saved && (
    <div class="rounded-2xl px-4 py-3 mb-6 text-sm flex items-center gap-2 bg-success/10 text-success"
        >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
      Settings saved.
    </div>
  )}

  <form method="POST" action="/api/admin/settings/update" enctype="multipart/form-data">
    <!-- Contact & Social -->
    <section class={cardCls} style={cardStyle}>
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">Contact &amp; Social</h2>
      <p class="text-sm mb-5 text-gray-text">Shown in the footer, contact page and trip pages.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class={labelCls}>Email</label>
          <input type="email" name="email" value={s.email ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Phone</label>
          <input type="text" name="phone" value={s.phone ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>WhatsApp link</label>
          <input type="text" name="whatsappLink" value={s.whatsappLink ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Instagram URL</label>
          <input type="text" name="instagram" value={s.instagram ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Facebook URL</label>
          <input type="text" name="facebook" value={s.facebook ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>YouTube URL</label>
          <input type="text" name="youtube" value={s.youtube ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>LinkedIn URL</label>
          <input type="text" name="linkedin" value={s.linkedin ?? ''} class={inputCls} />
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>Google Business Profile URL</label>
          <input type="text" name="googleBusinessProfile" value={s.googleBusinessProfile ?? ''} class={inputCls} />
          <p class="mt-1 text-xs text-gray-500">Every link here tells search and answer engines this is the same real business. Fill in each profile that actually exists — leave the rest blank.</p>
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>Address</label>
          <input type="text" name="address" value={s.address ?? ''} class={inputCls} />
        </div>
      </div>
    </section>

    <!-- Payment Details -->
    <section class={cardCls} style={cardStyle}>
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">Payment Details</h2>
      <p class="text-sm mb-5 text-gray-text">Shown on trip booking forms and in payment reminder emails.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class={labelCls}>UPI ID</label>
          <input type="text" name="upiId" value={s.upiId ?? ''} placeholder="name@bank" class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Bank account name</label>
          <input type="text" name="bankAccountName" value={s.bankAccountName ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Account number</label>
          <input type="text" name="bankAccountNumber" value={s.bankAccountNumber ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Branch name</label>
          <input type="text" name="bankBranch" value={s.bankBranch ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>IFSC code</label>
          <input type="text" name="bankIfsc" value={s.bankIfsc ?? ''} class={inputCls} />
        </div>
      </div>
    </section>

    <!-- Policies & Payment -->
    <section class={cardCls} style={cardStyle}>
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">Legal Page Overrides</h2>
      <p class="text-sm mb-5 text-gray-text">Leave blank to use the built-in Terms / Privacy / Cancellation pages. Overrides support Markdown for headings, bold text, lists, and links.</p>
      <div class="grid gap-4">
        <div>
          <label class={labelCls}>Cancellation policy <span class="text-gray-text normal-case tracking-normal">(override)</span></label>
          <textarea name="cancellationPolicy" rows="5" placeholder="Blank = use default /cancellation page" class={inputCls}>{s.cancellationPolicy ?? ''}</textarea>
          <label class={`${labelCls} mt-2`}>Last updated</label>
          <input type="date" name="cancellationUpdatedAt" value={s.cancellationUpdatedAt ?? '2026-08-01'} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Terms &amp; conditions <span class="text-gray-text normal-case tracking-normal">(override)</span></label>
          <textarea name="termsAndConditions" rows="5" placeholder="Blank = use default /terms page" class={inputCls}>{s.termsAndConditions ?? ''}</textarea>
          <label class={`${labelCls} mt-2`}>Last updated</label>
          <input type="date" name="termsUpdatedAt" value={s.termsUpdatedAt ?? '2026-08-01'} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Privacy policy <span class="text-gray-text normal-case tracking-normal">(override)</span></label>
          <textarea name="privacyPolicy" rows="4" placeholder="Blank = use default /privacy page" class={inputCls}>{s.privacyPolicy ?? ''}</textarea>
          <label class={`${labelCls} mt-2`}>Last updated</label>
          <input type="date" name="privacyUpdatedAt" value={s.privacyUpdatedAt ?? '2026-08-01'} class={inputCls} />
        </div>
      </div>
    </section>

    <!-- Site -->
    <section class={cardCls} style={cardStyle}>
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">Site</h2>
      <p class="text-sm mb-5 text-gray-text">Analytics, search-engine verification and footer.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class={labelCls}>Google Analytics ID</label>
          <input type="text" name="googleAnalyticsId" value={s.googleAnalyticsId ?? ''} placeholder="G-XXXXXXXXXX" class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Copyright text</label>
          <input type="text" name="copyrightText" value={s.copyrightText ?? ''} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Google Search Console verification</label>
          <input type="text" name="googleSiteVerification" value={s.googleSiteVerification ?? ''} placeholder="Content value only" class={inputCls} />
          <p class="text-xs mt-1.5 text-gray-text">Paste the content value from Google’s HTML meta tag.</p>
        </div>
        <div>
          <label class={labelCls}>Bing Webmaster Tools verification</label>
          <input type="text" name="bingSiteVerification" value={s.bingSiteVerification ?? ''} placeholder="Content value only" class={inputCls} />
          <p class="text-xs mt-1.5 text-gray-text">Paste the content value from Bing’s msvalidate.01 meta tag.</p>
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>Homepage Instagram images</label>
          <textarea name="instagramImages" rows="5" placeholder="One image URL per line (blank = default images)" class={inputCls}>{(s.instagramImages ?? []).join('\n')}</textarea>
          <p class="text-xs mt-1.5 text-gray-text">One image URL per line. Shown in the homepage Instagram grid. Leave blank to use defaults.</p>
        </div>
      </div>
    </section>

    <!-- About Page -->
    <section class={cardCls} style={cardStyle}>
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">About Page</h2>
      <p class="text-sm mb-5 text-gray-text">Copy for the <a href="/about/" target="_blank" class="underline text-coral-ink">/about</a> page. Leave any field blank to use the built-in default.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class={labelCls}>Portrait photo</label>
          {(s.aboutFounderImage || ABOUT_DEFAULTS.founderImage) && (
            <img
              src={s.aboutFounderImage || ABOUT_DEFAULTS.founderImage}
              alt="Current About page portrait"
              class="mb-3 h-48 w-36 rounded-xl object-cover"
            />
          )}
          <input
            id="about-founder-image"
            type="file"
            name="aboutFounderImage"
            accept="image/jpeg,image/png,image/webp"
            class={inputCls}
           
          />
          <img
            id="about-founder-image-preview"
            alt="New About page portrait preview"
            class="mt-3 hidden h-48 w-36 rounded-xl object-cover"
          />
          <p class="text-xs mt-1.5 text-gray-text">JPG, PNG or WebP · max 10 MB. Leave empty to keep the current portrait.</p>
        </div>
        <div>
          <label class={labelCls}>Byline name</label>
          <input type="text" name="aboutBylineName" value={aboutValue(s.aboutBylineName, ABOUT_DEFAULTS.bylineName)} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Portrait caption</label>
          <input type="text" name="aboutCaption" value={aboutValue(s.aboutCaption, ABOUT_DEFAULTS.caption)} class={inputCls} />
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>Pull quote</label>
          <textarea name="aboutQuote" rows="3" class={inputCls}>{aboutValue(s.aboutQuote, ABOUT_DEFAULTS.quote)}</textarea>
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>Body <span class="text-gray-text normal-case tracking-normal">(one paragraph per blank line)</span></label>
          <textarea name="aboutBody" rows="6" class={inputCls}>{aboutValue(s.aboutBody, ABOUT_DEFAULTS.body)}</textarea>
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>Principles heading</label>
          <input type="text" name="aboutPrinciplesHeading" value={aboutValue(s.aboutPrinciplesHeading, ABOUT_DEFAULTS.principlesHeading)} class={inputCls} />
        </div>
        {[0, 1, 2].map((i) => (
          <div class="sm:col-span-2 grid gap-2 sm:grid-cols-[1fr_2fr] rounded-2xl p-3 bg-gray-soft">
            <div>
              <label class={labelCls}>Principle {i + 1} title</label>
              <input type="text" name="aboutPrincipleTitle[]" value={aboutPrinciples[i]?.title ?? ''} class={inputCls} />
            </div>
            <div>
              <label class={labelCls}>Principle {i + 1} description</label>
              <input type="text" name="aboutPrincipleDesc[]" value={aboutPrinciples[i]?.desc ?? ''} class={inputCls} />
            </div>
          </div>
        ))}
        <div class="sm:col-span-2">
          <label class={labelCls}>Closing paragraph</label>
          <textarea name="aboutSignature" rows="3" class={inputCls}>{aboutValue(s.aboutSignature, ABOUT_DEFAULTS.signature)}</textarea>
        </div>
        <div>
          <label class={labelCls}>Sign-off label</label>
          <input type="text" name="aboutSignoff" value={aboutValue(s.aboutSignoff, ABOUT_DEFAULTS.signoff)} class={inputCls} />
        </div>
        <div>
          <label class={labelCls}>Signature name</label>
          <input type="text" name="aboutSignName" value={aboutValue(s.aboutSignName, ABOUT_DEFAULTS.signName)} class={inputCls} />
        </div>
        <div class="sm:col-span-2">
          <label class={labelCls}>CTA button label</label>
          <input type="text" name="aboutCtaLabel" value={aboutValue(s.aboutCtaLabel, ABOUT_DEFAULTS.ctaLabel)} class={inputCls} />
        </div>
      </div>
    </section>

    <div class="flex justify-end mb-10">
      <Button type="submit" variant="cta" size="md">
        Save changes
      </Button>
    </div>
  </form>

  <!-- Telegram -->
  {telegramCanLink && (
    <section class={cardCls} style={cardStyle}>
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">Telegram</h2>
      <p class="text-sm mb-5 text-gray-text">
        Connect your Telegram account to confirm, cancel and record payments straight from the
        booking messages in the ops group. Your role is checked on every tap, so removing it here
        removes it there.
      </p>

      {!telegramReady ? (
        <p class="text-sm text-gray-text">
          Two-way actions are not configured on this server. Set <code>TELEGRAM_WEBHOOK_SECRET</code>
          and <code>TELEGRAM_BOT_USERNAME</code>, then register the webhook.
        </p>
      ) : (
        <div id="telegram-panel" data-linked={telegramLink ? '1' : '0'}>
          <p class="text-sm mb-4" id="telegram-state">
            {telegramLink
              ? `Connected${telegramLink.telegramUsername ? ` as @${telegramLink.telegramUsername}` : ''}.`
              : 'Not connected.'}
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" id="telegram-connect"
                    class="rounded-full px-6 py-2.5 text-sm font-medium transition-colors border border-navy text-navy">
              {telegramLink ? 'Reconnect' : 'Connect Telegram'}
            </button>
            <button type="button" id="telegram-revoke" hidden={!telegramLink}
                    class="rounded-full px-6 py-2.5 text-sm font-medium transition-colors text-danger border border-danger">
              Disconnect
            </button>
          </div>
          <p class="text-sm mt-4" id="telegram-result" hidden></p>
        </div>
      )}
    </section>
  )}

  <!-- Account -->
  <section class={cardCls} style={cardStyle}>
    <h2 class="font-display text-lg font-semibold mb-1 text-navy">Account</h2>
    <p class="text-sm mb-5 text-gray-text">Signed in as Zahra · Super Admin.</p>
    <form method="POST" action="/api/admin/logout">
      <button type="submit"
              class="rounded-full px-6 py-2.5 text-sm font-medium transition-colors text-danger border border-danger"
             >
        Sign out
      </button>
    </form>
  </section>
</AdminLayout>

<script>
  const portraitInput = document.querySelector<HTMLInputElement>('#about-founder-image');
  const portraitPreview = document.querySelector<HTMLImageElement>('#about-founder-image-preview');
  let portraitPreviewUrl: string | null = null;

  portraitInput?.addEventListener('change', () => {
    if (portraitPreviewUrl) URL.revokeObjectURL(portraitPreviewUrl);
    const file = portraitInput.files?.[0];
    if (!file || !portraitPreview) {
      portraitPreview?.classList.add('hidden');
      portraitPreviewUrl = null;
      return;
    }
    portraitPreviewUrl = URL.createObjectURL(file);
    portraitPreview.src = portraitPreviewUrl;
    portraitPreview.classList.remove('hidden');
  });

  // ── Telegram linking ──
  const tgConnect = document.querySelector<HTMLButtonElement>('#telegram-connect');
  const tgRevoke = document.querySelector<HTMLButtonElement>('#telegram-revoke');
  const tgResult = document.querySelector<HTMLParagraphElement>('#telegram-result');
  const tgState = document.querySelector<HTMLParagraphElement>('#telegram-state');

  function tgSay(message: string, tone: 'ok' | 'error' = 'ok') {
    if (!tgResult) return;
    tgResult.textContent = message;
    tgResult.className = `text-sm mt-4 ${tone === 'ok' ? 'text-success' : 'text-danger'}`;
    tgResult.hidden = false;
  }

  tgConnect?.addEventListener('click', async () => {
    tgConnect.disabled = true;
    try {
      const res = await fetch('/api/admin/telegram-link', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'create' }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.success) throw new Error(data?.error || 'Could not create a link.');
      // Single-use and short-lived, so it is opened rather than displayed —
      // nothing worth copying out of the page and into a chat.
      window.open(data.url, '_blank', 'noopener');
      tgSay('Opened Telegram. Press Start there within 10 minutes, then reload this page.');
    } catch (error: any) {
      tgSay(String(error?.message || error), 'error');
    } finally {
      tgConnect.disabled = false;
    }
  });

  tgRevoke?.addEventListener('click', async () => {
    if (!confirm('Disconnect Telegram? Your buttons in the ops group will stop working.')) return;
    tgRevoke.disabled = true;
    try {
      const res = await fetch('/api/admin/telegram-link', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'revoke' }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.success) throw new Error(data?.error || 'Could not disconnect.');
      if (tgState) tgState.textContent = 'Not connected.';
      tgRevoke.hidden = true;
      tgSay('Disconnected.');
    } catch (error: any) {
      tgSay(String(error?.message || error), 'error');
    } finally {
      tgRevoke.disabled = false;
    }
  });
</script>
