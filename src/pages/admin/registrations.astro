---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { listTrips } from '../../lib/content';
export const prerender = false;

const adminUser = Astro.locals.adminUser;

// trip_lead: scoped to their assigned trips only; no payment actions
const isTripLead = adminUser?.role === 'trip_lead';
const allowedBatchIds = isTripLead ? (adminUser?.tripIds ?? []) : null;

const registrations = (allowedBatchIds !== null
  ? getDb()
      .prepare(`SELECT * FROM registrations WHERE batch_id IN (${allowedBatchIds.map(() => '?').join(',') || "''"}) ORDER BY id DESC`)
      .all(...allowedBatchIds)
  : getDb()
      .prepare('SELECT * FROM registrations ORDER BY id DESC')
      .all()
) as Record<string, any>[];

const total = registrations.length;
const leads = registrations.filter(r => r.status === 'lead').length;
const pending = registrations.filter(r => r.status === 'pending').length;
const confirmed = registrations.filter(r => r.status === 'confirmed').length;
const rejected = registrations.filter(r => r.status === 'rejected').length;
const totalRevenue = registrations
  .filter(r => r.status !== 'rejected')
  .reduce((s, r) => s + (r.amount_paid ?? 0), 0);

// Build trip status lookup from YAML content
const allTrips = listTrips() as Array<{ name: string; status?: string; slug: string }>;
const tripStatusMap = new Map(allTrips.map(t => [t.name as string, (t.status as string) || 'upcoming']));

// Group registrations by trip_name
const regsByTrip = new Map<string, typeof registrations>();
for (const reg of registrations) {
  const tn = reg.trip_name as string;
  if (!regsByTrip.has(tn)) regsByTrip.set(tn, []);
  regsByTrip.get(tn)!.push(reg);
}

// Sort groups: booking-open → upcoming → sold-out → completed → draft → unknown
const STATUS_ORDER = ['booking-open', 'upcoming', 'sold-out', 'completed', 'draft'];
const tripGroups = [...regsByTrip.entries()].sort(([aName], [bName]) => {
  const aIdx = STATUS_ORDER.indexOf(tripStatusMap.get(aName) ?? '');
  const bIdx = STATUS_ORDER.indexOf(tripStatusMap.get(bName) ?? '');
  return (aIdx === -1 ? 99 : aIdx) - (bIdx === -1 ? 99 : bIdx);
});

function groupStats(regs: typeof registrations) {
  return {
    lead:      regs.filter(r => r.status === 'lead').length,
    pending:   regs.filter(r => r.status === 'pending').length,
    confirmed: regs.filter(r => r.status === 'confirmed').length,
    rejected:  regs.filter(r => r.status === 'rejected').length,
  };
}

function statusStyle(status: string) {
  if (status === 'confirmed') return 'background:#D1FAE5;color:#065F46;';
  if (status === 'rejected')  return 'background:#FEE2E2;color:#991B1B;';
  if (status === 'lead')      return 'background:#FEF9C3;color:#78350F;';
  return 'background:#FEF3C7;color:#92400E;';
}

function tripStatusBadgeStyle(status: string) {
  if (status === 'booking-open') return 'background:#D1FAE5;color:#065F46;';
  if (status === 'upcoming')     return 'background:#FEF3C7;color:#92400E;';
  if (status === 'sold-out')     return 'background:#FEE2E2;color:#991B1B;';
  if (status === 'completed')    return 'background:#E5E7EB;color:#374151;';
  return 'background:#F3F4F6;color:#6B7280;';
}

function tripGroupHeaderStyle(status: string) {
  if (status === 'booking-open') return 'border-left:4px solid var(--color-coral);background:var(--color-blush);';
  if (status === 'upcoming')     return 'border-left:4px solid var(--color-peach);background:#FBF6F4;';
  return 'border-left:4px solid var(--color-border);background:white;';
}

function fmt(date: string) {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

function fmtCurrency(n: number) {
  return '₹' + (n ?? 0).toLocaleString('en-IN');
}
---

<AdminLayout title="Registrations" page="registrations">
  <!-- Stats row -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.75rem;">
    {[
      { label: 'Total', value: total, color: 'var(--color-primary)' },
      { label: 'Leads', value: leads, color: '#78350F' },
      { label: 'Pending', value: pending, color: '#D97706' },
      { label: 'Confirmed', value: confirmed, color: 'var(--color-success)' },
      { label: 'Rejected', value: rejected, color: 'var(--color-danger)' },
      { label: 'Revenue', value: fmtCurrency(totalRevenue), color: 'var(--color-primary)' },
    ].map(s => (
      <div style="background:white;border:1px solid var(--color-border);border-radius:0.75rem;padding:1rem 1.25rem;">
        <p style="margin:0 0 0.25rem;font-size:0.75rem;font-weight:600;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:0.05em;">{s.label}</p>
        <p style={`margin:0;font-size:1.5rem;font-weight:800;font-family:var(--font-display);color:${s.color};`}>{s.value}</p>
      </div>
    ))}
  </div>

  <!-- Toolbar -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;margin-bottom:1.25rem;">
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
      <input
        type="text"
        id="search"
        placeholder="Search name, email, trip…"
        style="padding:0.45rem 0.75rem;border:1.5px solid var(--color-border);border-radius:0.5rem;font-size:0.875rem;font-family:var(--font-sans);width:220px;"
      />
      <select id="statusFilter" style="padding:0.45rem 0.75rem;border:1.5px solid var(--color-border);border-radius:0.5rem;font-size:0.875rem;font-family:var(--font-sans);">
        <option value="">All statuses</option>
        <option value="lead">Lead</option>
        <option value="pending">Pending</option>
        <option value="confirmed">Confirmed</option>
        <option value="rejected">Rejected</option>
      </select>
      <select id="tripFilter" style="padding:0.45rem 0.75rem;border:1.5px solid var(--color-border);border-radius:0.5rem;font-size:0.875rem;font-family:var(--font-sans);min-width:180px;">
        <option value="">All trips</option>
        {allTrips.sort((a, b) => {
          const aIdx = STATUS_ORDER.indexOf((tripStatusMap.get(a.name as string) ?? ''));
          const bIdx = STATUS_ORDER.indexOf((tripStatusMap.get(b.name as string) ?? ''));
          return (aIdx === -1 ? 99 : aIdx) - (bIdx === -1 ? 99 : bIdx);
        }).map(t => (
          <option value={t.name}>{t.name}</option>
        ))}
      </select>
    </div>
    <div style="display:flex;gap:0.5rem;">
      <a
        id="exportLink"
        href="/api/admin/export?type=registrations"
        style="padding:0.45rem 1rem;background:var(--color-primary);color:white;border-radius:0.5rem;font-size:0.875rem;font-weight:600;text-decoration:none;"
      >
        ↓ Export CSV
      </a>
    </div>
  </div>

  <!-- Grouped registrations -->
  {registrations.length === 0 ? (
    <p style="text-align:center;padding:3rem;color:var(--color-text-secondary);background:white;border-radius:0.75rem;border:1px solid var(--color-border);">No registrations yet.</p>
  ) : (
    <div id="trip-groups-container">
      {tripGroups.map(([tripName, regs], groupIdx) => {
        const tripStatus = tripStatusMap.get(tripName) ?? 'upcoming';
        const stats = groupStats(regs);
        const groupId = `group-${groupIdx}`;
        return (
          <div class="trip-group" data-group-id={groupId} style="margin-bottom:1.25rem;">

            <!-- Group header -->
            <div
              class={`trip-group-header ${tripStatus.replace('-', '_')}`}
              onclick={`toggleGroup('${groupId}')`}
              style={`display:flex;align-items:center;justify-content:space-between;padding:0.875rem 1.25rem;cursor:pointer;border-radius:0.75rem 0.75rem 0 0;flex-wrap:wrap;gap:0.5rem;user-select:none;${tripGroupHeaderStyle(tripStatus)}`}
            >
              <div style="display:flex;align-items:center;gap:0.65rem;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:0.95rem;color:var(--color-text-primary);">{tripName}</span>
                <span style={`padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;${tripStatusBadgeStyle(tripStatus)}`}>
                  {tripStatus.replace(/-/g, ' ')}
                </span>
              </div>
              <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
                {stats.lead > 0 && (
                  <span style="padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:700;background:#FEF9C3;color:#78350F;">{stats.lead} lead</span>
                )}
                {stats.pending > 0 && (
                  <span style="padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:700;background:#FEF3C7;color:#92400E;">{stats.pending} pending</span>
                )}
                {stats.confirmed > 0 && (
                  <span style="padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:700;background:#D1FAE5;color:#065F46;">{stats.confirmed} confirmed</span>
                )}
                {stats.rejected > 0 && (
                  <span style="padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:700;background:#FEE2E2;color:#991B1B;">{stats.rejected} rejected</span>
                )}
                <span class="trip-chevron" style="font-size:0.9rem;color:var(--color-text-secondary);margin-left:0.25rem;">▾</span>
              </div>
            </div>

            <!-- Registrations cards for this trip -->
            <div class="trip-group-table" id={groupId}>
              <div style="background:var(--color-gray-soft);border:1px solid var(--color-border);border-top:none;border-radius:0 0 0.75rem 0.75rem;padding:0.75rem;display:flex;flex-direction:column;gap:0.6rem;">
                {regs.map((r) => (
                  <div
                    class="reg-row"
                    data-name={(r.full_name as string).toLowerCase()}
                    data-email={(r.email as string).toLowerCase()}
                    data-trip={(r.trip_name as string ?? '').toLowerCase()}
                    data-status={r.status}
                    style="background:white;border:1px solid var(--color-border);border-radius:0.9rem;padding:0.85rem 1rem;"
                  >
                    <!-- Summary -->
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;">
                      <div style="min-width:0;">
                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                          <span style="font-weight:700;color:var(--color-navy);">{r.full_name}</span>
                          <span class="status-badge" data-id={r.id} style={`padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.72rem;font-weight:700;${statusStyle(r.status)}`}>
                            {r.status}
                          </span>
                        </div>
                        <div style="font-size:0.8rem;color:var(--color-text-secondary);word-break:break-all;margin-top:0.15rem;">#{r.id} · {r.email} · {r.phone}</div>
                      </div>
                      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.3rem;flex:none;">
                        <span style="font-weight:700;color:var(--color-navy);font-size:0.9rem;">{fmtCurrency(r.amount_paid)}</span>
                        <span style="font-size:0.72rem;color:var(--color-text-secondary);white-space:nowrap;">{fmt(r.created_at as string)}</span>
                        <button
                          onclick={`toggleDetail(${r.id})`}
                          style="font-size:0.72rem;color:var(--color-coral);background:none;border:1px solid var(--color-coral);border-radius:0.5rem;padding:0.18rem 0.65rem;cursor:pointer;"
                        >
                          Details
                        </button>
                      </div>
                    </div>

                    <!-- Expandable detail -->
                    <div id={`detail-${r.id}`} class="detail-row" style="display:none;margin-top:0.9rem;padding-top:0.9rem;border-top:1px solid var(--color-border);">
                      <div class="detail-panel-grid" style="display:grid;grid-template-columns:1fr 320px;gap:1.5rem;align-items:start;">

                        <!-- Left: fields -->
                        <div>
                          <h3 style="margin:0 0 0.75rem;font-size:0.875rem;font-weight:700;color:var(--color-primary-dark);text-transform:uppercase;letter-spacing:0.05em;">Registration Details</h3>
                          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.4rem 1rem;font-size:0.82rem;">
                            {[
                              ['Full Name', r.full_name], ['Email', r.email], ['Phone', r.phone],
                              ['Age', r.age ?? '—'], ['Gender', r.gender ?? '—'], ['City', r.city],
                              ['Instagram', r.instagram ?? '—'],
                              ['Emergency Name', r.emergency_name], ['Emergency Phone', r.emergency_phone],
                              ['No. Travelers', r.num_travelers], ['Others', r.other_travelers ?? '—'],
                              ['Dietary', r.dietary ?? '—'], ['Food Allergies', r.food_allergies ?? '—'],
                              ['Medical Conditions', r.medical_conditions ?? '—'], ['Medications', r.medications ?? '—'],
                              ['Special Requests', r.special_requests ?? '—'],
                              ['Why Joining', r.why_join ?? '—'],
                              ['Trip Name', r.trip_name], ['Trip Date', r.trip_date ?? '—'],
                              ['Occupancy', r.sharing_option ?? '—'],
                              ['Total (selected)', r.total_amount ? fmtCurrency(r.total_amount) : '—'],
                              ['Amount Paid', fmtCurrency(r.amount_paid)],
                            ].map(([label, val]) => (
                              <div>
                                <span style="color:var(--color-text-secondary);font-weight:600;">{label}:</span>{' '}
                                <span>{val}</span>
                              </div>
                            ))}
                          </div>
                          {r.payment_screenshot_url && (
                            <div style="margin-top:0.75rem;">
                              <a
                                href={r.payment_screenshot_url}
                                target="_blank"
                                style="font-size:0.82rem;color:var(--color-accent);font-weight:600;"
                              >
                                View Payment Screenshot →
                              </a>
                            </div>
                          )}
                        </div>

                        <!-- Right: status update + admin notes -->
                        <div style="background:var(--color-gray-soft);border-radius:0.75rem;padding:1.25rem;border:1px solid var(--color-border);">
                          <h3 style="margin:0 0 1rem;font-size:0.875rem;font-weight:700;color:var(--color-primary-dark);">Admin Actions</h3>
                          <div id={`status-section-${r.id}`}>
                            <p style="font-size:0.8rem;margin:0 0 0.5rem;color:var(--color-text-secondary);font-weight:600;">Update Status</p>
                            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;">
                              {(['lead', 'pending', 'confirmed', 'rejected'] as const).map(s => (
                                <button
                                  onclick={`updateStatus(${r.id}, '${s}')`}
                                  style={`padding:0.35rem 0.75rem;border-radius:0.4rem;font-size:0.8rem;font-weight:700;cursor:pointer;border:2px solid transparent;${
                                    r.status === s
                                      ? (s === 'confirmed' ? 'background:#D1FAE5;color:#065F46;border-color:#6EE7B7;'
                                        : s === 'rejected'  ? 'background:#FEE2E2;color:#991B1B;border-color:#FCA5A5;'
                                        : s === 'lead'      ? 'background:#FEF9C3;color:#78350F;border-color:#FDE68A;'
                                        : 'background:#FEF3C7;color:#92400E;border-color:#FDE68A;')
                                      : 'background:var(--color-surface);color:var(--color-text-secondary);border-color:var(--color-border);'
                                  }`}
                                >
                                  {s.charAt(0).toUpperCase() + s.slice(1)}
                                </button>
                              ))}
                            </div>
                            <p style="font-size:0.8rem;margin:0 0 0.4rem;color:var(--color-text-secondary);font-weight:600;">Admin Notes</p>
                            <textarea
                              id={`notes-${r.id}`}
                              rows={3}
                              placeholder="Add internal notes…"
                              style="width:100%;padding:0.5rem;border:1.5px solid var(--color-border);border-radius:0.5rem;font-size:0.82rem;font-family:var(--font-sans);resize:vertical;box-sizing:border-box;"
                            >{r.admin_notes ?? ''}</textarea>
                            <button
                              onclick={`saveNotes(${r.id})`}
                              style="margin-top:0.5rem;width:100%;padding:0.5rem;background:var(--color-primary);color:white;border:none;border-radius:0.5rem;font-size:0.82rem;font-weight:700;cursor:pointer;font-family:var(--font-sans);"
                            >
                              Save Notes
                            </button>
                            <p id={`msg-${r.id}`} style="font-size:0.75rem;text-align:center;margin:0.4rem 0 0;color:var(--color-success);display:none;">Saved!</p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        );
      })}
    </div>
  )}

  <p id="noResults" style="display:none;text-align:center;padding:2rem;color:var(--color-text-secondary);">No matching registrations.</p>
</AdminLayout>

<script>
  function toggleGroup(groupId: string) {
    const tableEl = document.getElementById(groupId);
    const groupEl = tableEl?.closest('.trip-group') as HTMLElement | null;
    if (!tableEl || !groupEl) return;
    const isCollapsed = groupEl.classList.contains('collapsed');
    groupEl.classList.toggle('collapsed', !isCollapsed);
    tableEl.style.display = isCollapsed ? '' : 'none';
  }

  function toggleDetail(id: number) {
    const row = document.getElementById('detail-' + id);
    if (!row) return;
    row.style.display = row.style.display === 'none' ? 'block' : 'none';
  }

  async function updateStatus(id: number, status: string) {
    const label = status.charAt(0).toUpperCase() + status.slice(1);
    if (!confirm(`Mark this registration as "${label}"?\n\nThis will send a notification email to the registrant.`)) return;
    const notesEl = document.getElementById('notes-' + id) as HTMLTextAreaElement | null;
    const adminNotes = notesEl?.value ?? '';
    const res = await fetch('/api/admin/update-registration', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status, admin_notes: adminNotes }),
    });
    if (res.ok) {
      // Update badge
      const badge = document.querySelector(`.status-badge[data-id="${id}"]`) as HTMLElement | null;
      if (badge) {
        badge.textContent = status;
        badge.style.cssText = `padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.75rem;font-weight:700;${
          status === 'confirmed' ? 'background:#D1FAE5;color:#065F46;' :
          status === 'rejected'  ? 'background:#FEE2E2;color:#991B1B;' :
          status === 'lead'      ? 'background:#FEF9C3;color:#78350F;' :
                                   'background:#FEF3C7;color:#92400E;'
        }`;
      }
      // Update row data-status for filtering
      const rows = document.querySelectorAll('.reg-row');
      rows.forEach(row => {
        const btn = row.querySelector(`button[onclick*="toggleDetail(${id})"]`);
        if (btn) (row as HTMLElement).dataset.status = status;
      });
      const msgEl = document.getElementById('msg-' + id);
      if (msgEl) { msgEl.style.display = 'block'; setTimeout(() => msgEl.style.display = 'none', 2000); }
    }
  }

  async function saveNotes(id: number) {
    const notesEl = document.getElementById('notes-' + id) as HTMLTextAreaElement | null;
    const adminNotes = notesEl?.value ?? '';
    const badge = document.querySelector(`.status-badge[data-id="${id}"]`) as HTMLElement | null;
    const status = badge?.textContent?.trim() ?? 'pending';
    const res = await fetch('/api/admin/update-registration', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status, admin_notes: adminNotes }),
    });
    if (res.ok) {
      const msgEl = document.getElementById('msg-' + id);
      if (msgEl) { msgEl.style.display = 'block'; setTimeout(() => msgEl.style.display = 'none', 2000); }
    }
  }

  // Search + filter
  const searchEl = document.getElementById('search') as HTMLInputElement | null;
  const filterEl = document.getElementById('statusFilter') as HTMLSelectElement | null;
  const tripFilterEl = document.getElementById('tripFilter') as HTMLSelectElement | null;
  const exportLink = document.getElementById('exportLink') as HTMLAnchorElement | null;

  function applyFilters() {
    const q = searchEl?.value.toLowerCase() ?? '';
    const s = filterEl?.value ?? '';
    const t = tripFilterEl?.value ?? '';
    const rows = document.querySelectorAll<HTMLTableRowElement>('.reg-row');
    let totalVisible = 0;

    rows.forEach(row => {
      const matchQ = !q || row.dataset.name?.includes(q) || row.dataset.email?.includes(q) || row.dataset.trip?.includes(q);
      const matchS = !s || row.dataset.status === s;
      const matchT = !t || row.dataset.trip === t.toLowerCase();
      const show = !!(matchQ && matchS && matchT);
      row.style.display = show ? '' : 'none';
      // Hide open detail row when parent is hidden
      const id = row.querySelector('button[onclick*="toggleDetail"]')?.getAttribute('onclick')?.match(/\d+/)?.[0];
      const detailRow = id ? document.getElementById('detail-' + id) : null;
      if (!show && detailRow) detailRow.style.display = 'none';
      if (show) totalVisible++;
    });

    // Hide trip groups with no visible rows
    document.querySelectorAll<HTMLElement>('.trip-group').forEach(group => {
      const groupTable = group.querySelector<HTMLElement>('.trip-group-table');
      if (groupTable && groupTable.style.display === 'none') {
        const anyMatch = [...group.querySelectorAll<HTMLElement>('.reg-row')].some(
          row => row.style.display !== 'none'
        );
        group.style.display = anyMatch ? '' : 'none';
        return;
      }
      const visibleRows = group.querySelectorAll<HTMLElement>('.reg-row:not([style*="display: none"])');
      const anyVisible = [...group.querySelectorAll<HTMLElement>('.reg-row')].some(
        row => row.style.display !== 'none'
      );
      group.style.display = anyVisible ? '' : 'none';
    });

    const noResults = document.getElementById('noResults');
    if (noResults) noResults.style.display = totalVisible === 0 ? 'block' : 'none';

    // Update export link if trip filter is active
    if (exportLink) {
      if (t) {
        exportLink.href = `/api/admin/export?type=registrations&trip_name=${encodeURIComponent(t)}`;
      } else {
        exportLink.href = '/api/admin/export?type=registrations';
      }
    }
  }

  searchEl?.addEventListener('input', applyFilters);
  filterEl?.addEventListener('change', applyFilters);
  tripFilterEl?.addEventListener('change', applyFilters);

  // Expose to onclick handlers
  (window as any).toggleGroup = toggleGroup;
  (window as any).toggleDetail = toggleDetail;
  (window as any).updateStatus = updateStatus;
  (window as any).saveNotes = saveNotes;
</script>
