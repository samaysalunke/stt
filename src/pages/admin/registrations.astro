---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { buildRegistrationsView, regStats } from '../../lib/registrationsView';
import { formatINR } from '../../lib/utils';
export const prerender = false;

const adminUser = Astro.locals.adminUser;
const isTripLead = adminUser?.role === 'trip_lead';
const { trips, legacyRegs, total, totals, revenue, historyCount } = buildRegistrationsView(adminUser);

const money = (n: number) => formatINR(n);
const fmt = (d: string) => (d ? new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—');
---
<AdminLayout title="Registrations" page="registrations">
  <div class="stats-grid">{[
    ['Total', total, 'var(--color-primary)'], ['Wishlist', totals.wishlist, '#3730A3'], ['Leads', totals.lead, '#78350F'], ['Pending', totals.pending, '#D97706'], ['Confirmed', totals.confirmed, 'var(--color-success)'], ['Rejected', totals.rejected, 'var(--color-danger)'], ['Cancelled', totals.cancelled, '#334155'], ['Revenue', money(revenue), 'var(--color-primary)']
  ].map(([label, value, color]) => <div class="stat-card"><p>{label}</p><strong style={`color:${color}`}>{value}</strong></div>)}</div>

  <div class="toolbar">
    <p class="toolbar-hint">Pick a trip to manage its registrations.</p>
    <div class="actions">
      {!isTripLead && <a class="primary" href="/admin/registrations/new">+ Add</a>}
      {!isTripLead && <a href="/admin/registrations/import">↑ Import</a>}
      {!isTripLead && <a href="/admin/registrations/unpaid-leads">Unpaid leads</a>}
      <a class="export" href="/api/admin/export?type=registrations">↓ Export all CSV</a>
      {historyCount > 0 && <label class="history-toggle"><input id="show-history" type="checkbox" /> Show history <span class="history-count">({historyCount})</span></label>}
    </div>
  </div>

  <div class="trip-grid">
    {trips.map((trip) => {
      const s = regStats(trip.departures.flatMap((d) => d.regs));
      return (
        <a class={`trip-card ${trip.historical ? 'history-item' : ''}`} href={`/admin/registrations/${encodeURIComponent(trip.slug)}`}>
          <div class="trip-card-head">
            <h2>{trip.name}</h2>
            <span class={trip.active ? 'active' : 'closed'}>{trip.active ? 'active' : 'closed'}</span>
          </div>
          <p class="trip-card-meta">{trip.departures.length} departure{trip.departures.length === 1 ? '' : 's'} · {trip.regCount} registration{trip.regCount === 1 ? '' : 's'}</p>
          <div class="badges">
            {s.wishlist > 0 && <b class="wishlist">{s.wishlist} wishlist</b>}
            {s.lead > 0 && <b class="lead">{s.lead} lead</b>}
            {s.pending > 0 && <b class="pending">{s.pending} pending</b>}
            {s.confirmed > 0 && <b class="confirmed">{s.confirmed} confirmed</b>}
            {s.rejected > 0 && <b class="rejected">{s.rejected} rejected</b>}
            {s.cancelled > 0 && <b class="cancelled">{s.cancelled} cancelled</b>}
            {trip.regCount === 0 && <span class="empty-note">No registrations yet</span>}
          </div>
          <p class="trip-card-next">{trip.active && trip.nextDate !== '9999' ? `Next departure ${fmt(trip.nextDate)}` : 'No open departures'} →</p>
        </a>
      );
    })}
    {legacyRegs.length > 0 && (
      <a class="trip-card history-item legacy" href="/admin/registrations/__legacy">
        <div class="trip-card-head"><h2>Unassigned / legacy</h2><span class="closed">history</span></div>
        <p class="trip-card-meta">{legacyRegs.length} registration{legacyRegs.length === 1 ? '' : 's'} with no matching departure</p>
        <p class="trip-card-next">Review →</p>
      </a>
    )}
  </div>
  <p id="noResults">No trips with registrations yet.</p>
</AdminLayout>

<style>
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.7rem;margin-bottom:1.25rem}.stat-card{background:#fff;border:1px solid var(--color-border);border-radius:.85rem;padding:.8rem 1rem}.stat-card p{margin:0 0 .25rem;font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--color-text-secondary)}.stat-card strong{font:800 1.45rem var(--font-display)}
  .toolbar{display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap;background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:.75rem 1rem;margin-bottom:1rem}.toolbar-hint{margin:0;font-size:.85rem;color:var(--color-text-secondary);font-weight:600}.actions{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}.actions a{padding:.45rem .8rem;border:1px solid var(--color-coral);border-radius:.5rem;color:var(--color-coral);font-size:.8rem;font-weight:700;text-decoration:none}.actions .primary{background:var(--color-coral);color:#fff}.actions .export{background:var(--color-primary);border-color:var(--color-primary);color:#fff}
  .history-toggle{display:flex;align-items:center;gap:.4rem;font-weight:700;cursor:pointer;font-size:.85rem;white-space:nowrap}.history-count{color:var(--color-text-secondary);font-weight:400}
  .trip-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:.85rem}
  .trip-card{display:flex;flex-direction:column;gap:.5rem;background:#fff;border:1px solid var(--color-border);border-left:4px solid var(--color-coral);border-radius:1rem;padding:1rem 1.15rem;text-decoration:none;color:inherit;transition:box-shadow .15s ease,transform .15s ease}.trip-card:hover{box-shadow:0 6px 18px rgba(0,0,0,.08);transform:translateY(-2px)}.trip-card.history-item{border-left-color:#9CA3AF}
  .trip-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem}.trip-card h2{margin:0;font:700 1.05rem var(--font-display);color:var(--color-navy)}.trip-card-head span{padding:.15rem .5rem;border-radius:999px;font-weight:700;text-transform:uppercase;font-size:.65rem;white-space:nowrap}.trip-card-head .active{background:#D1FAE5;color:#065F46}.trip-card-head .closed{background:#E5E7EB;color:#374151}
  .trip-card-meta{margin:0;font-size:.78rem;color:var(--color-text-secondary)}.badges{display:flex;gap:.35rem;flex-wrap:wrap;min-height:1.2rem}.badges b{padding:.15rem .5rem;border-radius:999px;font-size:.7rem}.empty-note{font-size:.72rem;color:var(--color-text-secondary)}.wishlist{background:#E0E7FF;color:#3730A3}.lead{background:#FEF9C3;color:#78350F}.pending{background:#FEF3C7;color:#92400E}.confirmed{background:#D1FAE5;color:#065F46}.rejected{background:#FEE2E2;color:#991B1B}.cancelled{background:#E2E8F0;color:#334155}
  .trip-card-next{margin:.15rem 0 0;font-size:.76rem;font-weight:700;color:var(--color-coral)}
  .history-item{display:none}#noResults{display:none;text-align:center;padding:2rem;color:var(--color-text-secondary)}
  @media(max-width:900px){.stats-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:600px){.stats-grid{grid-template-columns:repeat(2,1fr)}.toolbar{align-items:stretch}.actions{justify-content:flex-start}}
</style>

<script>
  const history = document.getElementById('show-history') as HTMLInputElement | null;
  function applyHistory() {
    const showHistory = !!history?.checked;
    document.querySelectorAll<HTMLElement>('.trip-card').forEach((card) => {
      card.style.display = card.classList.contains('history-item') && !showHistory ? 'none' : 'flex';
    });
    const anyVisible = [...document.querySelectorAll<HTMLElement>('.trip-card')].some((c) => c.style.display !== 'none');
    const nr = document.getElementById('noResults');
    if (nr) nr.style.display = anyVisible ? 'none' : 'block';
  }
  history?.addEventListener('change', applyHistory);
  applyHistory();
</script>
