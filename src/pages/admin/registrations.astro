---
import AdminLayout from '../../layouts/AdminLayout.astro';
import RegistrationCard from '../../components/admin/RegistrationCard.astro';
import { getDb } from '../../lib/db';
import { editableBooking } from '../../lib/tripEditor';
import { listTrips } from '../../lib/content';
export const prerender = false;

type Reg = Record<string, any>;
type DepartureModel = { id:string; startDate:string; endDate:string; status:string; regs:Reg[]; cap:number|null; booked:number; soldOut:boolean; historical:boolean };
type TripModel = { slug:string; name:string; active:boolean; nextDate:string; departures:DepartureModel[]; historical:boolean };
const adminUser = Astro.locals.adminUser;
const isTripLead = adminUser?.role === 'trip_lead';
const allowedBatchIds: string[] | null = isTripLead ? (adminUser?.tripIds ?? []) : null;
const registrations = (allowedBatchIds === null
  ? getDb().prepare('SELECT * FROM registrations ORDER BY id DESC').all()
  : allowedBatchIds.length ? getDb().prepare(`SELECT * FROM registrations WHERE batch_id IN (${allowedBatchIds.map(() => '?').join(',')}) ORDER BY id DESC`).all(...allowedBatchIds) : []) as Reg[];

const today = new Date(); today.setHours(0,0,0,0);
const trips = listTrips();
const knownBatchIds = new Set<string>();
const regsByBatch = new Map<string, Reg[]>();
for (const r of registrations) if (r.batch_id) { const a=regsByBatch.get(r.batch_id) ?? []; a.push(r); regsByBatch.set(r.batch_id,a); }

const tripModels: TripModel[] = trips.map((trip:any) => {
  const name = String(trip.title || trip.name || trip.slug);
  const { editorDepartures } = editableBooking(trip);
  const departures: DepartureModel[] = editorDepartures
    .filter((d:any) => d.id && (!isTripLead || allowedBatchIds!.includes(String(d.id))))
    .map((d:any) => {
      const id=String(d.id); knownBatchIds.add(id);
      const offers=Array.isArray(d.offers)?d.offers:[];
      const metered=offers.length>0 && offers.every((o:any)=>o.cap != null);
      const cap=metered?offers.reduce((n:number,o:any)=>n+Number(o.cap||0),0):null;
      const booked=offers.reduce((n:number,o:any)=>n+Number(o.booked||0),0);
      const soldOut=d.status==='sold-out'||d.status==='sold_out'||(cap!==null&&booked>=cap);
      const start=new Date(d.startDate); start.setHours(0,0,0,0);
      const historical=!d.startDate||start<today||d.status==='completed'||d.status==='draft'||soldOut;
      return { id, startDate:String(d.startDate||''), endDate:String(d.endDate||d.startDate||''), status:String(d.status||'booking-open'), regs:regsByBatch.get(id)??[], cap, booked, soldOut, historical };
    }).sort((a,b)=>a.startDate.localeCompare(b.startDate));
  const activeDeps=departures.filter(d=>trip.registrationEnabled!==false && !d.historical && ['booking-open','booking_open','filling-fast','filling_fast','upcoming'].includes(d.status) && !d.soldOut && (d.cap===null||d.booked<d.cap));
  return { slug:String(trip.slug), name, active:activeDeps.length>0, nextDate:activeDeps[0]?.startDate ?? departures[0]?.startDate ?? '9999', departures, historical:activeDeps.length===0 };
}).filter(t=>t.departures.length>0).sort((a,b)=>Number(b.active)-Number(a.active)||a.nextDate.localeCompare(b.nextDate)||a.name.localeCompare(b.name));

const legacyRegs = registrations.filter(r=>!r.batch_id || !knownBatchIds.has(String(r.batch_id)));
const stats=(rs:Reg[])=>({lead:rs.filter(r=>r.status==='lead').length,pending:rs.filter(r=>r.status==='pending').length,confirmed:rs.filter(r=>r.status==='confirmed').length,rejected:rs.filter(r=>r.status==='rejected').length});
const total=registrations.length, totals=stats(registrations);
const revenue=registrations.filter(r=>r.status!=='rejected').reduce((n,r)=>n+Number(r.amount_paid||0),0);
const fmt=(d:string)=>d?new Date(d+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}):'—';
const money=(n:number)=>'₹'+n.toLocaleString('en-IN');
const historyCount=tripModels.reduce((n,t)=>n+t.departures.filter(d=>d.historical).length,0)+(legacyRegs.length?1:0);
const tripFilterData = tripModels.map((trip) => ({
  slug: trip.slug,
  name: trip.name,
  active: trip.active,
  historical: trip.historical,
  departures: trip.departures.map((dep) => ({
    id: dep.id,
    startDate: dep.startDate,
    endDate: dep.endDate,
    historical: dep.historical,
  })),
}));
---
<AdminLayout title="Registrations" page="registrations">
  <div class="stats-grid">{[
    ['Total',total,'var(--color-primary)'],['Leads',totals.lead,'#78350F'],['Pending',totals.pending,'#D97706'],['Confirmed',totals.confirmed,'var(--color-success)'],['Rejected',totals.rejected,'var(--color-danger)'],['Revenue',money(revenue),'var(--color-primary)']
  ].map(([label,value,color])=><div class="stat-card"><p>{label}</p><strong style={`color:${color}`}>{value}</strong></div>)}</div>

  <div class="toolbar">
    <div class="filters"><input id="search" type="search" placeholder="Search name, email, trip…"/><select id="statusFilter"><option value="">All statuses</option><option>lead</option><option>pending</option><option>confirmed</option><option>rejected</option></select><select id="tripFilter"><option value="">All trips</option>{tripModels.map(t=><option value={t.slug}>{t.name}</option>)}</select><label class="history-toggle"><input id="show-history" type="checkbox"/> Show history <span class="history-count">({historyCount})</span></label></div>
    <div class="actions">{!isTripLead&&<><a class="primary" href="/admin/registrations/new">+ Add</a><a href="/admin/registrations/import">↑ Import</a></>}<a class="export" id="exportLink" href="/api/admin/export?type=registrations">↓ Export CSV</a></div>
  </div>
  <p id="filterStatus" class="filter-status"></p>

  {!isTripLead&&<div class="bulk-bar"><label><input id="select-all-visible" type="checkbox"/> Select all matching</label><div><strong id="selected-count">0 selected</strong><select id="bulk-status"><option value="">Choose new status…</option><option>lead</option><option>pending</option><option>confirmed</option><option>rejected</option></select><button id="apply-bulk-status" disabled>Update status</button><select id="bulk-payment"><option value="">Payment action…</option><option value="unpaid">Unpaid</option><option value="advance">Advance paid</option><option value="full">Fully paid</option></select><button id="apply-bulk-payment" disabled>Update payment</button><button id="clear-selection">Clear</button></div></div>}

  <div id="trip-groups-container">
    {tripModels.map((trip,ti)=>{const tripListId=`trip-list-${ti}`;return <section class={`trip-group ${trip.historical?'history-item':''}`} data-trip={trip.slug} data-trip-name={trip.name.toLowerCase()}>
      <header><button type="button" class="trip-toggle" aria-expanded="true" aria-controls={tripListId}><span class="trip-heading"><h2>{trip.name}</h2><span class={trip.active?'active':'closed'}>{trip.active?'active':'closed / history'}</span></span><span class="trip-toggle-summary">{trip.departures.length} departure{trip.departures.length===1?'':'s'} <span class="trip-chevron" aria-hidden="true">▾</span></span></button></header>
      <div class="departures" id={tripListId}>
        {trip.departures.map((dep,di)=>{const s=stats(dep.regs),gid=`dep-${ti}-${di}`;return <article class={`departure ${dep.historical?'history-item':''}`} data-departure-id={dep.id}>
          <div class="departure-head">
            <div class="departure-title">{!isTripLead&&dep.regs.length>0&&<label title="Select this departure"><input class="departure-select-checkbox" data-group-id={gid} type="checkbox"/></label>}<div><strong>{fmt(dep.startDate)} – {fmt(dep.endDate)}</strong><small>{dep.status.replace(/[-_]/g,' ')} · {dep.id}</small></div></div>
            <div class="departure-summary"><span>{dep.regs.length} registration{dep.regs.length===1?'':'s'}</span>{s.lead>0&&<b class="lead">{s.lead} lead</b>}{s.pending>0&&<b class="pending">{s.pending} pending</b>}{s.confirmed>0&&<b class="confirmed">{s.confirmed} confirmed</b>}{s.rejected>0&&<b class="rejected">{s.rejected} rejected</b>}{dep.cap!==null&&<span>{dep.booked}/{dep.cap} occupied</span>}{!isTripLead&&<span class="dep-actions"><a href={`/admin/registrations/new?trip=${encodeURIComponent(trip.slug)}&departure=${encodeURIComponent(dep.id)}`}>+ Add</a><a href={`/admin/registrations/import?trip=${encodeURIComponent(trip.slug)}&departure=${encodeURIComponent(dep.id)}`}>↑ Import</a></span>}</div>
          </div>
          {dep.regs.length>0&&<div class="registration-list" id={gid}>{dep.regs.map(r=><RegistrationCard registration={r} readOnly={isTripLead}/>)}</div>}
        </article>})}
      </div>
    </section>})}
    {legacyRegs.length>0&&<section class="trip-group history-item legacy" data-trip="unassigned legacy registrations"><header><button type="button" class="trip-toggle" aria-expanded="true" aria-controls="legacy-registration-list"><span class="trip-heading"><h2>Unassigned / legacy registrations</h2><span class="closed">history</span></span><span class="trip-toggle-summary">{legacyRegs.length} registration{legacyRegs.length===1?'':'s'} <span class="trip-chevron" aria-hidden="true">▾</span></span></button></header><div class="registration-list" id="legacy-registration-list">{legacyRegs.map(r=><RegistrationCard registration={r} readOnly={isTripLead}/>)}</div></section>}
  </div>
  <p id="noResults">No matching registrations or departures.</p>
</AdminLayout>

<style>
  .stats-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.7rem;margin-bottom:1.25rem}.stat-card{background:#fff;border:1px solid var(--color-border);border-radius:.85rem;padding:.8rem 1rem}.stat-card p{margin:0 0 .25rem;font-size:.72rem;font-weight:700;text-transform:uppercase;color:var(--color-text-secondary)}.stat-card strong{font:800 1.45rem var(--font-display)}.toolbar{display:flex;justify-content:space-between;gap:.75rem;flex-wrap:wrap;background:#fff;border:1px solid var(--color-border);border-radius:1rem;padding:.75rem;margin-bottom:.75rem}.filters,.actions{display:flex;gap:.5rem;flex-wrap:wrap}.toolbar input,.toolbar select,.bulk-bar select{padding:.45rem .75rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff;color:var(--color-navy)}.toolbar input{width:220px}.actions a,.dep-actions a{padding:.45rem .8rem;border:1px solid var(--color-coral);border-radius:.5rem;color:var(--color-coral);font-size:.8rem;font-weight:700;text-decoration:none}.actions .primary{background:var(--color-coral);color:#fff}.actions .export{background:var(--color-primary);border-color:var(--color-primary);color:#fff}.bulk-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:.8rem;padding:.65rem .85rem;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-blush);font-size:.8rem}.bulk-bar label{font-weight:700}.history-toggle{display:flex;align-items:center;gap:.4rem;font-weight:700;cursor:pointer;font-size:.85rem;white-space:nowrap}.history-count{color:var(--color-text-secondary);font-weight:400}.filter-status{display:none;margin:-.25rem 0 .6rem;font-size:.78rem;color:var(--color-text-secondary)}.bulk-bar>div{display:flex;align-items:center;gap:.5rem}.bulk-bar button{padding:.45rem .7rem;border:1px solid var(--color-border);border-radius:.5rem;background:#fff;font-weight:700}.bulk-bar #apply-bulk-status{background:var(--color-navy);color:#fff}.bulk-bar button:disabled{opacity:.4}.trip-group{overflow:hidden;margin-bottom:1rem;background:#fff;border:1px solid var(--color-border);border-radius:1rem}.trip-group>header{background:var(--color-blush);border-left:4px solid var(--color-coral)}.trip-toggle{display:flex;width:100%;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.15rem;border:0;background:transparent;color:inherit;cursor:pointer;text-align:left;font:inherit}.trip-toggle:focus-visible{outline:2px solid var(--color-coral);outline-offset:-3px}.trip-heading{display:flex;align-items:center;gap:.6rem}.trip-group h2{margin:0;font:700 1.05rem var(--font-display);color:var(--color-navy)}.trip-group header span,.departure-summary>span{font-size:.74rem;color:var(--color-text-secondary)}.trip-group header .active,.trip-group header .closed{padding:.15rem .5rem;border-radius:999px;font-weight:700;text-transform:uppercase}.trip-group header .active{background:#D1FAE5;color:#065F46}.trip-group header .closed{background:#E5E7EB;color:#374151}.trip-toggle-summary{display:flex;align-items:center;gap:.5rem;white-space:nowrap}.trip-chevron{font-size:1rem!important;transition:transform .18s ease}.trip-group.collapsed .trip-chevron{transform:rotate(-90deg)}.trip-group.collapsed>.departures,.trip-group.collapsed>.registration-list{display:none}.departures{padding:.75rem;background:#FCFAF9}.departure{border:1px solid var(--color-border);border-radius:.75rem;background:#fff;margin-bottom:.65rem;overflow:hidden}.departure:last-child{margin-bottom:0}.departure-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.75rem .9rem}.departure-title,.departure-summary{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}.departure-title small{display:block;margin-top:.15rem;color:var(--color-text-secondary);font-size:.7rem}.departure-select-checkbox{width:1rem;height:1rem;accent-color:var(--color-coral)}.departure-summary b{padding:.15rem .5rem;border-radius:999px;font-size:.7rem}.lead{background:#FEF9C3;color:#78350F}.pending{background:#FEF3C7;color:#92400E}.confirmed{background:#D1FAE5;color:#065F46}.rejected{background:#FEE2E2;color:#991B1B}.dep-actions a{padding:.2rem .45rem;font-size:.7rem}.registration-list{display:flex;flex-direction:column;gap:.6rem;padding:.7rem;border-top:1px solid var(--color-border);background:#FCFAF9}.history-item{display:none}.legacy>.registration-list{border-top:1px solid var(--color-border)}#noResults{display:none;text-align:center;padding:2rem;color:var(--color-text-secondary)}@media(max-width:900px){.stats-grid{grid-template-columns:repeat(3,1fr)}.departure-head{align-items:flex-start;flex-direction:column}.bulk-bar,.bulk-bar>div{align-items:stretch;flex-direction:column}}@media(max-width:600px){.stats-grid{grid-template-columns:repeat(2,1fr)}.filters,.filters>*{width:100%!important}.trip-toggle{align-items:flex-start}.trip-heading{align-items:flex-start;flex-direction:column}}
</style>

<script define:vars={{ tripFilterData }}>
  function toggleDetail(id:number){const el=document.getElementById('detail-'+id);if(!el)return;const open=getComputedStyle(el).display==='none';el.style.display=open?'block':'none';const b=el.parentElement?.querySelector<HTMLButtonElement>('.details-btn');if(b){b.textContent=open?'Hide details':'View details';b.setAttribute('aria-expanded',String(open))}}
  const badgeStyle=(s:string)=>s==='confirmed'?'background:#D1FAE5;color:#065F46;':s==='rejected'?'background:#FEE2E2;color:#991B1B;':s==='lead'?'background:#FEF9C3;color:#78350F;':'background:#FEF3C7;color:#92400E;';
  async function requestStatusUpdate(id:number,status:string,admin_notes=''){const res=await fetch('/api/admin/update-registration',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,status,admin_notes})});if(res.ok){const badge=document.querySelector<HTMLElement>(`.status-badge[data-id="${id}"]`);if(badge){badge.textContent=status;badge.style.cssText=badgeStyle(status)}const row=badge?.closest<HTMLElement>('.reg-row');if(row)row.dataset.status=status;return{ok:true}}const data=await res.json().catch(()=>null);return{ok:false,error:data?.error||'Status update failed.'}}
  async function updateStatus(id:number,status:string){if(!confirm(`Mark this registration as "${status}"?`))return;const notes=(document.getElementById('notes-'+id)as HTMLTextAreaElement|null)?.value??'';const result=await requestStatusUpdate(id,status,notes);if(!result.ok)alert(result.error)}
  async function requestPaymentUpdate(ids:number[],action:string){const res=await fetch('/api/admin/registrations/payment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids,action})});const data=await res.json().catch(()=>null);return res.ok?data:{success:false,error:data?.error||'Payment update failed.'}}
  async function updatePayment(id:number,action:string){if(!confirm(`Set payment for registration #${id} to "${action}"?`))return;const data=await requestPaymentUpdate([id],action);if(!data.success||data.failed)alert(data.error||data.results?.find((r:any)=>!r.success)?.error||'Payment update failed.');else location.reload()}
  async function saveNotes(id:number){const badge=document.querySelector<HTMLElement>(`.status-badge[data-id="${id}"]`);const notes=(document.getElementById('notes-'+id)as HTMLTextAreaElement|null)?.value??'';const result=await requestStatusUpdate(id,badge?.textContent?.trim()||'pending',notes);if(result.ok){const msg=document.getElementById('msg-'+id);if(msg){msg.style.setProperty('display','block','important');setTimeout(()=>msg.style.removeProperty('display'),1500)}}}
  const search=document.getElementById('search')as HTMLInputElement, statusFilter=document.getElementById('statusFilter')as HTMLSelectElement, tripFilter=document.getElementById('tripFilter')as HTMLSelectElement, history=document.getElementById('show-history')as HTMLInputElement;
  const tripFilterOptions = tripFilterData as { slug:string; name:string; active:boolean; historical:boolean; departures:{ startDate:string; endDate:string; historical:boolean }[] }[];
  const boxes=()=>[...document.querySelectorAll<HTMLInputElement>('.registration-checkbox')];
  const visibleBoxes=()=>boxes().filter(b=>{const row=b.closest<HTMLElement>('.reg-row'),trip=b.closest<HTMLElement>('.trip-group'),dep=b.closest<HTMLElement>('.departure');return row?.style.display!=='none'&&trip?.style.display!=='none'&&dep?.style.display!=='none'});
  function renderTripFilterOptions() {
    const keep = tripFilter.value;
    const options = tripFilterOptions.filter((trip) => history?.checked || trip.active);
    tripFilter.innerHTML = '<option value="">All trips</option>';
    for (const trip of options) {
      const o = document.createElement('option');
      o.value = trip.slug;
      o.textContent = trip.active ? trip.name : `${trip.name} — history`;
      tripFilter.appendChild(o);
    }
    if (keep && [...tripFilter.options].some((opt) => opt.value === keep)) tripFilter.value = keep;
    else tripFilter.value = '';
  }
  function selectionUI(){const selected=boxes().filter(b=>b.checked), matching=visibleBoxes(), all=document.getElementById('select-all-visible')as HTMLInputElement|null, apply=document.getElementById('apply-bulk-status')as HTMLButtonElement|null, bulk=document.getElementById('bulk-status')as HTMLSelectElement|null, payApply=document.getElementById('apply-bulk-payment')as HTMLButtonElement|null,payBulk=document.getElementById('bulk-payment')as HTMLSelectElement|null,count=document.getElementById('selected-count');if(count)count.textContent=`${selected.length} selected`;if(apply)apply.disabled=!selected.length||!bulk?.value;if(payApply)payApply.disabled=!selected.length||!payBulk?.value;if(all){const n=matching.filter(b=>b.checked).length;all.checked=matching.length>0&&n===matching.length;all.indeterminate=n>0&&n<matching.length}document.querySelectorAll<HTMLInputElement>('.departure-select-checkbox').forEach(g=>{const dep=g.closest('.departure'),bs=[...(dep?.querySelectorAll<HTMLInputElement>('.registration-checkbox')??[])].filter(b=>b.closest<HTMLElement>('.reg-row')?.style.display!=='none'),n=bs.filter(b=>b.checked).length;g.checked=bs.length>0&&n===bs.length;g.indeterminate=n>0&&n<bs.length})}
  function applyFilters(){const q=search?.value.toLowerCase()??'',s=statusFilter?.value??'',t=tripFilter?.value.toLowerCase()??'';let visible=0,visibleRegs=0;document.querySelectorAll<HTMLElement>('.trip-group').forEach(trip=>{const historyHidden=trip.classList.contains('history-item')&&!history.checked;if(historyHidden){trip.style.display='none';delete trip.dataset.everExpanded;return}let tripVisible=0;trip.querySelectorAll<HTMLElement>('.departure').forEach(dep=>{if(dep.classList.contains('history-item')&&!history.checked){dep.style.display='none';return}else if(dep.classList.contains('history-item')){dep.style.display='block'}let depVisible=0;dep.querySelectorAll<HTMLElement>('.reg-row').forEach(row=>{const rowTrip=row.dataset.tripSlug||row.dataset.trip||'';const show=(!q||row.dataset.name?.includes(q)||row.dataset.email?.includes(q)||row.dataset.trip?.includes(q)||rowTrip.includes(q))&&(!s||row.dataset.status===s)&&(!t||rowTrip===t);row.style.display=show?'block':'none';if(show){depVisible++;visibleRegs++;}else{const b=row.querySelector<HTMLInputElement>('.registration-checkbox');if(b)b.checked=false}});const tripMatch=!t||trip.dataset.trip.toLowerCase()===t;const show=tripMatch&&(depVisible>0||(!q&&!s));dep.style.display=show?'block':'none';if(show)tripVisible++});if(trip.classList.contains('legacy')){const rows=[...trip.querySelectorAll<HTMLElement>('.reg-row')];tripVisible=rows.filter(r=>r.style.display!=='none').length}if(tripVisible>0){trip.style.display='block';if(trip.classList.contains('history-item')&&!trip.dataset.everExpanded){if(!trip.classList.contains('collapsed')){trip.classList.add('collapsed');trip.querySelector('.trip-toggle')?.setAttribute('aria-expanded','false')}trip.dataset.everExpanded='1'}}else{trip.style.display='none'}visible+=tripVisible});const fs=document.getElementById('filterStatus');if(fs){const active=!!(q||s||t||history?.checked);fs.style.display=active&&visible?'block':'none';if(active)fs.textContent=`Showing ${visibleRegs} registration${visibleRegs===1?'':'s'} across ${visible} departure${visible===1?'':'s'}`}const nr=document.getElementById('noResults');if(nr)nr.style.display=visible?'none':'block';selectionUI();const exportLink=document.getElementById('exportLink')as HTMLAnchorElement|null;if(exportLink){const selected=tripFilter.value;const selectedName=tripFilterOptions.find((trip)=>trip.slug===selected)?.name;exportLink.href=selectedName?`/api/admin/export?type=registrations&trip_name=${encodeURIComponent(selectedName)}`:'/api/admin/export?type=registrations'}}
  boxes().forEach(b=>b.addEventListener('change',selectionUI));document.querySelectorAll<HTMLInputElement>('.departure-select-checkbox').forEach(g=>g.addEventListener('change',()=>{g.closest('.departure')?.querySelectorAll<HTMLInputElement>('.registration-checkbox').forEach(b=>{if(b.closest<HTMLElement>('.reg-row')?.style.display!=='none')b.checked=g.checked});selectionUI()}));
  document.getElementById('select-all-visible')?.addEventListener('change',e=>{visibleBoxes().forEach(b=>b.checked=(e.target as HTMLInputElement).checked);selectionUI()});document.getElementById('clear-selection')?.addEventListener('click',()=>{boxes().forEach(b=>b.checked=false);selectionUI()});document.getElementById('bulk-status')?.addEventListener('change',selectionUI);
  document.getElementById('bulk-payment')?.addEventListener('change',selectionUI);
  document.getElementById('apply-bulk-status')?.addEventListener('click',async()=>{const selected=boxes().filter(b=>b.checked),status=(document.getElementById('bulk-status')as HTMLSelectElement).value;if(!selected.length||!status||!confirm(`Change ${selected.length} registration(s) to ${status}?`))return;const failures=[];for(const b of selected){const id=Number(b.dataset.registrationId),r=await requestStatusUpdate(id,status);if(!r.ok)failures.push(`#${id}: ${r.error}`)}if(failures.length)alert(failures.join('\n'));else location.reload()});
  document.getElementById('apply-bulk-payment')?.addEventListener('click',async()=>{const selected=boxes().filter(b=>b.checked),action=(document.getElementById('bulk-payment')as HTMLSelectElement).value;if(!selected.length||!action||!confirm(`Apply payment action "${action}" to ${selected.length} registration(s)?`))return;const data=await requestPaymentUpdate(selected.map(b=>Number(b.dataset.registrationId)),action);if(!data.success)alert(data.error);else if(data.failed)alert(data.results.filter((r:any)=>!r.success).map((r:any)=>`#${r.id}: ${r.error}`).join('\n'));else location.reload()});
  document.querySelectorAll<HTMLButtonElement>('.trip-toggle').forEach(toggle=>toggle.addEventListener('click',()=>{const group=toggle.closest<HTMLElement>('.trip-group');if(!group)return;const collapsed=group.classList.toggle('collapsed');toggle.setAttribute('aria-expanded',String(!collapsed));selectionUI()}));
  search?.addEventListener('input',applyFilters);statusFilter?.addEventListener('change',applyFilters);tripFilter?.addEventListener('change',applyFilters);history?.addEventListener('change',()=>{renderTripFilterOptions();applyFilters()});renderTripFilterOptions();applyFilters();
</script>
