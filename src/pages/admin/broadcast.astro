---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import { getDb } from '../../lib/db';
export const prerender = false;

const logs = getDb()
  .prepare('SELECT * FROM broadcast_log ORDER BY sent_at DESC LIMIT 20')
  .all() as Array<{ id: string; subject: string; sent_at: string; recipient_count: number; status: string }>;

function fmt(d: string) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
---

<AdminLayout title="Broadcast" page="broadcast">
  <div class="max-w-[720px]">
    <h1 class="font-display text-2xl font-extrabold text-navy-deep mt-0 mx-0 mb-1">
      Send Broadcast
    </h1>
    <p class="text-gray-text text-sm mt-0 mx-0 mb-8">
      Email all active newsletter subscribers.
    </p>

    <form id="broadcast-form" class="bg-white rounded-xl p-6 shadow-card mb-8">
      <div class="mb-5">
        <label class="block text-sm font-semibold mb-1.5 text-navy">Subject</label>
        <input
          type="text"
          name="subject"
          required
          placeholder="e.g. New Batch: Spiti Valley — June 2025"
          class="w-full py-2.5 px-3.5 border border-border rounded-lg text-sm box-border outline-none"
        />
      </div>

      <div class="mb-5">
        <label class="block text-sm font-semibold mb-1.5 text-navy">
          Body
          <span class="font-normal text-gray-text ml-1">(HTML supported)</span>
        </label>
        <textarea
          name="body_html"
          required
          rows="8"
          placeholder="<p>We just opened a new batch for ...</p>"
          class="w-full py-2.5 px-3.5 border border-border rounded-lg text-sm box-border resize-y outline-none font-mono"
        ></textarea>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-semibold mb-1.5 text-navy">Post URL <span class="font-normal text-gray-text">(optional)</span></label>
        <input
          type="url"
          name="post_url"
          placeholder="https://www.seekthethrill.in/trips/spiti-valley"
          class="w-full py-2.5 px-3.5 border border-border rounded-lg text-sm box-border outline-none"
        />
      </div>

      <div id="broadcast-status" class="hidden mb-4 py-3 px-4 rounded-lg text-sm"></div>

      <Button type="submit"
        id="broadcast-btn" variant="primary" size="md">
        Send to all active subscribers
      </Button>
    </form>

    {logs.length > 0 && (
      <div>
        <h2 class="text-base font-bold text-navy mt-0 mx-0 mb-4">Recent broadcasts</h2>
        <div class="bg-white rounded-xl overflow-hidden shadow-card">
          <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="bg-surface-soft border-b border-border">
                <th class="py-3 px-4 text-left text-gray-text font-semibold">Subject</th>
                <th class="py-3 px-4 text-left text-gray-text font-semibold">Sent</th>
                <th class="py-3 px-4 text-right text-gray-text font-semibold">Recipients</th>
                <th class="py-3 px-4 text-right text-gray-text font-semibold">Status</th>
              </tr>
            </thead>
            <tbody>
              {logs.map((log) => (
                <tr class="border-b border-border">
                  <td class="py-3 px-4 text-navy">{log.subject}</td>
                  <td class="py-3 px-4 text-gray-text">{fmt(log.sent_at)}</td>
                  <td class="py-3 px-4 text-right text-navy">{log.recipient_count}</td>
                  <td class="py-3 px-4 text-right">
                    <span style={`display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: ${log.status === 'sent' ? 'var(--color-success-surface)' : 'var(--color-danger-surface)'}; color: ${log.status === 'sent' ? 'var(--color-success-surface-ink)' : 'var(--color-danger-ink)'};`}>
                      {log.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('broadcast-form') as HTMLFormElement | null;
  const btn  = document.getElementById('broadcast-btn') as HTMLButtonElement | null;
  const status = document.getElementById('broadcast-status') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !status) return;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.style.display = 'none';

    const fd = new FormData(form!);
    try {
      const res = await fetch('/api/admin/send-broadcast', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          subject:   fd.get('subject'),
          body_html: fd.get('body_html'),
          post_url:  fd.get('post_url') || '',
        }),
      });
      const data = await res.json();
      if (data.success) {
        status.style.background = 'var(--color-success-surface)';
        status.style.color = 'var(--color-success-surface-ink)';
        status.textContent = `Sent to ${data.sent} subscriber${data.sent !== 1 ? 's' : ''}${data.failed ? ` (${data.failed} failed)` : ''}.`;
        form!.reset();
      } else {
        status.style.background = 'var(--color-danger-surface)';
        status.style.color = 'var(--color-danger-ink)';
        status.textContent = data.error ?? 'Something went wrong.';
      }
    } catch {
      status.style.background = 'var(--color-danger-surface)';
      status.style.color = 'var(--color-danger-ink)';
      status.textContent = 'Network error. Please try again.';
    }
    status.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Send to all active subscribers';
  });
</script>
