---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
export const prerender = false;

const logs = getDb()
  .prepare('SELECT * FROM broadcast_log ORDER BY sent_at DESC LIMIT 20')
  .all() as Array<{ id: string; subject: string; sent_at: string; recipient_count: number; status: string }>;

function fmt(d: string) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
---

<AdminLayout title="Broadcast" page="broadcast">
  <div class="max-w-[720px]">
    <h1 class="font-display text-[1.5rem] font-extrabold text-[#111D27] mt-[0] mx-[0] mb-[0.25rem]">
      Send Broadcast
    </h1>
    <p class="text-gray-text text-[0.875rem] mt-[0] mx-[0] mb-[2rem]">
      Email all active newsletter subscribers.
    </p>

    <form id="broadcast-form" class="bg-white rounded-[12px] p-[1.5rem] shadow-[0_1px_4px_rgba(0,0,0,0.08)] mb-[2rem]">
      <div class="mb-[1.25rem]">
        <label class="block text-[0.875rem] font-semibold mb-[0.4rem] text-navy">Subject</label>
        <input
          type="text"
          name="subject"
          required
          placeholder="e.g. New Batch: Spiti Valley — June 2025"
          class="w-full py-[0.65rem] px-[0.9rem] border-[1.5px] border-[#E5E7EB] rounded-[8px] text-[0.875rem] box-border outline-none"
        />
      </div>

      <div class="mb-[1.25rem]">
        <label class="block text-[0.875rem] font-semibold mb-[0.4rem] text-navy">
          Body
          <span class="font-normal text-gray-text ml-[4px]">(HTML supported)</span>
        </label>
        <textarea
          name="body_html"
          required
          rows="8"
          placeholder="<p>We just opened a new batch for ...</p>"
          class="w-full py-[0.65rem] px-[0.9rem] border-[1.5px] border-[#E5E7EB] rounded-[8px] text-[0.875rem] box-border resize-y outline-none font-mono"
        ></textarea>
      </div>

      <div class="mb-[1.5rem]">
        <label class="block text-[0.875rem] font-semibold mb-[0.4rem] text-navy">Post URL <span class="font-normal text-gray-text">(optional)</span></label>
        <input
          type="url"
          name="post_url"
          placeholder="https://www.seekthethrill.in/trips/spiti-valley"
          class="w-full py-[0.65rem] px-[0.9rem] border-[1.5px] border-[#E5E7EB] rounded-[8px] text-[0.875rem] box-border outline-none"
        />
      </div>

      <div id="broadcast-status" class="hidden mb-[1rem] py-[0.75rem] px-[1rem] rounded-[8px] text-[0.875rem]"></div>

      <button
        type="submit"
        id="broadcast-btn"
        class="py-[0.65rem] px-[1.5rem] bg-navy text-white border-none rounded-[8px] text-[0.875rem] font-semibold cursor-pointer"
      >
        Send to all active subscribers
      </button>
    </form>

    {logs.length > 0 && (
      <div>
        <h2 class="text-[1rem] font-bold text-navy mt-[0] mx-[0] mb-[1rem]">Recent broadcasts</h2>
        <div class="bg-white rounded-[12px] overflow-hidden shadow-[0_1px_4px_rgba(0,0,0,0.08)]">
          <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[0.875rem]">
            <thead>
              <tr class="bg-[#F9FAFB] border-b border-[#F0F0F0]">
                <th class="py-[0.75rem] px-[1rem] text-left text-gray-text font-semibold">Subject</th>
                <th class="py-[0.75rem] px-[1rem] text-left text-gray-text font-semibold">Sent</th>
                <th class="py-[0.75rem] px-[1rem] text-right text-gray-text font-semibold">Recipients</th>
                <th class="py-[0.75rem] px-[1rem] text-right text-gray-text font-semibold">Status</th>
              </tr>
            </thead>
            <tbody>
              {logs.map((log) => (
                <tr class="border-b border-[#F9FAFB]">
                  <td class="py-[0.75rem] px-[1rem] text-navy">{log.subject}</td>
                  <td class="py-[0.75rem] px-[1rem] text-gray-text">{fmt(log.sent_at)}</td>
                  <td class="py-[0.75rem] px-[1rem] text-right text-navy">{log.recipient_count}</td>
                  <td class="py-[0.75rem] px-[1rem] text-right">
                    <span style={`display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; background: ${log.status === 'sent' ? '#D1FAE5' : '#FEE2E2'}; color: ${log.status === 'sent' ? '#065F46' : '#991B1B'};`}>
                      {log.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('broadcast-form') as HTMLFormElement | null;
  const btn  = document.getElementById('broadcast-btn') as HTMLButtonElement | null;
  const status = document.getElementById('broadcast-status') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !status) return;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.style.display = 'none';

    const fd = new FormData(form!);
    try {
      const res = await fetch('/api/admin/send-broadcast', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          subject:   fd.get('subject'),
          body_html: fd.get('body_html'),
          post_url:  fd.get('post_url') || '',
        }),
      });
      const data = await res.json();
      if (data.success) {
        status.style.background = '#D1FAE5';
        status.style.color = '#065F46';
        status.textContent = `Sent to ${data.sent} subscriber${data.sent !== 1 ? 's' : ''}${data.failed ? ` (${data.failed} failed)` : ''}.`;
        form!.reset();
      } else {
        status.style.background = '#FEE2E2';
        status.style.color = '#991B1B';
        status.textContent = data.error ?? 'Something went wrong.';
      }
    } catch {
      status.style.background = '#FEE2E2';
      status.style.color = '#991B1B';
      status.textContent = 'Network error. Please try again.';
    }
    status.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Send to all active subscribers';
  });
</script>
