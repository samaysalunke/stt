---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import { listAlbums } from '../../../lib/content';

const albums = listAlbums();
---

<AdminLayout title="Photo Vault" page="photo-vault">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-display text-2xl font-bold text-navy m-0">Photo Vault</h1>
    <Button href="/admin/photo-vault/new" variant="primary" size="sm">+ New Album</Button>
  </div>

  {albums.length === 0 ? (
    <div class="text-center py-16 px-8 text-gray-text">
      <p class="text-lg mb-4">No albums yet.</p>
      <Button href="/admin/photo-vault/new" variant="primary" size="md">Create your first album</Button>
    </div>
  ) : (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-5">
      {albums.map(album => {
        const photos = Array.isArray(album.photos) ? album.photos : [];
        return (
          <div class="bg-white overflow-hidden rounded-[var(--radius-card)] border border-peach/60">
            <div class="h-[160px] overflow-hidden bg-gray-soft relative">
              {album.coverImage ? (
                <img src={album.coverImage} alt={album.name} class="w-full h-full object-cover" />
              ) : photos[0]?.image ? (
                <img src={photos[0].image} alt={album.name} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-text text-3xl">🖼️</div>
              )}
              <div style={`position:absolute; top:0.5rem; right:0.5rem; padding:0.2rem 0.6rem; border-radius:9999px; font-size:0.7rem; font-weight:700; ${album.published ? 'background:var(--color-success-surface);color:var(--color-success-surface-ink);' : 'background:var(--color-muted-surface);color:var(--color-muted-ink);'}`}>
                {album.published ? 'Published' : 'Draft'}
              </div>
            </div>
            <div class="p-4">
              <div class="font-bold text-navy mb-1">{album.name ?? album.slug}</div>
              <div class="text-xs text-gray-text mb-0.5">{album.location ?? ''}</div>
              <div class="text-xs text-gray-text">{photos.length} photo{photos.length !== 1 ? 's' : ''}</div>
              <div class="flex gap-2 mt-3">
                <a href={`/admin/photo-vault/${album.slug}`} class="flex-1 text-center text-xs text-navy no-underline border border-navy rounded-md py-1 px-2 font-medium">Edit</a>
                <button
                  class="delete-album-btn flex-1 text-xs text-danger-ink bg-transparent border border-danger-ink rounded-md py-1 px-2 cursor-pointer font-medium"
                  data-slug={album.slug}
                  data-name={album.name ?? album.slug}
                 
                >Delete</button>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</AdminLayout>

<script>
document.querySelectorAll('.delete-album-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const target = e.target as HTMLButtonElement;
    const slug = target.dataset.slug!;
    const name = target.dataset.name!;
    if (!confirm(`Delete album "${name}"? This cannot be undone.`)) return;
    try {
      const res = await fetch('/api/admin/albums/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      if (!res.ok) throw new Error('Failed');
      window.location.reload();
    } catch {
      alert('Failed to delete album. Try again.');
    }
  });
});
</script>
