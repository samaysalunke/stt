---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAlbums } from '../../../lib/content';

const albums = listAlbums();
---

<AdminLayout title="Photo Vault" page="photo-vault">
  <div class="flex items-center justify-between mb-[1.5rem]">
    <h1 class="font-display text-[1.5rem] font-bold text-navy m-0">Photo Vault</h1>
    <a href="/admin/photo-vault/new" class="bg-navy text-white py-[0.5rem] px-[1.25rem] rounded-[0.5rem] no-underline font-semibold text-[0.875rem]">+ New Album</a>
  </div>

  {albums.length === 0 ? (
    <div class="text-center py-[4rem] px-[2rem] text-gray-text">
      <p class="text-[1.1rem] mb-[1rem]">No albums yet.</p>
      <a href="/admin/photo-vault/new" class="bg-navy text-white py-[0.6rem] px-[1.5rem] rounded-[0.5rem] no-underline font-semibold">Create your first album</a>
    </div>
  ) : (
    <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-[1.25rem]">
      {albums.map(album => {
        const photos = Array.isArray(album.photos) ? album.photos : [];
        return (
          <div style="background:var(--color-surface-elevated); border:1px solid var(--color-border); border-radius:0.75rem; overflow:hidden;">
            <div class="h-[160px] overflow-hidden bg-gray-soft relative">
              {album.coverImage ? (
                <img src={album.coverImage} alt={album.name} class="w-full h-full object-cover" />
              ) : photos[0]?.image ? (
                <img src={photos[0].image} alt={album.name} class="w-full h-full object-cover" />
              ) : (
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:var(--color-text-muted); font-size:2rem;">🖼️</div>
              )}
              <div style={`position:absolute; top:0.5rem; right:0.5rem; padding:0.2rem 0.6rem; border-radius:9999px; font-size:0.7rem; font-weight:700; ${album.published ? 'background:#16a34a22; color:#16a34a;' : 'background:#6b728022; color:#6b7280;'}`}>
                {album.published ? 'Published' : 'Draft'}
              </div>
            </div>
            <div class="p-[1rem]">
              <div class="font-bold text-navy mb-[0.25rem]">{album.name ?? album.slug}</div>
              <div class="text-[0.8rem] text-gray-text mb-[0.15rem]">{album.location ?? ''}</div>
              <div style="font-size:0.8rem; color:var(--color-text-muted);">{photos.length} photo{photos.length !== 1 ? 's' : ''}</div>
              <div class="flex gap-[0.5rem] mt-[0.75rem]">
                <a href={`/admin/photo-vault/${album.slug}`} class="flex-1 text-center text-[0.8rem] text-navy no-underline border border-navy rounded-[0.35rem] py-[0.3rem] px-[0.5rem] font-medium">Edit</a>
                <button
                  class="delete-album-btn flex-1 text-[0.8rem] text-[#dc2626] bg-transparent border border-[#dc2626] rounded-[0.35rem] py-[0.3rem] px-[0.5rem] cursor-pointer font-medium"
                  data-slug={album.slug}
                  data-name={album.name ?? album.slug}
                 
                >Delete</button>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</AdminLayout>

<script>
document.querySelectorAll('.delete-album-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const target = e.target as HTMLButtonElement;
    const slug = target.dataset.slug!;
    const name = target.dataset.name!;
    if (!confirm(`Delete album "${name}"? This cannot be undone.`)) return;
    try {
      const res = await fetch('/api/admin/albums/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      if (!res.ok) throw new Error('Failed');
      window.location.reload();
    } catch {
      alert('Failed to delete album. Try again.');
    }
  });
});
</script>
