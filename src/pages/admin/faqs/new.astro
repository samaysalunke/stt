---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listFaqs } from '../../../lib/content';
import { ADMIN_CONTENT_INPUT_CLASS as inputCls, ADMIN_CONTENT_LABEL_CLASS as labelCls } from '../../../components/admin/formClasses';
export const prerender = false;

const categories = Array.from(new Set(listFaqs().map(f => f.category).filter(Boolean)));

---

<AdminLayout title="New FAQ" page="faqs">
  <form method="POST" action="/api/admin/faqs/create" class="bg-white rounded-[2rem] p-6 max-w-2xl border border-peach/60">
    <div class="grid gap-4">
      <div>
        <label class={labelCls}>Question</label>
        <input type="text" name="question" required class={inputCls} />
      </div>
      <div>
        <label class={labelCls}>Answer</label>
        <textarea name="answer" rows="4" required class={inputCls}></textarea>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class={labelCls}>Category</label>
          <input type="text" name="category" list="faq-cats" placeholder="e.g. Booking" class={inputCls} />
          <datalist id="faq-cats">{categories.map(c => <option value={c}></option>)}</datalist>
        </div>
        <div>
          <label class={labelCls}>Order</label>
          <input type="number" name="order" placeholder="Lower = higher up" class={inputCls} />
        </div>
      </div>
      <label class="flex items-start gap-3 rounded-2xl px-4 py-3 border border-peach/80 bg-white">
        <input type="checkbox" name="defaultOnTripPages" class="mt-1" />
        <span>
          <span class="block text-sm font-semibold text-navy">Default on trip pages</span>
          <span class="block text-xs mt-1 text-navy/55">Show this FAQ on every trip unless a trip hides it.</span>
        </span>
      </label>
    </div>
    <div class="flex items-center gap-3 mt-6">
      <button type="submit" class="rounded-full px-7 py-3 text-sm font-semibold text-white bg-cta">Create</button>
      <a href="/admin/faqs/" class="text-sm font-medium text-navy/55">Cancel</a>
    </div>
  </form>
</AdminLayout>
