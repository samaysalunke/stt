---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listFaqs } from '../../../lib/content';
export const prerender = false;

const faqs = listFaqs();
const categoryOrder: string[] = [];
const grouped: Record<string, Array<Record<string, any>>> = {};
for (const f of faqs) {
  const cat = (f.category as string) || 'General';
  if (!grouped[cat]) { grouped[cat] = []; categoryOrder.push(cat); }
  grouped[cat].push(f);
}
---

<AdminLayout title="FAQ" page="faqs">
  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-text">{faqs.length} question{faqs.length === 1 ? '' : 's'} · shown on the public FAQ page</p>
    <a href="/admin/faqs/new/" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-white bg-navy">+ New</a>
  </div>

  {faqs.length === 0 ? (
    <div class="bg-white rounded-[2rem] p-10 text-center border border-peach/60">
      <p class="text-sm text-gray-text">No FAQs yet. Add the first one.</p>
    </div>
  ) : (
    categoryOrder.map(cat => (
      <div class="mb-8">
        <h2 class="font-display text-lg font-semibold mb-3 text-navy">{cat}</h2>
        <div class="flex flex-col gap-2.5">
          {grouped[cat].map(f => (
            <div class="bg-white rounded-2xl p-4 flex items-start justify-between gap-4 border border-peach/60">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-navy">{f.question}</p>
                <span class="inline-block mt-1 rounded-full px-2 py-0.5 text-[10px] font-semibold" style={f.defaultOnTripPages === true ? 'background:var(--color-success-surface);color:var(--color-success-surface-ink);' : 'background:var(--color-muted-surface);color:var(--color-muted-ink);'}>
                  {f.defaultOnTripPages === true ? 'Default on trips' : 'Not default on trips'}
                </span>
                <p class="text-xs mt-1 line-clamp-2 text-gray-text">{f.answer}</p>
              </div>
              <div class="flex items-center gap-3 flex-none">
                <a href={`/admin/faqs/${f.slug}/`} class="text-sm font-medium text-coral-ink">Edit</a>
                <form method="POST" action="/api/admin/faqs/delete" onsubmit="return confirm('Delete this FAQ?');">
                  <input type="hidden" name="slug" value={f.slug} />
                  <button type="submit" class="text-sm font-medium text-danger">Delete</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  )}
</AdminLayout>
