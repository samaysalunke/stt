---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { contentLastmod, listTrips, upcomingBatches, tripCardSummary, tripCardSummaryAnyBatch, tripPriority } from '../../../lib/content';
import { getDb } from '../../../lib/db';

const db = getDb();
// Confirmed seats per departure — the source of truth for "Next batch" is the
// registrations table (status='confirmed'), not the admin-maintained YAML counter.
const confirmedByBatch = new Map<string, number>();
for (const row of db
  .prepare("SELECT trip_slug, batch_id, COUNT(*) AS n FROM registrations WHERE status='confirmed' AND batch_id IS NOT NULL GROUP BY trip_slug, batch_id")
  .all() as Array<{ trip_slug: string; batch_id: string; n: number }>) {
  confirmedByBatch.set(`${row.trip_slug}::${row.batch_id}`, row.n);
}

// Derive an at-a-glance summary from each trip's departures (the source of truth).
const trips = listTrips().map((t) => {
  const allBatches = Array.isArray(t.batches) ? t.batches : [];
  const upcoming = upcomingBatches(t);
  const lead = upcoming[0] ?? allBatches[0] ?? null;
  const summary = tripCardSummary(t);
  // Card price falls back to past batches so expired trips show a number, not "—".
  const cardPrice = tripCardSummaryAnyBatch(t);
  // Trip-level status is gone — derive a display state from departures.
  const _derivedStatus = upcoming.length === 0 ? 'hidden' : (summary.soldOut ? 'sold-out' : 'booking-open');
  const offers = Array.isArray(lead?.offers) ? lead.offers : [];
  const meteredOffers = offers.length > 0 && offers.every((o: any) => Number.isFinite(Number(o?.cap)));
  const leadTotal = meteredOffers
    ? offers.reduce((sum: number, o: any) => sum + Math.max(0, Number(o.cap)), 0)
    : (lead?.totalSpots ?? null);
  // Only confirmed registrations count as booked seats.
  const leadBooked = lead?.id != null
    ? (confirmedByBatch.get(`${t.slug}::${lead.id}`) ?? 0)
    : null;
  return {
    ...t,
    _derivedStatus,
    _fromPrice: cardPrice.fromPrice,
    _hasSharing: cardPrice.multiPrice,
    _leadStart: lead?.startDate ?? null,
    _leadBooked: leadBooked,
    _leadTotal: leadTotal,
    _departureCount: allBatches.length,
    _upcomingCount: upcoming.length,
    _updatedAt: t.updatedAt ?? contentLastmod('trips', t.slug) ?? null,
    _priority: tripPriority(t.priority),
  };
});
const visibleTripCount = trips.filter((trip) => trip._upcomingCount > 0).length;

function fmtDay(d: string | null) {
  if (!d) return '—';
  const dt = new Date(d);
  return isNaN(dt.getTime()) ? '—' : dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
}

function fmtUpdatedAt(value: string | null) {
  if (!value) return '—';
  const date = new Date(value);
  return isNaN(date.getTime())
    ? '—'
    : date.toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'Asia/Kolkata',
      });
}

// Display vocabulary for the derived trip state (computed from departures).
// Surface/ink pairs from the status palette. These were single hues painted as
// `background:<hue>22; color:<hue>`, which put 2.9:1 green and 3.3:1 grey text
// on their own 13% tints — the same pattern the photo-vault pills used.
const statusStyles: Record<string, string> = {
  'booking-open': 'background:var(--color-success-surface); color:var(--color-success-surface-ink);',
  'hidden':       'background:var(--color-muted-surface); color:var(--color-muted-ink);',
  'sold-out':     'background:var(--color-danger-surface); color:var(--color-danger-ink);',
};
const statusLabels: Record<string, string> = {
  'booking-open': 'Booking Open',
  'hidden':       'No upcoming dates',
  'sold-out':     'Sold Out',
};
---

<AdminLayout title="Trips" page="trips">
  <div class="flex items-center justify-between mb-6">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <p id="trip-count" class="text-sm text-gray-text">
        {visibleTripCount} of {trips.length} trips
      </p>
      <label class="flex items-center gap-2 text-sm cursor-pointer text-navy">
        <input id="hide-done-trips" type="checkbox" checked class="h-4 w-4 accent-current" />
        Hide completed trips
      </label>
    </div>
    <div class="flex items-center gap-2">
      <a href="/admin/trips/import/" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-navy border border-peach">Import</a>
      <a href="/admin/trips/new" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-white bg-navy">+ New Trip</a>
    </div>
  </div>

  {trips.length === 0 ? (
    <div class="bg-white rounded-[2rem] p-10 text-center border border-peach/60">
      <p class="text-sm mb-4 text-gray-text">No trips yet.</p>
      <a href="/admin/trips/new" class="rounded-full px-6 py-3 text-sm font-semibold text-white inline-block bg-cta">Create your first trip</a>
    </div>
  ) : (
    <>
    <div id="trip-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {trips.map((trip) => (
        <div
          class="trip-card bg-white rounded-[2rem] p-5 flex flex-col border border-peach/60"
          data-done={trip._upcomingCount === 0 ? 'true' : 'false'}
          hidden={trip._upcomingCount === 0}
         
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="min-w-0">
              <h3 class="font-display text-base font-semibold truncate text-navy">{trip.name || trip.slug}</h3>
              <p class="text-[11px] truncate text-gray-text">{trip.slug}</p>
              <p class="mt-1 text-[11px] text-gray-text">Updated {fmtUpdatedAt(trip._updatedAt)}</p>
            </div>
            <span class="flex-none text-[9px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full"
                  style={statusStyles[trip._derivedStatus]}>
              {statusLabels[trip._derivedStatus]}
            </span>
          </div>

          <div class="grid grid-cols-3 gap-2 mb-4 text-center">
            <div class="rounded-xl py-2 bg-gray-soft">
              <div class="text-[10px] uppercase tracking-wide text-gray-text">{trip._hasSharing ? 'From' : 'Price'}</div>
              <div class="text-sm font-semibold text-navy">{trip._fromPrice ? `₹${Number(trip._fromPrice).toLocaleString('en-IN')}` : '—'}</div>
            </div>
            <div class="rounded-xl py-2 bg-gray-soft">
              <div class="text-[10px] uppercase tracking-wide text-gray-text">Next batch</div>
              <div class="text-sm font-semibold text-navy">{trip._leadTotal != null ? `${trip._leadBooked ?? 0}/${trip._leadTotal}` : '—'}</div>
            </div>
            <div class="rounded-xl py-2 bg-gray-soft">
              <div class="text-[10px] uppercase tracking-wide text-gray-text">{trip._departureCount > 1 ? `${trip._departureCount} dates` : 'Starts'}</div>
              <div class="text-xs font-semibold text-navy">{fmtDay(trip._leadStart)}</div>
            </div>
          </div>

          <div class="mb-4 flex items-center gap-3">
            <label class="text-xs font-semibold text-navy" for={`priority-${trip.slug}`}>Priority</label>
            <select
              id={`priority-${trip.slug}`}
              class="trip-priority min-h-9 flex-1 rounded-xl bg-white px-3 text-sm border border-peach text-navy"
             
              data-slug={trip.slug}
              data-saved-value={trip._priority}
            >
              <option value="high" selected={trip._priority === 'high'}>High</option>
              <option value="medium" selected={trip._priority === 'medium'}>Medium</option>
              <option value="low" selected={trip._priority === 'low'}>Low</option>
            </select>
            <span class="priority-state w-12 text-[11px] text-gray-text" aria-live="polite"></span>
          </div>

          <div class="mt-auto flex items-center gap-2 pt-1">
            <a href={`/admin/trips/${trip.slug}`} class="flex-1 text-center text-sm font-semibold rounded-full py-2 text-white bg-cta">Edit</a>
            <button class="duplicate-trip-btn text-sm font-medium rounded-full px-4 py-2 text-navy border border-peach" data-slug={trip.slug}
                    title="Duplicate this trip as a draft"
                   >Copy</button>
            <button class="delete-trip-btn text-sm font-medium rounded-full px-4 py-2 text-danger border border-danger" data-slug={trip.slug} data-name={trip.name || trip.slug}
                   >Delete</button>
          </div>
        </div>
      ))}
    </div>
    <div id="no-visible-trips" class="bg-white rounded-[2rem] p-10 text-center border border-peach/60" hidden={visibleTripCount > 0}>
      <p class="text-sm text-gray-text">No active trips. Uncheck “Hide completed trips” to view completed trips.</p>
    </div>
    </>
  )}
</AdminLayout>

<script>
const hideDoneTrips = document.getElementById('hide-done-trips') as HTMLInputElement | null;
const tripCards = Array.from(document.querySelectorAll<HTMLElement>('.trip-card'));
const tripCount = document.getElementById('trip-count');
const noVisibleTrips = document.getElementById('no-visible-trips');

function filterTrips() {
  const hideDone = hideDoneTrips?.checked ?? true;
  let visibleCount = 0;

  tripCards.forEach((card) => {
    const shouldHide = hideDone && card.dataset.done === 'true';
    card.hidden = shouldHide;
    if (!shouldHide) visibleCount++;
  });

  if (tripCount) tripCount.textContent = `${visibleCount} of ${tripCards.length} trips`;
  if (noVisibleTrips) noVisibleTrips.hidden = visibleCount > 0;
}

hideDoneTrips?.addEventListener('change', filterTrips);

document.querySelectorAll<HTMLSelectElement>('.trip-priority').forEach((select) => {
  const state = select.parentElement?.querySelector<HTMLElement>('.priority-state');
  select.addEventListener('change', async () => {
    const previous = select.dataset.savedValue ?? 'medium';
    const priority = select.value;
    select.disabled = true;
    if (state) { state.textContent = 'Saving…'; state.style.color = 'rgba(27,43,58,0.55)'; }
    try {
      const response = await fetch('/api/admin/trips/priority', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: select.dataset.slug, priority }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.success !== true) throw new Error(result.error || 'Save failed');
      select.dataset.savedValue = priority;
      if (state) { state.textContent = 'Saved'; state.style.color = 'var(--color-success)'; }
    } catch {
      select.value = previous;
      if (state) { state.textContent = 'Try again'; state.style.color = 'var(--color-danger)'; }
    } finally {
      select.disabled = false;
    }
  });
});

// Duplicate trip
document.querySelectorAll('.duplicate-trip-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const target = e.target as HTMLButtonElement;
    const slug = target.dataset.slug!;
    target.disabled = true;
    target.textContent = '...';
    try {
      const res = await fetch('/api/admin/trips/duplicate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error('Failed');
      window.location.href = `/admin/trips/${data.newSlug}`;
    } catch {
      alert('Failed to duplicate trip. Try again.');
      target.disabled = false;
      target.textContent = 'Copy';
    }
  });
});

// Delete trip
document.querySelectorAll('.delete-trip-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const target = e.target as HTMLButtonElement;
    const slug = target.dataset.slug!;
    const name = target.dataset.name!;
    if (!confirm(`Delete trip "${name}"?\n\nIt will be hidden from the site but kept on file, so it can be restored if this was a mistake.`)) return;
    try {
      const res = await fetch('/api/admin/trips/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      if (!res.ok) throw new Error('Failed');
      window.location.reload();
    } catch {
      alert('Failed to delete trip. Try again.');
    }
  });
});
</script>
