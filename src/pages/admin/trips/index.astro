---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listTrips } from '../../../lib/content';

const trips = listTrips();

const statusColors: Record<string, string> = {
  'booking-open': '#16a34a',
  'upcoming':     '#2563eb',
  'draft':        '#6b7280',
  'sold-out':     '#dc2626',
  'completed':    '#7c3aed',
};
const statusLabels: Record<string, string> = {
  'booking-open': 'Booking Open',
  'upcoming':     'Upcoming',
  'draft':        'Draft',
  'sold-out':     'Sold Out',
  'completed':    'Completed',
};
---

<AdminLayout title="Trips" page="trips">
  <div class="flex items-center justify-between mb-6">
    <p class="text-sm" style="color: rgba(27,43,58,0.55);">{trips.length} trip{trips.length === 1 ? '' : 's'}</p>
    <div class="flex items-center gap-2">
      <a href="/admin/trips/import/" class="rounded-xl px-4 py-2.5 text-sm font-semibold" style="color: var(--color-navy); border: 1px solid var(--color-peach);">Import</a>
      <a href="/admin/trips/new" class="rounded-xl px-4 py-2.5 text-sm font-semibold text-white" style="background: var(--color-navy);">+ New Trip</a>
    </div>
  </div>

  {trips.length === 0 ? (
    <div class="bg-white rounded-[2rem] p-10 text-center" style="border: 1px solid rgba(245,221,215,0.6);">
      <p class="text-sm mb-4" style="color: rgba(27,43,58,0.5);">No trips yet.</p>
      <a href="/admin/trips/new" class="rounded-full px-6 py-3 text-sm font-semibold text-white inline-block" style="background-color: var(--color-cta);">Create your first trip</a>
    </div>
  ) : (
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {trips.map((trip) => (
        <div class="bg-white rounded-[2rem] p-5 flex flex-col" style="border: 1px solid rgba(245,221,215,0.6);">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="min-w-0">
              <h3 class="font-display text-base font-semibold truncate" style="color: var(--color-navy);">{trip.name || trip.slug}</h3>
              <p class="text-[11px] truncate" style="color: rgba(27,43,58,0.45);">{trip.slug}</p>
            </div>
            <span class="flex-none text-[9px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full"
                  style={`background:${statusColors[trip.status] ?? '#6b7280'}22; color:${statusColors[trip.status] ?? '#6b7280'};`}>
              {statusLabels[trip.status] ?? trip.status}
            </span>
          </div>

          <div class="grid grid-cols-3 gap-2 mb-4 text-center">
            <div class="rounded-xl py-2" style="background: var(--color-gray-soft);">
              <div class="text-[10px] uppercase tracking-wide" style="color: rgba(27,43,58,0.45);">Price</div>
              <div class="text-sm font-semibold" style="color: var(--color-navy);">{trip.pricePerPerson ? `₹${Number(trip.pricePerPerson).toLocaleString('en-IN')}` : '—'}</div>
            </div>
            <div class="rounded-xl py-2" style="background: var(--color-gray-soft);">
              <div class="text-[10px] uppercase tracking-wide" style="color: rgba(27,43,58,0.45);">Booked</div>
              <div class="text-sm font-semibold" style="color: var(--color-navy);">{trip.currentBookings ?? 0}/{trip.maxGroupSize ?? '?'}</div>
            </div>
            <div class="rounded-xl py-2" style="background: var(--color-gray-soft);">
              <div class="text-[10px] uppercase tracking-wide" style="color: rgba(27,43,58,0.45);">Starts</div>
              <div class="text-xs font-semibold" style="color: var(--color-navy);">{trip.startDate ?? '—'}</div>
            </div>
          </div>

          <div class="mb-4">
            <label class="text-[10px] font-semibold uppercase tracking-widest" style="color: rgba(27,43,58,0.45);">Quick status</label>
            <select class="status-select w-full mt-1 rounded-xl px-3 py-2 text-sm" data-slug={trip.slug}
                    style="border: 1px solid rgba(245,221,215,0.8); background: var(--color-white); color: var(--color-navy);">
              {['booking-open','upcoming','draft','sold-out','completed'].map(s => (
                <option value={s} selected={s === trip.status}>{statusLabels[s]}</option>
              ))}
            </select>
          </div>

          <div class="mt-auto flex items-center gap-2 pt-1">
            <a href={`/admin/trips/${trip.slug}`} class="flex-1 text-center text-sm font-semibold rounded-full py-2 text-white" style="background-color: var(--color-cta);">Edit</a>
            <button class="duplicate-trip-btn text-sm font-medium rounded-full px-4 py-2" data-slug={trip.slug}
                    title="Duplicate this trip as a draft"
                    style="color: var(--color-navy); border: 1px solid var(--color-peach);">Copy</button>
            <button class="delete-trip-btn text-sm font-medium rounded-full px-4 py-2" data-slug={trip.slug} data-name={trip.name || trip.slug}
                    style="color: var(--color-danger); border: 1px solid var(--color-danger);">Delete</button>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<script>
// Quick status toggle
document.querySelectorAll('.status-select').forEach(sel => {
  sel.addEventListener('change', async (e) => {
    const target = e.target as HTMLSelectElement;
    const slug = target.dataset.slug!;
    const status = target.value;
    try {
      const res = await fetch('/api/admin/trips/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, status }),
      });
      if (!res.ok) throw new Error('Failed');
      window.location.reload();
    } catch {
      alert('Failed to update status. Try again.');
    }
  });
});

// Duplicate trip
document.querySelectorAll('.duplicate-trip-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const target = e.target as HTMLButtonElement;
    const slug = target.dataset.slug!;
    target.disabled = true;
    target.textContent = '...';
    try {
      const res = await fetch('/api/admin/trips/duplicate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error('Failed');
      window.location.href = `/admin/trips/${data.newSlug}`;
    } catch {
      alert('Failed to duplicate trip. Try again.');
      target.disabled = false;
      target.textContent = 'Copy';
    }
  });
});

// Delete trip
document.querySelectorAll('.delete-trip-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    const target = e.target as HTMLButtonElement;
    const slug = target.dataset.slug!;
    const name = target.dataset.name!;
    if (!confirm(`Delete trip "${name}"? This cannot be undone.`)) return;
    try {
      const res = await fetch('/api/admin/trips/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
      if (!res.ok) throw new Error('Failed');
      window.location.reload();
    } catch {
      alert('Failed to delete trip. Try again.');
    }
  });
});
</script>
