---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readTrip, listAlbums } from '../../../lib/content';
import { editableBooking } from '../../../lib/tripEditor';

const { slug } = Astro.params;
const trip = slug ? readTrip(slug) : null;
if (!trip) return Astro.redirect('/admin/trips');

const publishedAlbums = listAlbums().filter(a => a.published);

const highlights = Array.isArray(trip.highlights) ? trip.highlights : [];
const included = Array.isArray(trip.included) ? trip.included : [];
const notIncluded = Array.isArray(trip.notIncluded) ? trip.notIncluded : [];
const packingList = Array.isArray(trip.packingList) ? trip.packingList : [];
const itinerary = Array.isArray(trip.itinerary) ? trip.itinerary : [];

// Occupancy catalog + departures-with-offers for the editor. Unlike
// resolveBooking (public, filters to upcoming dates) this keeps EVERY departure
// so saving never silently drops past/draft ones, and synthesizes offers from
// legacy sharingOptions/flat-price so opening an old trip auto-migrates it.
const { editorCatalog, editorDepartures } = editableBooking(trip);

// ── Trip photo gallery ──────────────────────────────────────────────────────
// Albums (with per-photo dimensions) the admin can pick images from.
const galleryAlbums = publishedAlbums.map(a => ({
  slug: a.slug,
  name: a.name,
  photos: (Array.isArray(a.photos) ? a.photos : []).map((p: any) => ({
    image: p.image, width: p.width ?? null, height: p.height ?? null,
  })),
}));
// Current gallery — migrate legacy `linkedAlbumSlug` trips by seeding the
// selection from the linked album's first 10 photos so saving converts them.
const existingGallery = Array.isArray(trip.gallery) ? trip.gallery : [];
let initialGallery = existingGallery;
if (existingGallery.length === 0 && trip.linkedAlbumSlug) {
  const linked = galleryAlbums.find(a => a.slug === trip.linkedAlbumSlug);
  if (linked) {
    initialGallery = linked.photos.slice(0, 10).map(p => ({ ...p, source: 'album' }));
  }
}
const tripSlug = slug;
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title={`Edit: ${trip.title ?? trip.name ?? slug}`} page="trips">

  {saved && (
    <div class="rounded-2xl px-4 py-3 mb-6 text-sm flex items-center gap-2"
         style="background: rgba(34,166,84,0.10); color: var(--color-success);">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
      Changes saved.
    </div>
  )}

  <!-- Header -->
  <div class="edit-header">
    <a href="/admin/trips" class="back-link">← Trips</a>
    <h1 class="edit-title">{trip.title ?? trip.name ?? slug}</h1>
    <div class="header-actions">
      <a href={`/trips/${slug}/`} target="_blank" class="preview-btn">Preview ↗</a>
      <button type="submit" form="trip-form" class="save-btn">Save Changes</button>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs-bar">
    {[
      { id: 'basics',    label: 'Basics'    },
      { id: 'content',   label: 'Content'   },
      { id: 'itinerary', label: 'Itinerary' },
      { id: 'logistics', label: 'Logistics' },
      { id: 'payment',   label: 'Payment & Media' },
    ].map(({ id, label }) => (
      <button type="button" class="tab-btn" data-tab={id}>{label}</button>
    ))}
  </div>

  <form method="POST" action="/api/admin/trips/update" enctype="multipart/form-data" id="trip-form">
    <input type="hidden" name="slug" value={slug} />

    <!-- ── TAB: BASICS ─────────────────────────────────────── -->
    <div class="tab-panel" id="tab-basics">
      <div class="panel-grid">

        <div class="field full">
          <label class="flabel">Trip Name *</label>
          <input type="text" name="name" required class="finput" value={trip.title ?? trip.name ?? ''} />
        </div>
        <div class="field">
          <label class="flabel">Slug</label>
          <input type="text" name="newSlug" class="finput" placeholder={slug ?? ''} />
          <span class="fhint">Leave blank to keep <code>{slug}</code>. Changing this changes the public URL.</span>
        </div>

        <div class="field full">
          <label class="flabel">Occupancy Tiers</label>
          <p class="fhint" style="margin-bottom:0.5rem;">Define each room type once (e.g. Dorm Bed, Double Sharing). Below, each departure picks which tiers it sells and at what price/stock.</p>
          <div id="catalog-editor"></div>
          <button type="button" id="add-tier-btn" class="add-btn">+ Add Occupancy Tier</button>
          <input type="hidden" name="occupancyCatalog_json" id="occupancyCatalog_json" />
        </div>

        <div class="field full">
          <label class="flabel">Departures &amp; Offers</label>
          <p class="fhint" style="margin-bottom:0.5rem;">One block per departure date. Tick which tiers it offers; set the price, stock (cap) and booked count per tier. A date is sold out when every offered tier is full. Leave a tier unticked to not sell it on that date.</p>
          <div id="departures-editor"></div>
          <button type="button" id="add-departure-btn" class="add-btn">+ Add Departure Date</button>
          <input type="hidden" name="departures_json" id="departures_json" />
        </div>

        <div class="field">
          <label class="flabel">Duration</label>
          <input type="text" name="duration" class="finput" placeholder="e.g. 6N/7D" value={trip.duration ?? ''} />
        </div>

        <div class="field">
          <label class="flabel">Location</label>
          <input type="text" name="location" class="finput" placeholder="e.g. Meghalaya" value={trip.location ?? ''} />
        </div>

        <div class="field">
          <label class="flabel">Publication</label>
          <select name="publicationStatus" class="finput">
            {['draft', 'published', 'archived', 'test'].map((status) => <option value={status} selected={(trip.publicationStatus ?? (String(slug).startsWith('qa-test-') ? 'test' : 'published')) === status}>{status}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="flabel" style="display:flex; align-items:center; gap:0.5rem;">
            <input
              type="checkbox"
              name="registrationEnabled"
              value="true"
              checked={trip.registrationEnabled === true}
              style="width:1rem; height:1rem;"
            />
            Registration open (accept bookings)
          </label>
        </div>

      </div>
    </div>

    <!-- ── TAB: CONTENT ────────────────────────────────────── -->
    <div class="tab-panel hidden" id="tab-content">
      <div class="panel-grid">

        <div class="field full">
          <label class="flabel">
            Short Description
            <span id="shortDesc-count" class="char-count">{(trip.shortDescription ?? '').length}/200</span>
          </label>
          <textarea name="shortDescription" class="finput" rows="3" maxlength="200"
            oninput="document.getElementById('shortDesc-count').textContent=this.value.length+'/200'"
          >{trip.shortDescription ?? ''}</textarea>
          <span class="fhint">Shows on trip cards and meta description.</span>
        </div>

        <div class="field full">
          <label class="flabel">Full Description</label>
          <textarea name="description" class="finput" rows="8" placeholder="Detailed trip description shown on the trip page...">{trip.description ?? ''}</textarea>
        </div>

        <div class="field full">
          <label class="flabel">SEO Title</label>
          <input name="seoTitle" class="finput" maxlength="70" value={trip.seoTitle ?? ''} placeholder="Optional; falls back to trip name" />
        </div>

        <div class="field full">
          <label class="flabel">SEO Description</label>
          <textarea name="seoDescription" class="finput" rows="3" maxlength="170" placeholder="Search result summary">{trip.seoDescription ?? ''}</textarea>
        </div>

        <div class="field full">
          <label class="flabel">Featured Image Alt Text</label>
          <input name="imageAlt" class="finput" maxlength="180" value={trip.imageAlt ?? ''} placeholder="Describe the destination and scene" />
        </div>

        <div class="field full">
          <label class="flabel">Who Should Join?</label>
          <textarea name="whoShouldJoin" class="finput" rows="4" placeholder="Describe the ideal traveler for this trip...">{trip.whoShouldJoin ?? ''}</textarea>
          <span class="fhint">Shown as a highlighted box on the trip page.</span>
        </div>

        <div class="field full">
          <label class="flabel">Highlights</label>
          <div id="highlights-list" class="dyn-list">
            {highlights.map((h: string) => (
              <div class="dyn-item">
                <input type="text" name="highlights[]" value={h} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="highlights-list" data-name="highlights[]" data-placeholder="e.g. Sunrise trek to summit...">+ Add Highlight</button>
        </div>

        <div class="field full">
          <label class="flabel">What's Included</label>
          <div id="included-list" class="dyn-list">
            {included.map((item: string) => (
              <div class="dyn-item">
                <input type="text" name="included[]" value={item} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="included-list" data-name="included[]" data-placeholder="e.g. Accommodation...">+ Add Inclusion</button>
        </div>

        <div class="field full">
          <label class="flabel">What's Not Included</label>
          <div id="notIncluded-list" class="dyn-list">
            {notIncluded.map((item: string) => (
              <div class="dyn-item">
                <input type="text" name="notIncluded[]" value={item} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="notIncluded-list" data-name="notIncluded[]" data-placeholder="e.g. Flight tickets...">+ Add Exclusion</button>
        </div>

        <div class="field full">
          <label class="flabel">Packing List</label>
          <div id="packingList-list" class="dyn-list">
            {packingList.map((item: string) => (
              <div class="dyn-item">
                <input type="text" name="packingList[]" value={item} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="packingList-list" data-name="packingList[]" data-placeholder="e.g. Warm jacket...">+ Add Item</button>
        </div>

      </div>
    </div>

    <!-- ── TAB: ITINERARY ──────────────────────────────────── -->
    <div class="tab-panel hidden" id="tab-itinerary">
      <div class="itin-toolbar">
        <span class="itin-count" id="itin-count">0 days</span>
        <div style="display:flex;gap:0.5rem;">
          <button type="button" class="itin-tool-btn" id="expand-all-btn">Expand all</button>
          <button type="button" class="itin-tool-btn" id="collapse-all-btn">Collapse all</button>
        </div>
      </div>
      <div id="itinerary-container"></div>
      <button type="button" id="add-day-btn">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Day
      </button>
      <input type="hidden" name="itinerary_json" id="itinerary_json" />
    </div>

    <!-- ── TAB: LOGISTICS ─────────────────────────────────── -->
    <div class="tab-panel hidden" id="tab-logistics">
      <div class="panel-grid">

        <div class="field full">
          <label class="flabel">Meeting Point</label>
          <textarea name="meetingPoint" class="finput" rows="3" placeholder="Where travelers should gather...">{trip.meetingPoint ?? ''}</textarea>
        </div>

        <div class="field">
          <label class="flabel">Meeting Time</label>
          <input type="text" name="meetingTime" class="finput" placeholder="e.g. 6:00 AM" value={trip.meetingTime ?? ''} />
        </div>

        <div class="field full">
          <label class="flabel">Important Notes</label>
          <textarea name="importantNotes" class="finput" rows="4" placeholder="Things travelers must know...">{trip.importantNotes ?? ''}</textarea>
        </div>

        <div class="field full">
          <label class="flabel">Cancellation Policy</label>
          <textarea name="cancellationPolicy" class="finput" rows="4">{trip.cancellationPolicy ?? ''}</textarea>
        </div>

      </div>
    </div>

    <!-- ── TAB: PAYMENT & MEDIA ───────────────────────────── -->
    <div class="tab-panel hidden" id="tab-payment">
      <div class="panel-grid">

        <div class="field">
          <label class="flabel">Advance / Booking Amount (₹)</label>
          <input type="number" name="paymentAmount" class="finput" value={trip.paymentAmount ?? ''} />
        </div>

        <div class="field">
          <label class="flabel">Balance Due Rule</label>
          <input type="text" name="balanceDueRule" class="finput" placeholder="e.g. 15 days before trip" value={trip.balanceDueRule ?? ''} />
          <span class="fhint">Shown in the booking summary, e.g. "due 15 days before trip".</span>
        </div>

        <div class="field">
          <label class="flabel">Featured Image</label>
          {trip.featuredImage && (
            <img src={trip.featuredImage} alt="Current" class="img-preview" />
          )}
          <input type="file" name="featuredImage" accept="image/*" class="finput file-input"
            data-preview="featured-preview" />
          <img id="featured-preview" src="" alt="" class="img-preview hidden" />
          <input type="hidden" name="existingFeaturedImage" value={trip.featuredImage ?? ''} />
          <span class="fhint">1200×675px · 16:9 · JPG/PNG · max 10 MB</span>
        </div>

        <div class="field full gallery-editor">
          <label class="flabel">Trip Photos</label>
          <span class="fhint">Pick up to 10 images from a photo album, and/or upload trip-only photos. Trip-only uploads stay on this trip and are <strong>not</strong> added to the Photo Vault.</span>

          <select id="gallery-album-select" class="finput" style="margin-top:0.5rem;">
            <option value="">— Choose an album to pick photos —</option>
            {publishedAlbums.map(a => (<option value={a.slug}>{a.name}</option>))}
          </select>

          <div id="gallery-album-grid" class="gallery-grid hidden"></div>

          <div style="margin-top:0.85rem; display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
            <input type="file" id="gallery-upload-input" accept="image/*" multiple style="display:none;" />
            <label for="gallery-upload-input" class="gallery-upload-btn">📷 Upload trip-only photos</label>
            <span id="gallery-upload-status" class="fhint"></span>
          </div>

          <p class="flabel" style="margin:1rem 0 0.5rem;"><span>Selected (<span id="gallery-count">0</span>)</span><span class="fhint" id="gallery-album-count"></span></p>
          <div id="gallery-selected" class="gallery-grid"></div>

          <input type="hidden" name="gallery_json" id="gallery_json" />
        </div>

      </div>
    </div>

    <!-- Bottom save bar -->
    <div class="save-bar">
      <a href="/admin/trips" class="cancel-btn">Cancel</a>
      <button type="submit" class="save-btn">Save Changes</button>
    </div>

  </form>
</AdminLayout>

<style is:global>
/* ── Layout ─────────────────────────────────── */
.edit-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.back-link {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: 0.875rem;
  white-space: nowrap;
}
.edit-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-text-primary);
  margin: 0;
  flex: 1;
}
.header-actions {
  display: flex;
  gap: 0.6rem;
  align-items: center;
}
.preview-btn {
  padding: 0.45rem 1rem;
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
  font-size: 0.8rem;
  color: var(--color-text-secondary);
  text-decoration: none;
  background: white;
}
.save-btn {
  background: var(--color-primary);
  color: white;
  padding: 0.55rem 1.5rem;
  border-radius: 0.5rem;
  border: none;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
}
.save-btn:hover { opacity: 0.9; }

/* ── Tabs ────────────────────────────────────── */
.tabs-bar {
  display: flex;
  gap: 0;
  border-bottom: 2px solid var(--color-border);
  margin-bottom: 1.5rem;
  overflow-x: auto;
  scrollbar-width: none;
}
.tabs-bar::-webkit-scrollbar { display: none; }
.tab-btn {
  padding: 0.6rem 1.1rem;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  white-space: nowrap;
  transition: color 0.15s, border-color 0.15s;
}
.tab-btn:hover { color: var(--color-text-primary); }
.tab-btn.active {
  color: var(--color-primary);
  border-bottom-color: var(--color-primary);
}

/* ── Panels ──────────────────────────────────── */
.tab-panel { }
.tab-panel.hidden { display: none; }

.panel-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.1rem;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.field.full { grid-column: 1 / -1; }

.flabel {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.char-count {
  font-weight: 400;
  color: #9CA3AF;
}
.fhint {
  font-size: 0.72rem;
  color: #9CA3AF;
  line-height: 1.4;
}
.fhint code {
  background: var(--color-border);
  padding: 0 0.2rem;
  border-radius: 0.2rem;
}
.finput {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  padding: 0.5rem 0.75rem;
  color: var(--color-text-primary);
  font-size: 0.875rem;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  font-family: inherit;
  transition: border-color 0.15s;
}
.finput:focus { border-color: var(--color-primary); box-shadow: 0 0 0 2px rgba(45,95,62,0.1); }
select.finput { cursor: pointer; }

/* ── Dynamic lists ───────────────────────────── */
.dyn-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 0.4rem;
}
.dyn-item { display: flex; gap: 0.4rem; }
.dyn-item input { flex: 1; }
.rm-btn {
  background: none;
  border: 1px solid #dc2626;
  color: #dc2626;
  border-radius: 0.35rem;
  padding: 0.3rem 0.55rem;
  cursor: pointer;
  font-size: 0.8rem;
  flex-shrink: 0;
}
.add-btn {
  background: none;
  border: 1px dashed var(--color-border);
  color: var(--color-text-secondary);
  border-radius: 0.35rem;
  padding: 0.4rem 0.75rem;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 500;
  align-self: flex-start;
}
.add-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* ── Itinerary toolbar ───────────────────────── */
.itin-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}
.itin-count {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-text-secondary);
}
.itin-tool-btn {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  padding: 0.3rem 0.7rem;
  font-size: 0.75rem;
  color: var(--color-text-secondary);
  cursor: pointer;
}
.itin-tool-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

#add-day-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  margin-top: 0.5rem;
  padding: 0.7rem;
  background: white;
  border: 1.5px dashed var(--color-border);
  border-radius: 0.6rem;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}
#add-day-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* ── Accordion day cards ─────────────────────── */
.day-card {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.65rem;
  margin-bottom: 0.6rem;
  overflow: hidden;
  transition: box-shadow 0.15s;
}
.day-card:focus-within { box-shadow: 0 0 0 2px rgba(45,95,62,0.15); border-color: var(--color-primary); }

.day-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.8rem 1rem;
  cursor: pointer;
  user-select: none;
}
.day-header:hover { background: var(--color-surface); }

.day-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-primary);
  color: white;
  font-size: 0.75rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: var(--font-display);
}
.day-card.open .day-num { background: var(--color-accent); }

.day-header-text { flex: 1; min-width: 0; }
.day-title {
  font-weight: 700;
  font-size: 0.875rem;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-display);
}
.day-summary {
  font-size: 0.72rem;
  color: var(--color-text-secondary);
  margin-top: 0.1rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-actions {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  flex-shrink: 0;
}
.day-move-btn {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: 0.3rem;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--color-text-secondary);
  font-size: 0.7rem;
  padding: 0;
}
.day-move-btn:hover { background: var(--color-surface); border-color: var(--color-primary); color: var(--color-primary); }
.day-move-btn:disabled { opacity: 0.3; cursor: not-allowed; }

.day-chevron {
  width: 16px;
  height: 16px;
  color: var(--color-text-secondary);
  transition: transform 0.2s;
  flex-shrink: 0;
}
.day-card.open .day-chevron { transform: rotate(180deg); }

.day-body {
  display: none;
  padding: 0 1rem 1rem;
  border-top: 1px solid var(--color-border);
}
.day-card.open .day-body { display: block; }

.day-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.7rem;
  margin-top: 0.85rem;
}
.day-grid .full { grid-column: 1 / -1; }
.day-label { font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 600; margin-bottom: 0.25rem; }
.day-input {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  padding: 0.45rem 0.65rem;
  color: var(--color-text-primary);
