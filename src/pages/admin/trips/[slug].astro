---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readTrip, listAlbums } from '../../../lib/content';

const { slug } = Astro.params;
const trip = slug ? readTrip(slug) : null;
if (!trip) return Astro.redirect('/admin/trips');

const publishedAlbums = listAlbums().filter(a => a.published);

const highlights = Array.isArray(trip.highlights) ? trip.highlights : [];
const sharingOptions = Array.isArray(trip.sharingOptions) ? trip.sharingOptions : [];
const batches = Array.isArray(trip.batches) ? trip.batches : [];
const included = Array.isArray(trip.included) ? trip.included : [];
const notIncluded = Array.isArray(trip.notIncluded) ? trip.notIncluded : [];
const packingList = Array.isArray(trip.packingList) ? trip.packingList : [];
const itinerary = Array.isArray(trip.itinerary) ? trip.itinerary : [];
---

<AdminLayout title={`Edit: ${trip.name ?? slug}`} page="trips">

  <!-- Header -->
  <div class="edit-header">
    <a href="/admin/trips" class="back-link">← Trips</a>
    <h1 class="edit-title">{trip.name ?? slug}</h1>
    <div class="header-actions">
      <a href={`/trips/${slug}/`} target="_blank" class="preview-btn">Preview ↗</a>
      <button type="submit" form="trip-form" class="save-btn">Save Changes</button>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs-bar">
    {[
      { id: 'basics',    label: 'Basics'    },
      { id: 'content',   label: 'Content'   },
      { id: 'itinerary', label: 'Itinerary' },
      { id: 'logistics', label: 'Logistics' },
      { id: 'payment',   label: 'Payment & Media' },
    ].map(({ id, label }) => (
      <button type="button" class="tab-btn" data-tab={id}>{label}</button>
    ))}
  </div>

  <form method="POST" action="/api/admin/trips/update" enctype="multipart/form-data" id="trip-form">
    <input type="hidden" name="slug" value={slug} />

    <!-- ── TAB: BASICS ─────────────────────────────────────── -->
    <div class="tab-panel" id="tab-basics">
      <div class="panel-grid">

        <div class="field full">
          <label class="flabel">Trip Name *</label>
          <input type="text" name="name" required class="finput" value={trip.name ?? ''} />
        </div>

        <div class="field">
          <label class="flabel">Status *</label>
          <select name="status" required class="finput">
            {['draft','booking-open','sold-out'].map(s => (
              <option value={s} selected={s === trip.status}>
                {s === 'draft' ? 'Draft' : s === 'booking-open' ? 'Booking Open' : 'Sold Out'}
              </option>
            ))}
          </select>
          <span class="fhint">Booking Open = live & accepting registrations</span>
        </div>

        <div class="field">
          <label class="flabel">Slug</label>
          <input type="text" name="newSlug" class="finput" placeholder={slug ?? ''} />
          <span class="fhint">Leave blank to keep <code>{slug}</code>. Changing this changes the public URL.</span>
        </div>

        <div class="field full">
          <label class="flabel">Departure Dates (batches)</label>
          <p class="fhint" style="margin-bottom:0.5rem;">Add one row per departure. Each can have its own price and seats. The trip card shows the first batch; the trip page lets travellers pick a date when there's more than one.</p>
          <div id="batches-list" class="dyn-list">
            {batches.map((b: any) => (
              <div class="dyn-item batch-row" style="flex-wrap:wrap; gap:0.5rem; align-items:flex-end; border:1px solid var(--color-border); border-radius:0.5rem; padding:0.6rem;">
                <input type="hidden" name="batchId[]" value={b.id ?? ''} />
                <div style="flex:1; min-width:130px;">
                  <span class="fhint">Start</span>
                  <input type="date" name="batchStart[]" value={b.startDate ?? ''} class="finput" />
                </div>
                <div style="flex:1; min-width:130px;">
                  <span class="fhint">End</span>
                  <input type="date" name="batchEnd[]" value={b.endDate ?? ''} class="finput" />
                </div>
                <div style="flex:1; min-width:90px;">
                  <span class="fhint">Price ₹</span>
                  <input type="number" name="batchPrice[]" value={b.price ?? ''} class="finput" />
                </div>
                <div style="flex:1; min-width:70px;">
                  <span class="fhint">Total spots</span>
                  <input type="number" name="batchTotal[]" value={b.totalSpots ?? ''} class="finput" />
                </div>
                <div style="flex:1; min-width:70px;">
                  <span class="fhint">Booked</span>
                  <input type="number" name="batchBooked[]" value={b.bookedSpots ?? 0} class="finput" />
                </div>
                <div style="flex:1; min-width:120px;">
                  <span class="fhint">Status</span>
                  <select name="batchStatus[]" class="finput">
                    {['booking-open','filling_fast','sold-out','draft','completed'].map(s => (
                      <option value={s} selected={(b.status ?? 'booking-open') === s}>{s}</option>
                    ))}
                  </select>
                </div>
                <button type="button" class="rm-btn" onclick="this.closest('.batch-row').remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" id="add-batch-btn" class="add-btn">+ Add Departure Date</button>
        </div>

        <div class="field">
          <label class="flabel">Duration</label>
          <input type="text" name="duration" class="finput" placeholder="e.g. 6N/7D" value={trip.duration ?? ''} />
        </div>

        <div class="field">
          <label class="flabel">Location</label>
          <input type="text" name="location" class="finput" placeholder="e.g. Meghalaya" value={trip.location ?? ''} />
        </div>

      </div>
    </div>

    <!-- ── TAB: CONTENT ────────────────────────────────────── -->
    <div class="tab-panel hidden" id="tab-content">
      <div class="panel-grid">

        <div class="field full">
          <label class="flabel">
            Short Description
            <span id="shortDesc-count" class="char-count">{(trip.shortDescription ?? '').length}/200</span>
          </label>
          <textarea name="shortDescription" class="finput" rows="3" maxlength="200"
            oninput="document.getElementById('shortDesc-count').textContent=this.value.length+'/200'"
          >{trip.shortDescription ?? ''}</textarea>
          <span class="fhint">Shows on trip cards and meta description.</span>
        </div>

        <div class="field full">
          <label class="flabel">Full Description</label>
          <textarea name="description" class="finput" rows="8" placeholder="Detailed trip description shown on the trip page...">{trip.description ?? ''}</textarea>
        </div>

        <div class="field full">
          <label class="flabel">Who Should Join?</label>
          <textarea name="whoShouldJoin" class="finput" rows="4" placeholder="Describe the ideal traveler for this trip...">{trip.whoShouldJoin ?? ''}</textarea>
          <span class="fhint">Shown as a highlighted box on the trip page.</span>
        </div>

        <div class="field full">
          <label class="flabel">Highlights</label>
          <div id="highlights-list" class="dyn-list">
            {highlights.map((h: string) => (
              <div class="dyn-item">
                <input type="text" name="highlights[]" value={h} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="highlights-list" data-name="highlights[]" data-placeholder="e.g. Sunrise trek to summit...">+ Add Highlight</button>
        </div>

        <div class="field full">
          <label class="flabel">What's Included</label>
          <div id="included-list" class="dyn-list">
            {included.map((item: string) => (
              <div class="dyn-item">
                <input type="text" name="included[]" value={item} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="included-list" data-name="included[]" data-placeholder="e.g. Accommodation...">+ Add Inclusion</button>
        </div>

        <div class="field full">
          <label class="flabel">What's Not Included</label>
          <div id="notIncluded-list" class="dyn-list">
            {notIncluded.map((item: string) => (
              <div class="dyn-item">
                <input type="text" name="notIncluded[]" value={item} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="notIncluded-list" data-name="notIncluded[]" data-placeholder="e.g. Flight tickets...">+ Add Exclusion</button>
        </div>

        <div class="field full">
          <label class="flabel">Packing List</label>
          <div id="packingList-list" class="dyn-list">
            {packingList.map((item: string) => (
              <div class="dyn-item">
                <input type="text" name="packingList[]" value={item} class="finput" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" class="add-btn" data-list="packingList-list" data-name="packingList[]" data-placeholder="e.g. Warm jacket...">+ Add Item</button>
        </div>

      </div>
    </div>

    <!-- ── TAB: ITINERARY ──────────────────────────────────── -->
    <div class="tab-panel hidden" id="tab-itinerary">
      <div class="itin-toolbar">
        <span class="itin-count" id="itin-count">0 days</span>
        <div style="display:flex;gap:0.5rem;">
          <button type="button" class="itin-tool-btn" id="expand-all-btn">Expand all</button>
          <button type="button" class="itin-tool-btn" id="collapse-all-btn">Collapse all</button>
        </div>
      </div>
      <div id="itinerary-container"></div>
      <button type="button" id="add-day-btn">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Day
      </button>
      <input type="hidden" name="itinerary_json" id="itinerary_json" />
    </div>

    <!-- ── TAB: LOGISTICS ─────────────────────────────────── -->
    <div class="tab-panel hidden" id="tab-logistics">
      <div class="panel-grid">

        <div class="field full">
          <label class="flabel">Meeting Point</label>
          <textarea name="meetingPoint" class="finput" rows="3" placeholder="Where travelers should gather...">{trip.meetingPoint ?? ''}</textarea>
        </div>

        <div class="field">
          <label class="flabel">Meeting Time</label>
          <input type="text" name="meetingTime" class="finput" placeholder="e.g. 6:00 AM" value={trip.meetingTime ?? ''} />
        </div>

        <div class="field full">
          <label class="flabel">Important Notes</label>
          <textarea name="importantNotes" class="finput" rows="4" placeholder="Things travelers must know...">{trip.importantNotes ?? ''}</textarea>
        </div>

        <div class="field full">
          <label class="flabel">Cancellation Policy</label>
          <textarea name="cancellationPolicy" class="finput" rows="4">{trip.cancellationPolicy ?? ''}</textarea>
        </div>

      </div>
    </div>

    <!-- ── TAB: PAYMENT & MEDIA ───────────────────────────── -->
    <div class="tab-panel hidden" id="tab-payment">
      <div class="panel-grid">

        <div class="field">
          <label class="flabel">Advance / Booking Amount (₹)</label>
          <input type="number" name="paymentAmount" class="finput" value={trip.paymentAmount ?? ''} />
        </div>


        <div class="field full">
          <label class="flabel">Room-Sharing / Occupancy Options</label>
          <p class="fhint" style="margin-bottom:0.5rem;">Optional. If set, the trip page lets travellers choose an occupancy and the total updates to that price (overrides the per-batch price for display). Leave empty to use the batch price.</p>
          <div id="sharing-list" class="dyn-list">
            {sharingOptions.map((o: any) => (
              <div class="dyn-item" style="gap:0.5rem;">
                <input type="text" name="sharingLabel[]" value={o.label} placeholder="e.g. Double sharing" class="finput" style="flex:2;" />
                <input type="number" name="sharingPrice[]" value={o.price} placeholder="₹ per person" class="finput" style="flex:1;" />
                <button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>
              </div>
            ))}
          </div>
          <button type="button" id="add-sharing-btn" class="add-btn">+ Add Occupancy Option</button>
        </div>

        <div class="field full">
          <label class="flabel">Payment Instructions</label>
          <textarea name="paymentInstructions" class="finput" rows="3">{trip.paymentInstructions ?? ''}</textarea>
        </div>

        <div class="field full">
          <label class="flabel">Link Photo Album</label>
          <select name="linkedAlbumSlug" class="finput">
            <option value="">— None (trip page uses fallback photos) —</option>
            {publishedAlbums.map(a => (
              <option value={a.slug} selected={trip.linkedAlbumSlug === a.slug}>{a.name}</option>
            ))}
          </select>
          <span class="fhint">Photos from this album appear in the trip page's inline photo strip.</span>
        </div>

        <div class="field">
          <label class="flabel">Featured Image</label>
          {trip.featuredImage && (
            <img src={trip.featuredImage} alt="Current" class="img-preview" />
          )}
          <input type="file" name="featuredImage" accept="image/*" class="finput file-input"
            data-preview="featured-preview" />
          <img id="featured-preview" src="" alt="" class="img-preview hidden" />
          <input type="hidden" name="existingFeaturedImage" value={trip.featuredImage ?? ''} />
          <span class="fhint">1200×675px · 16:9 · JPG/PNG · max 10 MB</span>
        </div>

        <div class="field">
          <label class="flabel">Payment QR Code</label>
          {trip.paymentQrCode && (
            <img src={trip.paymentQrCode} alt="Current QR" class="img-preview qr" />
          )}
          <input type="file" name="paymentQrCode" accept="image/*" class="finput file-input"
            data-preview="qr-preview" />
          <img id="qr-preview" src="" alt="" class="img-preview hidden" />
          <input type="hidden" name="existingPaymentQrCode" value={trip.paymentQrCode ?? ''} />
          <span class="fhint">400×400px · square · PNG preferred · max 2 MB</span>
        </div>

      </div>
    </div>

    <!-- Bottom save bar -->
    <div class="save-bar">
      <a href="/admin/trips" class="cancel-btn">Cancel</a>
      <button type="submit" class="save-btn">Save Changes</button>
    </div>

  </form>
</AdminLayout>

<style is:global>
/* ── Layout ─────────────────────────────────── */
.edit-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.back-link {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: 0.875rem;
  white-space: nowrap;
}
.edit-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-text-primary);
  margin: 0;
  flex: 1;
}
.header-actions {
  display: flex;
  gap: 0.6rem;
  align-items: center;
}
.preview-btn {
  padding: 0.45rem 1rem;
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
  font-size: 0.8rem;
  color: var(--color-text-secondary);
  text-decoration: none;
  background: white;
}
.save-btn {
  background: var(--color-primary);
  color: white;
  padding: 0.55rem 1.5rem;
  border-radius: 0.5rem;
  border: none;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
}
.save-btn:hover { opacity: 0.9; }

/* ── Tabs ────────────────────────────────────── */
.tabs-bar {
  display: flex;
  gap: 0;
  border-bottom: 2px solid var(--color-border);
  margin-bottom: 1.5rem;
  overflow-x: auto;
  scrollbar-width: none;
}
.tabs-bar::-webkit-scrollbar { display: none; }
.tab-btn {
  padding: 0.6rem 1.1rem;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  white-space: nowrap;
  transition: color 0.15s, border-color 0.15s;
}
.tab-btn:hover { color: var(--color-text-primary); }
.tab-btn.active {
  color: var(--color-primary);
  border-bottom-color: var(--color-primary);
}

/* ── Panels ──────────────────────────────────── */
.tab-panel { }
.tab-panel.hidden { display: none; }

.panel-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.1rem;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.field.full { grid-column: 1 / -1; }

.flabel {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.char-count {
  font-weight: 400;
  color: #9CA3AF;
}
.fhint {
  font-size: 0.72rem;
  color: #9CA3AF;
  line-height: 1.4;
}
.fhint code {
  background: var(--color-border);
  padding: 0 0.2rem;
  border-radius: 0.2rem;
}
.finput {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  padding: 0.5rem 0.75rem;
  color: var(--color-text-primary);
  font-size: 0.875rem;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  font-family: inherit;
  transition: border-color 0.15s;
}
.finput:focus { border-color: var(--color-primary); box-shadow: 0 0 0 2px rgba(45,95,62,0.1); }
select.finput { cursor: pointer; }

/* ── Dynamic lists ───────────────────────────── */
.dyn-list {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 0.4rem;
}
.dyn-item { display: flex; gap: 0.4rem; }
.dyn-item input { flex: 1; }
.rm-btn {
  background: none;
  border: 1px solid #dc2626;
  color: #dc2626;
  border-radius: 0.35rem;
  padding: 0.3rem 0.55rem;
  cursor: pointer;
  font-size: 0.8rem;
  flex-shrink: 0;
}
.add-btn {
  background: none;
  border: 1px dashed var(--color-border);
  color: var(--color-text-secondary);
  border-radius: 0.35rem;
  padding: 0.4rem 0.75rem;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 500;
  align-self: flex-start;
}
.add-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* ── Itinerary toolbar ───────────────────────── */
.itin-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}
.itin-count {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--color-text-secondary);
}
.itin-tool-btn {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  padding: 0.3rem 0.7rem;
  font-size: 0.75rem;
  color: var(--color-text-secondary);
  cursor: pointer;
}
.itin-tool-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

#add-day-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  margin-top: 0.5rem;
  padding: 0.7rem;
  background: white;
  border: 1.5px dashed var(--color-border);
  border-radius: 0.6rem;
  color: var(--color-text-secondary);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}
#add-day-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* ── Accordion day cards ─────────────────────── */
.day-card {
  background: white;
  border: 1px solid var(--color-border);
  border-radius: 0.65rem;
  margin-bottom: 0.6rem;
  overflow: hidden;
  transition: box-shadow 0.15s;
}
.day-card:focus-within { box-shadow: 0 0 0 2px rgba(45,95,62,0.15); border-color: var(--color-primary); }

.day-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.8rem 1rem;
  cursor: pointer;
  user-select: none;
}
.day-header:hover { background: var(--color-surface); }

.day-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-primary);
  color: white;
  font-size: 0.75rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: var(--font-display);
}
.day-card.open .day-num { background: var(--color-accent); }

.day-header-text { flex: 1; min-width: 0; }
.day-title {
  font-weight: 700;
  font-size: 0.875rem;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-family: var(--font-display);
}
.day-summary {
  font-size: 0.72rem;
  color: var(--color-text-secondary);
  margin-top: 0.1rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.day-actions {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  flex-shrink: 0;
}
.day-move-btn {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: 0.3rem;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--color-text-secondary);
  font-size: 0.7rem;
  padding: 0;
}
.day-move-btn:hover { background: var(--color-surface); border-color: var(--color-primary); color: var(--color-primary); }
.day-move-btn:disabled { opacity: 0.3; cursor: not-allowed; }

.day-chevron {
  width: 16px;
  height: 16px;
  color: var(--color-text-secondary);
  transition: transform 0.2s;
  flex-shrink: 0;
}
.day-card.open .day-chevron { transform: rotate(180deg); }

.day-body {
  display: none;
  padding: 0 1rem 1rem;
  border-top: 1px solid var(--color-border);
}
.day-card.open .day-body { display: block; }

.day-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.7rem;
  margin-top: 0.85rem;
}
.day-grid .full { grid-column: 1 / -1; }
.day-label { font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 600; margin-bottom: 0.25rem; }
.day-input {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 0.4rem;
  padding: 0.45rem 0.65rem;
  color: var(--color-text-primary);
  font-size: 0.825rem;
  width: 100%;
  box-sizing: border-box;
  outline: none;
  font-family: inherit;
  transition: border-color 0.15s;
}
.day-input:focus { border-color: var(--color-primary); }

.meal-row { display: flex; gap: 1.25rem; flex-wrap: wrap; padding: 0.5rem 0; }
.meal-label {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.8rem;
  color: var(--color-text-secondary);
  cursor: pointer;
  padding: 0.35rem 0.6rem;
  border-radius: 0.4rem;
  border: 1px solid var(--color-border);
  transition: background 0.15s, border-color 0.15s;
}
.meal-label:has(input:checked) {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

.day-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 0.85rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--color-border);
}

/* ── Images ─────────────────────────────────── */
.file-input { padding: 0.35rem 0.5rem; }
.img-preview {
  max-height: 120px;
  border-radius: 0.5rem;
  object-fit: cover;
  margin-bottom: 0.35rem;
}
.img-preview.qr { object-fit: contain; }
.img-preview.hidden { display: none; }

/* ── Bottom save bar ─────────────────────────── */
.save-bar {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  justify-content: flex-end;
  margin-top: 1.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--color-border);
}
.cancel-btn {
  padding: 0.55rem 1.25rem;
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: 0.875rem;
  background: white;
}

/* ── Responsive ─────────────────────────────── */
@media (max-width: 640px) {
  .panel-grid { grid-template-columns: 1fr; }
  .field.full { grid-column: 1; }
  .day-grid { grid-template-columns: 1fr; }
  .day-grid .full { grid-column: 1; }
  .day-actions .day-move-btn { display: none; }
  .edit-title { font-size: 1.1rem; }
}
</style>

<script define:vars={{ itinerary }}>
// ── Tab switching ─────────────────────────────
const tabs = document.querySelectorAll('.tab-btn');
const panels = document.querySelectorAll('.tab-panel');

function switchTab(id) {
  tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === id));
  panels.forEach(p => p.classList.toggle('hidden', p.id !== 'tab-' + id));
  history.replaceState(null, '', '#' + id);
}

tabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));

// Restore tab from URL hash
const hash = location.hash.replace('#', '');
const validTabs = ['basics','content','itinerary','logistics','payment'];
switchTab(validTabs.includes(hash) ? hash : 'basics');

// ── Dynamic list items ────────────────────────
function addItem(listId, name, placeholder) {
  const list = document.getElementById(listId);
  const div = document.createElement('div');
  div.className = 'dyn-item';
  div.innerHTML = `<input type="text" name="${name}" placeholder="${placeholder}" class="finput" /><button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>`;
  list.appendChild(div);
  div.querySelector('input').focus();
}

// ── Image preview ─────────────────────────────
function previewImage(input, previewId) {
  const img = document.getElementById(previewId);
  if (input.files && input.files[0]) {
    img.src = URL.createObjectURL(input.files[0]);
    img.classList.remove('hidden');
  }
}

// ── Itinerary accordion ───────────────────────
const container = document.getElementById('itinerary-container');

function updateCount() {
  const n = container.querySelectorAll('.day-card').length;
  document.getElementById('itin-count').textContent = `${n} day${n === 1 ? '' : 's'}`;
}

function updateSummary(card) {
  const title = card.querySelector('.day-dayTitle').value.trim();
  const accom = card.querySelector('.day-accommodation').value.trim();
  const b = card.querySelector('.day-breakfast').checked;
  const l = card.querySelector('.day-lunch').checked;
  const d = card.querySelector('.day-dinner').checked;
  const meals = [b && 'B', l && 'L', d && 'D'].filter(Boolean).join(' · ');
  const parts = [accom, meals].filter(Boolean).join('  •  ');
  card.querySelector('.day-title').textContent = title || `(untitled)`;
  card.querySelector('.day-summary').textContent = parts || '—';
}

function updateMoveButtons() {
  const cards = container.querySelectorAll('.day-card');
  cards.forEach((card, i) => {
    card.querySelector('.btn-up').disabled = i === 0;
    card.querySelector('.btn-down').disabled = i === cards.length - 1;
  });
}

function renumberDays() {
  container.querySelectorAll('.day-card').forEach((card, i) => {
    card.querySelector('.day-num').textContent = i + 1;
  });
  updateMoveButtons();
  updateCount();
}

function createDayCard(data, open = false) {
  const div = document.createElement('div');
  div.className = 'day-card' + (open ? ' open' : '');

  const title = (data?.dayTitle ?? '').replace(/"/g, '&quot;');
  const accom = (data?.accom ?? data?.accommodation ?? '').replace(/"/g, '&quot;');
  const transport = (data?.transport ?? '').replace(/"/g, '&quot;');
  const notes = (data?.specialNotes ?? '').replace(/"/g, '&quot;');
  const activities = (data?.activities ?? '').replace(/</g, '&lt;');
  const b = data?.breakfast ? 'checked' : '';
  const l = data?.lunch ? 'checked' : '';
  const d = data?.dinner ? 'checked' : '';

  div.innerHTML = `
    <div class="day-header">
      <div class="day-num">?</div>
      <div class="day-header-text">
        <div class="day-title">${title || '(untitled)'}</div>
        <div class="day-summary">—</div>
      </div>
      <div class="day-actions">
        <button type="button" class="day-move-btn btn-up" title="Move up">▲</button>
        <button type="button" class="day-move-btn btn-down" title="Move down">▼</button>
      </div>
      <svg class="day-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
    <div class="day-body">
      <div class="day-grid">
        <div class="full">
          <div class="day-label">Day Title</div>
          <input type="text" class="day-input day-dayTitle" value="${title}" placeholder="e.g. Arrive in Manali" />
        </div>
        <div class="full">
          <div class="day-label">Activities</div>
          <textarea class="day-input day-activities" rows="4" placeholder="What happens this day...">${activities}</textarea>
        </div>
        <div>
          <div class="day-label">Accommodation</div>
          <input type="text" class="day-input day-accommodation" value="${accom}" placeholder="e.g. Guesthouse in Tabo" />
        </div>
        <div>
          <div class="day-label">Transport</div>
          <input type="text" class="day-input day-transport" value="${transport}" placeholder="e.g. Bus to Kaza" />
        </div>
        <div class="full">
          <div class="day-label">Meals Included</div>
          <div class="meal-row">
            <label class="meal-label"><input type="checkbox" class="day-breakfast" ${b} /> Breakfast</label>
            <label class="meal-label"><input type="checkbox" class="day-lunch" ${l} /> Lunch</label>
            <label class="meal-label"><input type="checkbox" class="day-dinner" ${d} /> Dinner</label>
          </div>
        </div>
        <div class="full">
          <div class="day-label">Special Notes</div>
          <input type="text" class="day-input day-specialNotes" value="${notes}" placeholder="Anything travellers should know..." />
        </div>
      </div>
      <div class="day-footer">
        <button type="button" class="rm-btn day-remove-btn">Remove Day</button>
      </div>
    </div>
  `;

  div.querySelector('.day-remove-btn').addEventListener('click', () => { div.remove(); renumberDays(); });

  // Toggle open/close on header click
  div.querySelector('.day-header').addEventListener('click', (e) => {
    if (e.target.closest('.day-actions')) return;
    div.classList.toggle('open');
  });

  // Move up/down
  div.querySelector('.btn-up').addEventListener('click', () => {
    const prev = div.previousElementSibling;
    if (prev) { container.insertBefore(div, prev); renumberDays(); }
  });
  div.querySelector('.btn-down').addEventListener('click', () => {
    const next = div.nextElementSibling;
    if (next) { container.insertBefore(next, div); renumberDays(); }
  });

  // Live summary update
  const updateThis = () => updateSummary(div);
  div.querySelector('.day-dayTitle').addEventListener('input', updateThis);
  div.querySelector('.day-accommodation').addEventListener('input', updateThis);
  div.querySelectorAll('.day-breakfast,.day-lunch,.day-dinner').forEach(cb => cb.addEventListener('change', updateThis));

  return div;
}

function addDay() {
  const card = createDayCard(null, true);
  container.appendChild(card);
  renumberDays();
  updateSummary(card);
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  card.querySelector('.day-dayTitle').focus();
}

function expandAll()  { container.querySelectorAll('.day-card').forEach(c => c.classList.add('open')); }
function collapseAll(){ container.querySelectorAll('.day-card').forEach(c => c.classList.remove('open')); }

function serializeItinerary() {
  return Array.from(container.querySelectorAll('.day-card')).map((card, i) => ({
    dayNumber: i + 1,
    dayTitle:       card.querySelector('.day-dayTitle')?.value ?? '',
    activities:     card.querySelector('.day-activities')?.value ?? '',
    accommodation:  card.querySelector('.day-accommodation')?.value ?? '',
    transport:      card.querySelector('.day-transport')?.value ?? '',
    breakfast:      card.querySelector('.day-breakfast')?.checked ?? false,
    lunch:          card.querySelector('.day-lunch')?.checked ?? false,
    dinner:         card.querySelector('.day-dinner')?.checked ?? false,
    specialNotes:   card.querySelector('.day-specialNotes')?.value ?? '',
  }));
}

// Populate from saved data
if (Array.isArray(itinerary)) {
  itinerary.forEach(day => {
    const card = createDayCard(day, false);
    container.appendChild(card);
    updateSummary(card);
  });
}
renumberDays();

document.getElementById('trip-form').addEventListener('submit', () => {
  document.getElementById('itinerary_json').value = JSON.stringify(serializeItinerary());
});

// Wire up buttons that couldn't use onclick (Astro define:vars wraps in IIFE)
document.getElementById('add-day-btn').addEventListener('click', addDay);
document.getElementById('expand-all-btn').addEventListener('click', expandAll);
document.getElementById('collapse-all-btn').addEventListener('click', collapseAll);
document.querySelectorAll('.add-btn[data-list]').forEach(btn => {
  btn.addEventListener('click', () => addItem(btn.dataset.list, btn.dataset.name, btn.dataset.placeholder ?? ''));
});
document.getElementById('add-batch-btn')?.addEventListener('click', () => {
  const list = document.getElementById('batches-list');
  const div = document.createElement('div');
  div.className = 'dyn-item batch-row';
  div.style.cssText = 'flex-wrap:wrap; gap:0.5rem; align-items:flex-end; border:1px solid var(--color-border); border-radius:0.5rem; padding:0.6rem;';
  div.innerHTML =
    '<input type="hidden" name="batchId[]" value="" />' +
    '<div style="flex:1; min-width:130px;"><span class="fhint">Start</span><input type="date" name="batchStart[]" class="finput" /></div>' +
    '<div style="flex:1; min-width:130px;"><span class="fhint">End</span><input type="date" name="batchEnd[]" class="finput" /></div>' +
    '<div style="flex:1; min-width:90px;"><span class="fhint">Price ₹</span><input type="number" name="batchPrice[]" class="finput" /></div>' +
    '<div style="flex:1; min-width:70px;"><span class="fhint">Total spots</span><input type="number" name="batchTotal[]" class="finput" /></div>' +
    '<div style="flex:1; min-width:70px;"><span class="fhint">Booked</span><input type="number" name="batchBooked[]" value="0" class="finput" /></div>' +
    '<div style="flex:1; min-width:120px;"><span class="fhint">Status</span><select name="batchStatus[]" class="finput"><option value="booking-open">booking-open</option><option value="filling_fast">filling_fast</option><option value="sold-out">sold-out</option><option value="draft">draft</option><option value="completed">completed</option></select></div>' +
    '<button type="button" class="rm-btn" onclick="this.closest(\'.batch-row\').remove()">✕</button>';
  list.appendChild(div);
  div.querySelector('input[name="batchStart[]"]').focus();
});
document.getElementById('add-sharing-btn')?.addEventListener('click', () => {
  const list = document.getElementById('sharing-list');
  const div = document.createElement('div');
  div.className = 'dyn-item';
  div.style.gap = '0.5rem';
  div.innerHTML = '<input type="text" name="sharingLabel[]" placeholder="e.g. Double sharing" class="finput" style="flex:2;" /><input type="number" name="sharingPrice[]" placeholder="₹ per person" class="finput" style="flex:1;" /><button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>';
  list.appendChild(div);
  div.querySelector('input').focus();
});
document.querySelectorAll('.file-input[data-preview]').forEach(input => {
  input.addEventListener('change', () => previewImage(input, input.dataset.preview));
});
</script>
