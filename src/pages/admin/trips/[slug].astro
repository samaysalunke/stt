<script define:vars={{ itinerary }}>
// ── Tab switching ─────────────────────────────
const tabs = document.querySelectorAll('.tab-btn');
const panels = document.querySelectorAll('.tab-panel');

function switchTab(id) {
  tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === id));
  panels.forEach(p => p.classList.toggle('hidden', p.id !== 'tab-' + id));
  history.replaceState(null, '', '#' + id);
}

tabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));

// Restore tab from URL hash
const hash = location.hash.replace('#', '');
const validTabs = ['basics','content','itinerary','logistics','payment'];
switchTab(validTabs.includes(hash) ? hash : 'basics');

// ── Dynamic list items ────────────────────────
function addItem(listId, name, placeholder) {
  const list = document.getElementById(listId);
  const div = document.createElement('div');
  div.className = 'dyn-item';
  div.innerHTML = `<input type="text" name="${name}" placeholder="${placeholder}" class="finput" /><button type="button" class="rm-btn" onclick="this.parentElement.remove()">✕</button>`;
  list.appendChild(div);
  div.querySelector('input').focus();
}

// ── Image preview ─────────────────────────────
function previewImage(input, previewId) {
  const img = document.getElementById(previewId);
  if (input.files && input.files[0]) {
    img.src = URL.createObjectURL(input.files[0]);
    img.classList.remove('hidden');
  }
}

// ── Itinerary accordion ───────────────────────
const container = document.getElementById('itinerary-container');

function updateCount() {
  const n = container.querySelectorAll('.day-card').length;
  document.getElementById('itin-count').textContent = `${n} day${n === 1 ? '' : 's'}`;
}

function updateSummary(card) {
  const title = card.querySelector('.day-dayTitle').value.trim();
  const accom = card.querySelector('.day-accommodation').value.trim();
  const b = card.querySelector('.day-breakfast').checked;
  const l = card.querySelector('.day-lunch').checked;
  const d = card.querySelector('.day-dinner').checked;
  const meals = [b && 'B', l && 'L', d && 'D'].filter(Boolean).join(' · ');
  const parts = [accom, meals].filter(Boolean).join('  •  ');
  card.querySelector('.day-title').textContent = title || `(untitled)`;
  card.querySelector('.day-summary').textContent = parts || '—';
}

function updateMoveButtons() {
  const cards = container.querySelectorAll('.day-card');
  cards.forEach((card, i) => {
    card.querySelector('.btn-up').disabled = i === 0;
    card.querySelector('.btn-down').disabled = i === cards.length - 1;
  });
}

function renumberDays() {
  container.querySelectorAll('.day-card').forEach((card, i) => {
    card.querySelector('.day-num').textContent = i + 1;
  });
  updateMoveButtons();
  updateCount();
}

function createDayCard(data, open = false) {
  const div = document.createElement('div');
  div.className = 'day-card' + (open ? ' open' : '');

  // Accept both the editor's internal schema (dayTitle/activities/accommodation/
  // specialNotes + boolean meals) and the canonical YAML/import schema
  // (title/description/stay/note + meals array), so imported trips populate here.
  const title = (data?.dayTitle ?? data?.title ?? '').replace(/"/g, '&quot;');
  const accom = (data?.accom ?? data?.accommodation ?? data?.stay ?? '').replace(/"/g, '&quot;');
  const transport = (data?.transport ?? '').replace(/"/g, '&quot;');
  const notes = (data?.specialNotes ?? data?.note ?? '').replace(/"/g, '&quot;');
  const activities = (data?.activities ?? data?.description ?? '').replace(/</g, '&lt;');
  const meals = Array.isArray(data?.meals) ? data.meals.map(m => String(m).toUpperCase()) : null;
  const b = (meals ? meals.includes('B') : data?.breakfast) ? 'checked' : '';
  const l = (meals ? meals.includes('L') : data?.lunch) ? 'checked' : '';
  const d = (meals ? meals.includes('D') : data?.dinner) ? 'checked' : '';

  div.innerHTML = `
    <div class="day-header">
      <div class="day-num">?</div>
      <div class="day-header-text">
        <div class="day-title">${title || '(untitled)'}</div>
        <div class="day-summary">—</div>
      </div>
      <div class="day-actions">
        <button type="button" class="day-move-btn btn-up" title="Move up">▲</button>
        <button type="button" class="day-move-btn btn-down" title="Move down">▼</button>
      </div>
      <svg class="day-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
    <div class="day-body">
      <div class="day-grid">
        <div class="full">
          <div class="day-label">Day Title</div>
          <input type="text" class="day-input day-dayTitle" value="${title}" placeholder="e.g. Arrive in Manali" />
        </div>
        <div class="full">
          <div class="day-label">Activities</div>
          <textarea class="day-input day-activities" rows="4" placeholder="What happens this day...">${activities}</textarea>
        </div>
        <div>
          <div class="day-label">Accommodation</div>
          <input type="text" class="day-input day-accommodation" value="${accom}" placeholder="e.g. Guesthouse in Tabo" />
        </div>
        <div>
          <div class="day-label">Transport</div>
          <input type="text" class="day-input day-transport" value="${transport}" placeholder="e.g. Bus to Kaza" />
        </div>
        <div class="full">
          <div class="day-label">Meals Included</div>
          <div class="meal-row">
            <label class="meal-label"><input type="checkbox" class="day-breakfast" ${b} /> Breakfast</label>
            <label class="meal-label"><input type="checkbox" class="day-lunch" ${l} /> Lunch</label>
            <label class="meal-label"><input type="checkbox" class="day-dinner" ${d} /> Dinner</label>
          </div>
        </div>
        <div class="full">
          <div class="day-label">Special Notes</div>
          <input type="text" class="day-input day-specialNotes" value="${notes}" placeholder="Anything travellers should know..." />
        </div>
      </div>
      <div class="day-footer">
        <button type="button" class="rm-btn day-remove-btn">Remove Day</button>
      </div>
    </div>
  `;

  div.querySelector('.day-remove-btn').addEventListener('click', () => { div.remove(); renumberDays(); });

  // Toggle open/close on header click
  div.querySelector('.day-header').addEventListener('click', (e) => {
    if (e.target.closest('.day-actions')) return;
    div.classList.toggle('open');
  });

  // Move up/down
  div.querySelector('.btn-up').addEventListener('click', () => {
    const prev = div.previousElementSibling;
    if (prev) { container.insertBefore(div, prev); renumberDays(); }
  });
  div.querySelector('.btn-down').addEventListener('click', () => {
    const next = div.nextElementSibling;
    if (next) { container.insertBefore(next, div); renumberDays(); }
  });

  // Live summary update
  const updateThis = () => updateSummary(div);
  div.querySelector('.day-dayTitle').addEventListener('input', updateThis);
  div.querySelector('.day-accommodation').addEventListener('input', updateThis);
  div.querySelectorAll('.day-breakfast,.day-lunch,.day-dinner').forEach(cb => cb.addEventListener('change', updateThis));

  return div;
}

function addDay() {
  const card = createDayCard(null, true);
  container.appendChild(card);
  renumberDays();
  updateSummary(card);
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  card.querySelector('.day-dayTitle').focus();
}

function expandAll()  { container.querySelectorAll('.day-card').forEach(c => c.classList.add('open')); }
function collapseAll(){ container.querySelectorAll('.day-card').forEach(c => c.classList.remove('open')); }

function serializeItinerary() {
  return Array.from(container.querySelectorAll('.day-card')).map((card, i) => ({
    dayNumber: i + 1,
    dayTitle:       card.querySelector('.day-dayTitle')?.value ?? '',
    activities:     card.querySelector('.day-activities')?.value ?? '',
    accommodation:  card.querySelector('.day-accommodation')?.value ?? '',
    transport:      card.querySelector('.day-transport')?.value ?? '',
    breakfast:      card.querySelector('.day-breakfast')?.checked ?? false,
    lunch:          card.querySelector('.day-lunch')?.checked ?? false,
    dinner:         card.querySelector('.day-dinner')?.checked ?? false,
    specialNotes:   card.querySelector('.day-specialNotes')?.value ?? '',
  }));
}

// Populate from saved data
if (Array.isArray(itinerary)) {
  itinerary.forEach(day => {
    const card = createDayCard(day, false);
    container.appendChild(card);
    updateSummary(card);
  });
}
renumberDays();

document.getElementById('trip-form').addEventListener('submit', () => {
  document.getElementById('itinerary_json').value = JSON.stringify(serializeItinerary());
});

// Wire up buttons that couldn't use onclick (Astro define:vars wraps in IIFE)
document.getElementById('add-day-btn').addEventListener('click', addDay);
document.getElementById('expand-all-btn').addEventListener('click', expandAll);
document.getElementById('collapse-all-btn').addEventListener('click', collapseAll);
document.querySelectorAll('.add-btn[data-list]').forEach(btn => {
  btn.addEventListener('click', () => addItem(btn.dataset.list, btn.dataset.name, btn.dataset.placeholder ?? ''));
});
document.querySelectorAll('.file-input[data-preview]').forEach(input => {
  input.addEventListener('change', () => previewImage(input, input.dataset.preview));
});
</script>

<!-- ── Trip photo gallery editor ──────────────────────────────────────────── -->
<script define:vars={{ galleryAlbums, initialGallery, tripSlug }}>
(function () {
  const MAX_ALBUM = 10;
  const albums = galleryAlbums || [];
  let gallery = JSON.parse(JSON.stringify(initialGallery || []));

  const albumSelect = document.getElementById('gallery-album-select');
  const albumGrid = document.getElementById('gallery-album-grid');
  const selectedWrap = document.getElementById('gallery-selected');
  const countEl = document.getElementById('gallery-count');
  const albumCountEl = document.getElementById('gallery-album-count');
  const uploadInput = document.getElementById('gallery-upload-input');
  const uploadStatus = document.getElementById('gallery-upload-status');
  const hidden = document.getElementById('gallery_json');

  const nameInput = document.querySelector('#trip-form [name="name"]');
  const effSlug = () => tripSlug || (nameInput ? nameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') : '');
  const albumCount = () => gallery.filter(g => g.source === 'album').length;
  const isSelected = (url) => gallery.some(g => g.image === url);
  const aspect = (p) => (p.width && p.height) ? `aspect-ratio:${p.width}/${p.height};` : '';

  function tile(p, opts) {
    const div = document.createElement('div');
    div.className = 'gallery-thumb' + (opts.selected ? ' is-selected' : '');
    div.style.cssText = aspect(p);
    div.innerHTML =
      `<img src="${p.image}" loading="lazy" alt="" />` +
      `<button type="button" class="gallery-thumb-btn" title="${opts.removable ? 'Remove' : 'Toggle'}">${opts.removable ? '✕' : (opts.selected ? '✓' : '+')}</button>`;
    div.querySelector('button').addEventListener('click', opts.onClick);
    return div;
  }

  function renderSelected() {
    selectedWrap.innerHTML = '';
    gallery.forEach((p) => {
      selectedWrap.appendChild(tile(p, {
        removable: true, selected: true,
        onClick: () => { gallery = gallery.filter(g => g.image !== p.image); sync(); },
      }));
    });
    countEl.textContent = gallery.length;
    const ac = albumCount();
    albumCountEl.textContent = ac >= MAX_ALBUM ? `· album limit reached (${MAX_ALBUM})` : (ac ? `· ${ac}/${MAX_ALBUM} from album` : '');
    hidden.value = JSON.stringify(gallery);
  }

  function renderAlbumGrid() {
    const album = albums.find(a => a.slug === albumSelect.value);
    albumGrid.innerHTML = '';
    if (!album) { albumGrid.classList.add('hidden'); return; }
    albumGrid.classList.remove('hidden');
    album.photos.forEach((p) => {
      const sel = isSelected(p.image);
      albumGrid.appendChild(tile(p, {
        removable: false, selected: sel,
        onClick: () => {
          if (isSelected(p.image)) {
            gallery = gallery.filter(g => g.image !== p.image);
          } else {
            if (albumCount() >= MAX_ALBUM) { alert(`You can pick at most ${MAX_ALBUM} images from albums.`); return; }
            gallery.push({ image: p.image, width: p.width, height: p.height, source: 'album' });
          }
          sync();
        },
      }));
    });
  }

  function sync() { renderSelected(); renderAlbumGrid(); }

  albumSelect.addEventListener('change', renderAlbumGrid);

  uploadInput.addEventListener('change', async () => {
    const files = Array.from(uploadInput.files || []);
    if (!files.length) return;
    const slug = effSlug();
    if (!slug) { alert('Enter the trip name first, then upload trip-only photos.'); return; }
    let done = 0;
    uploadStatus.textContent = `Uploading 0 / ${files.length}...`;
    for (const file of files) {
      const fd = new FormData();
      fd.append('slug', slug);
      fd.append('photo', file);
      try {
        const res = await fetch('/api/admin/trips/upload-photo', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok && data.url) {
          gallery.push({ image: data.url, width: data.width, height: data.height, source: 'trip' });
          done++;
          renderSelected();
        }
      } catch { /* skip */ }
      uploadStatus.textContent = `Uploading ${done} / ${files.length}...`;
    }
    uploadStatus.textContent = `✓ Uploaded ${done} photo${done !== 1 ? 's' : ''}.`;
    uploadInput.value = '';
    setTimeout(() => { uploadStatus.textContent = ''; }, 2500);
  });

  document.getElementById('trip-form').addEventListener('submit', () => {
    hidden.value = JSON.stringify(gallery);
  });

  sync();
})();
</script>

<!-- ── Occupancy catalog + per-departure offers editor ────────────────────── -->
<script define:vars={{ editorCatalog, editorDepartures }}>
(function () {
  const STATUSES = ['booking-open', 'filling_fast', 'sold-out', 'draft', 'completed'];
  // Working state (deep-cloned from server data).
  let catalog = JSON.parse(JSON.stringify(editorCatalog || []));
  let departures = JSON.parse(JSON.stringify(editorDepartures || []));

  const catalogEl = document.getElementById('catalog-editor');
  const departuresEl = document.getElementById('departures-editor');
  const form = document.getElementById('trip-form');

  const slugify = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function ensureTierId(tier, i) {
    if (!tier.id) tier.id = slugify(tier.label) || ('tier-' + i);
    return tier.id;
  }

  // ── Catalog ───────────────────────────────────────────────────────────────
  function renderCatalog() {
    catalogEl.innerHTML = '';
    catalog.forEach((tier, i) => {
      ensureTierId(tier, i);
      const row = document.createElement('div');
      row.className = 'dyn-item';
      row.style.cssText = 'gap:0.5rem; align-items:flex-start;';
      row.innerHTML =
        '<div style="flex:2;"><span class="fhint">Label</span>' +
          '<input type="text" class="finput tier-label" value="' + esc(tier.label) + '" placeholder="e.g. Double Sharing" /></div>' +
        '<div style="flex:3;"><span class="fhint">Helper text (what this sharing means)</span>' +
          '<input type="text" class="finput tier-helper" value="' + esc(tier.helperText) + '" placeholder="e.g. Room shared with one other traveller." /></div>' +
        '<button type="button" class="rm-btn" style="margin-top:1.2rem;">✕</button>';
      row.querySelector('.tier-label').addEventListener('input', (e) => { tier.label = e.target.value; });
      row.querySelector('.tier-helper').addEventListener('input', (e) => { tier.helperText = e.target.value; });
      row.querySelector('.rm-btn').addEventListener('click', () => {
        catalog.splice(i, 1);
        renderCatalog();
        renderDepartures(); // offer grids depend on the catalog
      });
      catalogEl.appendChild(row);
    });
  }

  // ── Departures ──────────────────────────────────────────────────────────────
  function renderDepartures() {
    departuresEl.innerHTML = '';
    departures.forEach((dep, di) => {
      const card = document.createElement('div');
      card.style.cssText = 'border:1px solid var(--color-border); border-radius:0.5rem; padding:0.75rem; margin-bottom:0.75rem;';

      const head = document.createElement('div');
      head.style.cssText = 'display:flex; flex-wrap:wrap; gap:0.5rem; align-items:flex-end;';
      head.innerHTML =
        '<div style="flex:1; min-width:140px;"><span class="fhint">Start</span>' +
          '<input type="date" class="finput dep-start" value="' + esc(dep.startDate) + '" /></div>' +
        '<div style="flex:1; min-width:140px;"><span class="fhint">End</span>' +
          '<input type="date" class="finput dep-end" value="' + esc(dep.endDate) + '" /></div>' +
        '<div style="flex:1; min-width:130px;"><span class="fhint">Status</span>' +
          '<select class="finput dep-status">' +
            STATUSES.map((s) => '<option value="' + s + '"' + (s === dep.status ? ' selected' : '') + '>' + s + '</option>').join('') +
          '</select></div>' +
        '<button type="button" class="rm-btn dep-remove" style="margin-bottom:0.1rem;">✕ Date</button>';
      head.querySelector('.dep-start').addEventListener('input', (e) => { dep.startDate = e.target.value; });
      head.querySelector('.dep-end').addEventListener('input', (e) => { dep.endDate = e.target.value; });
      head.querySelector('.dep-status').addEventListener('change', (e) => { dep.status = e.target.value; });
      head.querySelector('.dep-remove').addEventListener('click', () => { departures.splice(di, 1); renderDepartures(); });
      card.appendChild(head);

      // Offer grid — one row per catalog tier.
      const grid = document.createElement('div');
      grid.style.cssText = 'margin-top:0.6rem; display:flex; flex-direction:column; gap:0.4rem;';
      if (catalog.length === 0) {
        grid.innerHTML = '<span class="fhint">Add an occupancy tier above to set offers.</span>';
      }
      catalog.forEach((tier, ti) => {
        const tierId = ensureTierId(tier, ti);
        const offer = dep.offers.find((o) => o.tierId === tierId);
        const offered = !!offer;
        const r = document.createElement('div');
        r.style.cssText = 'display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center; background:var(--color-bg-soft, #faf7f5); border-radius:0.4rem; padding:0.35rem 0.5rem;';
        r.innerHTML =
          '<label style="display:flex; align-items:center; gap:0.4rem; flex:2; min-width:160px; cursor:pointer;">' +
            '<input type="checkbox" class="off-on"' + (offered ? ' checked' : '') + ' />' +
            '<span>' + esc(tier.label || tierId) + '</span></label>' +
          '<div style="flex:1; min-width:90px;"><span class="fhint">Price ₹</span>' +
            '<input type="number" class="finput off-price" value="' + (offer && offer.price != null ? offer.price : '') + '"' + (offered ? '' : ' disabled') + ' /></div>' +
          '<div style="flex:1; min-width:70px;"><span class="fhint">Cap</span>' +
            '<input type="number" class="finput off-cap" value="' + (offer && offer.cap != null ? offer.cap : '') + '"' + (offered ? '' : ' disabled') + ' /></div>' +
          '<div style="flex:1; min-width:70px;"><span class="fhint">Booked</span>' +
            '<input type="number" class="finput off-booked" value="' + (offer && offer.booked != null ? offer.booked : 0) + '"' + (offered ? '' : ' disabled') + ' /></div>';
        const cb = r.querySelector('.off-on');
        const priceI = r.querySelector('.off-price');
        const capI = r.querySelector('.off-cap');
        const bookedI = r.querySelector('.off-booked');
        const getOffer = () => dep.offers.find((o) => o.tierId === tierId);
        cb.addEventListener('change', () => {
          if (cb.checked) {
            if (!getOffer()) dep.offers.push({ tierId, price: null, cap: null, booked: 0 });
            priceI.disabled = capI.disabled = bookedI.disabled = false;
          } else {
            dep.offers = dep.offers.filter((o) => o.tierId !== tierId);
            priceI.disabled = capI.disabled = bookedI.disabled = true;
          }
        });
        priceI.addEventListener('input', () => { const o = getOffer(); if (o) o.price = priceI.value === '' ? null : Number(priceI.value); });
        capI.addEventListener('input', () => { const o = getOffer(); if (o) o.cap = capI.value === '' ? null : Number(capI.value); });
        bookedI.addEventListener('input', () => { const o = getOffer(); if (o) o.booked = bookedI.value === '' ? 0 : Number(bookedI.value); });
        grid.appendChild(r);
      });
      card.appendChild(grid);
      departuresEl.appendChild(card);
    });
  }

  document.getElementById('add-tier-btn').addEventListener('click', () => {
    catalog.push({ id: '', label: '', helperText: '' });
    renderCatalog();
    renderDepartures();
  });
  document.getElementById('add-departure-btn').addEventListener('click', () => {
    departures.push({ id: '', startDate: '', endDate: '', status: 'booking-open', offers: [] });
    renderDepartures();
  });

  // Serialize on submit — assign stable tier ids + departure ids first.
  form.addEventListener('submit', () => {
    catalog.forEach((t, i) => ensureTierId(t, i));
    departures.forEach((d) => { if (!d.id && d.startDate) d.id = slugify(d.startDate); });
    document.getElementById('occupancyCatalog_json').value = JSON.stringify(catalog);
    document.getElementById('departures_json').value = JSON.stringify(departures);
  });

  renderCatalog();
  renderDepartures();
})();
</script>
