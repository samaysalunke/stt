---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
export const prerender = false;

const contacts = getDb()
  .prepare('SELECT * FROM contact_submissions ORDER BY id DESC')
  .all() as Record<string, any>[];

function fmt(date: string) {
  if (!date) return '—';
  return new Date(date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}

// A contact is resolved or it is waiting on us — the same two roles a
// registration's confirmed/pending pills carry, so they share the tokens.
const RESOLVED_PILL = 'background:var(--color-success-surface);color:var(--color-success-surface-ink);';
const OPEN_PILL = 'background:var(--color-warning-surface);color:var(--color-warning-ink);';
// The reopen button is a de-emphasised action, not a status.
const REOPEN_BTN = 'background:var(--color-muted-surface);color:var(--color-muted-ink);';

function statusStyle(status: string) {
  return status === 'resolved' ? RESOLVED_PILL : OPEN_PILL;
}
---

<AdminLayout title="Contact Submissions" page="contacts">
  <div class="flex items-center justify-between mb-[1.5rem]">
    <div>
      <h1 class="font-display text-[1.5rem] font-extrabold text-[#111D27] mt-[0] mx-[0] mb-[0.25rem]">Contact Submissions</h1>
      <p class="text-gray-text text-[0.875rem] m-0">{contacts.length} total messages</p>
    </div>
    <a id="contacts-export"
      href="/api/admin/export?type=contacts"
      class="py-[0.45rem] px-[1rem] bg-navy text-white rounded-[0.5rem] text-[0.875rem] font-semibold no-underline"
    >
      ↓ Export CSV
    </a>
  </div>

  <!-- Filter bar -->
  <div class="flex flex-wrap gap-[0.5rem] mb-[1rem]">
    {['all','new','resolved'].map(s => (
      <button
        class="contact-filter"
        data-filter={s}
        style={`padding:0.35rem 0.9rem;border-radius:9999px;font-size:0.78rem;font-weight:600;cursor:pointer;border:1.5px solid var(--color-border);background:${s==='all'?'var(--color-navy)':'var(--color-gray-soft)'};color:${s==='all'?'white':'var(--color-gray-text)'};`}
      >
        {s === 'all' ? 'All' : s.charAt(0).toUpperCase() + s.slice(1)}
      </button>
    ))}
  </div>

  {contacts.length === 0 ? (
    <p class="text-center p-[3rem] text-gray-text bg-white border border-peach/60 rounded-[1.25rem]">No contact submissions yet.</p>
  ) : (
    <div class="flex flex-col gap-[0.75rem]">
      {contacts.map((c) => (
        <div class="contact-row bg-white border border-peach/60 rounded-[1.25rem] py-[1rem] px-[1.15rem]" data-status={c.status ?? 'new'}>
          <!-- Summary -->
          <div class="flex items-start justify-between gap-[0.75rem] flex-wrap">
            <div class="min-w-0">
              <div class="flex items-center gap-[0.5rem] flex-wrap">
                <span class="font-bold text-navy">{c.full_name}</span>
                <span style={`padding:0.15rem 0.55rem;border-radius:9999px;font-size:0.72rem;font-weight:700;${statusStyle(c.status ?? 'new')}`}>
                  {c.status ?? 'new'}
                </span>
              </div>
              <a href={`mailto:${c.email}`} class="text-coral-ink text-[0.82rem] break-all">{c.email}</a>
              <p class="mt-[0.25rem] mx-[0] mb-[0] text-[0.85rem] text-navy">{c.subject}</p>
            </div>
            <div class="flex flex-col items-end gap-[0.4rem] flex-none">
              <span class="text-[0.75rem] text-gray-text whitespace-nowrap">{fmt(c.created_at as string)}</span>
              <button
                onclick={`toggleContact(${c.id})`}
                class="text-[0.75rem] text-coral-ink bg-transparent border border-coral rounded-[0.5rem] py-[0.2rem] px-[0.7rem] cursor-pointer"
              >
                View
              </button>
            </div>
          </div>

          <!-- Expandable detail -->
          <div id={`contact-${c.id}`} class="hidden mt-[1rem] pt-[1rem] border-t border-border">
            <div class="grid grid-cols-2 gap-y-[0.4rem] gap-x-[1.5rem] text-[0.82rem] mb-[1rem]">
              <div><span class="text-gray-text font-semibold">Phone:</span> {c.phone ?? '—'}</div>
              <div><span class="text-gray-text font-semibold">Source:</span> {c.source ?? '—'}</div>
            </div>
            <p class="text-[0.82rem] font-semibold text-gray-text mt-[0] mx-[0] mb-[0.4rem]">Message:</p>
            <div class="bg-gray-soft border border-border rounded-[0.75rem] p-[0.875rem] text-[0.875rem] whitespace-pre-wrap leading-[1.6]">{c.message}</div>
            <div class="flex gap-[0.5rem] flex-wrap mt-[1rem]">
              <a
                href={`mailto:${c.email}?subject=Re: ${encodeURIComponent(c.subject)}`}
                class="py-[0.5rem] px-[1.25rem] bg-coral text-white rounded-[0.5rem] text-[0.82rem] font-bold no-underline whitespace-nowrap"
              >
                Reply via Email
              </a>
              <button
                onclick={`toggleResolved(${c.id}, '${c.status ?? 'new'}')`}
                id={`resolve-btn-${c.id}`}
                style={`padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.82rem;font-weight:700;cursor:pointer;border:none;white-space:nowrap;${(c.status ?? 'new') === 'resolved' ? REOPEN_BTN : RESOLVED_PILL}`}
              >
                {(c.status ?? 'new') === 'resolved' ? '↩ Reopen' : '✓ Mark Resolved'}
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  function toggleContact(id: number) {
    const row = document.getElementById('contact-' + id);
    if (!row) return;
    row.style.display = row.style.display === 'none' ? 'block' : 'none';
  }

  async function toggleResolved(id: number, currentStatus: string) {
    const newStatus = currentStatus === 'resolved' ? 'new' : 'resolved';
    try {
      const res = await fetch('/api/admin/mark-contact-resolved', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: newStatus }),
      });
      if (!res.ok) throw new Error('Failed');
      // Update badge in the main row
      const rows = document.querySelectorAll<HTMLTableRowElement>('.contact-row');
      rows.forEach(row => {
        const btn = row.querySelector(`button[onclick*="toggleContact(${id})"]`);
        if (btn) {
          row.dataset.status = newStatus;
          const badge = row.querySelector('span[style*="border-radius:9999px"]') as HTMLElement | null;
          if (badge) {
            badge.textContent = newStatus;
            badge.style.cssText = `padding:0.2rem 0.6rem;border-radius:9999px;font-size:0.75rem;font-weight:700;${newStatus === 'resolved' ? RESOLVED_PILL : OPEN_PILL}`;
          }
        }
      });
      // Update the resolve button
      const resolveBtn = document.getElementById('resolve-btn-' + id) as HTMLButtonElement | null;
      if (resolveBtn) {
        resolveBtn.textContent = newStatus === 'resolved' ? '↩ Reopen' : '✓ Mark Resolved';
        resolveBtn.style.cssText = `padding:0.5rem 1rem;border-radius:0.5rem;font-size:0.82rem;font-weight:700;cursor:pointer;border:none;white-space:nowrap;${newStatus === 'resolved' ? REOPEN_BTN : RESOLVED_PILL}`;
        resolveBtn.setAttribute('onclick', `toggleResolved(${id}, '${newStatus}')`);
      }
      // Apply active filter
      applyContactFilter();
    } catch {
      alert('Failed to update status.');
    }
  }

  // Filter buttons
  let activeFilter = 'all';
  const exportLink = document.getElementById('contacts-export') as HTMLAnchorElement | null;

  function updateExportLink() {
    if (!exportLink) return;
    const params = new URLSearchParams({ type: 'contacts' });
    if (activeFilter !== 'all') params.set('status', activeFilter);
    exportLink.href = `/api/admin/export?${params}`;
  }

  function applyContactFilter() {
    const rows = document.querySelectorAll<HTMLTableRowElement>('.contact-row');
    rows.forEach(row => {
      const status = row.dataset.status ?? 'new';
      const show = activeFilter === 'all' || status === activeFilter;
      row.style.display = show ? '' : 'none';
      // Hide open detail row too
      const viewBtn = row.querySelector('button[onclick*="toggleContact"]');
      const id = viewBtn?.getAttribute('onclick')?.match(/\d+/)?.[0];
      if (!show && id) {
        const detail = document.getElementById('contact-' + id);
        if (detail) detail.style.display = 'none';
      }
    });
    updateExportLink();
  }

  document.querySelectorAll<HTMLButtonElement>('.contact-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';
      // Update button styles
      document.querySelectorAll<HTMLButtonElement>('.contact-filter').forEach(b => {
        const active = b.dataset.filter === activeFilter;
        b.style.background = active ? 'var(--color-navy)' : 'var(--color-gray-soft)';
        b.style.color = active ? 'white' : 'var(--color-gray-text)';
        b.style.borderColor = active ? 'var(--color-navy)' : 'var(--color-border)';
      });
      applyContactFilter();
    });
  });

  (window as any).toggleContact = toggleContact;
  (window as any).toggleResolved = toggleResolved;
  updateExportLink();
</script>
