---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listTrips } from '../../lib/content';
import { getDb } from '../../lib/db';
export const prerender = false;

const db = getDb();

const regsAll = db.prepare('SELECT status, amount_paid, created_at FROM registrations').all() as Array<Record<string, any>>;
const totalBookings = regsAll.length;
const pendingCount = regsAll.filter(r => r.status === 'pending').length;
// Match the registrations page definition: payments collected = all non-rejected.
const revenue = regsAll
  .filter(r => r.status !== 'rejected')
  .reduce((sum, r) => sum + (r.amount_paid ?? 0), 0);

const recent = db
  .prepare('SELECT full_name, trip_name, amount_paid, status, created_at FROM registrations ORDER BY id DESC LIMIT 5')
  .all() as Array<Record<string, any>>;

// 7-day booking growth (counts per day, oldest → newest)
const dayRows = db
  .prepare(`SELECT date(created_at) AS d, COUNT(*) AS c
            FROM registrations
            WHERE created_at >= date('now', '-6 days')
            GROUP BY date(created_at)`)
  .all() as Array<{ d: string; c: number }>;
const dayMap = new Map(dayRows.map(r => [r.d, r.c]));
const week: Array<{ label: string; count: number }> = [];
for (let i = 6; i >= 0; i--) {
  const dt = new Date();
  dt.setDate(dt.getDate() - i);
  const key = dt.toISOString().slice(0, 10);
  week.push({ label: dt.toLocaleDateString('en-US', { weekday: 'short' }), count: dayMap.get(key) ?? 0 });
}
const maxCount = Math.max(1, ...week.map(d => d.count));

const trips = listTrips();
const activeTrips = trips.filter(t => t.status && t.status !== 'draft').length;
const soldOut = trips.filter(t => t.status === 'sold-out');

function inr(n: number) {
  if (n >= 100000) return `₹${(n / 100000).toFixed(1)}L`;
  if (n >= 1000) return `₹${(n / 1000).toFixed(1)}k`;
  return `₹${n}`;
}
function statusStyle(status: string) {
  if (status === 'confirmed') return 'background:#D1FAE5;color:#065F46;';
  if (status === 'rejected') return 'background:#FEE2E2;color:#991B1B;';
  return 'background:#FEF3C7;color:#92400E;';
}

const kpis = [
  { label: 'Payments collected', value: inr(revenue), hint: `${totalBookings} bookings` },
  { label: 'Total bookings', value: String(totalBookings), hint: `${pendingCount} pending` },
  { label: 'Pending review', value: String(pendingCount), hint: 'Awaiting confirmation' },
  { label: 'Active trips', value: String(activeTrips), hint: `${trips.length} total` },
];

const quickActions = [
  { href: '/admin/trips/new/',       label: 'New Trip' },
  { href: '/admin/photo-vault/new/', label: 'Add Media' },
  { href: '/admin/broadcast/',       label: 'Broadcast' },
  { href: '/admin/settings/',        label: 'Settings' },
];
---

<AdminLayout title="Dashboard" page="dashboard">
  <!-- KPI cards -->
  <div class="grid gap-4 grid-cols-2 lg:grid-cols-4 mb-6">
    {kpis.map(k => (
      <div class="bg-white rounded-[2rem] p-5" style="border: 1px solid rgba(245,221,215,0.6);">
        <p class="text-[11px] font-semibold uppercase tracking-widest" style="color: rgba(27,43,58,0.45);">{k.label}</p>
        <p class="font-display text-3xl font-semibold mt-2" style="color: var(--color-navy);">{k.value}</p>
        <p class="text-xs mt-1" style="color: rgba(27,43,58,0.5);">{k.hint}</p>
      </div>
    ))}
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    <!-- Booking growth -->
    <div class="lg:col-span-2 bg-white rounded-[2rem] p-6" style="border: 1px solid rgba(245,221,215,0.6);">
      <h2 class="font-display text-lg font-semibold mb-1" style="color: var(--color-navy);">Booking growth</h2>
      <p class="text-sm mb-5" style="color: rgba(27,43,58,0.5);">Registrations over the last 7 days.</p>
      <div class="flex items-end gap-3 h-32">
        {week.map(d => (
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="w-full flex items-end justify-center" style="height: 100%;">
              <div class="w-full rounded-t-lg transition-all"
                   style={`height: ${(d.count / maxCount) * 100}%; min-height: 4px; background: rgba(232,114,90,0.8);`}
                   title={`${d.count} bookings`}></div>
            </div>
            <span class="text-[10px]" style="color: rgba(27,43,58,0.5);">{d.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick actions -->
    <div class="bg-white rounded-[2rem] p-6" style="border: 1px solid rgba(245,221,215,0.6);">
      <h2 class="font-display text-lg font-semibold mb-4" style="color: var(--color-navy);">Quick actions</h2>
      <div class="flex flex-col gap-2.5">
        {quickActions.map(a => (
          <a href={a.href}
             class="flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-medium transition-colors"
             style="background: var(--color-gray-soft); color: var(--color-navy);">
            {a.label}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Alerts -->
  {(soldOut.length > 0 || pendingCount > 0) && (
    <div class="grid gap-3 sm:grid-cols-2 mt-6">
      {pendingCount > 0 && (
        <a href="/admin/registrations/" class="rounded-2xl px-5 py-4 flex items-center justify-between"
           style="background: rgba(245,158,11,0.10);">
          <div>
            <p class="text-sm font-semibold" style="color: #92400E;">{pendingCount} registration{pendingCount > 1 ? 's' : ''} pending</p>
            <p class="text-xs mt-0.5" style="color: rgba(146,64,14,0.7);">Review and confirm or reject</p>
          </div>
          <svg class="w-5 h-5" style="color: #92400E;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      )}
      {soldOut.map(t => (
        <a href={`/admin/trips/${t.slug}/`} class="rounded-2xl px-5 py-4 flex items-center justify-between"
           style="background: rgba(217,48,37,0.08);">
          <div>
            <p class="text-sm font-semibold" style="color: #991B1B;">{t.name} is sold out</p>
            <p class="text-xs mt-0.5" style="color: rgba(153,27,27,0.7);">Consider opening a new batch</p>
          </div>
          <svg class="w-5 h-5" style="color: #991B1B;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      ))}
    </div>
  )}

  <!-- Recent activity -->
  <div class="bg-white rounded-[2rem] p-6 mt-6" style="border: 1px solid rgba(245,221,215,0.6);">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-display text-lg font-semibold" style="color: var(--color-navy);">Recent activity</h2>
      <a href="/admin/registrations/" class="text-sm font-medium" style="color: var(--color-coral);">View all</a>
    </div>
    {recent.length === 0 ? (
      <p class="text-sm" style="color: rgba(27,43,58,0.5);">No registrations yet.</p>
    ) : (
      <div class="flex flex-col gap-2.5">
        {recent.map(r => (
          <div class="flex items-center justify-between rounded-2xl px-4 py-3" style="background: var(--color-gray-soft);">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-9 h-9 rounded-xl grid place-items-center font-display font-bold flex-none"
                   style="background: var(--color-white); color: var(--color-navy);">{(r.full_name ?? '?')[0]}</div>
              <div class="min-w-0">
                <p class="text-sm font-semibold truncate" style="color: var(--color-navy);">{r.full_name}</p>
                <p class="text-[11px] truncate" style="color: rgba(27,43,58,0.5);">{r.trip_name}</p>
              </div>
            </div>
            <div class="text-right flex-none pl-3">
              <p class="text-sm font-semibold" style="color: var(--color-navy);">₹{r.amount_paid ?? 0}</p>
              <span class="inline-block text-[9px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full mt-0.5"
                    style={statusStyle(r.status)}>{r.status}</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
