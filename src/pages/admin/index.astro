---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listTrips, resolveBooking } from '../../lib/content';
import { getDb } from '../../lib/db';
import { editableBooking } from '../../lib/tripEditor';
import {
  buildBookingGrowthWeek,
  departureDateKey,
  financialYearStartForDate,
  indianFinancialYear,
  indianFinancialYearFromStart,
  isDateInIndianFinancialYear,
} from '../../lib/adminDashboard';
import { regStatusStyle } from '../../lib/registrationStatus';
export const prerender = false;

const db = getDb();

const regsAll = db.prepare(`
  SELECT id, status, amount_paid, created_at, status_changed_at, trip_name, trip_slug,
         trip_date, batch_id, full_name,
         date(COALESCE(status_changed_at, created_at), '+5 hours', '+30 minutes') AS booking_day
  FROM registrations
`).all() as Array<Record<string, any>>;
const trips = listTrips();
const departureDates = new Map<string, string>();
for (const trip of trips) {
  const { editorDepartures } = editableBooking(trip);
  for (const departure of editorDepartures) {
    if (!departure.id || !departure.startDate) continue;
    departureDates.set(String(departure.id), String(departure.startDate));
    departureDates.set(`${trip.slug}:${departure.id}`, String(departure.startDate));
  }
}

const registrationDepartureDate = (registration: Record<string, any>) =>
  departureDates.get(`${registration.trip_slug}:${registration.batch_id}`)
  ?? departureDates.get(String(registration.batch_id || ''))
  ?? departureDateKey(registration.trip_date);

const currentFy = indianFinancialYear();
const availableFyStarts = new Set<number>([currentFy.startYear]);
for (const date of departureDates.values()) {
  const year = financialYearStartForDate(date);
  if (year !== null) availableFyStarts.add(year);
}
for (const registration of regsAll) {
  const year = financialYearStartForDate(registrationDepartureDate(registration));
  if (year !== null) availableFyStarts.add(year);
}
const fyOptions = [...availableFyStarts].sort((a, b) => b - a).map(indianFinancialYearFromStart);
const requestedFy = Number(Astro.url.searchParams.get('fy') ?? Astro.cookies.get('admin-dashboard-fy')?.value);
const selectedFy = fyOptions.find((fy) => fy.startYear === requestedFy) ?? currentFy;
const inSelectedFy = (date: unknown) => isDateInIndianFinancialYear(date, selectedFy.startYear);

const regs = regsAll.filter((registration) => inSelectedFy(registrationDepartureDate(registration)));
const confirmedRegs = regs.filter(r => r.status === 'confirmed');
const totalBookings = confirmedRegs.length;
const pendingCount = regs.filter(r => r.status === 'pending').length;
// Match the registrations page definition: payments collected = all non-rejected,
// non-cancelled (cancelled is excluded from revenue from the moment of cancellation).
const paidRegs = regs.filter(r => r.status !== 'rejected' && r.status !== 'cancelled');
const revenue = paidRegs.reduce((sum, r) => sum + Number(r.amount_paid ?? 0), 0);
const revenueTripCount = new Set(paidRegs.map(r => r.trip_name).filter(Boolean)).size;

const recent = [...regs].sort((a, b) => Number(b.id) - Number(a.id)).slice(0, 5);

const weekCounts = new Map<string, number>();
for (const registration of confirmedRegs) {
  const key = String(registration.booking_day || '');
  if (key) weekCounts.set(key, (weekCounts.get(key) ?? 0) + 1);
}
const week = buildBookingGrowthWeek([...weekCounts].map(([d, c]) => ({ d, c })));
const maxCount = Math.max(1, ...week.map(d => d.count));

// Trip-level status removed — derive these from departures. "Active" counts every
// individual departure date that's upcoming and not sold out, not parent trips —
// one trip with 3 open departures counts as 3.
const allDepartures = trips.flatMap(t => resolveBooking(t).departures).filter(d => inSelectedFy(d.startDate));
const activeTrips = allDepartures.filter(d => !d.soldOut).length;
const soldOut = trips.filter(t => {
  const departures = resolveBooking(t).departures.filter(d => inSelectedFy(d.startDate));
  return departures.length > 0 && departures.every(d => d.soldOut);
});

function inr(n: number) {
  if (n >= 100000) return `₹${(n / 100000).toFixed(1)}L`;
  if (n >= 1000) return `₹${(n / 1000).toFixed(1)}k`;
  return `₹${n}`;
}
// Was a local copy of REG_STATUS_COLORS that had drifted: it knew about four
// statuses, so a lead or a wishlist row on the dashboard rendered with the
// pending amber. `regStatusStyle` keeps the same pending fallback.
const statusStyle = regStatusStyle;

const kpis = [
  { label: 'Payments collected', value: inr(revenue), hint: `${totalBookings} confirmed seat${totalBookings === 1 ? '' : 's'} · ${revenueTripCount} ${revenueTripCount === 1 ? 'trip' : 'trips'}` },
  { label: 'Total bookings', value: String(totalBookings), hint: `${pendingCount} pending signup${pendingCount === 1 ? '' : 's'}` },
  { label: 'Pending review', value: String(pendingCount), hint: 'Awaiting confirmation' },
  { label: 'Active trips', value: String(activeTrips), hint: `${allDepartures.length} departures · ${trips.length} trips` },
];

const quickActions = [
  { href: '/admin/trips/new/',       label: 'New Trip' },
  { href: '/admin/photo-vault/new/', label: 'Add Media' },
  { href: '/admin/broadcast/',       label: 'Broadcast' },
  { href: '/admin/settings/',        label: 'Settings' },
];
---

<AdminLayout title="Dashboard" page="dashboard">
  <div class="flex items-center justify-between gap-4 mb-5">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-widest text-gray-text">Dashboard period</p>
      <p class="text-sm text-gray-text mt-0.5">Trips departing Apr {selectedFy.startYear} \u2013 Mar {selectedFy.startYear + 1}</p>
    </div>
    <form method="get" class="flex-none">
      <label for="dashboard-fy" class="sr-only">Financial year</label>
      <select id="dashboard-fy" name="fy" data-dashboard-fy
        class="rounded-xl border border-peach bg-white px-4 py-2.5 text-sm font-semibold text-navy shadow-sm">
        {fyOptions.map(fy => <option value={fy.startYear} selected={fy.startYear === selectedFy.startYear}>{fy.label}</option>)}
      </select>
    </form>
  </div>

  <!-- KPI cards -->
  <div class="grid gap-4 grid-cols-2 lg:grid-cols-4 mb-6">
    {kpis.map(k => (
      <div class="bg-white rounded-[2rem] p-5 border border-peach/60">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-gray-text">{k.label}</p>
        <p class="font-display text-3xl font-semibold mt-2 text-navy">{k.value}</p>
        <p class="text-xs mt-1 text-gray-text">{k.hint}</p>
      </div>
    ))}
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    <!-- Booking growth -->
    <div class="md:col-span-2 bg-white rounded-[2rem] p-6 border border-peach/60">
      <h2 class="font-display text-lg font-semibold mb-1 text-navy">Booking growth</h2>
      <p class="text-sm mb-5 text-gray-text">Confirmed seats over the last 7 days.</p>
      <div class="flex items-end gap-3 h-36">
        {week.map(d => (
          <div class="flex-1 flex flex-col items-center gap-2 min-w-0">
            <span class="text-[10px] font-semibold tabular-nums text-gray-text">{d.count}</span>
            <div class="w-full flex items-end justify-center h-[100px]">
              <div
                class="w-full rounded-t-lg transition-all"
                style={`height: ${d.count === 0 ? 2 : Math.max(8, (d.count / maxCount) * 100)}%; background: ${d.count === 0 ? 'rgba(27,43,58,0.12)' : 'rgba(232,114,90,0.8)'};`}
                title={`${d.count} confirmed seat${d.count === 1 ? '' : 's'} on ${d.key}`}
              ></div>
            </div>
            <span class="text-[10px] text-gray-text">{d.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick actions -->
    <div class="bg-white rounded-[2rem] p-6 border border-peach/60">
      <h2 class="font-display text-lg font-semibold mb-4 text-navy">Quick actions</h2>
      <div class="flex flex-col gap-2.5">
        {quickActions.map(a => (
          <a href={a.href}
             class="flex items-center justify-between px-4 py-3 rounded-2xl text-sm font-medium transition-colors bg-gray-soft text-navy"
            >
            {a.label}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Alerts -->
  {(soldOut.length > 0 || pendingCount > 0) && (
    <div class="grid gap-3 sm:grid-cols-2 mt-6">
      {pendingCount > 0 && (
        <a href="/admin/registrations/" class="rounded-2xl px-5 py-4 flex items-center justify-between bg-[#F59E0B]/10"
          >
          <div>
            <p class="text-sm font-semibold text-warning-ink">{pendingCount} registration{pendingCount > 1 ? 's' : ''} pending</p>
            <p class="text-xs mt-0.5 text-warning-ink/70">Review and confirm or reject</p>
          </div>
          <svg class="w-5 h-5 text-warning-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      )}
      {soldOut.map(t => (
        <a href={`/admin/trips/${t.slug}/`} class="rounded-2xl px-5 py-4 flex items-center justify-between bg-danger/8"
          >
          <div>
            <p class="text-sm font-semibold text-danger-ink">{t.name} is sold out</p>
            <p class="text-xs mt-0.5 text-danger-ink/70">Consider opening a new batch</p>
          </div>
          <svg class="w-5 h-5 text-danger-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      ))}
    </div>
  )}

  <!-- Recent activity -->
  <div class="bg-white rounded-[2rem] p-6 mt-6 border border-peach/60">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-display text-lg font-semibold text-navy">Recent activity</h2>
      <a href="/admin/registrations/" class="text-sm font-medium text-coral-ink">View all</a>
    </div>
    {recent.length === 0 ? (
      <p class="text-sm text-gray-text">No registrations in {selectedFy.label}.</p>
    ) : (
      <div class="flex flex-col gap-2.5">
        {recent.map(r => (
          <div class="flex items-center justify-between rounded-2xl px-4 py-3 bg-gray-soft">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-9 h-9 rounded-xl grid place-items-center font-display font-bold flex-none bg-white text-navy"
                  >{(r.full_name ?? '?')[0]}</div>
              <div class="min-w-0">
                <p class="text-sm font-semibold truncate text-navy">{r.full_name}</p>
                <p class="text-[11px] truncate text-gray-text">{r.trip_name}</p>
              </div>
            </div>
            <div class="text-right flex-none pl-3">
              <p class="text-sm font-semibold text-navy">₹{r.amount_paid ?? 0}</p>
              <span class="inline-block text-[9px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full mt-0.5"
                    style={statusStyle(r.status)}>{r.status}</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</AdminLayout>

<script>
  const selector = document.querySelector<HTMLSelectElement>('[data-dashboard-fy]');
  selector?.addEventListener('change', () => {
    document.cookie = `admin-dashboard-fy=${encodeURIComponent(selector.value)}; Path=/admin; Max-Age=34560000; SameSite=Lax`;
    selector.form?.requestSubmit();
  });
</script>
