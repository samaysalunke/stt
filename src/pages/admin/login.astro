---
import '../../styles/global.css';
export const prerender = false;

const hasError = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — Seek the Thrill</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen flex items-center justify-center px-5"
        style="background-color: var(--color-blush); font-family: var(--font-sans);">
    <div class="w-full" style="max-width: 400px;">
      <div class="bg-white rounded-[2.5rem] px-8 py-10 shadow-sm"
           style="border: 1px solid rgba(245,221,215,0.6);">
        <!-- Brand -->
        <div class="text-center mb-7">
          <div class="w-14 h-14 mx-auto mb-4 rounded-2xl grid place-items-center"
               style="background: rgba(232,114,90,0.12);">
            <svg class="w-7 h-7" style="color: var(--color-coral);" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" />
            </svg>
          </div>
          <span class="text-[10px] font-semibold uppercase tracking-widest" style="color: var(--color-coral);">Admin Portal</span>
          <h1 class="font-display text-2xl font-semibold mt-1" style="color: var(--color-navy);">Welcome back, Zahra</h1>
          <p class="text-sm mt-1" style="color: rgba(27,43,58,0.5);">Sign in to manage Seek the Thrill</p>
        </div>

        {hasError && (
          <div class="rounded-2xl px-4 py-3 mb-5 text-sm"
               style="background: #FEF2F2; border: 1px solid #FECACA; color: #DC2626;">
            Incorrect password. Please try again.
          </div>
        )}

        <form method="POST" action="/api/admin/login">
          <label class="block text-xs font-semibold uppercase tracking-widest mb-1.5"
                 style="color: var(--color-navy);">Password</label>
          <input
            type="password"
            name="password"
            required
            autofocus
            placeholder="Enter admin password"
            class="w-full rounded-2xl px-4 py-3 text-sm outline-none mb-5"
            style="border: 1px solid rgba(245,221,215,0.8); background: var(--color-white);"
          />
          <button
            type="submit"
            class="w-full rounded-full py-3.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
            style="background-color: var(--color-cta);"
          >
            Enter Dashboard
          </button>
        </form>

        <div class="flex items-center justify-center gap-2 mt-6">
          <span class="w-2 h-2 rounded-full" style="background: var(--color-success);"></span>
          <span class="text-xs" style="color: rgba(27,43,58,0.5);">Secure connection verified</span>
        </div>
      </div>

      <p class="text-center mt-5">
        <a href="/" class="text-sm" style="color: rgba(27,43,58,0.5); text-decoration: none;">← Back to website</a>
      </p>
    </div>
  </body>
</html>
