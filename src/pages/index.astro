---
import BaseLayout from '../layouts/BaseLayout.astro';
import TripCard from '../components/TripCard.astro';
import { CAROUSEL_SIZES } from '../lib/imageVariants';
import TestimonialCard from '../components/TestimonialCard.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Stat from '../components/ui/Stat.astro';
import Icon from '../components/ui/Icon.astro';
import { cardLiveSpots } from '../lib/departureCounts';
import { listTrips, listTestimonials, selectFeaturedTestimonials, readSiteSettings, isTripListable, tripCardSummary, sortTripsByPriority, contentSeededRandom } from '../lib/content';
import { formatDateIN, formatINR } from '../lib/utils';
import {
  getUserTrips, upcomingTrips, unfinishedBooking, tripPrimaryAction, tripStates,
  savedTripSlugs, userTravelStats, isNewsletterSubscriber,
} from '../lib/userTrips';

const allTrips = listTrips();
// Visibility derives from departures: feature every trip that has an upcoming,
// not-fully-sold-out departure (trip-level status was removed). No cap — the
// section scrolls horizontally when there are more than fit on screen.
// Seeded shuffle: the order is stable until the content changes, so every edge
// PoP caches the same order instead of one per revalidation.
const featuredTrips = sortTripsByPriority(
  allTrips.filter((t) => isTripListable(t) && !tripCardSummary(t).soldOut),
  contentSeededRandom(),
);
const showCarouselArrows = featuredTrips.length > 3;
const liveSpots = cardLiveSpots(featuredTrips.map((t) => ({ slug: t.slug, ...tripCardSummary(t) })));

const featuredTestimonials = selectFeaturedTestimonials(listTestimonials());

let settings: any = {};
try { settings = readSiteSettings(); } catch (e) {}

const whatsapp = settings.whatsappLink ?? 'https://wa.me/917975027491';

// ── Signed-in personalisation ──────────────────────────────────────────────
// Only ever rendered for a request carrying a session: those are `private,
// no-cache` and bypass the edge (middleware.ts), so the shared cached homepage
// that logged-out visitors get is untouched.
const user = Astro.locals.user;
const firstName = user ? (user.displayName?.trim().split(/\s+/)[0] || null) : null;
const myTrips = user ? getUserTrips(Astro.locals) : [];
const upcoming = upcomingTrips(myTrips);
// When a seat is held on more than one trip, the one owing money leads.
const heroTrip = upcoming.find((r) => tripPrimaryAction(r)?.kind === 'pay') ?? upcoming[0] ?? null;
const heroLead = heroTrip ? null : unfinishedBooking(myTrips);
const myStats = user && !heroTrip && !heroLead ? userTravelStats(user.id) : null;
type HeroVariant = 'trip' | 'lead' | 'returning' | 'new';
const heroVariant: HeroVariant | null = !user ? null
  : heroTrip ? 'trip' : heroLead ? 'lead' : myStats ? 'returning' : 'new';
const heroAction = heroTrip ? tripPrimaryAction(heroTrip) : null;
const heroTripHref = heroTrip?.tripExists && heroTrip.tripSlug ? `/trips/${heroTrip.tripSlug}/` : '/profile?tab=trips';
const heroBalance = heroAction?.kind === 'pay' ? heroTrip!.details : null;
const otherUpcoming = Math.max(0, upcoming.length - 1);

const savedSlugs = user ? savedTripSlugs(user.id) : [];
const savedSet = new Set(savedSlugs);
const userStates = user ? tripStates(myTrips, savedSlugs) : new Map();
// Saved trips still on sale, bookable ones first, in the order they were saved.
const savedTrips = savedSlugs
  .map((slug) => allTrips.find((t) => t.slug === slug))
  .filter((t): t is (typeof allTrips)[number] => Boolean(t && isTripListable(t)))
  .sort((a, b) => Number(tripCardSummary(a).soldOut || tripCardSummary(a).allComingSoon) - Number(tripCardSummary(b).soldOut || tripCardSummary(b).allComingSoon));
const savedLiveSpots = savedTrips.length ? cardLiveSpots(savedTrips.map((t) => ({ slug: t.slug, ...tripCardSummary(t) }))) : new Map();
const subscribed = isNewsletterSubscriber(Astro.locals);
---

<BaseLayout
  title="Seek the Thrill — Offbeat Group Trips Across India"
  description="Offbeat group trips for people who want to feel alive again. Small groups. Curated routes. Come for the adventure, stay for the people."
  nav="scroll"
>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section
    id="homepage-hero"
    class="relative min-h-screen flex flex-col items-center justify-start sm:justify-center overflow-hidden"
  >
    <img
      src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1280&auto=format&fit=crop&q=80"
      srcset="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=640&auto=format&fit=crop&q=80 640w, https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=960&auto=format&fit=crop&q=80 960w, https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1280&auto=format&fit=crop&q=80 1280w, https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&auto=format&fit=crop&q=80 1920w"
      sizes="100vw"
      alt="Mountain landscape on an offbeat group trip in India"
      width="1920" height="1280"
      fetchpriority="high" decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="u-overlay-scrim-hero absolute inset-0"></div>

    <div class="relative z-10 w-full max-w-sm sm:max-w-xl lg:max-w-2xl mx-auto px-6 pt-8 sm:pt-0 flex flex-col items-center text-center">

      <!-- Brand mark -->
      <img src="/logo-192.webp" alt="Seek the Thrill" width="96" height="96" class="anim-fade-up w-16 h-16 mb-3 sm:w-20 sm:h-20 sm:mb-4 lg:w-24 lg:h-24 rounded-2xl object-cover shadow-xl" />
      <p class="anim-fade-up font-display text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-white">Seek the Thrill</p>
      <p class="anim-fade-up font-display italic text-sm text-white/70 mb-5 sm:mb-10">by Zahra Shakir</p>

      <!-- Headline -->
      <h1 class="anim-rise anim-delay-1 font-display font-bold text-display-xl mb-3 sm:mb-4 text-left w-full text-white">
        Offbeat group trips<br />
        <span class="italic text-coral">away from the crowds.</span>
      </h1>

      <!-- Subtext -->
      <p class="anim-fade-up anim-delay-2 text-base lg:text-lg text-white/75 text-left w-full mb-4 sm:mb-7 leading-relaxed">
        Group trips for travellers. Offbeat spots, zero fluff.
      </p>

      {heroVariant && heroVariant !== 'new' ? (
        <div
          data-testid="hero-personal"
          data-variant={heroVariant}
          class="anim-fade-up anim-delay-2 w-full rounded-2xl p-4 mb-4 sm:p-5 sm:mb-6 text-left bg-[rgba(15,20,35,0.7)] backdrop-blur-md"
        >
          <p class="text-sm text-white/75">Welcome back{firstName && <>, <strong class="font-semibold text-white">{firstName}</strong></>}</p>

          {heroVariant === 'trip' && heroTrip && (
            <>
              <a href={heroTripHref} class="mt-3 flex items-center gap-3 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                {heroTrip.coverImage && (
                  <img src={heroTrip.coverImage} alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 shrink-0 rounded-xl object-cover" />
                )}
                <span class="min-w-0">
                  <span class="block truncate font-display text-lg font-semibold text-white">{heroTrip.tripName}</span>
                  <span class="block text-sm text-white/75">
                    {heroTrip.dateLabel}
                    {heroTrip.timingLabel && <> · <span data-testid="hero-timing" class="font-semibold text-peach">{heroTrip.timingLabel}</span></>}
                  </span>
                </span>
              </a>
              {heroTrip.status === 'pending' && (
                <p class="mt-3 text-sm text-white/80">We've got your booking and are confirming your seat.</p>
              )}
              {heroBalance && heroBalance.balance != null && (
                <p data-testid="hero-balance" class="mt-3 text-sm text-white/85">
                  Balance <strong class="text-white">{formatINR(heroBalance.balance)}</strong>
                  {heroBalance.balanceDueDate && (heroBalance.daysOverdue != null && heroBalance.daysOverdue > 0
                    ? <span class="font-semibold text-peach"> · overdue since {formatDateIN(heroBalance.balanceDueDate)}</span>
                    : <> · due {formatDateIN(heroBalance.balanceDueDate)}</>)}
                </p>
              )}
              <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
                <Button href={heroAction?.href ?? heroTripHref} variant="cta" size="md" class="w-full sm:w-auto">
                  {heroAction?.kind === 'pay' && heroBalance?.balance != null ? `Pay ${formatINR(heroBalance.balance)}` : heroAction?.label ?? 'View trip'}
                </Button>
                <a href="/profile?tab=trips" class="text-center text-sm font-semibold text-white underline-offset-4 hover:underline">
                  My trips{otherUpcoming > 0 && ` · +${otherUpcoming} more upcoming`}
                </a>
              </div>
            </>
          )}

          {heroVariant === 'lead' && heroLead && (
            <>
              <p class="mt-2 font-display text-lg font-semibold text-white">You were booking {heroLead.tripName}</p>
              <p class="text-sm text-white/75">{heroLead.dateLabel} · your details are saved</p>
              <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
                <Button href={tripPrimaryAction(heroLead)?.href ?? '/trips/'} variant="cta" size="md" class="w-full sm:w-auto">Continue booking</Button>
                <a href="/trips/" class="text-center text-sm font-semibold text-white underline-offset-4 hover:underline">Browse other trips</a>
              </div>
            </>
          )}

          {heroVariant === 'returning' && myStats && (
            <>
              <p class="mt-2 font-display text-lg font-semibold text-white">Where to next?</p>
              <a href="/leaderboard" data-testid="hero-stats" class="mt-1 inline-block text-sm text-white/80 underline-offset-4 hover:underline">
                {Math.round(myStats.kmsFromHome).toLocaleString('en-IN')} km travelled · {myStats.tripsCount} {myStats.tripsCount === 1 ? 'trip' : 'trips'}{myStats.rank != null && ` · #${myStats.rank} on the leaderboard`}
              </a>
              <div class="mt-4">
                <Button href="/trips/" variant="cta" size="md" class="w-full sm:w-auto"><Icon name="users" /> Find your next trip</Button>
              </div>
            </>
          )}
        </div>
      ) : (
        <>
          {heroVariant === 'new' && (
            <p data-testid="hero-personal" data-variant="new" class="anim-fade-up anim-delay-2 w-full text-left text-sm text-white/80 mb-3">
              Hi{firstName && <> <strong class="font-semibold text-white">{firstName}</strong></>}, tap the ♡ on any trip to save it for later.
            </p>
          )}
        <!-- Stats card -->
        <div class="anim-fade-up anim-delay-2 w-full rounded-2xl p-3 mb-4 sm:p-4 sm:mb-5 grid grid-cols-2 bg-[rgba(15,20,35,0.65)] backdrop-blur-md">
          <Stat value="12–16" label="Group Size" tone="light" class="py-1" />
          <Stat value="10+" label="Destinations" tone="light" class="py-1 border-l border-white/10" />
        </div>

        <!-- CTA -->
        <Button
          href="/trips/"
          variant="cta"
          size="lg"
          class="anim-fade-up anim-delay-3 w-full sm:w-auto mb-4 sm:mb-6"
        >
          <Icon name="users" /> Join a Trip
        </Button>

        <!-- Social proof -->
        <p class="anim-fade-up anim-delay-4 text-sm text-white/70">Joined by <span class="text-white font-semibold">340+</span> adventurers</p>
        </>
      )}

    </div>
  </section>

  {savedTrips.length > 0 && (
    <section data-testid="saved-trips" aria-labelledby="saved-trips-heading" class="pt-14 lg:pt-16 bg-gray-soft">
      <div class="container-app">
        <div class="mb-6 flex items-end justify-between gap-6">
          <h2 id="saved-trips-heading" class="font-display text-2xl text-navy">Your saved trips</h2>
          <a href="/profile?tab=trips" class="inline-flex items-center gap-1 text-sm font-medium text-coral-ink hover:underline">Manage <Icon name="arrow-right" class="h-4 w-4" /></a>
        </div>
        <div class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {savedTrips.map((trip) => {
            const card = tripCardSummary(trip);
            return (
              <div class="flex w-[86%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]">
                <TripCard
                  sizes={CAROUSEL_SIZES}
                  slug={trip.slug}
                  title={trip.title}
                  name={trip.name}
                  coverImage={trip.coverImage}
                  featuredImage={trip.featuredImage}
                  description={trip.description}
                  shortDescription={trip.shortDescription}
                  location={trip.location}
                  duration={trip.duration}
                  fromPrice={card.fromPrice}
                  originalFromPrice={card.originalFromPrice}
                  discountEndsAt={card.discountEndsAt}
                  multiPrice={card.multiPrice}
                  spotsLeft={savedLiveSpots.get(trip.slug) ?? null}
                  soldOut={card.soldOut}
                  hasComingSoon={card.hasComingSoon}
                  allComingSoon={card.allComingSoon}
                  departures={card.departures}
                  userState={userStates.get(trip.slug) ?? null}
                  saved={true}
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ── UPCOMING TRIPS ────────────────────────────────────── -->
  <section class="py-16 lg:py-20 bg-gray-soft">
    <div class="container-app">
      <h2 class="font-display font-bold text-display-xl text-navy">
        {/* On --color-gray-soft, coral is 2.75:1 — under even the 3:1 large-text
            bound, which the "display size can stay text-coral" rule assumed held
            everywhere. coral-ink is 4.62:1 on this surface. */}
        Where to, <span class="italic text-coral-ink">wanderer?</span>
      </h2>
      <div class="mt-10 mb-8 flex items-end justify-between gap-6">
        <h3 class="font-display text-2xl text-navy">Featured Trips</h3>
        <div class="flex items-center gap-3">
          {showCarouselArrows && (
            <div class="hidden gap-2 lg:flex">
              <button id="featured-prev" type="button" aria-label="Previous trips" class="grid h-9 w-9 place-items-center rounded-full border border-peach text-navy transition-opacity disabled:opacity-30">
                <Icon name="chevron-right" class="h-4 w-4 rotate-180" />
              </button>
              <button id="featured-next" type="button" aria-label="More trips" class="grid h-9 w-9 place-items-center rounded-full border border-peach text-navy transition-opacity disabled:opacity-30">
                <Icon name="chevron-right" class="h-4 w-4" />
              </button>
            </div>
          )}
          <a href="/trips/" class="inline-flex items-center gap-1 text-sm font-medium text-coral-ink hover:underline">See All <Icon name="arrow-right" class="h-4 w-4" /></a>
        </div>
      </div>

      {featuredTrips.length > 0 ? (
        <div
          id="featured-carousel"
          tabindex="0"
          aria-label="Featured trips"
          class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-4 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {featuredTrips.map((trip) => {
            const card = tripCardSummary(trip);
            return (
              <div class="flex w-[86%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]">
                <TripCard
                  sizes={CAROUSEL_SIZES}
                  slug={trip.slug}
                  title={trip.title}
                  name={trip.name}
                  coverImage={trip.coverImage}
                  featuredImage={trip.featuredImage}
                  description={trip.description}
                  shortDescription={trip.shortDescription}
                  location={trip.location}
                  duration={trip.duration}
                  fromPrice={card.fromPrice}
                  originalFromPrice={card.originalFromPrice}
                  discountEndsAt={card.discountEndsAt}
                  multiPrice={card.multiPrice}
                  spotsLeft={liveSpots.get(trip.slug) ?? null}
                  soldOut={card.soldOut}
                  hasComingSoon={card.hasComingSoon}
                  allComingSoon={card.allComingSoon}
                  departures={card.departures}
                  userState={userStates.get(trip.slug) ?? null}
                  saved={savedSet.has(trip.slug)}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <p class="text-center py-12 text-gray-text">More trips coming soon. Stay tuned.</p>
      )}
    </div>
  </section>

  <script>
    // Featured-trips carousel: arrow + keyboard scrolling over the CSS scroll-snap
    // row. Native touch/trackpad swipe already works; this adds desktop affordances.
    const row = document.getElementById('featured-carousel');
    const prev = document.getElementById('featured-prev') as HTMLButtonElement | null;
    const next = document.getElementById('featured-next') as HTMLButtonElement | null;
    if (row) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const step = () => row.querySelector<HTMLElement>(':scope > div')?.offsetWidth ?? row.clientWidth * 0.8;
      const go = (dir: number) => row.scrollBy({ left: dir * (step() + 24), behavior: reduce ? 'auto' : 'smooth' });
      const sync = () => {
        const max = row.scrollWidth - row.clientWidth - 1;
        if (prev) prev.disabled = row.scrollLeft <= 0;
        if (next) next.disabled = row.scrollLeft >= max;
      };
      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));
      row.addEventListener('scroll', sync, { passive: true });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      });
      sync();
    }
  </script>

  <!-- ── HOW IT WORKS ──────────────────────────────────────── -->
  <Section as="section" tone="navy" space="md">
    <h2 class="font-display font-bold text-display-md text-white mb-14">
      How it works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {[
        { num: '01', title: 'Pick a trip', desc: 'Browse upcoming destinations, find one that pulls you.' },
        { num: '02', title: 'Save your spot', desc: 'Pay a small advance. The rest follows later.' },
        { num: '03', title: 'Show up', desc: 'We handle the details. You handle the experience.' },
      ].map((step) => (
        <div class="reveal pt-6 border-t border-white/15">
          <div class="font-display text-6xl font-bold mb-4 text-peach/70">{step.num}</div>
          <h3 class="font-display text-xl font-bold text-white mb-3">{step.title}</h3>
          <p class="text-white/65 text-sm leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ── COMMUNITY ─────────────────────────────────────────── -->
  {featuredTestimonials.length > 0 && (
    <Section
      tone="blush"
      title="Who comes on these trips"
      intro="Solo travelers. Friend groups. People who said yes on a whim. Nobody's left out."
    >
      <div class="flex items-start gap-5 overflow-x-auto overflow-y-hidden snap-x snap-mandatory pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4">
        {featuredTestimonials.map((t, index) => (
          <TestimonialCard testimonial={t} cardId={`home-${t.slug ?? index}`} surface="white" />
        ))}
      </div>
    </Section>
  )}

  <!-- ── NEWSLETTER ─────────────────────────────────────────── -->
  <section
    class="py-16 lg:py-20 relative bg-cover bg-center"
    style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1000&auto=format&fit=crop&q=70');"
  >
    <div class="u-overlay-scrim-flat absolute inset-0"></div>
    <div class="container-app relative">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="font-display font-bold text-display-md mb-3 text-white">
          Be first to know
        </h2>
        <p class="text-base mb-8 leading-relaxed text-white/75">
          New trips, new batches, things worth knowing. No spam.
        </p>
        {subscribed ? (
          <p data-testid="home-nl-subscribed" class="text-base font-medium text-white">You're on the list. We'll email {user!.email} when something good is coming.</p>
        ) : (
          <>
            <form id="home-newsletter" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
              <label for="home-newsletter-email" class="sr-only">Your email address</label>
              <input
                id="home-newsletter-email"
                type="email"
                name="email"
                placeholder="Your email address"
                value={user?.email}
                required
                class="flex-1 px-5 py-3.5 rounded-full text-sm border-2 border-white/25 bg-white/10 outline-none text-white placeholder:text-white/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              />
              <button
                type="submit"
                class="px-7 py-3.5 rounded-full text-sm font-semibold text-white bg-cta transition-all hover:-translate-y-0.5 hover:brightness-105 flex-shrink-0"
              >
                Keep me posted
              </button>
            </form>
            <p id="home-nl-success" class="hidden text-base mt-6 font-medium text-white">
              You're in. We'll be in touch when something good is coming.
            </p>
          </>
        )}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const hero = document.getElementById('homepage-hero');
  const header = document.getElementById('site-header');
  if (hero && header) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('header-visible', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);
  }
</script>

<script>
  document.getElementById('home-newsletter')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')?.value ?? '';
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'homepage' }),
      });
      const data = await res.json();
      if (data.success) {
        form.style.display = 'none';
        document.getElementById('home-nl-success')?.classList.remove('hidden');
      }
    } catch {}
  });
</script>
