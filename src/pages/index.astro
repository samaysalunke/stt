---
import BaseLayout from '../layouts/BaseLayout.astro';
import TripCard from '../components/TripCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import Stat from '../components/ui/Stat.astro';
import Icon from '../components/ui/Icon.astro';
import { listTrips, listTestimonials, selectFeaturedTestimonials, readSiteSettings, isTripListable, tripCardSummary, sortTripsByPriority, contentSeededRandom } from '../lib/content';

const allTrips = listTrips();
// Visibility derives from departures: feature every trip that has an upcoming,
// not-fully-sold-out departure (trip-level status was removed). No cap — the
// section scrolls horizontally when there are more than fit on screen.
// Seeded shuffle: the order is stable until the content changes, so every edge
// PoP caches the same order instead of one per revalidation.
const featuredTrips = sortTripsByPriority(
  allTrips.filter((t) => isTripListable(t) && !tripCardSummary(t).soldOut),
  contentSeededRandom(),
);
const showCarouselArrows = featuredTrips.length > 3;

const featuredTestimonials = selectFeaturedTestimonials(listTestimonials());

let settings: any = {};
try { settings = readSiteSettings(); } catch (e) {}

const whatsapp = settings.whatsappLink ?? 'https://wa.me/917975027491';
---

<BaseLayout
  title="Seek the Thrill — Offbeat Group Trips Across India"
  description="Offbeat group trips for people who want to feel alive again. Small groups. Curated routes. Come for the adventure, stay for the people."
  nav="scroll"
>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section
    id="homepage-hero"
    class="relative min-h-screen flex flex-col items-center justify-start sm:justify-center overflow-hidden"
  >
    <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&auto=format&fit=crop&q=80" alt="Mountain landscape on an offbeat group trip in India" width="1920" height="1080" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div class="u-overlay-scrim absolute inset-0"></div>

    <div class="relative z-10 w-full max-w-sm sm:max-w-xl lg:max-w-2xl mx-auto px-6 pt-8 sm:pt-0 flex flex-col items-center text-center">

      <!-- Brand mark -->
      <img src="/logo.jpg" alt="Seek the Thrill" width="96" height="96" class="anim-fade-up w-16 h-16 mb-3 sm:w-20 sm:h-20 sm:mb-4 lg:w-24 lg:h-24 rounded-2xl object-cover shadow-xl" />
      <p class="anim-fade-up font-display text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-white">Seek the Thrill</p>
      <p class="anim-fade-up font-display italic text-sm text-white/70 mb-5 sm:mb-10">by Zahra Shakir</p>

      <!-- Headline -->
      <h1 class="anim-fade-up anim-delay-1 font-display font-bold text-display-xl mb-3 sm:mb-4 text-left w-full text-white">
        Offbeat group trips<br />
        <span class="italic text-coral">away from the crowds.</span>
      </h1>

      <!-- Subtext -->
      <p class="anim-fade-up anim-delay-2 text-base lg:text-lg text-white/75 text-left w-full mb-4 sm:mb-7 leading-relaxed">
        Group trips for travellers. Offbeat spots, zero fluff.
      </p>

      <!-- Stats card -->
      <div class="anim-fade-up anim-delay-2 w-full rounded-2xl p-3 mb-4 sm:p-4 sm:mb-5 grid grid-cols-2 bg-[rgba(15,20,35,0.65)] backdrop-blur-md">
        <Stat value="12–16" label="Group Size" tone="light" class="py-1" />
        <Stat value="10+" label="Destinations" tone="light" class="py-1 border-l border-white/10" />
      </div>

      <!-- CTA -->
      <Button
        href="/trips/"
        variant="cta"
        size="lg"
        class="anim-fade-up anim-delay-3 w-full sm:w-auto mb-4 sm:mb-6"
      >
        <Icon name="users" /> Join a Trip
      </Button>

      <!-- Social proof -->
      <p class="anim-fade-up anim-delay-4 text-sm text-white/70">Joined by <span class="text-white font-semibold">340+</span> adventurers</p>

    </div>
  </section>

  <!-- ── UPCOMING TRIPS ────────────────────────────────────── -->
  <section class="py-16 lg:py-20 bg-gray-soft">
    <div class="container-app">
      <h2 class="font-display font-bold text-display-xl text-navy">
        Where to, <span class="italic text-coral">wanderer?</span>
      </h2>
      <div class="mt-10 mb-8 flex items-end justify-between gap-6">
        <h3 class="font-display text-2xl text-navy">Featured Trips</h3>
        <div class="flex items-center gap-3">
          {showCarouselArrows && (
            <div class="hidden gap-2 lg:flex">
              <button id="featured-prev" type="button" aria-label="Previous trips" class="grid h-9 w-9 place-items-center rounded-full border border-peach text-navy transition-opacity disabled:opacity-30">
                <Icon name="chevron-right" class="h-4 w-4 rotate-180" />
              </button>
              <button id="featured-next" type="button" aria-label="More trips" class="grid h-9 w-9 place-items-center rounded-full border border-peach text-navy transition-opacity disabled:opacity-30">
                <Icon name="chevron-right" class="h-4 w-4" />
              </button>
            </div>
          )}
          <a href="/trips/" class="inline-flex items-center gap-1 text-sm font-medium text-coral-ink hover:underline">See All <Icon name="arrow-right" class="h-4 w-4" /></a>
        </div>
      </div>

      {featuredTrips.length > 0 ? (
        <div
          id="featured-carousel"
          tabindex="0"
          aria-label="Featured trips"
          class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-4 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {featuredTrips.map((trip) => {
            const card = tripCardSummary(trip);
            return (
              <div class="flex w-[86%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]">
                <TripCard
                  slug={trip.slug}
                  title={trip.title}
                  name={trip.name}
                  coverImage={trip.coverImage}
                  featuredImage={trip.featuredImage}
                  description={trip.description}
                  shortDescription={trip.shortDescription}
                  location={trip.location}
                  duration={trip.duration}
                  fromPrice={card.fromPrice}
                  originalFromPrice={card.originalFromPrice}
                  discountEndsAt={card.discountEndsAt}
                  multiPrice={card.multiPrice}
                  spotsLeft={card.spotsLeft}
                  soldOut={card.soldOut}
                  hasComingSoon={card.hasComingSoon}
                  allComingSoon={card.allComingSoon}
                  departures={card.departures}
                />
              </div>
            );
          })}
        </div>
      ) : (
        <p class="text-center py-12 text-gray-text">More trips coming soon. Stay tuned.</p>
      )}
    </div>
  </section>

  <script>
    // Featured-trips carousel: arrow + keyboard scrolling over the CSS scroll-snap
    // row. Native touch/trackpad swipe already works; this adds desktop affordances.
    const row = document.getElementById('featured-carousel');
    const prev = document.getElementById('featured-prev') as HTMLButtonElement | null;
    const next = document.getElementById('featured-next') as HTMLButtonElement | null;
    if (row) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const step = () => row.querySelector<HTMLElement>(':scope > div')?.offsetWidth ?? row.clientWidth * 0.8;
      const go = (dir: number) => row.scrollBy({ left: dir * (step() + 24), behavior: reduce ? 'auto' : 'smooth' });
      const sync = () => {
        const max = row.scrollWidth - row.clientWidth - 1;
        if (prev) prev.disabled = row.scrollLeft <= 0;
        if (next) next.disabled = row.scrollLeft >= max;
      };
      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));
      row.addEventListener('scroll', sync, { passive: true });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      });
      sync();
    }
  </script>

  <!-- ── HOW IT WORKS ──────────────────────────────────────── -->
  <Section as="section" tone="navy" space="md">
    <h2 class="font-display font-bold text-display-md text-white mb-14">
      How it works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {[
        { num: '01', title: 'Pick a trip', desc: 'Browse upcoming destinations, find one that pulls you.' },
        { num: '02', title: 'Save your spot', desc: 'Pay a small advance. The rest follows later.' },
        { num: '03', title: 'Show up', desc: 'We handle the details. You handle the experience.' },
      ].map((step) => (
        <div class="reveal pt-6 border-t border-white/15">
          <div class="font-display text-6xl font-bold mb-4 text-peach/70">{step.num}</div>
          <h3 class="font-display text-xl font-bold text-white mb-3">{step.title}</h3>
          <p class="text-white/65 text-sm leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ── COMMUNITY ─────────────────────────────────────────── -->
  {featuredTestimonials.length > 0 && (
    <Section
      tone="blush"
      title="Who comes on these trips"
      intro="Solo travelers. Friend groups. People who said yes on a whim. Nobody's left out."
    >
      <div class="flex items-start gap-5 overflow-x-auto overflow-y-hidden snap-x snap-mandatory pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4">
        {featuredTestimonials.map((t, index) => (
          <TestimonialCard testimonial={t} cardId={`home-${t.slug ?? index}`} surface="white" />
        ))}
      </div>
    </Section>
  )}

  <!-- ── NEWSLETTER ─────────────────────────────────────────── -->
  <section
    class="py-16 lg:py-20 relative bg-cover bg-center"
    style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&q=80');"
  >
    <div class="u-overlay-scrim-flat absolute inset-0"></div>
    <div class="container-app relative">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="font-display font-bold text-display-md mb-3 text-white">
          Be first to know
        </h2>
        <p class="text-base mb-8 leading-relaxed text-white/75">
          New trips, new batches, things worth knowing. No spam.
        </p>
        <form id="home-newsletter" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <label for="home-newsletter-email" class="sr-only">Your email address</label>
          <input
            id="home-newsletter-email"
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="flex-1 px-5 py-3.5 rounded-full text-sm border-2 border-white/25 bg-white/10 outline-none text-white placeholder:text-white/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          />
          <button
            type="submit"
            class="px-7 py-3.5 rounded-full text-sm font-semibold text-white bg-cta transition-all hover:-translate-y-0.5 hover:brightness-105 flex-shrink-0"
          >
            Keep me posted
          </button>
        </form>
        <p id="home-nl-success" class="hidden text-base mt-6 font-medium text-white">
          You're in. We'll be in touch when something good is coming.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const hero = document.getElementById('homepage-hero');
  const header = document.getElementById('site-header');
  if (hero && header) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('header-visible', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);
  }
</script>

<script>
  document.getElementById('home-newsletter')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')?.value ?? '';
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'homepage' }),
      });
      const data = await res.json();
      if (data.success) {
        form.style.display = 'none';
        document.getElementById('home-nl-success')?.classList.remove('hidden');
      }
    } catch {}
  });
</script>
