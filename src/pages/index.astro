---
import BaseLayout from '../layouts/BaseLayout.astro';
import TripCard from '../components/TripCard.astro';
import { listTrips, listTestimonials, readSiteSettings } from '../lib/content';

const allTrips = listTrips();
const featuredTrips = allTrips
  .filter((t) => t.status !== 'draft' && t.status !== 'sold_out' && t.status !== 'sold-out')
  .slice(0, 3);

const allTestimonials = listTestimonials().slice(0, 4);

let settings: any = {};
try { settings = readSiteSettings(); } catch (e) {}

const instagram = settings.instagram ?? 'https://www.instagram.com/seekthethrill_/';
const whatsapp = settings.whatsappLink ?? 'https://wa.me/917975027491';
---

<BaseLayout
  title="Seek the Thrill — Offbeat Group Trips Across India"
  description="Offbeat group trips for people who want to feel alive again. Small groups. Curated routes. Come for the adventure, stay for the people."
  hideHeader={true}
>

  <!-- ── HERO ──────────────────────────────────────────────── -->
  <section
    class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden"
    style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&auto=format&fit=crop&q=80'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(8,12,24,0.6) 0%, rgba(8,12,24,0.4) 40%, rgba(8,12,24,0.75) 100%);"></div>

    <div class="relative z-10 w-full max-w-sm sm:max-w-xl lg:max-w-2xl mx-auto px-6 flex flex-col items-center text-center">

      <!-- Logo -->
      <img src="/logo.jpg" alt="Seek the Thrill" class="anim-fade-up w-20 h-20 lg:w-24 lg:h-24 rounded-2xl object-cover shadow-xl mb-3" />
      <p class="anim-fade-up text-sm text-white/50 mb-10 tracking-wide">India's adventure community</p>

      <!-- Badge pill -->
      <span class="anim-fade-up anim-delay-1 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-white px-4 py-1.5 rounded-full mb-5 self-start" style="background: rgba(217,95,59,0.85); backdrop-filter: blur(4px);">
        📍 India's Offbeat Routes
      </span>

      <!-- Headline -->
      <h1 class="anim-fade-up anim-delay-1 text-[2.6rem] md:text-5xl lg:text-6xl font-bold leading-tight mb-4 text-left w-full" style="font-family: var(--font-display); color: white;">
        Go where the<br />
        <span style="color: var(--color-coral); font-style: italic;">crowds don't.</span>
      </h1>

      <!-- Subtext -->
      <p class="anim-fade-up anim-delay-2 text-base lg:text-lg text-white/75 text-left w-full mb-7 leading-relaxed">
        Group trips for travellers. Offbeat spots, zero fluff.
      </p>

      <!-- Stats card -->
      <div class="anim-fade-up anim-delay-2 w-full rounded-2xl p-4 mb-5 grid grid-cols-3" style="background: rgba(15,20,35,0.65); backdrop-filter: blur(10px);">
        <div class="text-center py-1">
          <div class="text-xl lg:text-2xl font-bold text-white mb-0.5" style="font-family: var(--font-display);">12–16</div>
          <div class="text-xs uppercase tracking-wider text-white/45">Group Size</div>
        </div>
        <div class="text-center py-1 border-x border-white/10">
          <div class="text-xl lg:text-2xl font-bold text-white mb-0.5" style="font-family: var(--font-display);">10+</div>
          <div class="text-xs uppercase tracking-wider text-white/45">Destinations</div>
        </div>
        <div class="text-center py-1">
          <div class="text-xl lg:text-2xl font-bold text-white mb-0.5" style="font-family: var(--font-display);">4.9★</div>
          <div class="text-xs uppercase tracking-wider text-white/45">Avg Rating</div>
        </div>
      </div>

      <!-- CTA -->
      <a
        href="/trips/"
        class="anim-fade-up anim-delay-3 w-full sm:w-auto sm:px-10 flex items-center justify-center gap-2 font-semibold text-white py-4 rounded-full text-base transition-all hover:opacity-90 hover:shadow-2xl mb-6"
        style="background-color: var(--color-cta);"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-1a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v1h-3zM4.75 14.094A5.973 5.973 0 004 17v1H1v-1a3 3 0 013.75-2.906z"/></svg>
        Join a Trip
      </a>

      <!-- Social proof -->
      <div class="anim-fade-up anim-delay-4 flex items-center gap-3">
        <div class="flex -space-x-2">
          {[
            'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=80&h=80&fit=crop&crop=face&q=80',
            'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=80&h=80&fit=crop&crop=face&q=80',
            'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&fit=crop&crop=face&q=80',
            'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&h=80&fit=crop&crop=face&q=80',
          ].map((src, i) => (
            <img src={src} alt="Traveller" class="w-8 h-8 rounded-full object-cover border-2 border-white/80" style={`z-index: ${4 - i};`} loading="eager" />
          ))}
        </div>
        <p class="text-sm text-white/70">Joined by <span class="text-white font-semibold">340+</span> adventurers</p>
      </div>

    </div>
  </section>

  <!-- ── UPCOMING TRIPS ────────────────────────────────────── -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-gray-soft);">
    <div class="container-app">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold" style="font-family: var(--font-display); color: var(--color-navy);">
            Where we're going next
          </h2>
        </div>
        <a href="/trips/" class="text-sm font-semibold hidden sm:block" style="color: var(--color-coral);">
          See all trips →
        </a>
      </div>

      {featuredTrips.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredTrips.map((trip) => (
            <TripCard
              slug={trip.slug}
              title={trip.title}
              name={trip.name}
              status={trip.status}
              coverImage={trip.coverImage}
              featuredImage={trip.featuredImage}
              description={trip.description}
              shortDescription={trip.shortDescription}
              location={trip.location}
              duration={trip.duration}
              batches={trip.batches ?? []}
              startDate={trip.startDate}
              endDate={trip.endDate}
              pricePerPerson={trip.pricePerPerson}
              maxGroupSize={trip.maxGroupSize}
              currentBookings={trip.currentBookings}
            />
          ))}
        </div>
      ) : (
        <p class="text-center py-12" style="color: var(--color-gray-text);">More trips coming soon. Stay tuned.</p>
      )}

      <div class="text-center mt-10 sm:hidden">
        <a href="/trips/" class="font-semibold text-sm" style="color: var(--color-coral);">See all trips →</a>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────── -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-navy);">
    <div class="container-app">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-14" style="font-family: var(--font-display);">
        How it works
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {[
          { num: '01', title: 'Pick a trip', desc: 'Browse upcoming destinations, find one that pulls you.' },
          { num: '02', title: 'Save your spot', desc: 'Pay a small advance. The rest follows later.' },
          { num: '03', title: 'Show up', desc: 'We handle the details. You handle the experience.' },
        ].map((step) => (
          <div class="reveal text-center">
            <div class="text-5xl font-bold mb-4 opacity-20 text-white" style="font-family: var(--font-display);">{step.num}</div>
            <h3 class="text-xl font-bold text-white mb-3" style="font-family: var(--font-display);">{step.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed max-w-xs mx-auto">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── COMMUNITY ─────────────────────────────────────────── -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-blush);">
    <div class="container-app">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-navy);">
          Who comes on these trips
        </h2>
        <p class="text-base leading-relaxed" style="color: var(--color-gray-text);">
          Solo travelers. Friend groups. People who said yes on a whim. Nobody's left out.
        </p>
      </div>

      {allTestimonials.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {allTestimonials.map((t) => (
            <div class="reveal bg-white rounded-2xl p-5" style="box-shadow: 0 1px 4px rgba(0,0,0,0.07);">
              <p class="text-sm leading-relaxed mb-4" style="color: var(--color-navy);">"{t.quote}"</p>
              <div class="flex items-center gap-3">
                {t.photo ? (
                  <img src={t.photo} alt={t.name} class="w-9 h-9 rounded-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm text-white" style="background-color: var(--color-coral);">
                    {(t.name as string)?.[0] ?? '?'}
                  </div>
                )}
                <div>
                  <div class="text-sm font-semibold" style="color: var(--color-navy);">{t.name}</div>
                  {t.tripName && <div class="text-xs" style="color: var(--color-gray-text);">{t.tripName}</div>}
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Placeholder quotes if no testimonials -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { name: 'Priya S.', trip: 'Spiti Valley', quote: 'I came alone and left with people I talk to every week. The mountains were just the backdrop.' },
            { name: 'Rahul M.', trip: 'Gokarna', quote: 'Did not expect to unplug so completely. No agenda, no plans — exactly what I needed.' },
            { name: 'Ananya K.', trip: 'Meghalaya', quote: 'Solo travel always felt intimidating. This was the nudge I needed. Would do it again tomorrow.' },
          ].map((q) => (
            <div class="reveal bg-white rounded-2xl p-5" style="box-shadow: 0 1px 4px rgba(0,0,0,0.07);">
              <p class="text-sm leading-relaxed mb-4" style="color: var(--color-navy);">"{q.quote}"</p>
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm text-white" style="background-color: var(--color-coral);">
                  {q.name[0]}
                </div>
                <div>
                  <div class="text-sm font-semibold" style="color: var(--color-navy);">{q.name}</div>
                  <div class="text-xs" style="color: var(--color-gray-text);">{q.trip}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── INSTAGRAM ─────────────────────────────────────────── -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-gray-soft);">
    <div class="container-app">
      <div class="text-center mb-10">
        <h2 class="text-3xl lg:text-4xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-navy);">
          Straight from the trips
        </h2>
        <p class="text-sm" style="color: var(--color-gray-text);">@seekthethrill_</p>
      </div>

      <!-- Instagram grid placeholder — Zahra will swap these embed URLs via admin -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-8">
        {[
          'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400&auto=format&fit=crop&q=80',
          'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&auto=format&fit=crop&q=80',
          'https://images.unsplash.com/photo-1559827291-72ee739d0d9a?w=400&auto=format&fit=crop&q=80',
          'https://images.unsplash.com/photo-1583418855676-8a93cf51b4a6?w=400&auto=format&fit=crop&q=80',
        ].map((src, i) => (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="block relative overflow-hidden rounded-xl group"
            style="aspect-ratio: 1;"
          >
            <img
              src={src}
              alt={`Instagram photo ${i + 1}`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" style="background: rgba(0,0,0,0.35);">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a
          href={instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-sm border-2 px-6 py-3 rounded-full transition-all hover:opacity-80"
          style="border-color: var(--color-coral); color: var(--color-coral);"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          Follow the journey →
        </a>
      </div>
    </div>
  </section>

  <!-- ── NEWSLETTER ─────────────────────────────────────────── -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-blush);">
    <div class="container-app">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-navy);">
          Be first to know
        </h2>
        <p class="text-base mb-8 leading-relaxed" style="color: var(--color-gray-text);">
          New trips, new batches, things worth knowing. No spam.
        </p>
        <form id="home-newsletter" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="flex-1 px-5 py-3.5 rounded-full text-sm border-2 outline-none"
            style="border-color: var(--color-peach); color: var(--color-navy); background: white;"
          />
          <button
            type="submit"
            class="px-7 py-3.5 rounded-full text-sm font-semibold text-white transition-all hover:opacity-90 flex-shrink-0"
            style="background-color: var(--color-cta);"
          >
            Keep me posted
          </button>
        </form>
        <p id="home-nl-success" class="hidden text-base mt-6 font-medium" style="color: var(--color-navy);">
          You're in. We'll be in touch when something good is coming.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const hero = document.querySelector('section');
  const header = document.getElementById('site-header');
  if (hero && header) {
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('header-visible', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);
  }
</script>

<script>
  document.getElementById('home-newsletter')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')?.value ?? '';
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'homepage' }),
      });
      const data = await res.json();
      if (data.success) {
        form.style.display = 'none';
        document.getElementById('home-nl-success')?.classList.remove('hidden');
      }
    } catch {}
  });
</script>
