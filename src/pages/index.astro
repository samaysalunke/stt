---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seek the Thrill — Come seek the thrill of being truly alive!</title>
    <meta name="description" content="Come seek the thrill of being truly alive! Adventure group trips across India — Kashmir, Ladakh, Meghalaya, Sahyadris and more." />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --green: #1A3D28;
        --green-mid: #2D5F3E;
        --orange: #E8752A;
        --orange-hover: #D4631E;
        --gold: #D4A854;
        --surface: rgba(255,255,255,0.06);
        --surface-hover: rgba(255,255,255,0.11);
        --border: rgba(255,255,255,0.12);
      }

      html {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        background-color: var(--green);
        color: #fff;
        min-height: 100%;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 1rem 3rem;
        background:
          radial-gradient(ellipse 80% 50% at 50% -10%, rgba(232,117,42,0.18) 0%, transparent 70%),
          radial-gradient(ellipse 60% 40% at 80% 90%, rgba(45,95,62,0.6) 0%, transparent 60%),
          var(--green);
      }

      .card {
        width: 100%;
        max-width: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
      }

      /* Avatar */
      .avatar {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid var(--orange);
        box-shadow: 0 0 0 4px rgba(232,117,42,0.2);
        margin-bottom: 1rem;
        flex-shrink: 0;
      }
      .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* Header text */
      .handle {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        color: rgba(255,255,255,0.9);
        margin-bottom: 0.35rem;
        letter-spacing: 0.01em;
      }

      .tagline {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 400;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.6);
        text-align: center;
        max-width: 280px;
        line-height: 1.5;
        margin-bottom: 2rem;
      }

      /* Trip links */
      .links {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
      }

      .trip-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0.9rem 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        text-align: center;
        transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
        cursor: pointer;
        gap: 0.2rem;
      }

      .trip-link:hover {
        background: var(--surface-hover);
        border-color: rgba(232,117,42,0.45);
        transform: translateY(-1px);
      }

      .trip-link:active {
        transform: translateY(0);
      }

      .trip-name {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 600;
        font-size: 0.875rem;
        color: #fff;
        line-height: 1.4;
      }

      .trip-dates {
        font-size: 0.75rem;
        color: var(--gold);
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      /* Divider */
      .divider {
        width: 100%;
        height: 1px;
        background: var(--border);
        margin: 0.6rem 0;
      }

      /* YouTube link */
      .yt-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.9rem 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        text-decoration: none;
        width: 100%;
        transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
      }

      .yt-link:hover {
        background: var(--surface-hover);
        border-color: rgba(255,0,0,0.4);
        transform: translateY(-1px);
      }

      .yt-link span {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 600;
        font-size: 0.875rem;
        color: #fff;
      }

      /* Social row */
      .social-row {
        display: flex;
        gap: 1rem;
        margin-top: 1.75rem;
      }

      .social-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--surface);
        border: 1px solid var(--border);
        text-decoration: none;
        transition: background 0.18s ease, border-color 0.18s ease;
      }

      .social-btn:hover {
        background: var(--surface-hover);
        border-color: var(--orange);
      }

      .social-btn svg {
        width: 18px;
        height: 18px;
        fill: rgba(255,255,255,0.75);
      }

      /* Footer note */
      .footer-note {
        margin-top: 2rem;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.25);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <!-- Logo -->
      <div class="avatar">
        <img src="/logo.jpg" alt="Seek the Thrill" />
      </div>

      <!-- Identity -->
      <div class="handle">@Seekthethrill</div>
      <p class="tagline">Come seek the thrill of being truly alive!</p>

      <!-- Trip Links -->
      <div class="links">
        {trips.map((trip) => (
          <a href={trip.link} class="trip-link" target="_blank" rel="noopener noreferrer">
            <span class="trip-name">{trip.name}</span>
            <span class="trip-dates">{trip.dates}</span>
          </a>
        ))}

        <div class="divider"></div>

        <!-- YouTube -->
        <a href="#REPLACE_WITH_YOUTUBE_LINK" class="yt-link" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;fill:#FF0000;flex-shrink:0;">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>YouTube</span>
        </a>
      </div>

      <!-- Social icons -->
      <div class="social-row">
        <!-- Instagram -->
        <a href="https://www.instagram.com/seekthethrill/" class="social-btn" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <!-- WhatsApp -->
        <a href="https://wa.me/917975027491?text=Hi%2C%20I%27m%20interested%20in%20a%20trip%20with%20Seek%20the%20Thrill!" class="social-btn" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>

      <p class="footer-note">seekthethrill.in</p>
    </div>
  </body>
</html>
