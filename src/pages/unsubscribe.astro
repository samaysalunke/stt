---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb } from '../lib/db';
export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
let unsubscribed = false;

if (token) {
  const db = getDb();
  const sub = db
    .prepare('SELECT id FROM newsletter_subscribers WHERE unsubscribe_token = ?')
    .get(token) as { id: number } | null;

  if (sub) {
    db.prepare("UPDATE newsletter_subscribers SET status = 'unsubscribed', active = 0 WHERE id = ?").run(sub.id);
    unsubscribed = true;
  }
}
---

<BaseLayout
  title="Unsubscribed — Seek the Thrill"
  description="You've been removed from the Seek the Thrill mailing list."
  robots="noindex, follow"
>
  <section class="min-h-[60vh] flex items-center justify-center py-20 px-5">
    <div class="max-w-md w-full text-center">
      {unsubscribed ? (
        <>
          <div class="text-5xl mb-6">🏔️</div>
          <h1 class="text-2xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-navy);">
            You've been unsubscribed.
          </h1>
          <p class="text-base leading-relaxed mb-8" style="color: var(--color-gray-text);">
            Safe travels.
          </p>
          <a
            href="/trips/"
            class="inline-block font-semibold text-white px-7 py-3 rounded-full transition-all hover:opacity-90"
            style="background-color: var(--color-coral);"
          >
            Browse trips →
          </a>
        </>
      ) : (
        <>
          <h1 class="text-2xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-navy);">
            Invalid link
          </h1>
          <p class="text-base leading-relaxed" style="color: var(--color-gray-text);">
            This unsubscribe link is invalid or has already been used.
          </p>
        </>
      )}
    </div>
  </section>
</BaseLayout>
