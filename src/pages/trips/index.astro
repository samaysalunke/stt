---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripCard from '../../components/TripCard.astro';
import { listTrips, isTripListable, resolveBooking, tripCardSummary } from '../../lib/content';

// Visibility derives from departures (trip-level status removed): list trips
// that have at least one upcoming, non-draft departure.
const allTrips = listTrips().filter(isTripListable);

// Separate available from sold out (derived from departures) — sold out goes last.
const available = allTrips.filter((t) => !tripCardSummary(t).soldOut);
const soldOut = allTrips.filter((t) => tripCardSummary(t).soldOut);
const trips = [...available, ...soldOut];
---

<BaseLayout
  title="Upcoming Trips — Seek the Thrill"
  description="Small groups. Handpicked routes. Browse STT's upcoming adventures across India."
  nav="header"
>

  <!-- Page header -->
  <section class="py-10 lg:py-12" style="background-color: var(--color-blush);">
    <div class="container-app text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-navy);">
        Upcoming trips
      </h1>
      <p class="text-base max-w-md mx-auto leading-relaxed" style="color: var(--color-gray-text);">
        Small groups. Handpicked routes.
      </p>
    </div>
  </section>

  <!-- Trip grid -->
  <section class="py-14 lg:py-18" style="background-color: var(--color-gray-soft);">
    <div class="container-app">
      {trips.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-base" style="color: var(--color-gray-text);">Nothing open right now. The next trip will show up here when it's ready.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
          {trips.map((trip) => {
            const card = tripCardSummary(trip);
            return (
              <TripCard
                slug={trip.slug}
                title={trip.title}
                name={trip.name}
                coverImage={trip.coverImage}
                featuredImage={trip.featuredImage}
                description={trip.description}
                shortDescription={trip.shortDescription}
                location={trip.location}
                duration={trip.duration}
                fromPrice={card.fromPrice}
                multiPrice={card.multiPrice}
                spotsLeft={card.spotsLeft}
                soldOut={card.soldOut}
                departures={resolveBooking(trip).departures}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>

</BaseLayout>
