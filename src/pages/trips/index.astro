---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripCard from '../../components/TripCard.astro';
import { listTrips, tripHasUpcomingDates, tripCardSummary } from '../../lib/content';

// Hide drafts, and hide trips whose dates have all passed (no upcoming batches).
const allTrips = listTrips()
  .filter((t) => t.status !== 'draft')
  .filter((t) => tripHasUpcomingDates(t));

// Separate available from sold out — sold out goes last
const available = allTrips.filter((t) => t.status !== 'sold_out' && t.status !== 'sold-out');
const soldOut = allTrips.filter((t) => t.status === 'sold_out' || t.status === 'sold-out');
const trips = [...available, ...soldOut];
---

<BaseLayout
  title="Upcoming Trips — Seek the Thrill"
  description="Small groups. Handpicked routes. A few spots left on each. Browse STT's upcoming adventures across India."
>

  <!-- Page header -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-blush);">
    <div class="container-app text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-4" style="font-family: var(--font-display); color: var(--color-navy);">
        Upcoming trips
      </h1>
      <p class="text-base max-w-md mx-auto leading-relaxed" style="color: var(--color-gray-text);">
        Small groups. Handpicked routes. A few spots left on each.
      </p>
    </div>
  </section>

  <!-- Trip grid -->
  <section class="py-14 lg:py-18" style="background-color: var(--color-gray-soft);">
    <div class="container-app">
      {trips.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-base" style="color: var(--color-gray-text);">Nothing open right now. The next trip will show up here when it's ready.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
          {trips.map((trip) => {
            const card = tripCardSummary(trip);
            return (
              <TripCard
                slug={trip.slug}
                title={trip.title}
                name={trip.name}
                status={trip.status}
                coverImage={trip.coverImage}
                featuredImage={trip.featuredImage}
                description={trip.description}
                shortDescription={trip.shortDescription}
                location={trip.location}
                duration={trip.duration}
                fromPrice={card.fromPrice}
                multiPrice={card.multiPrice}
                spotsLeft={card.spotsLeft}
                soldOut={card.soldOut}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>

</BaseLayout>
