---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripCard from '../../components/TripCard.astro';
import { listTrips, isTripListable, tripCardSummary, sortTripsByPriority, contentSeededRandom } from '../../lib/content';
import { siteUrl } from '../../lib/siteUrl';

// Visibility derives from departures (trip-level status removed): list trips
// that have at least one upcoming, non-draft departure. The shuffle is seeded
// from the content version so the order is stable across edge PoPs and only
// rotates when the content changes.
const trips = sortTripsByPriority(listTrips().filter(isTripListable), contentSeededRandom());
const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${siteUrl('/trips/')}#trip-list`,
  name: 'Upcoming Seek the Thrill trips',
  itemListElement: trips.map((trip, index) => ({
    '@type': 'ListItem', position: index + 1,
    name: String(trip.title || trip.name || trip.slug),
    url: siteUrl(`/trips/${trip.slug}/`),
  })),
};
---

<BaseLayout
  title="Upcoming Trips — Seek the Thrill"
  description="Small groups. Handpicked routes. Browse STT's upcoming adventures across India."
  nav="header"
>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify(listingSchema)} /></Fragment>

  <!-- Page header -->
  <section class="py-10 lg:py-12 bg-blush">
    <div class="container-app text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-3 font-display text-navy">
        Upcoming trips
      </h1>
      <p class="text-base max-w-md mx-auto leading-relaxed text-gray-text">
        Small groups. Handpicked routes.
      </p>
    </div>
  </section>

  <!-- Trip grid -->
  <section class="py-14 lg:py-18 bg-gray-soft">
    <h2 class="sr-only">All upcoming trips</h2>
    <div class="container-app">
      {trips.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-base text-gray-text">Nothing open right now. The next trip will show up here when it's ready.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
          {trips.map((trip) => {
            const card = tripCardSummary(trip);
            return (
              <TripCard
                slug={trip.slug}
                title={trip.title}
                name={trip.name}
                coverImage={trip.coverImage}
                featuredImage={trip.featuredImage}
                description={trip.description}
                shortDescription={trip.shortDescription}
                location={trip.location}
                duration={trip.duration}
                fromPrice={card.fromPrice}
                originalFromPrice={card.originalFromPrice}
                discountEndsAt={card.discountEndsAt}
                multiPrice={card.multiPrice}
                spotsLeft={card.spotsLeft}
                soldOut={card.soldOut}
                hasComingSoon={card.hasComingSoon}
                allComingSoon={card.allComingSoon}
                departures={card.departures}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>

</BaseLayout>
