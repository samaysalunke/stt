---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapIndia from '../../components/MapIndia.astro';
import { getDb } from '../../lib/db';
import { readTrip } from '../../lib/content';

export const prerender = false;

const { username } = Astro.params;
if (!username) return new Response('Not Found', { status: 404 });

const db = getDb();

const profileUser = db.prepare(`
  SELECT id, email, displayName, avatarUrl, username, leaderboardOptOut, showTripsPublicly, createdAt
  FROM users WHERE username = ?
`).get(username) as {
  id: string;
  email: string;
  displayName: string | null;
  avatarUrl: string | null;
  username: string;
  leaderboardOptOut: number;
  showTripsPublicly: number;
  createdAt: number;
} | undefined;

if (!profileUser) {
  return new Response('Not Found', { status: 404 });
}

// Stats from leaderboard cache
const stats = db.prepare(
  'SELECT kmsFromHome, daysOutdoors, destinationsCount, tripsCount FROM leaderboard_cache WHERE userId = ?'
).get(profileUser.id) as {
  kmsFromHome: number;
  daysOutdoors: number;
  destinationsCount: number;
  tripsCount: number;
} | undefined;

// Leaderboard rank (km from home tab), shown unless opted out
let kmRank: number | null = null;
if (!profileUser.leaderboardOptOut && stats) {
  const rankRow = db.prepare(
    'SELECT COUNT(*) + 1 as rank FROM leaderboard_cache WHERE kmsFromHome > ?'
  ).get(stats.kmsFromHome) as { rank: number };
  kmRank = rankRow.rank;
}

// Confirmed registrations (used for map + trip list)
const confirmedRegs = db.prepare(`
  SELECT trip_name, trip_slug, batch_id
  FROM registrations
  WHERE email = ? AND status = 'confirmed'
  ORDER BY created_at DESC
`).all(profileUser.email) as { trip_name: string; trip_slug: string | null; batch_id: string | null }[];

// Build map pins from geocode_cache
type PinStatus = 'completed' | 'ongoing' | 'upcoming';

interface Pin {
  lat: number;
  lng: number;
  status: PinStatus;
  label: string;
}

function getBatchStatus(tripSlug: string, batchId: string | null): PinStatus {
  if (!batchId) return 'completed';
  try {
    const trip = readTrip(tripSlug);
    const batch = (trip?.batches as any[])?.find((b: any) => b.id === batchId);
    if (!batch?.startDate) return 'completed';
    const today = Date.now();
    const start = new Date(batch.startDate).getTime();
    const end = batch.endDate ? new Date(batch.endDate).getTime() : start;
    if (end < today) return 'completed';
    if (start <= today) return 'ongoing';
    return 'upcoming';
  } catch {
    return 'completed';
  }
}

const pins: Pin[] = [];
const destinationsSeen = new Set<string>();

for (const reg of confirmedRegs) {
  const slug = reg.trip_slug;
  if (!slug) continue;
  const trip = readTrip(slug);
  const location = (trip?.location as string | undefined)?.trim();
  if (!location || destinationsSeen.has(location.toLowerCase())) continue;

  const coords = db.prepare('SELECT lat, lng FROM geocode_cache WHERE query = ?')
    .get(location.toLowerCase()) as { lat: number; lng: number } | undefined;
  if (!coords) continue;

  destinationsSeen.add(location.toLowerCase());
  pins.push({ lat: coords.lat, lng: coords.lng, status: getBatchStatus(slug, reg.batch_id), label: location });
}

// Public trip list (only if opted in)
interface PublicTrip {
  tripName: string;
  location: string;
  status: PinStatus;
}

let publicTrips: PublicTrip[] | null = null;
if (profileUser.showTripsPublicly) {
  publicTrips = confirmedRegs.map((reg) => {
    const slug = reg.trip_slug;
    const trip = slug ? readTrip(slug) : null;
    const location = (trip?.location as string | undefined) ?? '';
    return {
      tripName: reg.trip_name,
      location,
      status: slug ? getBatchStatus(slug, reg.batch_id) : 'completed',
    };
  });
}

const firstName = profileUser.displayName?.split(' ')[0] ?? 'Traveller';
const joinYear = new Date(profileUser.createdAt * 1000).getFullYear();
const tripsCount = stats?.tripsCount ?? 0;
const tagline = tripsCount > 0
  ? `${tripsCount} trip${tripsCount !== 1 ? 's' : ''} with Seek the Thrill`
  : `Explorer since ${joinYear}`;

const pageTitle = `${firstName}'s trips with Seek the Thrill`;
const pageDesc = `${tripsCount} trip${tripsCount !== 1 ? 's' : ''} · ${stats?.destinationsCount ?? 0} destinations · ${stats?.kmsFromHome ?? 0} km from home`;

const statusMeta: Record<PinStatus, { label: string; color: string }> = {
  completed: { label: 'Completed', color: '#10B981' },
  ongoing:   { label: 'Ongoing',   color: '#F59E0B' },
  upcoming:  { label: 'Upcoming',  color: 'var(--color-coral)' },
};
---

<BaseLayout title={pageTitle} description={pageDesc} nav="back">
  <Fragment slot="head">
    <meta property="og:title" content={`${firstName} on Seek the Thrill`} />
    <meta property="og:description" content={`${tripsCount} trips across India with @seekthethrill_`} />
  </Fragment>

  <div class="container-app py-10 max-w-lg mx-auto">

    <!-- Avatar + name + tagline -->
    <div class="flex items-center gap-4 mb-8">
      {profileUser.avatarUrl ? (
        <img src={profileUser.avatarUrl} alt={firstName}
             class="w-16 h-16 rounded-full object-cover" referrerpolicy="no-referrer" />
      ) : (
        <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold flex-shrink-0"
             style="background: var(--color-coral);">
          {firstName[0].toUpperCase()}
        </div>
      )}
      <div>
        <h1 class="text-xl font-bold" style="font-family: var(--font-display); color: var(--color-navy);">{firstName}</h1>
        <p class="text-sm" style="color: var(--color-gray-text);">@{profileUser.username}</p>
        <p class="text-xs mt-0.5" style="color: var(--color-gray-text);">{tagline}</p>
      </div>
    </div>

    <!-- Stats strip -->
    {stats && (
      <div class="grid grid-cols-3 gap-3 mb-8">
        {[
          { value: String(stats.tripsCount),                                 label: 'trips'        },
          { value: String(stats.destinationsCount),                          label: 'destinations' },
          { value: `${stats.kmsFromHome.toLocaleString('en-IN')} km`,       label: 'from home'    },
        ].map((s) => (
          <div class="rounded-xl p-4 text-center" style="background: var(--color-blush);">
            <p class="text-xl font-bold" style="font-family: var(--font-display); color: var(--color-navy);">{s.value}</p>
            <p class="text-xs mt-0.5" style="color: var(--color-gray-text);">{s.label}</p>
          </div>
        ))}
      </div>
    )}

    <!-- Leaderboard rank -->
    {kmRank !== null && (
      <a href="/leaderboard?tab=km" class="flex items-center gap-2 mb-8 text-sm font-medium hover:opacity-80"
         style="color: var(--color-coral);">
        <span>#{kmRank} on the km from home board</span>
        <span>→</span>
      </a>
    )}

    <!-- India map -->
    <div class="mb-8">
      <MapIndia pins={pins} class="w-full max-w-xs mx-auto block" />
      {pins.length > 0 && (
        <div class="flex items-center justify-center gap-5 mt-3">
          <span class="flex items-center gap-1.5 text-xs" style="color: var(--color-gray-text);">
            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background: var(--color-coral);"></span>
            Visited
          </span>
          <span class="flex items-center gap-1.5 text-xs" style="color: var(--color-gray-text);">
            <span class="w-3 h-3 rounded-full border-2 flex-shrink-0" style="border-color: var(--color-coral); background: white;"></span>
            Upcoming
          </span>
        </div>
      )}
    </div>

    <!-- Trip list (opt-in only) -->
    {publicTrips && publicTrips.length > 0 && (
      <div class="mb-10">
        <h2 class="text-base font-semibold mb-4" style="color: var(--color-navy);">Trips</h2>
        <div class="flex flex-col gap-3">
          {publicTrips.map((t) => {
            const meta = statusMeta[t.status];
            return (
              <div class="rounded-xl px-4 py-4 flex items-center justify-between"
                   style="background: white; border: 1px solid var(--color-peach);">
                <div>
                  <p class="font-medium text-sm" style="color: var(--color-navy);">{t.tripName}</p>
                  {t.location && (
                    <p class="text-xs mt-0.5" style="color: var(--color-gray-text);">{t.location}</p>
                  )}
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full flex-shrink-0 ml-3"
                      style={`color: ${meta.color}; background: ${meta.color}1a;`}>
                  {meta.label}
                </span>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="rounded-2xl p-8 text-center mt-4" style="background: var(--color-blush);">
      <p class="text-lg font-bold mb-1" style="font-family: var(--font-display); color: var(--color-navy);">
        Travel with Seek the Thrill
      </p>
      <p class="text-sm mb-5" style="color: var(--color-gray-text);">
        Group travel across India, small groups, handpicked hosts.
      </p>
      <a href="/trips/"
         class="inline-block px-8 py-3 rounded-full text-sm font-semibold text-white transition-opacity hover:opacity-80"
         style="background: var(--color-coral);">
        Explore trips →
      </a>
    </div>

  </div>
</BaseLayout>
