---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found — Seek the Thrill"
  description="The page you're looking for doesn't exist. There are still trips to look through."
  robots="noindex, follow"
>
  <div class="min-h-screen flex items-center justify-center py-20 px-4 bg-gray-soft">
    <div class="max-w-md w-full text-center">
      <div class="text-8xl font-bold mb-4 font-display text-peach">404</div>
      <h1 class="text-display-md font-display font-bold mb-3 text-navy">
        This page isn't here.
      </h1>
      <p class="text-base mb-10 text-gray-text">
        The page you're looking for doesn't exist. There are still trips to look through.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/" variant="cta" size="lg">Back to home</Button>
        <Button href="/trips/" variant="outline" size="lg" class="border-2 text-navy">See upcoming trips</Button>
      </div>
    </div>
  </div>
</BaseLayout>
