---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileChrome from '../components/ProfileChrome.astro';
import ProfileTripCard from '../components/ProfileTripCard.astro';
import { getDb } from '../lib/db';
import { readTrip } from '../lib/content';
import { readSiteSettings } from '../lib/settings';
import { SITE_HOST, siteUrl } from '../lib/siteUrl';
import { canonicalizeProfileTrips, groupProfileTrips, type ProfileRegistrationRow } from '../lib/profileTrips';

export const prerender = false;
const user = Astro.locals.user!;
const db = getDb();
type Tab = 'overview' | 'trips' | 'settings';
const rawTab = Astro.url.searchParams.get('tab');
const tab: Tab = ['overview', 'trips', 'settings'].includes(rawTab ?? '') ? rawTab as Tab : 'overview';
const userRow = db.prepare(`SELECT username, usernameChangedAt, leaderboardOptOut, showTripsPublicly FROM users WHERE id = ?`).get(user.id) as { username: string | null; usernameChangedAt: number | null; leaderboardOptOut: number; showTripsPublicly: number } | undefined;
const stats = db.prepare(`SELECT kmsFromHome, daysOutdoors, destinationsCount, tripsCount FROM leaderboard_cache WHERE userId = ?`).get(user.id) as { kmsFromHome: number; daysOutdoors: number; destinationsCount: number; tripsCount: number } | undefined;
const rows = db.prepare(`
  SELECT id, trip_name, trip_slug, trip_date, batch_id, status, created_at, updated_at, status_changed_at,
         full_name, phone, age, date_of_birth, gender, city, state, instagram,
         emergency_name, emergency_phone, emergency_relationship, why_join,
         sharing_option, tier_id, total_amount, amount_paid, amount_refunded, payment_status
    FROM registrations WHERE lower(trim(email)) = lower(trim(?)) ORDER BY created_at DESC, id DESC
`).all(user.email) as ProfileRegistrationRow[];
const canonical = canonicalizeProfileTrips(rows);
const grouped = groupProfileTrips(canonical);
const PAGE_SIZE = 10;
const requestedPage = Number.parseInt(Astro.url.searchParams.get('pastPage') ?? '1', 10);
const totalPastPages = Math.max(1, Math.ceil(grouped.history.length / PAGE_SIZE));
const pastPage = Math.min(totalPastPages, Math.max(1, Number.isFinite(requestedPage) ? requestedPage : 1));
const visibleHistory = grouped.history.slice((pastPage - 1) * PAGE_SIZE, pastPage * PAGE_SIZE);
let settings: any = {};
try { settings = readSiteSettings(); } catch {}
const supportEmail = settings.email ?? 'zahra@seekthethrill.in';
const whatsapp = settings.whatsappLink ?? `https://wa.me/${String(settings.phone ?? '+917975027491').replace(/[^0-9]/g, '')}`;
const supportHref = `mailto:${supportEmail}?subject=${encodeURIComponent('Booking support request')}`;
const dataRequestHref = `mailto:${supportEmail}?subject=${encodeURIComponent('Privacy data access or deletion request')}`;
const shareCandidates = db.prepare(`SELECT id, trip_name, trip_slug, batch_id FROM registrations WHERE lower(trim(email)) = lower(trim(?)) AND status = 'confirmed' AND sharedAt IS NULL ORDER BY created_at DESC`).all(user.email) as { id: number; trip_name: string; trip_slug: string | null; batch_id: string | null }[];
let shareBannerTrip: { id: number; tripName: string } | null = null;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata' }).format(new Date());
for (const reg of shareCandidates) {
  try {
    const trip = reg.trip_slug ? readTrip(reg.trip_slug) : null;
    const batch = Array.isArray(trip?.batches) ? trip.batches.find((b: any) => String(b.id) === String(reg.batch_id)) : null;
    if (batch?.endDate && String(batch.endDate).slice(0, 10) < today) { shareBannerTrip = { id: reg.id, tripName: reg.trip_name }; break; }
  } catch {}
}
const firstName = user.displayName?.trim().split(/\s+/)[0] || 'Traveller';
const canChangeUsername = !userRow?.usernameChangedAt;
const profileUrl = userRow?.username ? siteUrl(`/u/${userRow.username}`) : null;
const navItems: { id: Tab; label: string }[] = [{ id: 'overview', label: 'Overview' }, { id: 'trips', label: 'My Trips' }, { id: 'settings', label: 'Settings' }];
---
<BaseLayout title={`${firstName}'s account — Seek the Thrill`} description="Your private Seek the Thrill account and bookings." robots="noindex, nofollow" nav="none" hideWhatsApp={true}>
  <ProfileChrome>
    <div class="profile-shell dashboard">
      {shareBannerTrip && userRow?.username && <aside id="share-banner" class="share-banner" aria-label="Share your updated profile">
        <button id="share-banner-dismiss" aria-label="Dismiss profile sharing message">×</button><strong>{shareBannerTrip.tripName} just wrapped. Your profile is updated.</strong><p>Share your latest travel stats with friends.</p>
        <div><code id="share-banner-url">{SITE_HOST}/u/{userRow.username}</code><button id="share-banner-copy" data-url={profileUrl} data-reg-id={String(shareBannerTrip.id)}>Copy link</button></div><p id="share-banner-copied" class="live" aria-live="polite"></p>
      </aside>}
      <header class="identity" data-card-skeleton data-skeleton-ready={!user.avatarUrl ? '' : undefined}>
        {user.avatarUrl ? <img data-skeleton-image src={user.avatarUrl} alt="" referrerpolicy="no-referrer" /> : <span class="avatar-fallback" aria-hidden="true">{firstName[0].toUpperCase()}</span>}
        <div class="identity-copy"><h1>{user.displayName ?? firstName}</h1>{userRow?.username && <p class="username">@{userRow.username}</p>}<p class="email">{user.email}</p><p class="provenance">Avatar and email are provided by your Google account.</p></div>
      </header>
      <nav class="profile-tabs" aria-label="Profile sections">{navItems.map((item) => <a href={`/profile?tab=${item.id}`} aria-current={tab === item.id ? 'page' : undefined}>{item.label}</a>)}</nav>

      {tab === 'overview' && <div class="panel-grid">
        <main class="main-column">
          <section aria-labelledby="stats-heading">
            <div class="section-heading"><div><h2 id="stats-heading">Your travel stats</h2><p>Private stats stay available even if you leave the leaderboard.</p></div><a href="/leaderboard">View leaderboard</a></div>
            {stats ? <div class="stats-grid" data-card-skeleton data-skeleton-ready><div><strong>{stats.tripsCount}</strong><span>confirmed trips</span></div><div><strong>{stats.destinationsCount}</strong><span>destinations</span></div><div><strong>{stats.daysOutdoors}</strong><span>days outdoors</span></div><div><strong>{stats.kmsFromHome.toLocaleString('en-IN')} km</strong><span>from home</span></div></div> : rows.some((r) => r.status === 'confirmed') ? <div class="empty-state"><strong>Stats are still being calculated.</strong><p>Your confirmed trips are safe and will appear here soon.</p></div> : <div class="empty-state"><strong>No confirmed trips yet.</strong><p>Your stats begin after your first trip is confirmed.</p><a href="/trips/">Explore trips →</a></div>}
          </section>
          <section aria-labelledby="upcoming-heading"><div class="section-heading"><div><h2 id="upcoming-heading">Active &amp; upcoming</h2><p>Your nearest actionable bookings.</p></div><a href="/profile?tab=trips">See all trips</a></div>{grouped.active.length ? <div class="card-stack">{grouped.active.slice(0, 3).map((record) => <ProfileTripCard {record} {supportHref} />)}</div> : rows.length ? <div class="empty-state"><strong>No active or upcoming trips.</strong><p>Past, cancelled, and wishlisted trips are available in My Trips.</p></div> : <div class="empty-state"><strong>No bookings yet.</strong><p>When you register for a departure, it will appear here.</p><a href="/trips/">Explore trips →</a></div>}</section>
        </main>
        <aside class="side-column">
          <section class="action-card" data-card-skeleton data-skeleton-ready><h2>Share &amp; explore</h2>{profileUrl && <><code id="share-profile-url">{SITE_HOST}/u/{userRow!.username}</code><button id="share-profile-copy" data-url={profileUrl}>Copy profile</button><a href={profileUrl}>View public profile</a></>}<a href="/leaderboard">View leaderboard</a><a href="/trips/">Explore trips</a><p id="share-profile-copied" class="live" aria-live="polite"></p></section>
          <section class="support-card" data-card-skeleton data-skeleton-ready><h2>Need help with a booking?</h2><p>Our team can help with payment review, changed plans, or a missing departure.</p><a href={supportHref}>Email support</a><a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp support</a></section>
        </aside>
      </div>}

      {tab === 'trips' && <main class="trips-panel"><header class="page-intro"><h2>My Trips</h2><p>Bookings are grouped by their current status and departure date.</p></header>
        <section aria-labelledby="active-title"><h2 id="active-title">Active &amp; upcoming <span>{grouped.active.length}</span></h2>{grouped.active.length ? <div class="card-stack">{grouped.active.map((record) => <ProfileTripCard {record} {supportHref} />)}</div> : <div class="empty-state"><p>No active bookings right now.</p></div>}</section>
        <section aria-labelledby="wishlist-title"><h2 id="wishlist-title">Wishlist <span>{grouped.wishlist.length}</span></h2>{grouped.wishlist.length ? <div class="card-stack">{grouped.wishlist.map((record) => <ProfileTripCard {record} {supportHref} />)}</div> : <div class="empty-state"><p>No wishlisted departures.</p></div>}</section>
        <section aria-labelledby="history-title"><h2 id="history-title">Past &amp; closed <span>{grouped.history.length}</span></h2>{visibleHistory.length ? <div class="card-stack">{visibleHistory.map((record) => <ProfileTripCard {record} {supportHref} />)}</div> : <div class="empty-state"><p>No past or closed bookings.</p></div>}{totalPastPages > 1 && <nav class="pagination" aria-label="Past trips pages">{pastPage > 1 ? <a href={`/profile?tab=trips&pastPage=${pastPage - 1}`}>← Previous</a> : <span></span>}<span>Page {pastPage} of {totalPastPages}</span>{pastPage < totalPastPages ? <a href={`/profile?tab=trips&pastPage=${pastPage + 1}`}>Next →</a> : <span></span>}</nav>}</section>
        <section class="support-strip"><div><h2>Something look wrong?</h2><p>Contact us about duplicate, legacy, cancelled, or missing trip records.</p></div><a href={supportHref}>Contact support</a></section>
      </main>}

      {tab === 'settings' && <main class="settings-panel"><header class="page-intro"><h2>Settings</h2><p>Manage your public identity and privacy choices.</p></header>
        <section><h2>Account</h2><div class="settings-card"><form id="display-name-form"><label for="display-name-input">Display name</label><div class="form-row"><input id="display-name-input" type="text" value={user.displayName ?? ''} maxlength="50" required /><button type="submit">Save</button></div><p id="display-name-msg" class="live" aria-live="polite"></p></form><div class="readonly"><span>Google email</span><strong>{user.email}</strong><small>Read-only. Your email and avatar come from Google.</small></div></div></section>
        <section><h2>Username</h2><div class="settings-card"><p>Your public profile is <strong>@{userRow?.username ?? 'not set'}</strong>.</p>{canChangeUsername ? <><p class="help">You can change this once. Your old link will continue to redirect, and the new username is permanent.</p><form id="username-form"><label for="username-input">New username</label><div class="form-row"><input id="username-input" type="text" placeholder="new-username" maxlength="30" pattern="[a-z0-9][a-z0-9_\-]{1,28}[a-z0-9]" required /><button type="submit">Review &amp; save</button></div><p id="username-hint" class="live"></p><p id="username-msg" class="live" aria-live="polite"></p></form></> : <p class="help">Your username is locked because the one permitted change has been used.</p>}</div></section>
        <section><h2>Privacy</h2><div class="settings-card switches"><p>Leaderboard visibility and public trip sharing are independent choices.</p><div class="switch-row"><div><strong>Show me on the leaderboard</strong><small>Your rank and leaderboard entry become public.</small></div><button id="toggle-leaderboard" type="button" role="switch" aria-label="Show me on the leaderboard" aria-checked={userRow?.leaderboardOptOut !== 1} data-on={userRow?.leaderboardOptOut !== 1 ? 'true' : 'false'}><span></span></button></div><div class="switch-row"><div><strong>Show my trips publicly</strong><small>Publishes confirmed trip names and map locations on your public profile.</small></div><button id="toggle-show-trips" type="button" role="switch" aria-label="Show my trips publicly" aria-checked={userRow?.showTripsPublicly === 1} data-on={userRow?.showTripsPublicly === 1 ? 'true' : 'false'}><span></span></button></div><p id="privacy-msg" class="live" aria-live="polite"></p></div></section>
        <section><h2>Account &amp; support</h2><div class="settings-card account-links"><a href={supportHref}>Contact support</a><a href={dataRequestHref}>Request data access or account deletion</a><form method="POST" action="/api/auth/logout"><button type="submit" class="outline">Sign out</button></form></div></section>
      </main>}
    </div>
  </ProfileChrome>
</BaseLayout>

<script>
  async function postSettings(body: object) { const res = await fetch('/api/profile/settings', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) }); return res.json(); }
  async function copyText(value: string, fallback: HTMLElement | null) { try { await navigator.clipboard.writeText(value); return true; } catch { if(fallback){const r=document.createRange();r.selectNodeContents(fallback);const s=getSelection();s?.removeAllRanges();s?.addRange(r);} return false; } }
  function setLive(id:string,text:string,error=false){const el=document.getElementById(id);if(!el)return;el.textContent=text;el.classList.toggle('error',error)}
  document.getElementById('share-profile-copy')?.addEventListener('click',async(e)=>{const b=e.currentTarget as HTMLButtonElement;const ok=await copyText(b.dataset.url??'',document.getElementById('share-profile-url'));setLive('share-profile-copied',ok?'Profile link copied.':'Link selected. Press Ctrl/Cmd+C to copy.',!ok)});
  document.getElementById('share-banner-copy')?.addEventListener('click',async(e)=>{const b=e.currentTarget as HTMLButtonElement;const ok=await copyText(b.dataset.url??'',document.getElementById('share-banner-url'));setLive('share-banner-copied',ok?'Profile link copied.':'Link selected. Press Ctrl/Cmd+C to copy.',!ok);if(b.dataset.regId)fetch('/api/profile/share-dismiss',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({registrationId:Number(b.dataset.regId),action:'share'})})});
  document.getElementById('share-banner-dismiss')?.addEventListener('click',()=>{const b=document.getElementById('share-banner-copy') as HTMLButtonElement|null;document.getElementById('share-banner')?.remove();if(b?.dataset.regId)fetch('/api/profile/share-dismiss',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({registrationId:Number(b.dataset.regId),action:'dismiss'})})});
  const displayForm=document.getElementById('display-name-form') as HTMLFormElement|null;displayForm?.addEventListener('submit',async(e)=>{e.preventDefault();const input=document.getElementById('display-name-input') as HTMLInputElement;const button=displayForm.querySelector('button') as HTMLButtonElement;button.disabled=input.disabled=true;try{const data=await postSettings({action:'setDisplayName',displayName:input.value.trim()});setLive('display-name-msg',data.error??'Display name saved.',!data.success);if(data.success)setTimeout(()=>location.reload(),500)}finally{button.disabled=input.disabled=false}});
  const USERNAME_RE=/^[a-z0-9][a-z0-9_-]{1,28}[a-z0-9]$|^[a-z0-9]{1,30}$/;const RESERVED=new Set(['admin','owner','root','api','login','logout','register','profile','leaderboard','trips','about','contact','me','null','undefined','system','support','help','team','seekthethrill','stt','user','users']);
  function usernameError(v:string){if(v.length<3)return'Must be at least 3 characters.';if(!USERNAME_RE.test(v))return'Use letters, numbers, hyphens, and underscores; start and end with a letter or number.';if(RESERVED.has(v))return'That username is reserved.';return null}
  const usernameForm=document.getElementById('username-form') as HTMLFormElement|null;const usernameInput=document.getElementById('username-input') as HTMLInputElement|null;usernameInput?.addEventListener('input',()=>setLive('username-hint',usernameError(usernameInput.value.trim().toLowerCase())??''));usernameForm?.addEventListener('submit',async(e)=>{e.preventDefault();const username=usernameInput?.value.trim().toLowerCase()??'';const error=usernameError(username);if(error){setLive('username-msg',error,true);return}const url=`${location.origin}/u/${username}`;if(!confirm(`Your new public profile will be:\n${url}\n\nThis username change is permanent. Your old link will redirect here. Continue?`))return;const button=usernameForm.querySelector('button') as HTMLButtonElement;button.disabled=true;if(usernameInput)usernameInput.disabled=true;try{const data=await postSettings({action:'setUsername',username});setLive('username-msg',data.error??'Username saved.',!data.success);if(data.success)setTimeout(()=>location.reload(),500)}finally{button.disabled=false;if(usernameInput)usernameInput.disabled=false}});
  function paintSwitch(button:HTMLButtonElement,on:boolean){button.dataset.on=String(on);button.setAttribute('aria-checked',String(on))}
  function bindSwitch(id:string,action:string){const button=document.getElementById(id) as HTMLButtonElement|null;button?.addEventListener('click',async()=>{const before=button.dataset.on==='true';paintSwitch(button,!before);button.disabled=true;try{const data=await postSettings({action,value:!before});if(!data.success){paintSwitch(button,before);setLive('privacy-msg',data.error??'Could not save your preference.',true)}else setLive('privacy-msg','Privacy preference saved.')}catch{paintSwitch(button,before);setLive('privacy-msg','Could not save your preference.',true)}finally{button.disabled=false}})}bindSwitch('toggle-leaderboard','setLeaderboard');bindSwitch('toggle-show-trips','setShowTrips');
</script>

<style>
  .dashboard{padding-top:2rem}.identity{display:flex;align-items:center;gap:1rem;min-width:0}.identity img,.avatar-fallback{width:4rem;height:4rem;border-radius:50%;object-fit:cover;flex:0 0 auto}.avatar-fallback{display:grid;place-items:center;background:var(--color-cta);color:#fff;font-size:1.35rem;font-weight:800}.identity-copy{min-width:0}.identity h1{font-family:var(--font-display);font-size:clamp(1.45rem,3vw,2rem);font-weight:700;overflow-wrap:anywhere}.identity p{overflow-wrap:anywhere}.username{color:var(--color-coral-ink);font-family:monospace;font-size:.86rem}.email{color:var(--color-gray-text);font-size:.82rem}.provenance{margin-top:.2rem;color:var(--color-gray-text);font-size:.7rem}
  .profile-tabs{display:flex;gap:.25rem;margin:1.6rem 0 2rem;border-bottom:1px solid var(--color-peach);overflow-x:auto}.profile-tabs a{min-width:max-content;min-height:48px;padding:.8rem 1rem;display:flex;align-items:center;border-bottom:3px solid transparent;color:var(--color-gray-text);font-size:.86rem;font-weight:700}.profile-tabs a[aria-current=page]{border-color:var(--color-coral);color:var(--color-navy)}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid var(--color-coral);outline-offset:2px}
  .share-banner{position:relative;margin-bottom:1.5rem;padding:1rem 3rem 1rem 1rem;border:1px solid var(--color-peach);border-radius:1rem;background:var(--color-blush)}.share-banner>button{position:absolute;right:.7rem;top:.45rem;width:44px;height:44px;font-size:1.4rem}.share-banner p{font-size:.78rem;color:var(--color-gray-text)}.share-banner>div{display:flex;gap:.5rem;margin-top:.7rem;min-width:0}.share-banner code,.action-card code{display:block;min-width:0;padding:.6rem;border-radius:.6rem;background:#fff;font-size:.7rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.share-banner code{flex:1}.share-banner div button,.action-card button,.settings-card button,.support-strip>a{min-height:44px;padding:.65rem .9rem;border-radius:.75rem;background:var(--color-cta);color:#fff;font-size:.78rem;font-weight:700}
  .panel-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(15rem,1fr);gap:2rem}.main-column,.side-column,.trips-panel,.settings-panel{min-width:0}.main-column>section+section,.trips-panel>section,.settings-panel>section{margin-top:2rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.85rem}.section-heading h2,.page-intro h2,.trips-panel section>h2,.settings-panel>section>h2{font-family:var(--font-display);font-size:1.2rem;font-weight:700}.section-heading p,.page-intro p{color:var(--color-gray-text);font-size:.78rem}.section-heading a{min-height:44px;display:flex;align-items:center;color:var(--color-coral-ink);font-size:.78rem;font-weight:700;white-space:nowrap}.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem}.stats-grid div{min-width:0;padding:1rem .65rem;border-radius:1rem;background:var(--color-blush);text-align:center}.stats-grid strong{display:block;font-family:var(--font-display);font-size:clamp(1rem,2vw,1.35rem);overflow-wrap:anywhere}.stats-grid span{display:block;margin-top:.15rem;color:var(--color-gray-text);font-size:.67rem}.empty-state{padding:1.25rem;border-radius:1rem;background:var(--color-blush);color:var(--color-gray-text);font-size:.82rem}.empty-state strong{color:var(--color-navy)}.empty-state a{display:inline-block;margin-top:.6rem;color:var(--color-coral-ink);font-weight:700}.card-stack{display:flex;flex-direction:column;gap:.75rem}
  .side-column{display:flex;flex-direction:column;gap:1rem}.action-card,.support-card,.support-strip{padding:1.1rem;border:1px solid var(--color-peach);border-radius:1rem;background:#fff}.action-card h2,.support-card h2,.support-strip h2{font-size:.92rem;font-weight:700}.action-card code{margin:.75rem 0}.action-card button{width:100%;margin-bottom:.35rem}.action-card a,.support-card a,.account-links a{min-height:44px;display:flex;align-items:center;color:var(--color-coral-ink);font-size:.78rem;font-weight:700}.support-card p,.support-strip p{margin:.35rem 0;color:var(--color-gray-text);font-size:.77rem}.live{min-height:1rem;margin-top:.4rem;color:var(--color-success-ink);font-size:.72rem}.live.error{color:var(--color-danger-ink)}
  .page-intro{margin-bottom:1.5rem}.trips-panel{max-width:52rem}.trips-panel section>h2{margin-bottom:.75rem}.trips-panel section>h2 span{font-family:var(--font-sans);font-size:.7rem;color:var(--color-gray-text)}.pagination{min-height:52px;margin-top:.8rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;font-size:.76rem;color:var(--color-gray-text)}.pagination a{min-height:44px;display:flex;align-items:center;color:var(--color-coral-ink);font-weight:700}.pagination a:last-child{justify-self:end}.support-strip{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .settings-panel{max-width:48rem}.settings-card{padding:1.1rem;border:1px solid var(--color-peach);border-radius:1rem;background:#fff}.settings-panel>section>h2{margin-bottom:.65rem}.settings-card label,.readonly span{display:block;margin-bottom:.35rem;font-size:.76rem;font-weight:700}.form-row{display:flex;gap:.55rem}.settings-card input{min-width:0;min-height:44px;flex:1;padding:.7rem .8rem;border:1px solid var(--color-peach);border-radius:.75rem;background:#fff;font-size:.85rem}.readonly{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--color-peach)}.readonly strong{display:block;font-size:.84rem;overflow-wrap:anywhere}.readonly small,.help,.switch-row small{display:block;color:var(--color-gray-text);font-size:.72rem}.settings-card>p{font-size:.82rem}.help{margin:.35rem 0 1rem}.switches>p{margin-bottom:.5rem;color:var(--color-gray-text)}.switch-row{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-top:1px solid var(--color-peach)}.switch-row strong{display:block;font-size:.82rem}.switch-row button{position:relative;width:48px;height:28px;min-height:28px;padding:0;border-radius:999px;background:var(--color-gray-text);flex:0 0 auto}.switch-row button span{position:absolute;left:3px;top:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .15s}.switch-row button[data-on=true]{background:var(--color-coral)}.switch-row button[data-on=true] span{transform:translateX(20px)}button:disabled{cursor:wait;opacity:.55}.account-links form{margin-top:.5rem}.settings-card button.outline{width:100%;background:#fff;color:var(--color-coral-ink);border:1px solid var(--color-coral-ink)}
  @media(max-width:800px){.panel-grid{grid-template-columns:1fr}.side-column{display:grid;grid-template-columns:1fr 1fr}.stats-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.dashboard{padding-top:1.25rem}.side-column{display:flex}.section-heading{align-items:flex-start}.share-banner>div,.form-row,.support-strip{align-items:stretch;flex-direction:column}.share-banner div button,.form-row button{width:100%}.profile-tabs a{flex:1;justify-content:center;padding-inline:.6rem}.identity img,.avatar-fallback{width:3.4rem;height:3.4rem}.support-strip>a{text-align:center;justify-content:center}}
</style>
