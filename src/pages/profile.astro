---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb } from '../lib/db';
import { readTrip } from '../lib/content';
import { SITE_HOST, siteUrl } from '../lib/siteUrl';

export const prerender = false;

const user = Astro.locals.user!;

const db = getDb();

const userRow = db.prepare(`
  SELECT username, usernameChangedAt, leaderboardOptOut, showTripsPublicly
  FROM users WHERE id = ?
`).get(user.id) as {
  username: string | null;
  usernameChangedAt: number | null;
  leaderboardOptOut: number;
  showTripsPublicly: number;
} | undefined;

const stats = db.prepare(`
  SELECT kmsFromHome, daysOutdoors, destinationsCount, tripsCount
  FROM leaderboard_cache WHERE userId = ?
`).get(user.id) as {
  kmsFromHome: number;
  daysOutdoors: number;
  destinationsCount: number;
  tripsCount: number;
} | undefined;

// Detect "newly completed" trips for share banner:
// confirmed + sharedAt IS NULL + batch endDate has passed
const shareCandidates = db.prepare(`
  SELECT id, trip_name, trip_slug, batch_id
  FROM registrations
  WHERE email = ? AND status = 'confirmed' AND sharedAt IS NULL
  ORDER BY created_at DESC
`).all(user.email) as { id: number; trip_name: string; trip_slug: string | null; batch_id: string | null }[];

interface ShareBannerTrip { id: number; tripName: string }
let shareBannerTrip: ShareBannerTrip | null = null;

const now = Date.now();
for (const reg of shareCandidates) {
  if (!reg.trip_slug || !reg.batch_id) continue;
  try {
    const trip = readTrip(reg.trip_slug);
    const batch = (trip?.batches as any[])?.find((b: any) => b.id === reg.batch_id);
    if (batch?.endDate && new Date(batch.endDate).getTime() < now) {
      shareBannerTrip = { id: reg.id, tripName: reg.trip_name };
      break;
    }
  } catch { /* skip if YAML can't be read */ }
}

const PAGE_SIZE = 10;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'));
const offset = (page - 1) * PAGE_SIZE;

const { total: totalBookings } = db.prepare(`
  SELECT COUNT(*) as total FROM registrations WHERE email = ?
`).get(user.email) as { total: number };
const totalPages = Math.max(1, Math.ceil(totalBookings / PAGE_SIZE));

const bookings = db.prepare(`
  SELECT trip_name, trip_date, batch_id, status, created_at
  FROM registrations
  WHERE email = ?
  ORDER BY created_at DESC
  LIMIT ? OFFSET ?
`).all(user.email, PAGE_SIZE, offset) as {
  trip_name: string;
  trip_date: string | null;
  batch_id: string | null;
  status: string;
  created_at: string;
}[];

const statusLabel: Record<string, { label: string; color: string }> = {
  lead:      { label: 'Registered',  color: 'var(--color-gray-text)' },
  pending:   { label: 'Pending',     color: '#F59E0B' },
  confirmed: { label: 'Confirmed',   color: '#10B981' },
  rejected:  { label: 'Rejected',    color: 'var(--color-coral)' },
};

const firstName = user.displayName?.split(' ')[0] ?? 'Traveller';
const canChangeUsername = !userRow?.usernameChangedAt;
---

<BaseLayout title={`${firstName}'s Profile — Seek the Thrill`} description="Your trips and adventures with Seek the Thrill." robots="noindex, follow" nav="back">
  <div class="container-app py-10 max-w-lg mx-auto">

    <!-- Share banner: shown once after a trip completes -->
    {shareBannerTrip && userRow?.username && (
      <div id="share-banner" class="rounded-2xl p-4 mb-8 relative" style="background: var(--color-blush); border: 1px solid var(--color-peach);">
        <button id="share-banner-dismiss" aria-label="Dismiss"
                class="absolute top-3 right-3 text-lg leading-none hover:opacity-60"
                style="color: var(--color-gray-text);">×</button>
        <p class="text-sm font-semibold mb-0.5" style="color: var(--color-navy);">
          {shareBannerTrip.tripName} just wrapped. Your profile is updated.
        </p>
        <div class="flex items-center gap-2 mt-3">
          <code id="share-banner-url" class="text-xs px-2 py-1 rounded-lg flex-1 truncate"
                style="background: white; color: var(--color-navy); border: 1px solid var(--color-peach);">
            {SITE_HOST}/u/{userRow.username}
          </code>
          <button id="share-banner-copy"
                  data-url={siteUrl(`/u/${userRow.username}`)}
                  data-reg-id={String(shareBannerTrip.id)}
                  class="px-3 py-1.5 rounded-xl text-sm font-semibold text-white flex-shrink-0 transition-opacity hover:opacity-80"
                  style="background: var(--color-coral);">
            Copy link
          </button>
        </div>
        <p id="share-banner-copied" class="text-xs mt-2 hidden" style="color: var(--color-coral);">Copied!</p>
      </div>
    )}

    <!-- User header -->
    <div class="flex items-center gap-4 mb-10">
      {user.avatarUrl ? (
        <img src={user.avatarUrl} alt={firstName} class="w-14 h-14 rounded-full object-cover" referrerpolicy="no-referrer" />
      ) : (
        <div class="w-14 h-14 rounded-full flex items-center justify-center text-white text-xl font-bold"
             style="background: var(--color-coral);">
          {firstName[0].toUpperCase()}
        </div>
      )}
      <div>
        <p class="font-semibold text-lg" style="color: var(--color-navy);">{user.displayName ?? firstName}</p>
        {userRow?.username && (
          <p class="text-sm font-mono" style="color: var(--color-coral);">@{userRow.username}</p>
        )}
        <p class="text-sm" style="color: var(--color-gray-text);">{user.email}</p>
      </div>
    </div>

    <!-- Stats (only populated when user has confirmed trips in leaderboard) -->
    {stats ? (
      <div class="grid grid-cols-3 gap-3 mb-10">
        {[
          { value: `${stats.kmsFromHome.toLocaleString('en-IN')} km`, label: 'from home' },
          { value: String(stats.daysOutdoors), label: 'days outdoors' },
          { value: String(stats.destinationsCount), label: 'destinations' },
        ].map((s) => (
          <div class="rounded-xl p-4 text-center" style="background: var(--color-blush);">
            <p class="text-xl font-bold" style="font-family: var(--font-display); color: var(--color-navy);">{s.value}</p>
            <p class="text-xs mt-0.5" style="color: var(--color-gray-text);">{s.label}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-xl p-6 text-center mb-10" style="background: var(--color-blush);">
        <p class="text-sm mb-3" style="color: var(--color-gray-text);">Complete a trip to start tracking your stats.</p>
        <a href="/trips/" class="text-sm font-semibold" style="color: var(--color-coral);">Explore trips →</a>
      </div>
    )}

    <!-- My Trips -->
    <h2 class="text-base font-semibold mb-4" style="color: var(--color-navy);">My Trips</h2>

    {bookings.length === 0 ? (
      <div class="rounded-xl p-6 text-center mb-10" style="background: var(--color-blush);">
        <p class="text-sm mb-3" style="color: var(--color-gray-text);">No trips yet.</p>
        <a href="/trips/" class="text-sm font-semibold" style="color: var(--color-coral);">Explore trips →</a>
      </div>
    ) : (
      <div class="flex flex-col gap-3 mb-3">
        {bookings.map((b) => {
          const s = statusLabel[b.status] ?? { label: b.status, color: 'var(--color-gray-text)' };
          return (
            <div class="rounded-xl px-4 py-4 flex items-center justify-between" style="background: white; border: 1px solid var(--color-peach);">
              <div>
                <p class="font-medium text-sm" style="color: var(--color-navy);">{b.trip_name}</p>
                {b.trip_date && (
                  <p class="text-xs mt-0.5" style="color: var(--color-gray-text);">{b.trip_date}</p>
                )}
              </div>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full" style={`color: ${s.color}; background: ${s.color}1a;`}>
                {s.label}
              </span>
            </div>
          );
        })}
      </div>
    )}

    {totalPages > 1 && (
      <div class="flex items-center justify-between mb-10 text-sm">
        {page > 1 ? (
          <a href={`?page=${page - 1}`} class="font-semibold" style="color: var(--color-coral);">← Prev</a>
        ) : <span />}
        <span style="color: var(--color-gray-text);">Page {page} of {totalPages}</span>
        {page < totalPages ? (
          <a href={`?page=${page + 1}`} class="font-semibold" style="color: var(--color-coral);">Next →</a>
        ) : <span />}
      </div>
    )}

    <!-- Display name -->
    <h2 class="text-base font-semibold mb-4" style="color: var(--color-navy);">Display name</h2>
    <div class="rounded-xl p-4 mb-10" style="border: 1px solid var(--color-peach);">
      <form id="display-name-form" class="flex gap-2">
        <input
          id="display-name-input"
          type="text"
          value={user.displayName ?? ''}
          maxlength="50"
          class="flex-1 px-3 py-2 rounded-xl text-sm border outline-none focus:ring-2"
          style="border-color: var(--color-peach); --tw-ring-color: var(--color-coral);"
        />
        <button type="submit"
                class="px-4 py-2 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-80"
                style="background: var(--color-coral);">
          Save
        </button>
      </form>
      <p id="display-name-msg" class="text-xs mt-2 hidden" aria-live="polite"></p>
    </div>

    <!-- Username -->
    <h2 class="text-base font-semibold mb-4" style="color: var(--color-navy);">Username</h2>
    <div class="rounded-xl p-4 mb-10" style="border: 1px solid var(--color-peach);">
      {userRow?.username ? (
        <div>
          <p class="text-sm font-mono font-medium mb-1" style="color: var(--color-navy);">@{userRow.username}</p>
          {canChangeUsername ? (
            <p class="text-xs mb-3" style="color: var(--color-gray-text);">You can change your username once.</p>
          ) : (
            <p class="text-xs mb-3" style="color: var(--color-gray-text);">Your username is locked — it can only be changed once.</p>
          )}
        </div>
      ) : (
        <p class="text-xs mb-3" style="color: var(--color-gray-text);">No username set yet.</p>
      )}

      {canChangeUsername && (
        <form id="username-form" class="flex gap-2">
          <input
            id="username-input"
            type="text"
            placeholder="new-username"
            maxlength="30"
            pattern="[a-z0-9][a-z0-9_\-]{1,28}[a-z0-9]"
            class="flex-1 px-3 py-2 rounded-xl text-sm border outline-none focus:ring-2"
            style="border-color: var(--color-peach); font-family: monospace; --tw-ring-color: var(--color-coral);"
          />
          <button type="submit"
                  class="px-4 py-2 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-80"
                  style="background: var(--color-coral);">
            Save
          </button>
        </form>
      )}
      <p id="username-hint" class="text-xs mt-2 hidden" style="color: var(--color-gray-text);"></p>
      <p id="username-msg" class="text-xs mt-2 hidden" aria-live="polite"></p>
    </div>

    <!-- Privacy -->
    <h2 class="text-base font-semibold mb-4" style="color: var(--color-navy);">Privacy</h2>
    <div class="rounded-xl p-4 mb-10 flex flex-col gap-4" style="border: 1px solid var(--color-peach);">
      <div class="flex items-center justify-between gap-3">
        <span class="text-sm" style="color: var(--color-navy);">Show me on the leaderboard</span>
        <button
          id="toggle-leaderboard"
          type="button"
          role="switch"
          aria-checked={userRow?.leaderboardOptOut !== 1}
          data-on={userRow?.leaderboardOptOut !== 1 ? 'true' : 'false'}
          class="w-10 h-6 rounded-full relative flex-shrink-0 transition-colors"
          style={`background: ${userRow?.leaderboardOptOut !== 1 ? 'var(--color-coral)' : 'var(--color-gray-text)'};`}
        >
          <span
            class="toggle-knob absolute top-0.5 w-5 h-5 rounded-full bg-white transition-all"
            style={`left: ${userRow?.leaderboardOptOut !== 1 ? '1.125rem' : '0.125rem'};`}
          ></span>
        </button>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-sm" style="color: var(--color-navy);">Show my trips publicly</span>
        <button
          id="toggle-show-trips"
          type="button"
          role="switch"
          aria-checked={userRow?.showTripsPublicly === 1}
          data-on={userRow?.showTripsPublicly === 1 ? 'true' : 'false'}
          class="w-10 h-6 rounded-full relative flex-shrink-0 transition-colors"
          style={`background: ${userRow?.showTripsPublicly === 1 ? 'var(--color-coral)' : 'var(--color-gray-text)'};`}
        >
          <span
            class="toggle-knob absolute top-0.5 w-5 h-5 rounded-full bg-white transition-all"
            style={`left: ${userRow?.showTripsPublicly === 1 ? '1.125rem' : '0.125rem'};`}
          ></span>
        </button>
      </div>
      <p id="privacy-msg" class="text-xs hidden" aria-live="polite"></p>
    </div>

    <!-- Share profile -->
    {userRow?.username && (
      <div class="rounded-xl p-4 mb-6" style="border: 1px solid var(--color-peach);">
        <p class="text-sm font-medium mb-3" style="color: var(--color-navy);">Share your profile</p>
        <div class="flex items-center gap-2">
          <code id="share-profile-url" class="text-xs px-2 py-1.5 rounded-lg flex-1 truncate"
                style="background: var(--color-blush); color: var(--color-navy);">
            {SITE_HOST}/u/{userRow.username}
          </code>
          <button id="share-profile-copy"
                  data-url={siteUrl(`/u/${userRow.username}`)}
                  class="px-3 py-1.5 rounded-xl text-sm font-semibold text-white flex-shrink-0 transition-opacity hover:opacity-80"
                  style="background: var(--color-coral);">
            Copy
          </button>
        </div>
        <p id="share-profile-copied" class="text-xs mt-2 hidden" style="color: var(--color-coral);">Copied!</p>
      </div>
    )}

    <!-- Leaderboard link -->
    <a href="/leaderboard" class="flex items-center justify-between px-4 py-4 rounded-xl mb-6 transition-opacity hover:opacity-80"
       style="background: var(--color-blush);">
      <span class="text-sm font-medium" style="color: var(--color-navy);">View leaderboard</span>
      <span style="color: var(--color-coral);">→</span>
    </a>

    <!-- Sign out -->
    <form method="POST" action="/api/auth/logout">
      <button type="submit" class="w-full py-3.5 rounded-full text-sm font-semibold border transition-all hover:opacity-70"
              style="color: var(--color-coral); border-color: var(--color-coral);">
        Sign out
      </button>
    </form>

  </div>
</BaseLayout>

<script>
  // Share banner
  async function markShareBanner(regId: string, action: 'share' | 'dismiss') {
    await fetch('/api/profile/share-dismiss', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ registrationId: parseInt(regId), action }),
    });
  }

  // Copies text to clipboard; on failure, selects codeEl's text so the user can copy manually.
  async function copyText(text: string, codeEl: HTMLElement | null): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      if (codeEl) {
        const range = document.createRange();
        range.selectNodeContents(codeEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      return false;
    }
  }

  // Share profile (permanent)
  document.getElementById('share-profile-copy')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const url = btn.dataset.url ?? '';
    const ok = await copyText(url, document.getElementById('share-profile-url'));
    const msg = document.getElementById('share-profile-copied');
    if (msg) {
      msg.textContent = ok ? 'Copied!' : 'Could not copy automatically — text selected, press Ctrl/Cmd+C.';
      msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), ok ? 2000 : 5000);
    }
  });

  // Share banner (post-trip)
  document.getElementById('share-banner-copy')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const url = btn.dataset.url ?? '';
    const regId = btn.dataset.regId ?? '';
    const ok = await copyText(url, document.getElementById('share-banner-url'));
    const msg = document.getElementById('share-banner-copied');
    if (msg) {
      msg.textContent = ok ? 'Copied!' : 'Could not copy automatically — text selected, press Ctrl/Cmd+C.';
      msg.classList.remove('hidden');
      setTimeout(() => msg.classList.add('hidden'), ok ? 2000 : 5000);
    }
    if (regId) markShareBanner(regId, 'share');
  });

  document.getElementById('share-banner-dismiss')?.addEventListener('click', () => {
    const btn = document.getElementById('share-banner-copy') as HTMLButtonElement | null;
    const regId = btn?.dataset.regId ?? '';
    document.getElementById('share-banner')?.remove();
    if (regId) markShareBanner(regId, 'dismiss');
  });

  // Username form
  // Keep in sync with USERNAME_RE / validateUsername in src/lib/usernames.ts
  const USERNAME_RE = /^[a-z0-9][a-z0-9_-]{1,28}[a-z0-9]$|^[a-z0-9]{1,30}$/;
  const RESERVED = new Set([
    'admin', 'owner', 'root', 'api', 'login', 'logout', 'register', 'profile',
    'leaderboard', 'trips', 'about', 'contact', 'me', 'null', 'undefined',
    'system', 'support', 'help', 'team', 'seekthethrill', 'stt', 'user', 'users',
  ]);
  function validateUsernameClientSide(username: string): string | null {
    if (!username) return null;
    if (username.length < 3) return 'Must be at least 3 characters.';
    if (username.length > 30) return 'Must be 30 characters or fewer.';
    if (!USERNAME_RE.test(username)) return 'Use only letters, numbers, hyphens, and underscores (start/end with a letter or number).';
    if (RESERVED.has(username)) return 'That username is reserved.';
    return null;
  }

  const usernameForm = document.getElementById('username-form') as HTMLFormElement | null;
  const usernameInput = document.getElementById('username-input') as HTMLInputElement | null;
  const usernameHint = document.getElementById('username-hint') as HTMLElement | null;
  const usernameMsg = document.getElementById('username-msg') as HTMLElement | null;

  usernameInput?.addEventListener('input', () => {
    const err = validateUsernameClientSide(usernameInput.value.trim().toLowerCase());
    if (usernameHint) {
      usernameHint.textContent = err ?? '';
      usernameHint.classList.toggle('hidden', !err);
    }
  });

  usernameForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = usernameInput?.value.trim().toLowerCase() ?? '';
    if (!username) return;

    const submitBtn = usernameForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (usernameInput) usernameInput.disabled = true;

    try {
      const res = await fetch('/api/profile/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'setUsername', username }),
      });
      const data = await res.json();

      if (usernameMsg) {
        usernameMsg.textContent = data.error ?? 'Username saved!';
        usernameMsg.style.color = data.success ? 'var(--color-coral)' : '#ef4444';
        usernameMsg.classList.remove('hidden');
      }

      if (data.success) {
        setTimeout(() => location.reload(), 800);
        return;
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (usernameInput) usernameInput.disabled = false;
    }
  });

  // Display name form
  const displayNameForm = document.getElementById('display-name-form') as HTMLFormElement | null;
  const displayNameInput = document.getElementById('display-name-input') as HTMLInputElement | null;
  const displayNameMsg = document.getElementById('display-name-msg') as HTMLElement | null;

  displayNameForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const displayName = displayNameInput?.value.trim() ?? '';
    if (!displayName) return;

    const submitBtn = displayNameForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (displayNameInput) displayNameInput.disabled = true;

    try {
      const res = await fetch('/api/profile/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'setDisplayName', displayName }),
      });
      const data = await res.json();

      if (displayNameMsg) {
        displayNameMsg.textContent = data.error ?? 'Display name saved!';
        displayNameMsg.style.color = data.success ? 'var(--color-coral)' : '#ef4444';
        displayNameMsg.classList.remove('hidden');
      }

      if (data.success) setTimeout(() => location.reload(), 800);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (displayNameInput) displayNameInput.disabled = false;
    }
  });

  // Privacy toggles
  const privacyMsg = document.getElementById('privacy-msg') as HTMLElement | null;

  function showPrivacyMsg(text: string, isError: boolean) {
    if (!privacyMsg) return;
    privacyMsg.textContent = text;
    privacyMsg.style.color = isError ? '#ef4444' : 'var(--color-coral)';
    privacyMsg.classList.remove('hidden');
    setTimeout(() => privacyMsg.classList.add('hidden'), 2000);
  }

  function paintToggle(btn: HTMLButtonElement, on: boolean) {
    btn.dataset.on = on ? 'true' : 'false';
    btn.setAttribute('aria-checked', String(on));
    btn.style.background = on ? 'var(--color-coral)' : 'var(--color-gray-text)';
    const knob = btn.querySelector('.toggle-knob') as HTMLElement | null;
    if (knob) knob.style.left = on ? '1.125rem' : '0.125rem';
  }

  function bindToggle(id: string, action: 'setLeaderboard' | 'setShowTrips') {
    const btn = document.getElementById(id) as HTMLButtonElement | null;
    btn?.addEventListener('click', async () => {
      const nextOn = btn.dataset.on !== 'true';
      btn.disabled = true;
      paintToggle(btn, nextOn); // optimistic
      try {
        const res = await fetch('/api/profile/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, value: nextOn }),
        });
        const data = await res.json();
        if (!data.success) {
          paintToggle(btn, !nextOn); // revert
          showPrivacyMsg(data.error ?? 'Could not save.', true);
        } else {
          showPrivacyMsg('Saved!', false);
        }
      } catch {
        paintToggle(btn, !nextOn);
        showPrivacyMsg('Could not save.', true);
      } finally {
        btn.disabled = false;
      }
    });
  }

  bindToggle('toggle-leaderboard', 'setLeaderboard');
  bindToggle('toggle-show-trips', 'setShowTrips');
</script>
