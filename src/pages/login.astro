---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

// Already logged in → go to profile
if (Astro.locals.user) return Astro.redirect('/profile');

const next = Astro.url.searchParams.get('next') ?? '/profile';
const loginUrl = `/api/auth/google?next=${encodeURIComponent(next)}`;

const errorMessages: Record<string, string> = {
  oauth_state: 'That sign-in link expired. Please try again.',
  oauth_token: 'Google sign-in is temporarily unavailable. Please try again in a moment.',
  oauth_server: 'Something went wrong finishing your sign-in. Please try again.',
  oauth_config: 'Google sign-in is temporarily unavailable. Please try again in a moment.',
};
const errorMessage = errorMessages[Astro.url.searchParams.get('error') ?? ''] ?? null;
---

<BaseLayout title="Sign in — Seek the Thrill" description="Sign in to track your adventures with Seek the Thrill." robots="noindex, follow" nav="back">
  <div class="container-app py-16 flex flex-col items-center">
    <div class="w-full max-w-sm">
      <h1 class="text-display-sm font-display font-bold mb-2 text-navy">
        Sign in
      </h1>
      <p class="text-sm mb-10 text-gray-text">
        Track your adventures, see your km from home, and join the leaderboard. New here? Signing in with Google sets you up automatically.
      </p>

      {errorMessage && (
        <p
          role="alert"
          class="text-sm mb-6 px-4 py-3 rounded-2xl border border-peach bg-coral/10 text-coral-ink"
        >
          {errorMessage}
        </p>
      )}

      <a
        href={loginUrl}
        class="flex items-center justify-center gap-3 w-full py-3.5 rounded-[var(--radius-pill)] border border-peach bg-white font-semibold text-sm text-navy transition-all hover:shadow-md"
      >
        <!-- Google logo -->
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.35-8.16 2.35-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </a>

      <p class="text-xs text-center mt-6 text-gray-text">
        No password needed. We use your Google account to identify you.
      </p>
    </div>
  </div>
</BaseLayout>
