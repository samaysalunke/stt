---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readAlbum, isAlbumPublic } from '../../lib/content';
import { SITE_ORIGIN, siteUrl } from '../../lib/siteUrl';
import 'glightbox/dist/css/glightbox.css';

export const prerender = false;

const { slug } = Astro.params;
const album = readAlbum(slug!);

if (!album || !isAlbumPublic({ slug, ...album })) return new Response('Not Found', { status: 404 });

const name = (album.name as string) || slug;
const photos = (album.photos ?? []) as any[];

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
}
const subtitle = (album.description as string) || [album.location, formatDate(album.date)].filter(Boolean).join(' · ');
const year = album.date ? new Date(album.date).getFullYear() : new Date().getFullYear();
// Richer social share: use the album cover (or first photo) as the OG image.
const ogImage = (album.coverImage as string) || photos[0]?.image || undefined;
const canonicalUrl = siteUrl(`/photo-vault/${slug}/`);
const albumSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Photo Vault', item: siteUrl('/photo-vault/') },
        { '@type': 'ListItem', position: 3, name, item: canonicalUrl },
      ],
    },
    {
      '@type': 'ImageGallery', name, url: canonicalUrl,
      description: album.seoDescription || album.description || `Photos from our ${name} adventure.`,
      image: photos.slice(0, 20).map((photo) => photo.image),
      creator: { '@id': `${SITE_ORIGIN}/#organization` },
    },
  ],
};
---

<BaseLayout
  title={album.seoTitle || `${name} — The Vault | Seek the Thrill`}
  description={album.seoDescription || album.description || `Photos from our ${name} adventure.`}
  image={album.socialImage || ogImage}
  imageAlt={album.socialImageAlt || `${name} group trip photo album`}
  type="article"
  nav="none"
>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify(albumSchema)} /></Fragment>
  <div style="background-color: var(--color-blush);">
    <!-- Top bar -->
    <header class="mx-auto flex max-w-2xl items-center justify-between px-5 pt-5">
      <a href="/photo-vault/" id="album-back" aria-label="Back" class="grid h-9 w-9 place-items-center rounded-full transition-colors hover:bg-white/70" style="color: var(--color-navy);">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </a>
      <span class="text-[11px] uppercase tracking-[0.25em]" style="color: rgba(27,43,58,0.55);">
        by <span class="font-display italic" style="color: var(--color-coral);">Zahra</span>
      </span>
      <button id="album-share" aria-label="Share" class="grid h-9 w-9 place-items-center rounded-full transition-colors hover:bg-white/70" style="color: var(--color-navy);">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
        </svg>
      </button>
    </header>

    <!-- Title block -->
    <section class="mx-auto max-w-2xl px-5 pt-8 pb-6">
      <h1 class="font-display leading-[1]" style="font-size: 3rem; color: var(--color-navy);">{name}</h1>
      {subtitle && <p class="mt-2 font-display text-lg italic" style="color: var(--color-coral);">{subtitle}</p>}
    </section>

    <!-- Masonry grid -->
    {photos.length > 0 ? (
      <section class="mx-auto max-w-2xl px-5">
        <div class="columns-2 gap-3 [column-fill:_balance]">
          {photos.map((p, i) => (
            <a
              href={p.image}
              data-glightbox="type: image"
              data-gallery="album"
              data-title={p.caption ?? `Photo ${i + 1} of ${name}`}
              class="group mb-3 block break-inside-avoid overflow-hidden rounded-xl"
              style="background-color: var(--color-peach);"
            >
              <img
                src={p.image}
                alt={p.caption ?? `${name} photo ${i + 1}`}
                width={p.width || undefined}
                height={p.height || undefined}
                class="block h-auto w-full transition-transform duration-300 group-hover:scale-105"
                style={p.width && p.height ? `aspect-ratio:${p.width}/${p.height};` : ''}
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section class="mx-auto max-w-2xl px-5 py-16 text-center">
        <h3 class="font-display text-xl mb-2" style="color: var(--color-navy);">Photos coming soon</h3>
        <p style="color: var(--color-gray-text);">We're uploading the memories from this trip.</p>
      </section>
    )}

    <!-- End of vault -->
    <section class="mx-auto max-w-2xl px-5 py-16 text-center">
      <p class="text-[10px] uppercase tracking-[0.3em]" style="color: rgba(27,43,58,0.45);">End of Vault</p>
      <span aria-hidden class="mx-auto mt-3 block h-[2px] w-10 rounded-full" style="background: var(--color-coral);"></span>
    </section>

    <!-- Footer line -->
    <footer class="mx-auto max-w-2xl px-5 pb-10 text-center">
      <p class="text-[10px] uppercase tracking-[0.25em]" style="color: rgba(27,43,58,0.45);">Curated by Zahra © {year}</p>
    </footer>
  </div>
</BaseLayout>

<script>
  const back = document.getElementById('album-back');
  back?.addEventListener('click', (e) => {
    if (window.history.length > 1) { e.preventDefault(); window.history.back(); }
  });
  const share = document.getElementById('album-share');
  share?.addEventListener('click', async () => {
    const url = window.location.href;
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url }); } catch {}
    } else {
      try { await navigator.clipboard.writeText(url); } catch {}
    }
  });

  // GLightbox
  import('glightbox').then(({ default: GLightbox }) => {
    GLightbox({ selector: '[data-glightbox]', touchNavigation: true, loop: true, autoplayVideos: false });
  });
</script>
