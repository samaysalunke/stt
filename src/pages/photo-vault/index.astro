---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listAlbums, isAlbumPublic } from '../../lib/content';

const allAlbums = listAlbums();
const albums = allAlbums
  .filter(isAlbumPublic)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
}

---

<BaseLayout
  title="Photo Vault — Seek the Thrill"
  description="Browse photos from all our past adventures. Relive the memories from our group trips across India."
  robots="noindex, follow"
>
  <!-- Hero — simple text header -->
  <section class="max-w-2xl mx-auto px-5 pt-10 pb-6">
    <h1 class="font-display text-display-lg leading-[1.05] text-navy">
      The Vault
    </h1>
    <p class="mt-2 font-display text-base italic text-gray-text">
      Every memory, raw and unedited.
    </p>
  </section>

  <!-- Albums grid -->
  <section class="pb-16 lg:pb-20">
    <div class="max-w-2xl mx-auto px-5">
      <div id="albums-grid" class="grid grid-cols-1 gap-6">
        {albums.length > 0 ? albums.map((album) => {
          const title = (album.name as string) || album.slug;
          const photos = Array.isArray(album.photos) ? album.photos : [];
          const image = album.coverImage ?? photos[0]?.image;

          return (
          <a
            data-card-skeleton
            data-skeleton-ready={!image ? '' : undefined}
            href={`/photo-vault/${album.slug}/`}
            class="album-card group relative block aspect-[5/6] overflow-hidden rounded-[var(--radius-card)] shadow-md transition-all duration-300 hover:shadow-xl reveal"
            data-title={title.toLowerCase()}
            data-date={album.date ?? ''}
          >
            {image ? (
              <img
                data-skeleton-image
                src={image}
                alt={`${title} album`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="h-full w-full bg-peach"></div>
            )}
            <div class="u-overlay-scrim-bottom absolute inset-0"></div>
            {photos.length > 0 && (
              <div class="absolute top-3 right-3 rounded-[var(--radius-pill)] bg-black/45 px-2.5 py-1 text-xs font-bold text-white backdrop-blur-sm">
                {photos.length} photos
              </div>
            )}
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="font-display font-extrabold text-display-xs text-white leading-tight mb-1">
                {title}
              </h3>
              {album.location && (
                <p class="text-white/80 text-sm flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                  {album.location}
                </p>
              )}
              <div class="flex items-center justify-between mt-2">
                <span class="text-white/60 text-xs">{formatDate(album.date)}</span>
                <span class="text-xs font-bold text-white opacity-0 group-hover:opacity-100 transition-opacity">
                  View Album →
                </span>
              </div>
            </div>
          </a>
          );
        }) : (
          <div class="py-16 text-center">
            <h2 class="font-display text-display-sm text-navy">No albums yet</h2>
            <p class="mt-2 text-sm text-gray-text">New memories will appear here soon.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
