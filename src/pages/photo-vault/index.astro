---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listAlbums } from '../../lib/content';

const allAlbums = listAlbums();
const albums = allAlbums
  .filter((a) => a.published)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
}

const placeholderImgs = [
  'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&auto=format&fit=crop&q=80',
  'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600&auto=format&fit=crop&q=80',
  'https://images.unsplash.com/photo-1559827291-72ee739d0d9a?w=600&auto=format&fit=crop&q=80',
  'https://images.unsplash.com/photo-1583418855676-8a93cf51b4a6?w=600&auto=format&fit=crop&q=80',
];
---

<BaseLayout
  title="Photo Vault — Seek the Thrill"
  description="Browse photos from all our past adventures. Relive the memories from our group trips across India."
>
  <!-- Hero -->
  <section
    class="relative flex items-center justify-center overflow-hidden"
    style="height: 35vh; background-image: url('https://images.unsplash.com/photo-1533669955142-6a73332af4db?w=1920&auto=format&fit=crop&q=80'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-3" style="font-family: var(--font-display);">
        Our Adventures in Pictures
      </h1>
      <p class="text-base md:text-lg text-white/80">Relive the memories from our past trips</p>
    </div>
  </section>

  <!-- Filter Bar -->
  <section class="py-8 bg-white border-b" style="border-color: var(--color-border);">
    <div class="container-app">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="color: var(--color-text-secondary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="vault-search"
            type="text"
            placeholder="Search albums..."
            class="w-full pl-9 pr-4 py-2.5 border rounded-xl text-sm outline-none"
            style="border-color: var(--color-border);"
          />
        </div>
        <select id="vault-sort" class="px-4 py-2.5 border rounded-xl text-sm outline-none" style="border-color: var(--color-border);">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="name">Name A–Z</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Albums grid -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="container-app">
      <div id="albums-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {(albums.length > 0 ? albums.map((album, i) => ({
          href: `/photo-vault/${album.slug}/`,
          img: album.coverImage ?? placeholderImgs[i % placeholderImgs.length],
          title: (album.name as string) || album.slug,
          location: album.location ?? '',
          date: formatDate(album.date),
          rawDate: album.date ?? '',
          photoCount: Array.isArray((album as any).photos) ? (album as any).photos.length : 0,
          isLink: true,
        })) : [
          { href: '#', img: placeholderImgs[0], title: 'Spiti Valley 2023', location: 'Himachal Pradesh, India', date: 'September 2023', rawDate: '2023-09-01', photoCount: 0, isLink: false },
          { href: '#', img: placeholderImgs[1], title: 'Gokarna Beach 2024', location: 'Karnataka, India', date: 'January 2024', rawDate: '2024-01-01', photoCount: 0, isLink: false },
          { href: '#', img: placeholderImgs[2], title: 'Rishikesh Weekend', location: 'Uttarakhand, India', date: 'March 2024', rawDate: '2024-03-01', photoCount: 0, isLink: false },
          { href: '#', img: placeholderImgs[3], title: 'Meghalaya Trek', location: 'Northeast India', date: 'October 2024', rawDate: '2024-10-01', photoCount: 0, isLink: false },
        ]).map((item) => (
          <a
            href={item.href}
            class="album-card group block relative overflow-hidden rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 reveal"
            style="aspect-ratio: 4/3;"
            data-title={item.title.toLowerCase()}
            data-date={item.rawDate}
          >
            <img
              src={item.img}
              alt={`${item.title} album`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.15) 55%, transparent 100%);"></div>
            {item.photoCount > 0 && (
              <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-bold text-white backdrop-blur-sm" style="background: rgba(0,0,0,0.45);">
                {item.photoCount} photos
              </div>
            )}
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="font-extrabold text-lg text-white leading-tight mb-1" style="font-family: var(--font-display);">
                {item.title}
              </h3>
              {item.location && (
                <p class="text-white/80 text-sm flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                  {item.location}
                </p>
              )}
              <div class="flex items-center justify-between mt-2">
                <span class="text-white/60 text-xs">{item.date}</span>
                <span class="text-xs font-bold text-white opacity-0 group-hover:opacity-100 transition-opacity">
                  View Album →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <p id="no-results" class="hidden text-center py-16" style="color: var(--color-text-secondary);">
        No albums match your search.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('vault-search') as HTMLInputElement;
  const sortSelect = document.getElementById('vault-sort') as HTMLSelectElement;
  const grid = document.getElementById('albums-grid') as HTMLElement;
  const noResults = document.getElementById('no-results') as HTMLElement;

  function applyFilters() {
    const q = searchInput.value.toLowerCase().trim();
    const sortVal = sortSelect.value;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.album-card'));

    cards.forEach((card) => {
      const title = card.dataset.title ?? '';
      card.style.display = (!q || title.includes(q)) ? '' : 'none';
    });

    const visible = cards.filter((c) => c.style.display !== 'none');
    noResults.classList.toggle('hidden', visible.length > 0);

    visible.sort((a, b) => {
      const da = a.dataset.date ?? '';
      const db = b.dataset.date ?? '';
      if (sortVal === 'newest') return db.localeCompare(da);
      if (sortVal === 'oldest') return da.localeCompare(db);
      return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
    }).forEach((card) => grid.appendChild(card));
  }

  searchInput?.addEventListener('input', applyFilters);
  sortSelect?.addEventListener('change', applyFilters);
</script>
