---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listAlbums, isAlbumPublic } from '../../lib/content';

const allAlbums = listAlbums();
const albums = allAlbums
  .filter(isAlbumPublic)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

function formatDate(d: string | null | undefined) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
}

---

<BaseLayout
  title="Photo Vault — Seek the Thrill"
  description="Browse photos from all our past adventures. Relive the memories from our group trips across India."
  robots="noindex, follow"
>
  <!-- Hero — simple text header -->
  <section class="max-w-2xl mx-auto px-5 pt-10 pb-6">
    <h1 class="font-display text-[2.75rem] leading-[1.05]" style="color: var(--color-navy);">
      The Vault
    </h1>
    <p class="mt-2 font-display text-base italic" style="color: rgba(27,43,58,0.55);">
      Every memory, raw and unedited.
    </p>
  </section>

  <!-- Albums grid -->
  <section class="pb-16 lg:pb-20">
    <div class="max-w-2xl mx-auto px-5">
      <div id="albums-grid" class="grid grid-cols-1 gap-6">
        {albums.length > 0 ? albums.map((album) => {
          const title = (album.name as string) || album.slug;
          const photos = Array.isArray(album.photos) ? album.photos : [];
          const image = album.coverImage ?? photos[0]?.image;

          return (
          <a
            data-card-skeleton
            data-skeleton-ready={!image ? '' : undefined}
            href={`/photo-vault/${album.slug}/`}
            class="album-card group block relative overflow-hidden rounded-3xl shadow-md hover:shadow-xl transition-all duration-300 reveal"
            style="aspect-ratio: 5/6;"
            data-title={title.toLowerCase()}
            data-date={album.date ?? ''}
          >
            {image ? (
              <img
                data-skeleton-image
                src={image}
                alt={`${title} album`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="h-full w-full" style="background-color: var(--color-peach);"></div>
            )}
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.15) 55%, transparent 100%);"></div>
            {photos.length > 0 && (
              <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-bold text-white backdrop-blur-sm" style="background: rgba(0,0,0,0.45);">
                {photos.length} photos
              </div>
            )}
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="font-extrabold text-lg text-white leading-tight mb-1" style="font-family: var(--font-display);">
                {title}
              </h3>
              {album.location && (
                <p class="text-white/80 text-sm flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                  {album.location}
                </p>
              )}
              <div class="flex items-center justify-between mt-2">
                <span class="text-white/60 text-xs">{formatDate(album.date)}</span>
                <span class="text-xs font-bold text-white opacity-0 group-hover:opacity-100 transition-opacity">
                  View Album →
                </span>
              </div>
            </div>
          </a>
          );
        }) : (
          <div class="py-16 text-center">
            <h2 class="font-display text-2xl" style="color: var(--color-navy);">No albums yet</h2>
            <p class="mt-2 text-sm" style="color: var(--color-gray-text);">New memories will appear here soon.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
