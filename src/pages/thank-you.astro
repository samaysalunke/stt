---
import BaseLayout from '../layouts/BaseLayout.astro';

const tripName = Astro.url.searchParams.get('trip') ?? 'your trip';
---

<BaseLayout
  title="Registration Received — Seek the Thrill"
  description="Your Seek the Thrill registration has been received."
>
  <div class="min-h-screen flex items-center justify-center py-20 px-5" style="background-color: var(--color-gray-soft);">
    <div class="max-w-lg w-full text-center">

      <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6" style="background-color: #22A654;">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="text-3xl md:text-4xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-navy);">
        You're in.
      </h1>
      <p class="text-base mb-8" style="color: var(--color-gray-text);">
        We've received your registration for <strong style="color: var(--color-navy);">{tripName}</strong>. We'll verify your payment and send confirmation within 24 hours.
      </p>

      <div class="bg-white rounded-2xl p-6 mb-8 text-left" style="box-shadow: var(--shadow-card); border-top: 4px solid var(--color-coral);">
        <h2 class="font-bold text-base mb-4" style="font-family: var(--font-display); color: var(--color-navy);">What happens next</h2>
        <ul class="space-y-2.5">
          {[
            'Booking confirmation within 24 hours',
            'Trip prep guide sent to your email',
            "You'll be added to the trip WhatsApp group",
            'Balance payment reminder 15 days before the trip',
          ].map((item) => (
            <li class="flex items-start gap-2.5 text-sm" style="color: var(--color-gray-text);">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color: var(--color-coral);" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/trips/" class="font-semibold text-white px-8 py-3.5 rounded-full hover:opacity-90 transition-all" style="background-color: var(--color-coral);">
          See other trips →
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
