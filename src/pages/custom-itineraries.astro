---
import BaseLayout from '../layouts/BaseLayout.astro';

const heroImg = 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1920&auto=format&fit=crop&q=80';

const steps = [
  {
    n: '01',
    t: 'Tell us what you have in mind',
    d: 'A few lines through the form below — where you’re drawn to, who’s coming, roughly when. No commitment, no charge.',
  },
  {
    n: '02',
    t: 'A 45-minute call',
    d: 'We sit with you and get specific: the pace you want, the places that matter, the things you’d rather skip. This is where a trip starts to take shape.',
  },
  {
    n: '03',
    t: 'Your first itinerary draft',
    d: 'You receive a considered first draft — route, rhythm, and the choices behind it — as a starting point to react to and refine.',
  },
];

// TravelAgency + Service JSON-LD with the ₹1,000 consultation offer.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Seek the Thrill — Custom Itineraries',
  url: 'https://seekthethrill.in/custom-itineraries/',
  description:
    'Bespoke, custom-designed adventure itineraries across India for travellers whose dates, group, or route don’t fit our fixed group departures.',
  areaServed: 'IN',
  makesOffer: {
    '@type': 'Offer',
    name: 'Custom itinerary consultation',
    description:
      '45-minute consultation call plus the creation of a first custom itinerary draft. The full detailed itinerary — bookings, logistics, and revisions — is quoted separately, upfront.',
    price: '1000',
    priceCurrency: 'INR',
    category: 'Consultation',
    itemOffered: {
      '@type': 'Service',
      name: 'Bespoke adventure itinerary design',
      serviceType: 'Custom travel itinerary planning',
      provider: { '@type': 'TravelAgency', name: 'Seek the Thrill' },
      areaServed: 'IN',
    },
  },
};
---

<BaseLayout
  title="Custom Itineraries — Bespoke Adventure Trips in India | Seek the Thrill"
  description="A custom-designed adventure itinerary for the trip that doesn’t fit a fixed departure — your dates, your group, your route across India. Flat ₹1,000 for a 45-minute consultation and a first draft."
  image="/images/og-default.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="height: 56vh; min-height: 420px;">
    <img
      src={heroImg}
      alt="A quiet mountain trail winding into the distance at dawn"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
    <div class="relative z-10 mx-auto flex h-full max-w-4xl flex-col justify-end px-4 pb-14 text-white">
      <p class="mb-3 text-xs uppercase tracking-[0.2em] text-white/70">Custom Itineraries</p>
      <h1 class="font-display font-medium leading-tight text-white" style="font-size: clamp(2.25rem, 5.5vw, 4rem);">
        For the trip that doesn’t fit a fixed date.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-white/85">
        Our group departures suit most people, most of the time. But sometimes the dates are wrong, the group is
        your own, or the route is one only you can picture. When that’s true, we build the trip around you.
      </p>
      <div class="mt-7">
        <a
          href="#enquiry"
          class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-semibold text-white transition-transform hover:scale-[1.03]"
          style="background-color: var(--color-cta);"
        >
          Start a custom trip
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12l-15 0m15 0-6.75 6.75M19.5 12l-6.75-6.75" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-gray-soft);">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="font-display text-3xl lg:text-4xl" style="color: var(--color-navy);">How it works</h2>
      <p class="mt-3 max-w-2xl" style="color: var(--color-gray-text);">
        Three steps to a trip that reads like it was written for you — because it was.
      </p>

      <ol class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {steps.map((s) => (
          <li class="rounded-2xl bg-white p-7">
            <span class="font-display text-2xl" style="color: var(--color-coral);">{s.n}</span>
            <h3 class="mt-3 font-display text-xl" style="color: var(--color-navy);">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-gray-text);">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-16 lg:py-20" style="background-color: var(--color-blush);">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="font-display text-3xl lg:text-4xl" style="color: var(--color-navy);">What it costs</h2>

      <div class="mt-8 rounded-3xl bg-white p-8 lg:p-10">
        <p class="text-xs uppercase tracking-widest" style="color: var(--color-gray-text);">The consultation</p>
        <p class="mt-2 font-display leading-none" style="color: var(--color-navy); font-size: clamp(2.5rem, 7vw, 3.5rem);">
          ₹1,000
        </p>
        <p class="mt-3 text-base leading-relaxed" style="color: var(--color-navy);">
          A flat fee for a 45-minute consultation call and the creation of your first itinerary draft. That’s the
          whole price of getting started — nothing else is charged at this stage.
        </p>

        <div class="mt-6 border-t pt-6" style="border-color: rgba(27,43,58,0.1);">
          <p class="text-sm leading-relaxed" style="color: var(--color-gray-text);">
            If you decide to go ahead, the full detailed itinerary — bookings, logistics, and revisions — is a
            separate piece of work. We quote that upfront, based on the scale of your trip, before any of it begins.
            No hidden costs, no surprises later.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Enquiry form -->
  <section id="enquiry" class="py-16 lg:py-20" style="background-color: var(--color-gray-soft);">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="font-display text-3xl lg:text-4xl" style="color: var(--color-navy);">Tell us about your trip</h2>
      <p class="mt-3" style="color: var(--color-gray-text);">
        The more you tell us, the better the first call. Only your name and email are required — the rest helps us
        prepare. Submitting this form doesn’t charge you anything.
      </p>

      <form id="lead-form" class="mt-8 space-y-5" novalidate>
        <!-- Honeypot: hidden from humans, catnip for bots. Leave empty. -->
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label for="lead-company">Company (leave blank)</label>
          <input type="text" id="lead-company" name="_honey" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="lead-name" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
              Name <span style="color: var(--color-coral);">*</span>
            </label>
            <input
              type="text" id="lead-name" name="name" required autocomplete="name"
              class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
              style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
            />
          </div>
          <div>
            <label for="lead-email" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
              Email <span style="color: var(--color-coral);">*</span>
            </label>
            <input
              type="email" id="lead-email" name="email" required autocomplete="email"
              class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
              style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
            />
          </div>
          <div>
            <label for="lead-phone" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
              Phone / WhatsApp
            </label>
            <input
              type="tel" id="lead-phone" name="phone" autocomplete="tel"
              class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
              style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
            />
          </div>
          <div>
            <label for="lead-destination" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
              Destination or region
            </label>
            <input
              type="text" id="lead-destination" name="destination" placeholder="Spiti, Meghalaya, still deciding…"
              class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
              style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
            />
          </div>
          <div>
            <label for="lead-travellers" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
              Number of travellers
            </label>
            <input
              type="text" id="lead-travellers" name="travellers" inputmode="numeric" placeholder="e.g. 4"
              class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
              style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
            />
          </div>
          <div>
            <label for="lead-dates" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
              Rough dates
            </label>
            <input
              type="text" id="lead-dates" name="dates" placeholder="Mid-October, flexible"
              class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
              style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
            />
          </div>
        </div>

        <div>
          <label for="lead-budget" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
            Rough budget per person <span style="color: var(--color-gray-text); font-weight: 400;">(optional)</span>
          </label>
          <input
            type="text" id="lead-budget" name="budget" placeholder="Helps us pitch it right"
            class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
            style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
          />
        </div>

        <div>
          <label for="lead-message" class="mb-1.5 block text-sm font-medium" style="color: var(--color-navy);">
            Anything else
          </label>
          <textarea
            id="lead-message" name="message" rows="5"
            placeholder="The shape of the trip you’re imagining — pace, must-dos, things to avoid."
            class="w-full rounded-xl border bg-white px-4 py-3 text-sm outline-none focus:border-[var(--color-coral)]"
            style="border-color: rgba(27,43,58,0.15); color: var(--color-navy);"
          ></textarea>
        </div>

        <button
          type="submit" id="lead-submit"
          class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-3.5 text-sm font-semibold text-white transition-transform hover:scale-[1.02] disabled:opacity-60 disabled:hover:scale-100"
          style="background-color: var(--color-cta);"
        >
          Send enquiry
        </button>

        <p id="lead-success" class="hidden rounded-xl p-4 text-sm" style="background-color: var(--color-blush); color: var(--color-navy);" role="status">
          Thank you — we’ve got it. We’ll reach out to set up your consultation call. This didn’t charge you anything.
        </p>
        <p id="lead-error" class="hidden rounded-xl p-4 text-sm" style="background-color: #FEE2E2; color: #991B1B;" role="alert"></p>
      </form>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('lead-form');
      if (!form) return;
      var btn = document.getElementById('lead-submit');
      var success = document.getElementById('lead-success');
      var error = document.getElementById('lead-error');

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        error.classList.add('hidden');

        var fd = new FormData(form);
        var payload = {
          name: fd.get('name'),
          email: fd.get('email'),
          phone: fd.get('phone'),
          destination: fd.get('destination'),
          travellers: fd.get('travellers'),
          dates: fd.get('dates'),
          budget: fd.get('budget'),
          message: fd.get('message'),
          _honey: fd.get('_honey'),
        };

        btn.disabled = true;
        var original = btn.textContent;
        btn.textContent = 'Sending…';

        try {
          var res = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = await res.json();
          if (res.ok && data.success) {
            form.reset();
            form.querySelectorAll('input, textarea, button').forEach(function (el) { el.style.display = 'none'; });
            success.classList.remove('hidden');
            success.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            error.textContent = data.error || 'Something went wrong. Please try again.';
            error.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = original;
          }
        } catch (err) {
          error.textContent = 'Network error. Please check your connection and try again.';
          error.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    })();
  </script>
</BaseLayout>
