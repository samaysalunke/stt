---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listFaqs } from '../lib/content';
import { buildBreadcrumb } from '../lib/breadcrumbs';

// Build category groups from the FAQ collection, preserving order.
const faqs = listFaqs();
const categoryOrder: string[] = [];
const grouped: Record<string, Array<{ q: string; a: string }>> = {};
for (const f of faqs) {
  const cat = (f.category as string) || 'General';
  if (!grouped[cat]) { grouped[cat] = []; categoryOrder.push(cat); }
  grouped[cat].push({ q: f.question, a: f.answer });
}
const categories = categoryOrder.map((name) => ({ name, questions: grouped[name] }));

// ── FAQPage structured data for rich results ──────────────────────────────
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumb([{ name: 'FAQ', path: '/faq/' }]),
    {
      '@type': 'FAQPage',
      mainEntity: faqs.filter((f: any) => f.question && f.answer).map((f: any) => ({
        '@type': 'Question', name: String(f.question),
        acceptedAnswer: { '@type': 'Answer', text: String(f.answer) },
      })),
    },
  ],
} : null;
---

<BaseLayout
  title="FAQ — Seek the Thrill"
  description="Everything you need to know about booking, payment, and what to expect on a Seek the Thrill trip."
>
  {faqSchema && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    </Fragment>
  )}

  <!-- Header -->
  <section class="py-16 bg-blush">
    <div class="container-app text-center">
      <h1 class="text-display-xl font-display font-bold mb-3 text-navy">
        Questions
      </h1>
      <p class="text-base text-gray-text">
        Answers to things people actually ask.
      </p>
    </div>
  </section>

  <!-- FAQ Sections -->
  <section class="py-14 lg:py-20 bg-gray-soft">
    <div class="container-app max-w-3xl">
      {categories.map((category) => (
        <div class="mb-12">
          <h2 class="text-display-sm font-display font-bold mb-5 text-coral-ink">
            {category.name}
          </h2>
          <div class="space-y-2">
            {category.questions.map((item) => (
              <details
                data-card-skeleton
                data-skeleton-ready
                class="bg-white rounded-xl overflow-hidden border border-border group"
              >
                <summary
                  class="px-5 py-4 font-medium text-sm cursor-pointer select-none flex items-center justify-between list-none text-navy"
                >
                  {item.q}
                  <svg
                    class="w-4 h-4 flex-shrink-0 ml-3 text-gray-text transition-transform duration-200 group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 pb-5 pt-1 text-sm leading-relaxed text-gray-text">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <!-- Still have questions -->
      <div class="mt-10 text-center p-8 rounded-2xl bg-blush" data-card-skeleton data-skeleton-ready>
        <h3 class="font-display font-bold text-display-xs mb-2 text-navy">Still have a question?</h3>
        <p class="text-sm mb-5 text-gray-text">WhatsApp is the fastest way to reach us.</p>
        <a
          href="https://wa.me/917975027491?text=Hi%2C%20I%20have%20a%20question%20about%20a%20Seek%20the%20Thrill%20trip."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-white text-sm px-6 py-3 rounded-[var(--radius-pill)] bg-cta"
        >
          Ask on WhatsApp →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
