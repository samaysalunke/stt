---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listFaqs } from '../lib/content';

// Build category groups from the FAQ collection, preserving order.
const faqs = listFaqs();
const categoryOrder: string[] = [];
const grouped: Record<string, Array<{ q: string; a: string }>> = {};
for (const f of faqs) {
  const cat = (f.category as string) || 'General';
  if (!grouped[cat]) { grouped[cat] = []; categoryOrder.push(cat); }
  grouped[cat].push({ q: f.question, a: f.answer });
}
const categories = categoryOrder.map((name) => ({ name, questions: grouped[name] }));

// ── FAQPage structured data for rich results ──────────────────────────────
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs
    .filter((f: any) => f.question && f.answer)
    .map((f: any) => ({
      '@type': 'Question',
      name: String(f.question),
      acceptedAnswer: { '@type': 'Answer', text: String(f.answer) },
    })),
} : null;
---

<BaseLayout
  title="FAQ — Seek the Thrill"
  description="Everything you need to know about booking, payment, and what to expect on a Seek the Thrill trip."
>
  {faqSchema && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    </Fragment>
  )}

  <!-- Header -->
  <section class="py-16" style="background-color: var(--color-blush);">
    <div class="container-app text-center">
      <h1 class="text-5xl lg:text-6xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-navy);">
        Questions
      </h1>
      <p class="text-base" style="color: var(--color-gray-text);">
        Answers to things people actually ask.
      </p>
    </div>
  </section>

  <!-- FAQ Sections -->
  <section class="py-14 lg:py-20" style="background-color: var(--color-gray-soft);">
    <div class="container-app max-w-3xl">
      {categories.map((category) => (
        <div class="mb-12">
          <h2 class="text-2xl font-bold mb-5" style="font-family: var(--font-display); color: var(--color-coral);">
            {category.name}
          </h2>
          <div class="space-y-2">
            {category.questions.map((item) => (
              <details
                class="bg-white rounded-xl overflow-hidden border group"
                style="border-color: var(--color-border);"
              >
                <summary
                  class="px-5 py-4 font-medium text-sm cursor-pointer select-none flex items-center justify-between list-none"
                  style="color: var(--color-navy);"
                >
                  {item.q}
                  <svg
                    class="w-4 h-4 flex-shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180"
                    style="color: var(--color-gray-text);"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 pb-5 pt-1 text-sm leading-relaxed" style="color: var(--color-gray-text);">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <!-- Still have questions -->
      <div class="mt-10 text-center p-8 rounded-2xl" style="background-color: var(--color-blush);">
        <h3 class="font-bold text-lg mb-2" style="font-family: var(--font-display); color: var(--color-navy);">Still have a question?</h3>
        <p class="text-sm mb-5" style="color: var(--color-gray-text);">WhatsApp is the fastest way to reach us.</p>
        <a
          href="https://wa.me/917975027491?text=Hi%2C%20I%20have%20a%20question%20about%20a%20Seek%20the%20Thrill%20trip."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-white text-sm px-6 py-3 rounded-full"
          style="background-color: var(--color-coral);"
        >
          Ask on WhatsApp →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
