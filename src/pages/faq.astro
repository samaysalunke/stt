---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  {
    name: 'Booking',
    questions: [
      {
        q: 'How do I reserve a spot?',
        a: "Find a trip you like, click Save my spot, fill in the form, pay the advance via UPI, upload your payment screenshot, and submit. We confirm within 24 hours.",
      },
      {
        q: 'Can I book for a group of friends?',
        a: "Yes — fill out one form per person. If you're all traveling together, mention it in the form and we'll try to keep you in the same batch.",
      },
      {
        q: 'What happens after I register?',
        a: "You'll get a confirmation email within 24 hours once we've verified your payment. If a trip fills up before we process yours, we'll reach out directly on WhatsApp.",
      },
      {
        q: 'Can I transfer my spot to someone else?',
        a: "Yes, up to 7 days before departure. Email us with the new traveler's details — name, phone, and any relevant health info.",
      },
    ],
  },
  {
    name: 'Payment',
    questions: [
      {
        q: "What's the booking advance amount?",
        a: "₹3,000 to confirm your spot. This is non-refundable unless we cancel the trip.",
      },
      {
        q: 'When is the full payment due?',
        a: "15 days before the trip departure date. We'll send a reminder — but it's your responsibility to pay on time or your spot may be released.",
      },
      {
        q: 'What payment methods do you accept?',
        a: "UPI only right now — GPay, PhonePe, Paytm, BHIM. Scan the QR code on the trip page, pay, screenshot it, upload it. Simple.",
      },
      {
        q: 'What if I need to cancel?',
        a: "30+ days before: full refund minus ₹500 processing fee. 15–29 days: 50% refund. 7–14 days: 25% refund. Under 7 days: no refund. All cancellations must be in writing to zahra@seekthethrill.in.",
      },
    ],
  },
  {
    name: 'What to expect',
    questions: [
      {
        q: 'Who else comes on these trips?',
        a: "Usually solo travelers between 22–35, mostly from major cities, all looking for something a bit more real than a resort. Friend groups too. The mix is always interesting.",
      },
      {
        q: "What's the group size?",
        a: "Typically 8–20 people depending on the trip. Small enough that everyone actually knows each other by the end.",
      },
      {
        q: 'Is solo travel experience required?',
        a: "Not at all. Many people on STT trips are doing their first solo or first group trip. You're not expected to know anything — just show up.",
      },
      {
        q: 'What level of fitness do I need?',
        a: "Depends on the trip. Beach escapes need very little. Mountain treks need more. Each trip page has specifics. If you're unsure, WhatsApp us — we'll tell you straight.",
      },
    ],
  },
  {
    name: 'Safety & logistics',
    questions: [
      {
        q: 'Are these trips safe for solo women?',
        a: "Yes. Many of our travelers are solo women. We keep groups mixed, brief everyone on conduct, and Zahra personally vets every route. Message us if you have specific concerns — we'll answer honestly.",
      },
      {
        q: 'What if I have dietary restrictions?',
        a: "Mention it when you register. We do our best to accommodate vegetarian and vegan options everywhere. Remote areas have limited choices — we'll always tell you in advance.",
      },
      {
        q: 'Do you arrange flights or trains?',
        a: "For most trips, no — you get to the meeting point, we handle everything from there. Some trips include coordinated group travel from Delhi or Mumbai. Check the trip page.",
      },
      {
        q: 'What should I pack?',
        a: "Each trip page has a packing list. The one universal rule: pack light. You'll thank yourself on day two when everyone else is dragging a suitcase uphill.",
      },
    ],
  },
];
---

<BaseLayout
  title="FAQ — Seek the Thrill"
  description="Everything you need to know about booking, payment, and what to expect on a Seek the Thrill trip."
>

  <!-- Header -->
  <section class="py-16" style="background-color: var(--color-blush);">
    <div class="container-app text-center">
      <h1 class="text-4xl lg:text-5xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-navy);">
        Questions
      </h1>
      <p class="text-base" style="color: var(--color-gray-text);">
        Answers to things people actually ask.
      </p>
    </div>
  </section>

  <!-- FAQ Sections -->
  <section class="py-14 lg:py-20" style="background-color: var(--color-gray-soft);">
    <div class="container-app max-w-3xl">
      {categories.map((category) => (
        <div class="mb-12">
          <h2 class="text-xl font-bold mb-5" style="font-family: var(--font-display); color: var(--color-navy);">
            {category.name}
          </h2>
          <div class="space-y-2">
            {category.questions.map((item) => (
              <details
                class="bg-white rounded-xl overflow-hidden border group"
                style="border-color: var(--color-border);"
              >
                <summary
                  class="px-5 py-4 font-medium text-sm cursor-pointer select-none flex items-center justify-between list-none"
                  style="color: var(--color-navy);"
                >
                  {item.q}
                  <svg
                    class="w-4 h-4 flex-shrink-0 ml-3 transition-transform duration-200 group-open:rotate-180"
                    style="color: var(--color-gray-text);"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-5 pb-5 pt-1 text-sm leading-relaxed" style="color: var(--color-gray-text);">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <!-- Still have questions -->
      <div class="mt-10 text-center p-8 rounded-2xl" style="background-color: var(--color-blush);">
        <h3 class="font-bold text-lg mb-2" style="font-family: var(--font-display); color: var(--color-navy);">Still have a question?</h3>
        <p class="text-sm mb-5" style="color: var(--color-gray-text);">WhatsApp is the fastest way to reach us.</p>
        <a
          href="https://wa.me/917975027491?text=Hi%2C%20I%20have%20a%20question%20about%20a%20Seek%20the%20Thrill%20trip."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold text-white text-sm px-6 py-3 rounded-full"
          style="background-color: var(--color-coral);"
        >
          Ask on WhatsApp →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
