# ============================================
# SEEK THE THRILL — Environment Variables
# Copy this file to .env and fill in values.
#
# On Railway these are set in the service's "Variables" tab — the Node
# standalone build does NOT read a .env file at runtime.
# ============================================

# Site — canonical public origin (no trailing slash, no path).
# Production is www; the middleware canonicalises apex -> www off this.
SITE_URL=https://www.seekthethrill.in

# Persistent storage — MUST point inside a mounted Railway Volume in prod,
# or the SQLite DB and CMS content are wiped on every deploy.
# DATA_DIR=/app/data          # SQLite DB + uploaded payment screenshots
# CONTENT_DIR=/app/content    # Trip/album/testimonial YAML files

# ── Google OAuth (user sign-in + admin sign-in share one client) ──────────────
# Web application client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URIs — must byte-match the "Authorized redirect URIs" in the console.
# Optional: if unset, both are derived from SITE_URL.
# USER_AUTH_REDIRECT_URI=https://www.seekthethrill.in/api/auth/callback
# ADMIN_OAUTH_REDIRECT_URI=https://www.seekthethrill.in/api/admin/auth/callback
# First admin sign-in with this email is auto-granted the `owner` role.
ADMIN_OWNER_EMAIL=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=zahra@seekthethrill.in
# Password login is a dev/test fallback only. LEAVE UNSET IN PRODUCTION to disable
# it entirely and rely on Google OAuth. If set for local dev, use a strong value.
# ADMIN_PASSWORD=

# Test-only helper routes under /api/test/* (PII read + destructive reset).
# Auto-enabled in dev builds. NEVER set this in production.
# ENABLE_TEST_ENDPOINTS=true

# ── Email — Resend HTTPS API only ────────────────────────────────────────────
# Railway blocks all outbound SMTP ports; nodemailer/SMTP cannot work there.
# Without RESEND_API_KEY every send is mock-logged and throws.
RESEND_API_KEY=
# Sender — must be a Resend-verified domain. Until seekthethrill.in is verified,
# Resend's sandbox "onboarding@resend.dev" only delivers to the account owner.
EMAIL_FROM=Seek the Thrill <notifications@seekthethrill.in>

# ── IndexNow (search-engine ping on content changes) ─────────────────────────
# Key must also be hosted at <SITE_URL>/<INDEXNOW_KEY>.txt (served automatically).
# Unset = every submission is a no-op.
INDEXNOW_KEY=

# ── Zoho Books accounting documents ──────────────────────────────────────────
# Keep disabled until a non-taxable item, templates, numbering, and the
# complete draft flow have been verified.
ZOHO_BOOKS_MODE=disabled # disabled | draft | live
ZOHO_DATA_CENTER=in
# ZOHO_BOOKS_ORGANIZATION_ID=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_BOOKS_ITEM_ID=
# ZOHO_RETAINER_TEMPLATE_ID=
# ZOHO_INVOICE_TEMPLATE_ID=
# ZOHO_JOB_SECRET= # long random bearer token for POST /api/jobs/zoho-documents

# ── Telegram booking notifications ───────────────────────────────────────────
# Create the bot with @BotFather. Never expose or log this server-only token.
TELEGRAM_BOT_TOKEN=
# Numeric chat.id for the private user/group that receives booking events.
TELEGRAM_ADMIN_CHAT_ID=
